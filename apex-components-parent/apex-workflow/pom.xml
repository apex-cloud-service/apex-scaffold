<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - 工作流模块 POM 配置文件
  - 该模块聚合工作流引擎（定义/实例/任务）、办公审批集成、监控统计等能力，
  - 对外暴露独立的领域模型、仓储契约、应用服务与接口层（Router/Handler）。
  - @author Apex Team
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-components-parent</artifactId>
        <version>1.3.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>apex-workflow</artifactId>
    <packaging>jar</packaging>
    <name>apex-workflow</name>
    <description>Apex Scaffold - Workflow Module (工作流引擎、办公审批集成、监控统计)</description>

    <dependencies>
        <!-- 依赖领域层：工作流领域模型与仓储契约（迁移自 apex-domain） -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-domain</artifactId>
        </dependency>

        <!-- 依赖公共模块：统一响应、异常、注解、工具类等 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>

        <!-- Spring WebFlux：响应式路由与处理器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Spring JDBC：阻塞式持久化访问的调度桥接 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 参数校验：请求 DTO 的声明式校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- springdoc：为功能路由生成 OpenAPI 文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok：编译期生成样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok 编译期注解处理器 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok-mapstruct-binding</artifactId>
            <version>0.2.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- MapStruct：对象转换 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <excludeRoots>
                        <excludeRoot>${project.build.directory}/generated-sources/annotations</excludeRoot>
                    </excludeRoots>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- 纯 DTO / 请求对象：仅携带数据，无业务决策分支 -->
                        <exclude>com/apex/scaffold/workflow/application/dto/**/*</exclude>
                        <!-- 纯领域模型：仅携带数据，无业务决策分支 -->
                        <exclude>com/apex/scaffold/workflow/domain/model/**/*</exclude>
                        <!-- 持久化对象与转换器：无业务决策分支 -->
                        <exclude>com/apex/scaffold/workflow/infrastructure/persistence/po/**/*</exclude>
                        <exclude>com/apex/scaffold/workflow/infrastructure/persistence/converter/**/*</exclude>
                        <exclude>com/apex/scaffold/workflow/infrastructure/persistence/repository/**/*</exclude>
                    </excludes>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <!-- 应用服务：核心编排逻辑 -->
                                <include>com.apex.scaffold.workflow.application.service.*</include>
                                <include>com.apex.scaffold.workflow.application.query.*</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.85</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.65</minimum>
                                </limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <!-- 定时调度与超时处理 -->
                                <include>com.apex.scaffold.workflow.application.scheduler.*</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.70</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.50</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>workflow-report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
                    <execution><id>workflow-coverage-check</id><phase>test</phase><goals><goal>check</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
