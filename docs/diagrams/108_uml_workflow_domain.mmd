%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#ecfdf5','primaryTextColor':'#0f172a','primaryBorderColor':'#059669','lineColor':'#64748b','fontFamily':'sans-serif'}}}%%
classDiagram
    direction TB

    class WorkflowDefinition {
        «aggregate root · 流程模板 @Data»
        - Long id
        - String workflowCode
        - String workflowName
        - String description
        - Integer version
        - String dagJson
        - Integer enabled
        - WorkflowDefinitionStatus status
        - LocalDateTime publishedAt
        - Long publishedBy
        - LocalDateTime createTime / updateTime
        - Long createBy / updateBy
        - Integer deleted
        + isDraft() boolean
        + isPublished() boolean
        + isEditable() boolean
        + publish(operatorId, now)
    }
    note for WorkflowDefinition "dagJson: WorkflowDefinitionGraph DAG 定义\nstatus: DRAFT/ACTIVE/ARCHIVED\nenabled 与 status 双控发布"

    class WorkflowDefinitionStatus {
        «enumeration»
        DRAFT
        ACTIVE
        ARCHIVED
    }

    class ProcessInstance {
        «aggregate root · 运行实例 @Data»
        - Long id
        - Long workflowDefinitionId
        - String businessKey
        - String currentNodeKey
        - String status
        - Long initiatorId
        - String contextJson
        - LocalDateTime startTime / endTime
        - LocalDateTime createTime / updateTime
        - Integer deleted
        - Boolean suspended
    }
    note for ProcessInstance "status: RUNNING/SUSPENDED/COMPLETED/REJECTED/CANCELLED\nsuspended 挂起标志\ncontextJson 流程上下文"

    class Task {
        «entity · 任务 @Data @Version»
        - String tenantId
        - Long id
        - Integer version
        - Long processInstanceId
        - String nodeKey / nodeCode / nodeName
        - Long assigneeId
        - String status
        - LocalDateTime dueDate / completedTime
        - LocalDateTime timeoutAt
        - String timeoutStrategy
        - Long transferredFrom
        - LocalDateTime createTime / updateTime
        - Integer deleted
    }
    note for Task "status: PENDING/COMPLETED/REJECTED/CANCELLED/TRANSFERRED\ntimeoutStrategy: AUTO_APPROVE/AUTO_REJECT/REMIND\nversion 乐观锁条件更新"

    class ApprovalRecord {
        «entity · 审批留痕 @Data»
        - Long id
        - Long processInstanceId
        - Long taskId
        - Long approverId
        - String action
        - String comment
        - LocalDateTime createTime
        - Integer deleted
    }
    note for ApprovalRecord "action: APPROVE/REJECT/TRANSFER/CANCEL\n纯留痕记录，不可变"

    class WorkflowDefinitionRepository {
        «repository»
        + findById(id) Mono~WorkflowDefinition~
        + findByCode(code) Mono~WorkflowDefinition~
        + findVersions(code) Mono~List~
        + save(def) Mono~WorkflowDefinition~
    }

    class ProcessInstanceRepository {
        «repository»
        + findById(id) Mono~ProcessInstance~
        + findByBusinessKey(key) Mono~ProcessInstance~
        + findByInitiator(id) Mono~List~
        + save(instance) Mono~ProcessInstance~
    }

    class TaskRepository {
        «repository»
        + findById(id) Mono~Task~
        + findByProcessInstanceId(id) Mono~List~
        + save(task) Mono~Task~
        + findByAssigneeAndStatus(id, status) Flux~Task~
    }

    class ApprovalRecordRepository {
        «repository»
        + findById(id) Mono~ApprovalRecord~
        + findByProcessInstanceId(id) Mono~List~
        + findByTaskId(id) Mono~List~
        + save(record) Mono~ApprovalRecord~
    }

    class WorkflowTaskTransaction {
        «transaction port»
        + execute(tenant, Consumer~Operations~)
        + interface Operations
    }

    WorkflowDefinition "1" --> "*" ProcessInstance : "实例化"
    ProcessInstance "1" --> "1..*" Task : "生成任务"
    Task --> ApprovalRecord : "审批留痕"
    ProcessInstance --> "*" ApprovalRecord : "流程记录"

    WorkflowDefinitionRepository ..> WorkflowDefinition : «manages»
    ProcessInstanceRepository ..> ProcessInstance : «manages»
    TaskRepository ..> Task : «manages»
    ApprovalRecordRepository ..> ApprovalRecord : «manages»
    WorkflowTaskTransaction ..> Task : «事务边界»

    note for ProcessInstance "流程状态机：RUNNING → SUSPENDED → COMPLETED / REJECTED / CANCELLED"
    note for Task "任务状态机：PENDING → COMPLETED / REJECTED / CANCELLED / TRANSFERRED"
    note for WorkflowTaskTransaction "任务完成+审批记录写入需同事务\nexecute 内 Operations 提供原子操作"
