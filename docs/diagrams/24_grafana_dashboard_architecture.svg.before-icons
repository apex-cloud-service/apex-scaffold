<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1800">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #F8FAFC; }
      .subtitle { font: 16px sans-serif; fill: #94A3B8; }
      .section-title { font: bold 20px sans-serif; fill: #38BDF8; }
      .layer-title { font: bold 16px sans-serif; fill: #F8FAFC; }
      .group-title { font: bold 14px sans-serif; fill: #F8FAFC; }
      .panel-desc { font: 12px sans-serif; fill: #CBD5E1; }
      .metric-name { font: 11px monospace; fill: #4FD1C5; }
      .count { font: bold 18px sans-serif; fill: #F97316; }
      .port { font: 11px monospace; fill: #38BDF8; }
      
      .datasource-bg { fill: #1E293B; stroke: #38BDF8; stroke-width: 2; }
      .dashboard-bg { fill: #0F172A; stroke: #F97316; stroke-width: 3; }
      .group-box { fill: #1E293B; stroke: #4FD1C5; stroke-width: 1.5; }
      .critical-group { fill: #1E293B; stroke: #EF4444; stroke-width: 2; }
      .warning-group { fill: #1E293B; stroke: #F59E0B; stroke-width: 2; }
      .success-group { fill: #1E293B; stroke: #10B981; stroke-width: 2; }
      
      .data-flow { stroke: #4FD1C5; stroke-width: 2.5; fill: none; marker-end: url(#arrowhead); }
      .query-flow { stroke: #F97316; stroke-width: 2; fill: none; stroke-dasharray: 5,5; marker-end: url(#queryhead); }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#4FD1C5" />
    </marker>
    <marker id="queryhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#F97316" />
    </marker>
  </defs>

  <!-- Background -->
  <rect width="1600" height="1800" fill="#0B0E14"/>

  <!-- Title -->
  <text x="800" y="40" text-anchor="middle" class="title">Apex Scaffold Grafana 监控大盘架构</text>
  <text x="800" y="65" text-anchor="middle" class="subtitle">66个监控面板 · 10组分类 · 实时指标可视化</text>

  <!-- Left: Data Sources -->
  <rect x="50" y="100" width="380" height="1620" rx="8" class="datasource-bg"/>
  <text x="240" y="135" text-anchor="middle" class="section-title">数据源 Data Sources</text>

  <!-- Prometheus -->
  <rect x="70" y="160" width="340" height="140" rx="6" style="fill:#0B0E14;stroke:#38BDF8;stroke-width:2;"/>
  <text x="240" y="190" text-anchor="middle" class="layer-title">Prometheus</text>
  <text x="240" y="210" text-anchor="middle" class="port">http://prometheus:9090</text>
  <text x="85" y="235" class="panel-desc">• scrape_interval: 15s</text>
  <text x="85" y="255" class="panel-desc">• retention: 15 days</text>
  <text x="85" y="275" class="panel-desc">• 6个抓取目标</text>
  <text x="85" y="295" class="panel-desc">• 10组告警规则</text>

  <!-- Target 1: Apex Scaffold -->
  <rect x="70" y="320" width="340" height="100" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:1.5;"/>
  <text x="240" y="345" text-anchor="middle" class="group-title">① Apex Scaffold 应用</text>
  <text x="240" y="365" text-anchor="middle" class="port">:8081/actuator/prometheus</text>
  <text x="85" y="385" class="panel-desc">• apex_api_* 接口指标</text>
  <text x="85" y="405" class="panel-desc">• jvm_* JVM运行时</text>
  <text x="85" y="425" class="panel-desc">• hikaricp_*/druid_* 连接池</text>

  <!-- Target 2: Sentinel -->
  <rect x="70" y="440" width="340" height="80" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:1.5;"/>
  <text x="240" y="465" text-anchor="middle" class="group-title">② Sentinel 治理</text>
  <text x="240" y="485" text-anchor="middle" class="port">:8720/metrics</text>
  <text x="85" y="505" class="panel-desc">• sentinel_* 限流/熔断</text>

  <!-- Target 3: Health Probe -->
  <rect x="70" y="540" width="340" height="80" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:1.5;"/>
  <text x="240" y="565" text-anchor="middle" class="group-title">③ 健康探针 Blackbox</text>
  <text x="240" y="585" text-anchor="middle" class="port">probe_success{}</text>
  <text x="85" y="605" class="panel-desc">• 健康检查状态</text>

  <!-- Target 4: Grafana -->
  <rect x="70" y="640" width="340" height="80" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:1.5;"/>
  <text x="240" y="665" text-anchor="middle" class="group-title">④ Grafana 自监控</text>
  <text x="240" y="685" text-anchor="middle" class="port">:3000/metrics</text>
  <text x="85" y="705" class="panel-desc">• 大盘渲染性能</text>

  <!-- Target 5: Zipkin -->
  <rect x="70" y="740" width="340" height="80" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:1.5;"/>
  <text x="240" y="765" text-anchor="middle" class="group-title">⑤ Zipkin 链路追踪</text>
  <text x="240" y="785" text-anchor="middle" class="port">:9411/prometheus</text>
  <text x="85" y="805" class="panel-desc">• zipkin_collector_* Span</text>

  <!-- Metrics Summary -->
  <rect x="70" y="840" width="340" height="860" rx="6" style="fill:#0B0E14;stroke:#4FD1C5;stroke-width:2;"/>
  <text x="240" y="870" text-anchor="middle" class="layer-title">核心指标类型</text>
  
  <text x="85" y="900" class="group-title">🔹 应用指标</text>
  <text x="95" y="920" class="metric-name">apex_api_request_count_total</text>
  <text x="95" y="940" class="metric-name">apex_api_response_time_seconds</text>
  <text x="95" y="960" class="metric-name">apex_exception_total</text>
  
  <text x="85" y="990" class="group-title">🔹 JVM指标</text>
  <text x="95" y="1010" class="metric-name">jvm_memory_used_bytes</text>
  <text x="95" y="1030" class="metric-name">jvm_gc_pause_seconds_count</text>
  <text x="95" y="1050" class="metric-name">jvm_threads_live_threads</text>
  
  <text x="85" y="1080" class="group-title">🔹 数据库指标</text>
  <text x="95" y="1100" class="metric-name">hikaricp_connections_active</text>
  <text x="95" y="1120" class="metric-name">druid_connections_max</text>
  
  <text x="85" y="1150" class="group-title">🔹 Redis指标</text>
  <text x="95" y="1170" class="metric-name">redisson_healthy</text>
  <text x="95" y="1190" class="metric-name">apex_cache_hit_ratio</text>
  
  <text x="85" y="1220" class="group-title">🔹 治理指标</text>
  <text x="95" y="1240" class="metric-name">sentinel_block_qps_total</text>
  <text x="95" y="1260" class="metric-name">resilience4j_circuitbreaker_*</text>
  
  <text x="85" y="1290" class="group-title">🔹 业务指标</text>
  <text x="95" y="1310" class="metric-name">apex_business_login_total</text>
  <text x="95" y="1330" class="metric-name">apex_business_upload_total</text>
  
  <text x="85" y="1360" class="group-title">🔹 安全指标</text>
  <text x="95" y="1380" class="metric-name">apex_security_ip_blocked_total</text>
  <text x="95" y="1400" class="metric-name">apex_security_xss_blocked_total</text>
  
  <text x="85" y="1430" class="group-title">🔹 链路追踪</text>
  <text x="95" y="1450" class="metric-name">zipkin_collector_spans_total</text>
  <text x="95" y="1470" class="metric-name">zipkin_collector_messages_dropped</text>
  
  <text x="85" y="1500" class="group-title">🔹 系统资源</text>
  <text x="95" y="1520" class="metric-name">apex_disk_used_percent</text>
  <text x="95" y="1540" class="metric-name">apex_network_interface_up</text>
  
  <text x="85" y="1570" class="group-title">🔹 阻塞IO</text>
  <text x="95" y="1590" class="metric-name">apex_blocking_io_queued_tasks</text>
  <text x="95" y="1610" class="metric-name">apex_blocking_io_active_threads</text>
  
  <text x="240" y="1650" text-anchor="middle" class="panel-desc" style="fill:#F97316;">✅ 100+ 指标类型</text>
  <text x="240" y="1675" text-anchor="middle" class="panel-desc" style="fill:#F97316;">⚡ 15秒采集周期</text>

  <!-- Center: Grafana Dashboard -->
  <rect x="480" y="100" width="660" height="1620" rx="8" class="dashboard-bg"/>
  <text x="810" y="135" text-anchor="middle" class="section-title">Grafana Dashboard</text>
  <text x="810" y="160" text-anchor="middle" class="subtitle">66个监控面板 · 11个分组</text>

  <!-- Group 1: Core Metrics -->
  <rect x="500" y="190" width="620" height="120" rx="6" class="critical-group"/>
  <text x="520" y="220" class="group-title">1️⃣ 核心指标看板 (6个)</text>
  <text x="1050" y="220" class="count">6</text>
  <text x="520" y="240" class="panel-desc">• 服务状态 (UP/DOWN)</text>
  <text x="520" y="260" class="panel-desc">• 请求吞吐 (QPS)</text>
  <text x="520" y="280" class="panel-desc">• P95响应时间</text>
  <text x="810" y="240" class="panel-desc">• 5xx错误率</text>
  <text x="810" y="260" class="panel-desc">• JVM堆使用率</text>
  <text x="810" y="280" class="panel-desc">• DB连接池水位</text>
  <text x="520" y="300" class="metric-name">up{}, apex_api_request_count_total</text>

  <!-- Group 2: HTTP Monitoring -->
  <rect x="500" y="330" width="620" height="100" rx="6" class="group-box"/>
  <text x="520" y="360" class="group-title">2️⃣ HTTP接口监控 (4个)</text>
  <text x="1050" y="360" class="count">4</text>
  <text x="520" y="380" class="panel-desc">• 请求量(按状态码)</text>
  <text x="810" y="380" class="panel-desc">• 响应时间分位数(P50/P90/P95/P99)</text>
  <text x="520" y="400" class="panel-desc">• 外部API调用QPS</text>
  <text x="810" y="400" class="panel-desc">• 外部API成功率</text>
  <text x="520" y="420" class="metric-name">histogram_quantile(0.95, apex_api_response_time_seconds_bucket)</text>

  <!-- Group 3: JVM Deep Monitoring -->
  <rect x="500" y="450" width="620" height="140" rx="6" class="warning-group"/>
  <text x="520" y="480" class="group-title">3️⃣ JVM深度监控 (10个)</text>
  <text x="1050" y="480" class="count">10</text>
  <text x="520" y="500" class="panel-desc">• JVM堆内存趋势</text>
  <text x="810" y="500" class="panel-desc">• JVM非堆内存</text>
  <text x="520" y="520" class="panel-desc">• GC频率(Minor/Major)</text>
  <text x="810" y="520" class="panel-desc">• GC耗时分布</text>
  <text x="520" y="540" class="panel-desc">• 线程数(活跃/守护/峰值)</text>
  <text x="810" y="540" class="panel-desc">• 类加载/卸载</text>
  <text x="520" y="560" class="panel-desc">• Eden/Old Gen使用率</text>
  <text x="810" y="560" class="panel-desc">• GC停顿时间(STW)</text>
  <text x="520" y="580" class="metric-name">jvm_memory_used_bytes, jvm_gc_pause_seconds_count</text>

  <!-- Group 4: Database -->
  <rect x="500" y="610" width="620" height="80" rx="6" class="group-box"/>
  <text x="520" y="640" class="group-title">4️⃣ 数据库监控 (2个)</text>
  <text x="1050" y="640" class="count">2</text>
  <text x="520" y="660" class="panel-desc">• 数据库连接池(HikariCP/Druid)</text>
  <text x="810" y="660" class="panel-desc">• 连接池等待/超时</text>
  <text x="520" y="680" class="metric-name">hikaricp_connections_active, druid_connections_max</text>

  <!-- Group 5: System Resources -->
  <rect x="500" y="710" width="620" height="100" rx="6" class="group-box"/>
  <text x="520" y="740" class="group-title">5️⃣ 系统资源 (4个)</text>
  <text x="1050" y="740" class="count">4</text>
  <text x="520" y="760" class="panel-desc">• 磁盘使用率</text>
  <text x="810" y="760" class="panel-desc">• 磁盘使用率(按挂载点)</text>
  <text x="520" y="780" class="panel-desc">• 网卡启用数</text>
  <text x="810" y="780" class="panel-desc">• 网卡状态(按接口)</text>
  <text x="520" y="800" class="metric-name">apex_disk_used_percent, apex_network_interface_up</text>

  <!-- Group 6: Middleware -->
  <rect x="500" y="830" width="620" height="100" rx="6" class="success-group"/>
  <text x="520" y="860" class="group-title">6️⃣ 中间件监控 (5个)</text>
  <text x="1050" y="860" class="count">5</text>
  <text x="520" y="880" class="panel-desc">• Redis健康</text>
  <text x="810" y="880" class="panel-desc">• Redis节点数</text>
  <text x="520" y="900" class="panel-desc">• Redis可用性</text>
  <text x="810" y="900" class="panel-desc">• 缓存命中率</text>
  <text x="520" y="920" class="metric-name">redisson_healthy, apex_cache_hit_ratio</text>

  <!-- Group 7: Governance & Security -->
  <rect x="500" y="950" width="620" height="140" rx="6" class="warning-group"/>
  <text x="520" y="980" class="group-title">7️⃣ 治理与安全 (12个)</text>
  <text x="1050" y="980" class="count">12</text>
  <text x="520" y="1000" class="panel-desc">• Sentinel治理(限流/熔断)</text>
  <text x="810" y="1000" class="panel-desc">• 限流拒绝(5m)</text>
  <text x="520" y="1020" class="panel-desc">• 熔断触发(5m)</text>
  <text x="810" y="1020" class="panel-desc">• 限流/熔断趋势</text>
  <text x="520" y="1040" class="panel-desc">• 活跃会话</text>
  <text x="810" y="1040" class="panel-desc">• 安全防护拦截明细</text>
  <text x="520" y="1060" class="panel-desc">• IP封禁统计</text>
  <text x="810" y="1060" class="panel-desc">• XSS拦截统计</text>
  <text x="520" y="1080" class="metric-name">sentinel_block_qps_total, apex_security_ip_blocked_total</text>

  <!-- Group 8: Business -->
  <rect x="500" y="1110" width="620" height="100" rx="6" class="group-box"/>
  <text x="520" y="1140" class="group-title">8️⃣ 核心业务 (5个)</text>
  <text x="1050" y="1140" class="count">5</text>
  <text x="520" y="1160" class="panel-desc">• 登录成功(5m)</text>
  <text x="810" y="1160" class="panel-desc">• 注册(5m)</text>
  <text x="520" y="1180" class="panel-desc">• 上传(5m)</text>
  <text x="810" y="1180" class="panel-desc">• 信用变更(5m)</text>
  <text x="520" y="1200" class="metric-name">apex_business_login_total, apex_business_upload_total</text>

  <!-- Group 9: Tracing -->
  <rect x="500" y="1230" width="620" height="100" rx="6" class="group-box"/>
  <text x="520" y="1260" class="group-title">9️⃣ 链路追踪 (4个)</text>
  <text x="1050" y="1260" class="count">4</text>
  <text x="520" y="1280" class="panel-desc">• Zipkin在线</text>
  <text x="810" y="1280" class="panel-desc">• Span接收速率(5m)</text>
  <text x="520" y="1300" class="panel-desc">• Span丢弃(5m)</text>
  <text x="810" y="1300" class="panel-desc">• Zipkin收集器负载</text>
  <text x="520" y="1320" class="metric-name">zipkin_collector_spans_total, zipkin_collector_messages_dropped</text>

  <!-- Group 10: Gateway Performance -->
  <rect x="500" y="1350" width="620" height="100" rx="6" class="group-box"/>
  <text x="520" y="1380" class="group-title">🔟 网关与接口性能 (5个)</text>
  <text x="1050" y="1380" class="count">5</text>
  <text x="520" y="1400" class="panel-desc">• 接口QPS Top 10</text>
  <text x="810" y="1400" class="panel-desc">• 慢接口Top 10(P95)</text>
  <text x="520" y="1420" class="panel-desc">• 错误接口Top 10</text>
  <text x="810" y="1420" class="panel-desc">• 接口热力图</text>
  <text x="520" y="1440" class="metric-name">topk(10, rate(apex_api_request_count_total[5m]))</text>

  <!-- Group 11: Circuit Breaker -->
  <rect x="500" y="1470" width="620" height="120" rx="6" class="critical-group"/>
  <text x="520" y="1500" class="group-title">1️⃣1️⃣ 熔断器状态监控 (6个)</text>
  <text x="1050" y="1500" class="count">6</text>
  <text x="520" y="1520" class="panel-desc">• 熔断器状态(Open/Closed/HalfOpen)</text>
  <text x="520" y="1540" class="panel-desc">• 熔断器失败率</text>
  <text x="810" y="1540" class="panel-desc">• 熔断器调用统计</text>
  <text x="520" y="1560" class="panel-desc">• 慢调用比例</text>
  <text x="810" y="1560" class="panel-desc">• 阻塞IO队列积压</text>
  <text x="520" y="1580" class="metric-name">resilience4j_circuitbreaker_state, apex_blocking_io_queued_tasks</text>

  <!-- Dashboard Summary -->
  <rect x="500" y="1610" width="620" height="100" rx="6" style="fill:#1E293B;stroke:#F97316;stroke-width:3;"/>
  <text x="810" y="1645" text-anchor="middle" class="section-title">📊 总计: 66个监控面板</text>
  <text x="810" y="1675" text-anchor="middle" class="panel-desc">实时刷新 · 历史回溯 · 告警联动 · 一键导出</text>

  <!-- Right: Users & Alerts -->
  <rect x="1190" y="100" width="360" height="1620" rx="8" class="datasource-bg"/>
  <text x="1370" y="135" text-anchor="middle" class="section-title">用户访问 &amp; 告警</text>

  <!-- Web UI -->
  <rect x="1210" y="160" width="320" height="120" rx="6" style="fill:#0B0E14;stroke:#38BDF8;stroke-width:2;"/>
  <text x="1370" y="190" text-anchor="middle" class="layer-title">Grafana Web UI</text>
  <text x="1370" y="210" text-anchor="middle" class="port">http://localhost:3000</text>
  <text x="1225" y="235" class="panel-desc">👤 默认账号: admin/admin</text>
  <text x="1225" y="255" class="panel-desc">🔐 SSO认证(可选)</text>
  <text x="1225" y="275" class="panel-desc">📱 响应式设计</text>

  <!-- Alert Rules -->
  <rect x="1210" y="300" width="320" height="620" rx="6" style="fill:#0B0E14;stroke:#EF4444;stroke-width:2;"/>
  <text x="1370" y="330" text-anchor="middle" class="layer-title">10组告警规则</text>
  
  <text x="1225" y="360" class="group-title">🚨 服务可用性 (2条)</text>
  <text x="1235" y="380" class="panel-desc">• ApexServiceDown (1m)</text>
  <text x="1235" y="400" class="panel-desc">• ApexHealthCheckDown (2m)</text>
  
  <text x="1225" y="430" class="group-title">⚠️ 接口质量 (5条)</text>
  <text x="1235" y="450" class="panel-desc">• 5xx错误率 > 5% (5m)</text>
  <text x="1235" y="470" class="panel-desc">• P95延迟 > 2s (5m)</text>
  <text x="1235" y="490" class="panel-desc">• 流量骤降 &lt; 20% (10m)</text>
  <text x="1235" y="510" class="panel-desc">• 异常突增 > 50/min (5m)</text>
  <text x="1235" y="530" class="panel-desc">• 告警风暴 > 3次 (5m)</text>
  
  <text x="1225" y="560" class="group-title">☕ JVM健康 (4条)</text>
  <text x="1235" y="580" class="panel-desc">• 堆内存 > 85% (10m)</text>
  <text x="1235" y="600" class="panel-desc">• Full GC > 5次/min (5m)</text>
  <text x="1235" y="620" class="panel-desc">• GC停顿 > 1s (5m)</text>
  <text x="1235" y="640" class="panel-desc">• 线程数 > 2000 (10m)</text>
  
  <text x="1225" y="670" class="group-title">💾 数据库 (2条)</text>
  <text x="1235" y="690" class="panel-desc">• 连接池水位 > 80% (5m)</text>
  <text x="1235" y="710" class="panel-desc">• 连接超时 > 5次 (10m)</text>
  
  <text x="1225" y="740" class="group-title">🛡️ Sentinel (1条)</text>
  <text x="1235" y="760" class="panel-desc">• 拦截 > 100次 (10m)</text>
  
  <text x="1225" y="790" class="group-title">🔌 阻塞IO (2条)</text>
  <text x="1235" y="810" class="panel-desc">• 队列积压 > 500 (30m)</text>
  <text x="1235" y="830" class="panel-desc">• 采集失败 (10m)</text>
  
  <text x="1225" y="860" class="group-title">📡 下游依赖 (2条)</text>
  <text x="1235" y="880" class="panel-desc">• Redis不可达 (2m)</text>
  <text x="1235" y="900" class="panel-desc">• 指标采集失败 (5m)</text>

  <!-- Alert Notification -->
  <rect x="1210" y="940" width="320" height="140" rx="6" style="fill:#0B0E14;stroke:#F59E0B;stroke-width:2;"/>
  <text x="1370" y="970" text-anchor="middle" class="layer-title">告警通知渠道</text>
  <text x="1225" y="995" class="panel-desc">📧 Email</text>
  <text x="1225" y="1015" class="panel-desc">💬 钉钉/企业微信</text>
  <text x="1225" y="1035" class="panel-desc">📱 短信/电话</text>
  <text x="1225" y="1055" class="panel-desc">🔔 PagerDuty/OpsGenie</text>
  <text x="1225" y="1075" class="metric-name">Alertmanager配置</text>

  <!-- Features -->
  <rect x="1210" y="1100" width="320" height="600" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:2;"/>
  <text x="1370" y="1130" text-anchor="middle" class="layer-title">核心功能特性</text>
  
  <text x="1225" y="1160" class="group-title">📈 数据可视化</text>
  <text x="1235" y="1180" class="panel-desc">• Time Series (时间序列图)</text>
  <text x="1235" y="1200" class="panel-desc">• Stat (统计面板)</text>
  <text x="1235" y="1220" class="panel-desc">• Gauge (仪表盘)</text>
  <text x="1235" y="1240" class="panel-desc">• Table (数据表格)</text>
  <text x="1235" y="1260" class="panel-desc">• Heatmap (热力图)</text>
  
  <text x="1225" y="1290" class="group-title">🔍 查询分析</text>
  <text x="1235" y="1310" class="panel-desc">• PromQL高级查询</text>
  <text x="1235" y="1330" class="panel-desc">• 变量模板化</text>
  <text x="1235" y="1350" class="panel-desc">• 时间范围选择</text>
  <text x="1235" y="1370" class="panel-desc">• 自动刷新(5s-1h)</text>
  
  <text x="1225" y="1400" class="group-title">📊 面板功能</text>
  <text x="1235" y="1420" class="panel-desc">• 动态阈值配置</text>
  <text x="1235" y="1440" class="panel-desc">• 颜色映射规则</text>
  <text x="1235" y="1460" class="panel-desc">• 单位自动转换</text>
  <text x="1235" y="1480" class="panel-desc">• Tooltip悬浮提示</text>
  
  <text x="1225" y="1510" class="group-title">💾 导出分享</text>
  <text x="1235" y="1530" class="panel-desc">• JSON导出/导入</text>
  <text x="1235" y="1550" class="panel-desc">• PNG快照</text>
  <text x="1235" y="1570" class="panel-desc">• 公共链接分享</text>
  <text x="1235" y="1590" class="panel-desc">• PDF报告生成</text>
  
  <text x="1225" y="1620" class="group-title">🔐 权限管理</text>
  <text x="1235" y="1640" class="panel-desc">• 组织/团队隔离</text>
  <text x="1235" y="1660" class="panel-desc">• 查看/编辑权限</text>
  <text x="1235" y="1680" class="panel-desc">• LDAP/OAuth集成</text>

