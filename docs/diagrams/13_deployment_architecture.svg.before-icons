<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 1200">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #0f172a; }
      .subtitle { font: 16px sans-serif; fill: #666; }
      .layer-title { font: bold 18px sans-serif; fill: #1e293b; }
      .component-title { font: bold 14px sans-serif; fill: #334155; }
      .component-text { font: 12px sans-serif; fill: #555; }
      .label-text { font: 11px sans-serif; fill: #666; }
      .zone-bg { fill: #f8f9fa; stroke: #dee2e6; stroke-width: 2; }
      .dmz-zone { fill: #fff3cd; stroke: #ffc107; stroke-width: 2; stroke-dasharray: 5,5; }
      .app-zone { fill: #d1ecf1; stroke: #0dcaf0; stroke-width: 2; stroke-dasharray: 5,5; }
      .data-zone { fill: #d4edda; stroke: #28a745; stroke-width: 2; stroke-dasharray: 5,5; }
      .service-zone { fill: #e7d4f5; stroke: #9c27b0; stroke-width: 2; stroke-dasharray: 5,5; }
      .monitor-zone { fill: #ffe8d6; stroke: #fd7e14; stroke-width: 2; stroke-dasharray: 5,5; }
      .component-box { fill: white; stroke: #495057; stroke-width: 1.5; }
      .lb-box { fill: #e3f2fd; stroke: #2196f3; stroke-width: 2; }
      .app-box { fill: #f1f8e9; stroke: #8bc34a; stroke-width: 2; }
      .db-box { fill: #fff3e0; stroke: #ff9800; stroke-width: 2; }
      .cache-box { fill: #fce4ec; stroke: #e91e63; stroke-width: 2; }
      .mq-box { fill: #f3e5f5; stroke: #9c27b0; stroke-width: 2; }
      .monitor-box { fill: #e0f2f1; stroke: #009688; stroke-width: 2; }
      .arrow { fill: none; stroke: #495057; stroke-width: 2; marker-end: url(#arrowhead); }
      .network-line { stroke: #dc3545; stroke-width: 2; stroke-dasharray: 3,3; }
      .icon-text { font: bold 20px sans-serif; }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#495057" />
    </marker>
  </defs>

  <!-- Title -->
  <text x="700" y="40" text-anchor="middle" class="title">Apex Scaffold 部署架构图</text>
  <text x="700" y="65" text-anchor="middle" class="subtitle">Production Deployment Architecture (K8s/Docker)</text>

  <!-- DMZ Zone (Public Network) -->
  <rect x="50" y="100" width="1300" height="180" rx="10" class="dmz-zone"/>
  <text x="70" y="130" class="layer-title">DMZ区 (公网访问层)</text>
  
  <!-- Internet Users -->
  <ellipse cx="150" cy="180" rx="60" ry="40" fill="#fff" stroke="#6c757d" stroke-width="2"/>
  <text x="150" y="175" text-anchor="middle" class="icon-text"></text>
  <text x="150" y="195" text-anchor="middle" class="component-text">互联网用户</text>
  
  <!-- CDN -->
  <rect x="280" y="140" width="120" height="80" rx="8" class="component-box" fill="#e8f5e9"/>
  <text x="340" y="165" text-anchor="middle" class="component-title">CDN</text>
  <text x="340" y="185" text-anchor="middle" class="label-text">火山云CDN</text>
  <text x="340" y="202" text-anchor="middle" class="label-text">静态资源加速</text>
  
  <!-- WAF -->
  <rect x="450" y="140" width="120" height="80" rx="8" class="component-box" fill="#ffebee"/>
  <text x="510" y="165" text-anchor="middle" class="component-title">WAF</text>
  <text x="510" y="185" text-anchor="middle" class="label-text">Web应用防火墙</text>
  <text x="510" y="202" text-anchor="middle" class="label-text">SQL注入/XSS防护</text>
  
  <!-- Load Balancer -->
  <rect x="620" y="140" width="160" height="80" rx="8" class="lb-box"/>
  <text x="700" y="165" text-anchor="middle" class="component-title">负载均衡器</text>
  <text x="700" y="185" text-anchor="middle" class="label-text">ALB / Nginx</text>
  <text x="700" y="202" text-anchor="middle" class="label-text">443 (HTTPS)</text>
  
  <!-- DNS -->
  <rect x="830" y="140" width="120" height="80" rx="8" class="component-box" fill="#e1f5fe"/>
  <text x="890" y="165" text-anchor="middle" class="component-title">DNS</text>
  <text x="890" y="185" text-anchor="middle" class="label-text">域名解析</text>
  <text x="890" y="202" text-anchor="middle" class="label-text">api.apex.com</text>
  
  <!-- Arrows in DMZ -->
  <path d="M 210 180 L 280 180" class="arrow"/>
  <path d="M 400 180 L 450 180" class="arrow"/>
  <path d="M 570 180 L 620 180" class="arrow"/>

  <!-- Application Zone -->
  <rect x="50" y="310" width="1300" height="220" rx="10" class="app-zone"/>
  <text x="70" y="340" class="layer-title">应用服务层 (内网)</text>
  
  <!-- K8s Cluster -->
  <rect x="80" y="360" width="1240" height="150" rx="8" fill="#fff" stroke="#326ce5" stroke-width="2" stroke-dasharray="8,4"/>
  <text x="100" y="385" class="component-title">Kubernetes Cluster (或 Docker Swarm)</text>
  
  <!-- App Instance 1 -->
  <rect x="120" y="400" width="140" height="90" rx="8" class="app-box"/>
  <text x="190" y="425" text-anchor="middle" class="component-title">Apex Pod-1</text>
  <text x="190" y="445" text-anchor="middle" class="label-text">apex:v2.5.0</text>
  <text x="190" y="462" text-anchor="middle" class="label-text">:8080 (业务)</text>
  <text x="190" y="479" text-anchor="middle" class="label-text">CPU: 2C / Mem: 4G</text>
  
  <!-- App Instance 2 -->
  <rect x="290" y="400" width="140" height="90" rx="8" class="app-box"/>
  <text x="360" y="425" text-anchor="middle" class="component-title">Apex Pod-2</text>
  <text x="360" y="445" text-anchor="middle" class="label-text">apex:v2.5.0</text>
  <text x="360" y="462" text-anchor="middle" class="label-text">:8080 (业务)</text>
  <text x="360" y="479" text-anchor="middle" class="label-text">CPU: 2C / Mem: 4G</text>
  
  <!-- App Instance 3 -->
  <rect x="460" y="400" width="140" height="90" rx="8" class="app-box"/>
  <text x="530" y="425" text-anchor="middle" class="component-title">Apex Pod-3</text>
  <text x="530" y="445" text-anchor="middle" class="label-text">apex:v2.5.0</text>
  <text x="530" y="462" text-anchor="middle" class="label-text">:8080 (业务)</text>
  <text x="530" y="479" text-anchor="middle" class="label-text">CPU: 2C / Mem: 4G</text>
  
  <!-- HPA -->
  <rect x="640" y="410" width="120" height="70" rx="8" fill="#fff9c4" stroke="#fbc02d" stroke-width="2"/>
  <text x="700" y="435" text-anchor="middle" class="component-title">[Flash] HPA</text>
  <text x="700" y="455" text-anchor="middle" class="label-text">自动扩缩容</text>
  <text x="700" y="472" text-anchor="middle" class="label-text">Min:3 Max:10</text>
  
  <!-- ConfigMap -->
  <rect x="790" y="410" width="120" height="70" rx="8" fill="#e8eaf6" stroke="#5c6bc0" stroke-width="2"/>
  <text x="850" y="435" text-anchor="middle" class="component-title">[Clipboard] ConfigMap</text>
  <text x="850" y="455" text-anchor="middle" class="label-text">配置注入</text>
  <text x="850" y="472" text-anchor="middle" class="label-text">application.yml</text>
  
  <!-- Secret -->
  <rect x="940" y="410" width="120" height="70" rx="8" fill="#fce4ec" stroke="#c2185b" stroke-width="2"/>
  <text x="1000" y="435" text-anchor="middle" class="component-title">[SecureLock] Secret</text>
  <text x="1000" y="455" text-anchor="middle" class="label-text">密钥管理</text>
  <text x="1000" y="472" text-anchor="middle" class="label-text">DB/Redis密码</text>
  
  <!-- Service -->
  <rect x="1090" y="410" width="120" height="70" rx="8" fill="#e0f2f1" stroke="#00897b" stroke-width="2"/>
  <text x="1150" y="435" text-anchor="middle" class="component-title">[Link] Service</text>
  <text x="1150" y="455" text-anchor="middle" class="label-text">ClusterIP</text>
  <text x="1150" y="472" text-anchor="middle" class="label-text">apex-svc:8080</text>

  <!-- Arrow from LB to Apps -->
  <path d="M 700 220 L 700 290 L 190 290 L 190 400" class="arrow"/>
  <path d="M 700 290 L 360 290 L 360 400" class="arrow"/>
  <path d="M 700 290 L 530 290 L 530 400" class="arrow"/>

  <!-- Data Storage Zone -->
  <rect x="50" y="560" width="630" height="280" rx="10" class="data-zone"/>
  <text x="70" y="590" class="layer-title">[Disk] 数据存储层</text>
  
  <!-- MySQL Master -->
  <rect x="80" y="610" width="140" height="100" rx="8" class="db-box"/>
  <text x="150" y="635" text-anchor="middle" class="component-title">[DB] MySQL 主库</text>
  <text x="150" y="655" text-anchor="middle" class="label-text">MySQL 8.0</text>
  <text x="150" y="672" text-anchor="middle" class="label-text">:3306</text>
  <text x="150" y="689" text-anchor="middle" class="label-text">写操作</text>
  <text x="150" y="704" text-anchor="middle" class="label-text" font-weight="bold" fill="#28a745">Master</text>
  
  <!-- MySQL Slave 1 -->
  <rect x="240" y="610" width="140" height="100" rx="8" class="db-box"/>
  <text x="310" y="635" text-anchor="middle" class="component-title">[DB] MySQL 从库1</text>
  <text x="310" y="655" text-anchor="middle" class="label-text">MySQL 8.0</text>
  <text x="310" y="672" text-anchor="middle" class="label-text">:3306</text>
  <text x="310" y="689" text-anchor="middle" class="label-text">读操作</text>
  <text x="310" y="704" text-anchor="middle" class="label-text" font-weight="bold" fill="#17a2b8">Slave</text>
  
  <!-- MySQL Slave 2 -->
  <rect x="400" y="610" width="140" height="100" rx="8" class="db-box"/>
  <text x="470" y="635" text-anchor="middle" class="component-title">[DB] MySQL 从库2</text>
  <text x="470" y="655" text-anchor="middle" class="label-text">MySQL 8.0</text>
  <text x="470" y="672" text-anchor="middle" class="label-text">:3306</text>
  <text x="470" y="689" text-anchor="middle" class="label-text">读操作</text>
  <text x="470" y="704" text-anchor="middle" class="label-text" font-weight="bold" fill="#17a2b8">Slave</text>
  
  <!-- Replication arrows -->
  <path d="M 220 650 L 240 650" class="arrow" stroke="#28a745"/>
  <path d="M 220 670 L 400 670" class="arrow" stroke="#28a745"/>
  <text x="280" y="645" class="label-text" fill="#28a745">binlog复制</text>
  
  <!-- Redis Cluster -->
  <rect x="80" y="730" width="180" height="90" rx="8" class="cache-box"/>
  <text x="170" y="755" text-anchor="middle" class="component-title">Redis Cluster</text>
  <text x="170" y="775" text-anchor="middle" class="label-text">Redis 7.x</text>
  <text x="170" y="792" text-anchor="middle" class="label-text">3主3从 :6379</text>
  <text x="170" y="809" text-anchor="middle" class="label-text">缓存+会话</text>
  
  <!-- MinIO -->
  <rect x="290" y="730" width="120" height="90" rx="8" class="component-box" fill="#c51162"/>
  <text x="350" y="755" text-anchor="middle" class="component-title" fill="white">[Bucket] MinIO</text>
  <text x="350" y="775" text-anchor="middle" class="label-text" fill="white">对象存储</text>
  <text x="350" y="792" text-anchor="middle" class="label-text" fill="white">:9000 (API)</text>
  <text x="350" y="809" text-anchor="middle" class="label-text" fill="white">文件服务</text>
  
  <!-- TOS -->
  <rect x="440" y="730" width="120" height="90" rx="8" class="component-box" fill="#0288d1"/>
  <text x="500" y="755" text-anchor="middle" class="component-title" fill="white">[Cloud] 火山云TOS</text>
  <text x="500" y="775" text-anchor="middle" class="label-text" fill="white">云对象存储</text>
  <text x="500" y="792" text-anchor="middle" class="label-text" fill="white">CDN分发</text>
  <text x="500" y="809" text-anchor="middle" class="label-text" fill="white">公共读</text>

  <!-- Middleware Zone -->
  <rect x="710" y="560" width="640" height="280" rx="10" class="service-zone"/>
  <text x="730" y="590" class="layer-title">🔧 中间件服务层</text>
  
  <!-- Nacos -->
  <rect x="740" y="610" width="140" height="90" rx="8" class="mq-box"/>
  <text x="810" y="635" text-anchor="middle" class="component-title">[Compass] Nacos</text>
  <text x="810" y="655" text-anchor="middle" class="label-text">配置中心</text>
  <text x="810" y="672" text-anchor="middle" class="label-text">服务发现</text>
  <text x="810" y="689" text-anchor="middle" class="label-text">:8848</text>
  
  <!-- Sentinel -->
  <rect x="910" y="610" width="140" height="90" rx="8" class="component-box" fill="#ff6f00"/>
  <text x="980" y="635" text-anchor="middle" class="component-title" fill="white">Sentinel</text>
  <text x="980" y="655" text-anchor="middle" class="label-text" fill="white">流控熔断</text>
  <text x="980" y="672" text-anchor="middle" class="label-text" fill="white">Dashboard</text>
  <text x="980" y="689" text-anchor="middle" class="label-text" fill="white">:8858</text>
  
  <!-- RocketMQ NameServer -->
  <rect x="1080" y="610" width="140" height="90" rx="8" class="mq-box"/>
  <text x="1150" y="635" text-anchor="middle" class="component-title">[Mail] RocketMQ</text>
  <text x="1150" y="655" text-anchor="middle" class="label-text">NameServer</text>
  <text x="1150" y="672" text-anchor="middle" class="label-text">:9876</text>
  <text x="1150" y="689" text-anchor="middle" class="label-text">消息队列</text>
  
  <!-- RocketMQ Broker -->
  <rect x="1080" y="720" width="140" height="90" rx="8" class="mq-box"/>
  <text x="1150" y="745" text-anchor="middle" class="component-title">[Mail] Broker集群</text>
  <text x="1150" y="765" text-anchor="middle" class="label-text">Master-Slave</text>
  <text x="1150" y="782" text-anchor="middle" class="label-text">:10911</text>
  <text x="1150" y="799" text-anchor="middle" class="label-text">消息存储</text>
  
  <!-- Elasticsearch -->
  <rect x="740" y="720" width="140" height="90" rx="8" class="component-box" fill="#005571"/>
  <text x="810" y="745" text-anchor="middle" class="component-title" fill="white">Elasticsearch</text>
  <text x="810" y="765" text-anchor="middle" class="label-text" fill="white">全文检索</text>
  <text x="810" y="782" text-anchor="middle" class="label-text" fill="white">:9200</text>
  <text x="810" y="799" text-anchor="middle" class="label-text" fill="white">日志分析</text>
  
  <!-- Logstash -->
  <rect x="910" y="720" width="140" height="90" rx="8" class="component-box" fill="#00bfb3"/>
  <text x="980" y="745" text-anchor="middle" class="component-title">[Chart] Logstash</text>
  <text x="980" y="765" text-anchor="middle" class="label-text">日志采集</text>
  <text x="980" y="782" text-anchor="middle" class="label-text">:5044</text>
  <text x="980" y="799" text-anchor="middle" class="label-text">数据转换</text>

  <!-- Monitoring Zone -->
  <rect x="50" y="870" width="1300" height="280" rx="10" class="monitor-zone"/>
  <text x="70" y="900" class="layer-title">[Chart] 监控运维层</text>
  
  <!-- Prometheus -->
  <rect x="100" y="920" width="160" height="100" rx="8" class="monitor-box"/>
  <text x="180" y="945" text-anchor="middle" class="component-title">[Graph] Prometheus</text>
  <text x="180" y="965" text-anchor="middle" class="label-text">指标采集</text>
  <text x="180" y="982" text-anchor="middle" class="label-text">:9090</text>
  <text x="180" y="999" text-anchor="middle" class="label-text">时序数据库</text>
  <text x="180" y="1014" text-anchor="middle" class="label-text" font-weight="bold">15s采集间隔</text>
  
  <!-- Grafana -->
  <rect x="290" y="920" width="160" height="100" rx="8" class="monitor-box"/>
  <text x="370" y="945" text-anchor="middle" class="component-title">[Chart] Grafana</text>
  <text x="370" y="965" text-anchor="middle" class="label-text">监控大盘</text>
  <text x="370" y="982" text-anchor="middle" class="label-text">:3000</text>
  <text x="370" y="999" text-anchor="middle" class="label-text">可视化</text>
  <text x="370" y="1014" text-anchor="middle" class="label-text" font-weight="bold">66个Dashboard</text>
  
  <!-- Zipkin -->
  <rect x="480" y="920" width="160" height="100" rx="8" class="monitor-box"/>
  <text x="560" y="945" text-anchor="middle" class="component-title">[Link] Zipkin</text>
  <text x="560" y="965" text-anchor="middle" class="label-text">链路追踪</text>
  <text x="560" y="982" text-anchor="middle" class="label-text">:9411</text>
  <text x="560" y="999" text-anchor="middle" class="label-text">分布式追踪</text>
  <text x="560" y="1014" text-anchor="middle" class="label-text" font-weight="bold">Span收集</text>
  
  <!-- AlertManager -->
  <rect x="670" y="920" width="160" height="100" rx="8" class="component-box" fill="#ff5722"/>
  <text x="750" y="945" text-anchor="middle" class="component-title" fill="white">AlertManager</text>
  <text x="750" y="965" text-anchor="middle" class="label-text" fill="white">告警管理</text>
  <text x="750" y="982" text-anchor="middle" class="label-text" fill="white">:9093</text>
  <text x="750" y="999" text-anchor="middle" class="label-text" fill="white">多渠道通知</text>
  <text x="750" y="1014" text-anchor="middle" class="label-text" fill="white" font-weight="bold">钉钉/邮件/短信</text>
  
  <!-- Kibana -->
  <rect x="860" y="920" width="160" height="100" rx="8" class="component-box" fill="#005571"/>
  <text x="940" y="945" text-anchor="middle" class="component-title" fill="white">Kibana</text>
  <text x="940" y="965" text-anchor="middle" class="label-text" fill="white">日志查询</text>
  <text x="940" y="982" text-anchor="middle" class="label-text" fill="white">:5601</text>
  <text x="940" y="999" text-anchor="middle" class="label-text" fill="white">可视化分析</text>
  <text x="940" y="1014" text-anchor="middle" class="label-text" fill="white" font-weight="bold">ELK Stack</text>
  
  <!-- Filebeat -->
  <rect x="1050" y="920" width="140" height="100" rx="8" class="component-box" fill="#00bfb3"/>
  <text x="1120" y="945" text-anchor="middle" class="component-title">[Note] Filebeat</text>
  <text x="1120" y="965" text-anchor="middle" class="label-text">日志采集</text>
  <text x="1120" y="982" text-anchor="middle" class="label-text">轻量级Agent</text>
  <text x="1120" y="999" text-anchor="middle" class="label-text">应用日志</text>
  <text x="1120" y="1014" text-anchor="middle" class="label-text" font-weight="bold">→ Logstash</text>
  
  <!-- Backup -->
  <rect x="1220" y="920" width="110" height="100" rx="8" class="component-box" fill="#607d8b"/>
  <text x="1275" y="945" text-anchor="middle" class="component-title" fill="white">[Disk] 备份</text>
  <text x="1275" y="965" text-anchor="middle" class="label-text" fill="white">数据备份</text>
  <text x="1275" y="982" text-anchor="middle" class="label-text" fill="white">全量+增量</text>
  <text x="1275" y="999" text-anchor="middle" class="label-text" fill="white">每日3:00</text>
  <text x="1275" y="1014" text-anchor="middle" class="label-text" fill="white" font-weight="bold">保留30天</text>

  <!-- Arrows from Apps to Data -->
  <path d="M 190 490 L 190 530 L 150 530 L 150 610" class="arrow"/>
  <path d="M 190 530 L 170 530 L 170 730" class="arrow"/>
  <text x="155" y="575" class="label-text">写</text>
  <text x="175" y="710" class="label-text">缓存</text>
  
  <path d="M 360 490 L 360 540 L 310 540 L 310 610" class="arrow"/>
  <path d="M 360 540 L 350 540 L 350 730" class="arrow"/>
  <text x="315" y="575" class="label-text">读</text>
  
  <path d="M 530 490 L 530 550 L 470 550 L 470 610" class="arrow"/>
  <text x="475" y="575" class="label-text">读</text>

  <!-- Arrows from Apps to Middleware -->
  <path d="M 530 490 L 530 560 L 810 560 L 810 610" class="arrow"/>
  <path d="M 530 560 L 980 560 L 980 610" class="arrow"/>
  <path d="M 530 560 L 1150 560 L 1150 610" class="arrow"/>
  <text x="670" y="555" class="label-text">配置拉取</text>
  <text x="810" y="555" class="label-text">流控上报</text>
  <text x="980" y="555" class="label-text">消息发送</text>

  <!-- Arrows to Monitoring -->
  <path d="M 190 490 L 190 850 L 180 850 L 180 920" class="arrow" stroke="#fd7e14"/>
  <path d="M 360 490 L 360 860 L 370 860 L 370 920" class="arrow" stroke="#fd7e14"/>
  <path d="M 530 490 L 530 870 L 560 870 L 560 920" class="arrow" stroke="#fd7e14"/>
  <text x="100" y="865" class="label-text" fill="#fd7e14">Metrics上报</text>
  
  <path d="M 260 970 L 290 970" class="arrow"/>
  <path d="M 260 990 L 750 990 L 750 920" class="arrow"/>
  <text x="270" y="985" class="label-text">数据源</text>
  <text x="690" y="985" class="label-text">告警</text>

  <!-- Network Boundaries -->
  <line x1="50" y1="285" x2="1350" y2="285" class="network-line"/>
  <text x="1200" y="300" class="label-text" fill="#dc3545" font-weight="bold">═══ 网络边界 (DMZ → 内网) ═══</text>
  
  <line x1="50" y1="545" x2="1350" y2="545" class="network-line"/>
  <text x="1150" y="555" class="label-text" fill="#dc3545" font-weight="bold">═══ 网络边界 (应用 → 数据/中间件) ═══</text>

  <!-- Legend -->
  <rect x="50" y="1050" width="1300" height="130" rx="8" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="1075" class="component-title">[Clipboard] 架构说明</text>
  
  <text x="70" y="1100" class="label-text">• <tspan font-weight="bold">无状态应用</tspan>: 所有应用实例无状态，支持水平扩展，会话存储在Redis</text>
  <text x="70" y="1120" class="label-text">• <tspan font-weight="bold">高可用保障</tspan>: MySQL主从复制，Redis Cluster 3主3从，RocketMQ Master-Slave</text>
  <text x="70" y="1140" class="label-text">• <tspan font-weight="bold">监控覆盖</tspan>: 应用指标(JVM/HTTP)、中间件监控、业务指标、日志聚合、链路追踪</text>
  <text x="70" y="1160" class="label-text">• <tspan font-weight="bold">部署方式</tspan>: 推荐Kubernetes部署，支持Docker Compose本地开发，生产环境建议3+节点集群</text>
</svg>
