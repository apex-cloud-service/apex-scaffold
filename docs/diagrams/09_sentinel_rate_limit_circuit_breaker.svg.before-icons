<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800">
  <defs>
    <style>
      
      
      text {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        fill: #0f172a;
      }
      
      .title {
        font-size: 24px;
        font-weight: 600;
        fill: #0f172a;
      }
      
      .subtitle {
        font-size: 14px;
        fill: #64748b;
      }
      
      .label {
        font-size: 14px;
        font-weight: 500;
      }
      
      .label-small {
        font-size: 12px;
        fill: #64748b;
      }
      
      .box {
        fill: #ffffff;
        stroke: #e2e8f0;
        stroke-width: 2;
        rx: 8;
      }
      
      .box-primary {
        fill: #ffffff;
        stroke: #4f46e5;
        stroke-width: 2;
        rx: 8;
      }
      
      .box-success {
        fill: #ffffff;
        stroke: #059669;
        stroke-width: 2;
        rx: 8;
      }
      
      .box-warning {
        fill: #ffffff;
        stroke: #d97706;
        stroke-width: 2;
        rx: 8;
      }
      
      .box-danger {
        fill: #ffffff;
        stroke: #dc2626;
        stroke-width: 2;
        rx: 8;
      }
      
      .arrow {
        stroke: #64748b;
        stroke-width: 2;
        fill: none;
        marker-end: url(#arrowhead);
      }
      
      .arrow-primary {
        stroke: #4f46e5;
        stroke-width: 2;
        fill: none;
        marker-end: url(#arrowhead-primary);
      }
      
      .arrow-danger {
        stroke: #dc2626;
        stroke-width: 2;
        fill: none;
        marker-end: url(#arrowhead-danger);
      }
      
      .badge {
        font-size: 11px;
        font-weight: 600;
      }
      
      .badge-rect {
        rx: 4;
      }
    </style>
    
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#64748b" />
    </marker>
    
    <marker id="arrowhead-primary" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#4f46e5" />
    </marker>
    
    <marker id="arrowhead-danger" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#dc2626" />
    </marker>
  </defs>
  
  <!-- Title -->
  <text x="600" y="35" text-anchor="middle" class="title">Sentinel 限流熔断降级架构</text>
  <text x="600" y="55" text-anchor="middle" class="subtitle">43条限流规则 + 30条熔断规则 + 系统保护</text>
  
  <!-- Layer 1: Client Request -->
  <rect x="450" y="90" width="300" height="60" class="box"/>
  <text x="600" y="115" text-anchor="middle" class="label">客户端请求</text>
  <text x="600" y="135" text-anchor="middle" class="label-small">API/Web/Mobile</text>
  
  <!-- Arrow to Sentinel -->
  <path d="M 600 150 L 600 180" class="arrow-primary"/>
  
  <!-- Layer 2: Sentinel Gateway -->
  <rect x="350" y="180" width="500" height="120" class="box-primary"/>
  <text x="600" y="205" text-anchor="middle" class="label" style="font-size: 16px; font-weight: 600;">Sentinel 防护网关</text>
  
  <!-- Three rule types -->
  <g>
    <!-- Flow Control -->
    <rect x="370" y="220" width="140" height="65" class="box-success"/>
    <text x="440" y="240" text-anchor="middle" class="label" style="font-size: 13px;">流控规则</text>
    <text x="440" y="258" text-anchor="middle" class="label-small">43条规则</text>
    <text x="440" y="273" text-anchor="middle" class="label-small" style="font-size: 10px;">QPS阈值限制</text>
    
    <!-- Degrade -->
    <rect x="530" y="220" width="140" height="65" class="box-warning"/>
    <text x="600" y="240" text-anchor="middle" class="label" style="font-size: 13px;">熔断降级</text>
    <text x="600" y="258" text-anchor="middle" class="label-small">30条规则</text>
    <text x="600" y="273" text-anchor="middle" class="label-small" style="font-size: 10px;">异常率/慢调用</text>
    
    <!-- System Protection -->
    <rect x="690" y="220" width="140" height="65" class="box-danger"/>
    <text x="760" y="240" text-anchor="middle" class="label" style="font-size: 13px;">系统保护</text>
    <text x="760" y="258" text-anchor="middle" class="label-small">实时规则</text>
    <text x="760" y="273" text-anchor="middle" class="label-small" style="font-size: 10px;">CPU/QPS/线程</text>
  </g>
  
  <!-- Arrows: Pass or Block -->
  <path d="M 440 300 L 440 330" class="arrow-primary"/>
  <text x="460" y="320" class="label-small" style="fill: #059669;">✓ 通过</text>
  
  <path d="M 760 300 L 760 330 L 920 330 L 920 650" class="arrow-danger"/>
  <text x="780" y="320" class="label-small" style="fill: #dc2626;">✗ 拦截</text>
  
  <!-- Layer 3: Business Service -->
  <rect x="300" y="330" width="320" height="80" class="box"/>
  <text x="460" y="355" text-anchor="middle" class="label">业务服务处理</text>
  <text x="460" y="375" text-anchor="middle" class="label-small">9大业务模块</text>
  <text x="460" y="395" text-anchor="middle" class="label-small" style="font-size: 11px;">认证/用户/文件/媒体/工作流...</text>
  
  <!-- Layer 4: Response Strategy -->
  <text x="460" y="440" text-anchor="middle" class="label" style="font-size: 15px;">响应策略</text>
  
  <!-- Success Response -->
  <g>
    <rect x="300" y="460" width="150" height="80" class="box-success"/>
    <text x="375" y="485" text-anchor="middle" class="label" style="fill: #059669;">正常响应</text>
    <text x="375" y="505" text-anchor="middle" class="label-small">200 OK</text>
    <text x="375" y="525" text-anchor="middle" class="label-small" style="font-size: 10px;">返回业务数据</text>
    <path d="M 375 410 L 375 460" class="arrow-primary"/>
  </g>
  
  <!-- Degraded Response -->
  <g>
    <rect x="470" y="460" width="150" height="80" class="box-warning"/>
    <text x="545" y="485" text-anchor="middle" class="label" style="fill: #d97706;">降级响应</text>
    <text x="545" y="505" text-anchor="middle" class="label-small">503 Service</text>
    <text x="545" y="520" text-anchor="middle" class="label-small" style="font-size: 10px;">读: 返回缓存</text>
    <text x="545" y="533" text-anchor="middle" class="label-small" style="font-size: 10px;">写: 排队状态</text>
    <path d="M 545 410 L 545 460" class="arrow"/>
  </g>
  
  <!-- Layer 5: Exception Handler -->
  <rect x="750" y="460" width="300" height="180" class="box-danger"/>
  <text x="900" y="485" text-anchor="middle" class="label" style="fill: #dc2626; font-size: 15px;">异常处理器</text>
  
  <!-- Exception Types -->
  <g>
    <rect x="770" y="500" width="260" height="30" class="box"/>
    <text x="900" y="520" text-anchor="middle" class="label-small">FlowException → 429 Too Many Requests</text>
  </g>
  
  <g>
    <rect x="770" y="540" width="260" height="30" class="box"/>
    <text x="900" y="560" text-anchor="middle" class="label-small">DegradeException → 503 Unavailable</text>
  </g>
  
  <g>
    <rect x="770" y="580" width="260" height="30" class="box"/>
    <text x="900" y="600" text-anchor="middle" class="label-small">SystemBlockException → 503 Overload</text>
  </g>
  
  <g>
    <rect x="770" y="620" width="260" height="30" class="box"/>
    <text x="900" y="640" text-anchor="middle" class="label-small">AuthorityException → 403 Forbidden</text>
  </g>
  
  <!-- Return arrows -->
  <path d="M 375 540 L 375 660 L 600 660 L 600 690" class="arrow"/>
  <path d="M 545 540 L 545 660 L 600 660" class="arrow"/>
  <path d="M 900 650 L 900 660 L 600 660" class="arrow-danger"/>
  
  <!-- Final Response -->
  <rect x="450" y="690" width="300" height="60" class="box-primary"/>
  <text x="600" y="715" text-anchor="middle" class="label">统一响应</text>
  <text x="600" y="735" text-anchor="middle" class="label-small">Result&lt;T&gt; + TraceId</text>
  
  <!-- Legend -->
  <g transform="translate(50, 650)">
    <text x="0" y="0" class="label" style="font-size: 13px; font-weight: 600;">图例</text>
    
    <rect x="0" y="10" width="15" height="15" style="fill: #059669; stroke: none;"/>
    <text x="20" y="22" class="label-small">通过 (Pass)</text>
    
    <rect x="0" y="35" width="15" height="15" style="fill: #d97706; stroke: none;"/>
    <text x="20" y="47" class="label-small">降级 (Degrade)</text>
    
    <rect x="0" y="60" width="15" height="15" style="fill: #dc2626; stroke: none;"/>
    <text x="20" y="72" class="label-small">拦截 (Block)</text>
    
    <rect x="0" y="85" width="15" height="15" style="fill: #4f46e5; stroke: none;"/>
    <text x="20" y="97" class="label-small">关键路径</text>
  </g>
  
  <!-- Stats Box -->
  <g transform="translate(50, 90)">
    <rect x="0" y="0" width="200" height="140" class="box-primary"/>
    <text x="100" y="25" text-anchor="middle" class="label" style="font-size: 14px; font-weight: 600;">防护统计</text>
    
    <text x="15" y="50" class="label-small">• 限流规则: 43条</text>
    <text x="15" y="70" class="label-small">• 熔断规则: 30条</text>
    <text x="15" y="90" class="label-small">• 保护模块: 9个</text>
    <text x="15" y="110" class="label-small">• 异常类型: 4种</text>
    <text x="15" y="130" class="label-small">• 响应策略: 分级处理</text>
  </g>
  
  <!-- Performance Box -->
  <g transform="translate(50, 250)">
    <rect x="0" y="0" width="200" height="160" class="box"/>
    <text x="100" y="25" text-anchor="middle" class="label" style="font-size: 14px; font-weight: 600;">性能保障</text>
    
    <text x="15" y="50" class="label-small" style="font-size: 11px;">登录限流: 50 QPS</text>
    <text x="15" y="68" class="label-small" style="font-size: 11px;">刷新令牌: 200 QPS</text>
    <text x="15" y="86" class="label-small" style="font-size: 11px;">短信验证码: 20 QPS</text>
    <text x="15" y="104" class="label-small" style="font-size: 11px;">用户信息: 300 QPS</text>
    <text x="15" y="122" class="label-small" style="font-size: 11px;">文件上传: 50 QPS</text>
    <text x="15" y="140" class="label-small" style="font-size: 11px;">熔断窗口: 10-30秒</text>
  </g>
  
  <!-- Config Source -->
  <g transform="translate(50, 430)">
    <rect x="0" y="0" width="200" height="100" class="box"/>
    <text x="100" y="25" text-anchor="middle" class="label" style="font-size: 14px; font-weight: 600;">配置来源</text>
    
    <text x="15" y="50" class="label-small" style="font-size: 11px;">• 硬编码规则 (Code)</text>
    <text x="15" y="68" class="label-small" style="font-size: 11px;">• Nacos动态配置</text>
    <text x="15" y="86" class="label-small" style="font-size: 11px;">• 实时规则推送</text>
  </g>
</svg>
