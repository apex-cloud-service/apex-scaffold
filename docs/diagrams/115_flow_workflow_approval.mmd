flowchart TD
    A["创建工作流定义（DAG 模板）<br/>workflow_code · version · node_config_json"] --> B["发起流程实例<br/>POST /api/v1/workflows/{code}/instances"]
    B --> C["ProcessInstance.status = RUNNING<br/>business_key · initiator_id · suspended=false"]
    C -.-> D["当前实现不解析 DAG / 不自动建首节点任务"]

    C --> E["任务创建 / 分配（Task）<br/>PENDING · assignee_id · due_date · timeout_at"]
    E --> F["查询我的待办<br/>GET /api/v1/workflows/tasks/pending"]
    F --> G["审批人处理任务<br/>OR/AND 会签 · approverType/approverValue"]
    G --> H{"审批动作<br/>WorkflowService"}

    H -->|completeTask| I["Task → COMPLETED"]
    H -->|rejectTask| J["ProcessInstance → REJECTED"]
    H -->|rollbackToNode| K["Task → ROLLED_BACK<br/>新建目标节点 PENDING"]
    H -->|transferTask| L["办理人变更（所有权永久转移）<br/>transferredFrom 记录原办理人"]
    H -->|delegateTask| M["新建 DELEGATED 任务<br/>原任务保持 PENDING（临时转移）"]
    H -->|suspendInstance| N["ProcessInstance → SUSPENDED"]
    H -->|resumeInstance| O["ProcessInstance → RUNNING"]

    P["WorkflowTimeoutHandler<br/>@Scheduled fixedDelay=300000ms"] --> Q["扫描超时任务<br/>status=PENDING AND timeout_at &lt; now"]
    Q --> R{"timeoutStrategy"}
    R -->|ESCALATE| S["transferTask → 管理员"]
    R -->|AUTO_COMPLETE| T["completeTask 自动审批"]
    R -->|NOTIFY| U["仅通知（日志）"]

    S --> V["监控与统计<br/>WorkflowStatisticsService.getStatistics / getTrend"]
    T --> V
    U --> V

    classDef def fill:#eef2ff,stroke:#4f46e5,color:#0f172a;
