flowchart TB
  HTTP["HTTP 出口（位于 apex-workflow-service）\ninterfaces · router/handler/dto · WorkflowServiceApplication"]

  subgraph APP["应用层 application"]
    A1["service / query · 流转与查询用例（事务边界）"]
    A2["validation · 校验"]
    A3["scheduler · 超时/催办定时任务"]
    A4["dto · 应用 DTO"]
  end

  subgraph DOM["领域层 domain"]
    D1["model · WorkflowDefinition（流程 DAG：节点/连线 JSON）· ProcessInstance · Task · ApprovalRecord"]
    D2["repository · 仓储接口（领域契约）"]
  end

  subgraph INF["基础设施层 infrastructure"]
    N1["persistence.po / mapper（MyBatis-Plus）"]
    N2["converter · PO ↔ 领域模型"]
    N3["repository · 实现 domain.repository"]
  end

  AUTO["autoconfigure · 组件自动装配"]

  COMMON["apex-common"]
  DOMAIN["apex-domain"]
  SVC["apex-workflow-service / apex-boot-all（运行装配）"]

  COMMON --> APP
  DOMAIN --> APP
  HTTP --> A1
  A1 --> D1
  A1 --> D2
  A3 --> A1
  A2 --> A1
  D2 -. "被实现" .-> N3
  N1 --> N2 --> N3
  AUTO -.-> APP
  SVC -. "扫描装配" .-> HTTP

  NOTE["包名 com.apex.scaffold.workflow；本库无 interfaces 层，HTTP 出口在 apex-workflow-service；apex-example 仅 test scope 依赖；流程定义为 DAG（节点/连线 JSON），持久化用 MyBatis-Plus + WorkflowTenantAccess 显式租户条件（fail-closed），超时扫描经 JdbcScanLease（JdbcTemplate）"]
  DOM -.-> NOTE
