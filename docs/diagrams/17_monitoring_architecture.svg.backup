<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1300">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #1a1a1a; }
      .subtitle { font: 16px sans-serif; fill: #666; }
      .section-title { font: bold 20px sans-serif; fill: #2c3e50; }
      .layer-title { font: bold 16px sans-serif; fill: #34495e; }
      .component-title { font: bold 14px sans-serif; fill: #34495e; }
      .component-text { font: 12px sans-serif; fill: #555; }
      .label-text { font: 11px sans-serif; fill: #666; }
      .detail-text { font: 10px sans-serif; fill: #444; }
      
      .app-box { fill: #e8f5e9; stroke: #4caf50; stroke-width: 2; }
      .collector-box { fill: #fff3e0; stroke: #ff9800; stroke-width: 2; }
      .storage-box { fill: #e1f5fe; stroke: #03a9f4; stroke-width: 2; }
      .visual-box { fill: #f3e5f5; stroke: #9c27b0; stroke-width: 2; }
      .alert-box { fill: #ffebee; stroke: #f44336; stroke-width: 2; }
      .log-box { fill: #e8eaf6; stroke: #5c6bc0; stroke-width: 2; }
      .trace-box { fill: #fce4ec; stroke: #e91e63; stroke-width: 2; }
      
      .metrics-arrow { fill: none; stroke: #ff9800; stroke-width: 2.5; marker-end: url(#metrics-arrow); }
      .logs-arrow { fill: none; stroke: #5c6bc0; stroke-width: 2.5; marker-end: url(#logs-arrow); }
      .trace-arrow { fill: none; stroke: #e91e63; stroke-width: 2.5; marker-end: url(#trace-arrow); }
      .alert-arrow { fill: none; stroke: #f44336; stroke-width: 2.5; marker-end: url(#alert-arrow); stroke-dasharray: 6,4; }
    </style>
    
    <marker id="metrics-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#ff9800" />
    </marker>
    <marker id="logs-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#5c6bc0" />
    </marker>
    <marker id="trace-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#e91e63" />
    </marker>
    <marker id="alert-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#f44336" />
    </marker>
  </defs>

  <!-- Title -->
  <text x="800" y="40" text-anchor="middle" class="title">Apex Scaffold 监控体系架构</text>
  <text x="800" y="65" text-anchor="middle" class="subtitle">Observability Architecture (Metrics + Logs + Traces)</text>

  <!-- ==================== Application Layer ==================== -->
  <rect x="50" y="100" width="1500" height="180" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="130" class="section-title">[Server] 应用层 (被监控对象)</text>
  
  <!-- App Instance 1 -->
  <rect x="100" y="160" width="180" height="100" rx="8" class="app-box"/>
  <text x="190" y="185" text-anchor="middle" class="component-title">Apex App-1</text>
  <text x="190" y="205" text-anchor="middle" class="label-text">:8080 (业务端口)</text>
  <text x="190" y="220" text-anchor="middle" class="label-text">:8081 (管理端口)</text>
  <text x="190" y="235" text-anchor="middle" class="detail-text">• JVM Metrics</text>
  <text x="190" y="250" text-anchor="middle" class="detail-text">• HTTP Metrics</text>
  
  <!-- App Instance 2 -->
  <rect x="320" y="160" width="180" height="100" rx="8" class="app-box"/>
  <text x="410" y="185" text-anchor="middle" class="component-title">Apex App-2</text>
  <text x="410" y="205" text-anchor="middle" class="label-text">:8080 (业务端口)</text>
  <text x="410" y="220" text-anchor="middle" class="label-text">:8081 (管理端口)</text>
  <text x="410" y="235" text-anchor="middle" class="detail-text">• JVM Metrics</text>
  <text x="410" y="250" text-anchor="middle" class="detail-text">• HTTP Metrics</text>
  
  <!-- App Instance 3 -->
  <rect x="540" y="160" width="180" height="100" rx="8" class="app-box"/>
  <text x="630" y="185" text-anchor="middle" class="component-title">Apex App-N</text>
  <text x="630" y="205" text-anchor="middle" class="label-text">:8080 (业务端口)</text>
  <text x="630" y="220" text-anchor="middle" class="label-text">:8081 (管理端口)</text>
  <text x="630" y="235" text-anchor="middle" class="detail-text">• JVM Metrics</text>
  <text x="630" y="250" text-anchor="middle" class="detail-text">• HTTP Metrics</text>
  
  <!-- Middleware -->
  <rect x="770" y="160" width="150" height="100" rx="8" class="app-box"/>
  <text x="845" y="185" text-anchor="middle" class="component-title">MySQL</text>
  <text x="845" y="205" text-anchor="middle" class="label-text">mysqld_exporter</text>
  <text x="845" y="220" text-anchor="middle" class="detail-text">:9104</text>
  
  <rect x="960" y="160" width="150" height="100" rx="8" class="app-box"/>
  <text x="1035" y="185" text-anchor="middle" class="component-title">Redis</text>
  <text x="1035" y="205" text-anchor="middle" class="label-text">redis_exporter</text>
  <text x="1035" y="220" text-anchor="middle" class="detail-text">:9121</text>
  
  <rect x="1150" y="160" width="150" height="100" rx="8" class="app-box"/>
  <text x="1225" y="185" text-anchor="middle" class="component-title">RocketMQ</text>
  <text x="1225" y="205" text-anchor="middle" class="label-text">rocketmq_exporter</text>
  <text x="1225" y="220" text-anchor="middle" class="detail-text">:5557</text>
  
  <rect x="1340" y="160" width="150" height="100" rx="8" class="app-box"/>
  <text x="1415" y="185" text-anchor="middle" class="component-title">Node</text>
  <text x="1415" y="205" text-anchor="middle" class="label-text">node_exporter</text>
  <text x="1415" y="220" text-anchor="middle" class="detail-text">:9100</text>

  <!-- ==================== Metrics Flow ==================== -->
  <rect x="50" y="310" width="720" height="260" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="340" class="section-title">[Chart] Metrics 流 (指标监控)</text>
  
  <!-- Prometheus -->
  <rect x="100" y="370" width="260" height="180" rx="8" class="storage-box"/>
  <text x="230" y="395" text-anchor="middle" class="component-title">[Graph] Prometheus</text>
  <text x="230" y="415" text-anchor="middle" class="label-text">:9090</text>
  <text x="230" y="435" text-anchor="middle" class="label-text" font-weight="bold">时序数据库 (TSDB)</text>
  
  <rect x="120" y="460" width="220" height="70" rx="6" fill="#fff" stroke="#03a9f4" stroke-width="1.5"/>
  <text x="140" y="480" class="component-text">采集策略</text>
  <text x="140" y="497" class="detail-text">• 采集间隔: 15s</text>
  <text x="140" y="512" class="detail-text">• 数据保留: 15天</text>
  <text x="140" y="527" class="detail-text">• 抓取目标: 服务发现 (K8s/File)</text>
  
  <!-- Grafana -->
  <rect x="420" y="370" width="300" height="180" rx="8" class="visual-box"/>
  <text x="570" y="395" text-anchor="middle" class="component-title">[Chart] Grafana</text>
  <text x="570" y="415" text-anchor="middle" class="label-text">:3000</text>
  <text x="570" y="435" text-anchor="middle" class="label-text" font-weight="bold">可视化大盘</text>
  
  <rect x="440" y="460" width="260" height="70" rx="6" fill="#fff" stroke="#9c27b0" stroke-width="1.5"/>
  <text x="460" y="480" class="component-text">66个监控面板</text>
  <text x="460" y="497" class="detail-text">• JVM监控 (堆/GC/线程)</text>
  <text x="460" y="512" class="detail-text">• HTTP监控 (QPS/延迟/错误率)</text>
  <text x="460" y="527" class="detail-text">• 中间件监控 (MySQL/Redis/RocketMQ)</text>
  
  <!-- Arrows Metrics -->
  <path d="M 190 260 L 190 310 L 230 310 L 230 370" class="metrics-arrow"/>
  <path d="M 410 260 L 410 320 L 230 320 L 230 370" class="metrics-arrow"/>
  <path d="M 630 260 L 630 330 L 230 330 L 230 370" class="metrics-arrow"/>
  <path d="M 845 260 L 845 350 L 230 350 L 230 370" class="metrics-arrow"/>
  <path d="M 1035 260 L 1035 360 L 360 360 L 360 460" class="metrics-arrow"/>
  
  <path d="M 360 460 L 420 460" class="metrics-arrow"/>
  <text x="370" y="455" class="label-text" fill="#ff9800">PromQL查询</text>

  <!-- ==================== Logs Flow ==================== -->
  <rect x="820" y="310" width="730" height="260" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="840" y="340" class="section-title">[Note] Logs 流 (日志聚合)</text>
  
  <!-- Filebeat -->
  <rect x="870" y="370" width="150" height="90" rx="8" class="collector-box"/>
  <text x="945" y="395" text-anchor="middle" class="component-title">[Note] Filebeat</text>
  <text x="945" y="415" text-anchor="middle" class="label-text">轻量级采集</text>
  <text x="945" y="432" text-anchor="middle" class="detail-text">监控目录:</text>
  <text x="945" y="447" text-anchor="middle" class="detail-text">/logs/*.log</text>
  
  <!-- Logstash -->
  <rect x="1070" y="370" width="150" height="90" rx="8" class="collector-box"/>
  <text x="1145" y="395" text-anchor="middle" class="component-title">[Chart] Logstash</text>
  <text x="1145" y="415" text-anchor="middle" class="label-text">:5044</text>
  <text x="1145" y="432" text-anchor="middle" class="detail-text">数据转换</text>
  <text x="1145" y="447" text-anchor="middle" class="detail-text">过滤/增强</text>
  
  <!-- Elasticsearch -->
  <rect x="870" y="480" width="190" height="70" rx="8" class="storage-box"/>
  <text x="965" y="505" text-anchor="middle" class="component-title">[Search] Elasticsearch</text>
  <text x="965" y="525" text-anchor="middle" class="label-text">:9200 (搜索引擎)</text>
  <text x="965" y="540" text-anchor="middle" class="detail-text">保留30天</text>
  
  <!-- Kibana -->
  <rect x="1090" y="480" width="190" height="70" rx="8" class="visual-box"/>
  <text x="1185" y="505" text-anchor="middle" class="component-title">[Search] Kibana</text>
  <text x="1185" y="525" text-anchor="middle" class="label-text">:5601 (日志查询)</text>
  <text x="1185" y="540" text-anchor="middle" class="detail-text">全文检索/分析</text>
  
  <!-- Arrows Logs -->
  <path d="M 1225 260 L 1225 330 L 945 330 L 945 370" class="logs-arrow"/>
  <path d="M 1020 415 L 1070 415" class="logs-arrow"/>
  <path d="M 1145 460 L 1145 470 L 965 470 L 965 480" class="logs-arrow"/>
  <path d="M 1060 515 L 1090 515" class="logs-arrow"/>

  <!-- ==================== Traces Flow ==================== -->
  <rect x="50" y="600" width="1500" height="180" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="630" class="section-title">[Link] Traces 流 (链路追踪)</text>
  
  <!-- Spring Cloud Sleuth -->
  <rect x="100" y="660" width="200" height="90" rx="8" class="trace-box"/>
  <text x="200" y="685" text-anchor="middle" class="component-title">[Tag] Sleuth</text>
  <text x="200" y="705" text-anchor="middle" class="label-text">应用内嵌</text>
  <text x="200" y="722" text-anchor="middle" class="detail-text">自动生成 TraceID</text>
  <text x="200" y="737" text-anchor="middle" class="detail-text">SpanID / ParentID</text>
  
  <!-- Zipkin Server -->
  <rect x="360" y="660" width="200" height="90" rx="8" class="storage-box"/>
  <text x="460" y="685" text-anchor="middle" class="component-title">[Link] Zipkin Server</text>
  <text x="460" y="705" text-anchor="middle" class="label-text">:9411</text>
  <text x="460" y="722" text-anchor="middle" class="detail-text">Span收集/存储</text>
  <text x="460" y="737" text-anchor="middle" class="detail-text">MySQL/ES后端</text>
  
  <!-- Zipkin UI -->
  <rect x="620" y="660" width="200" height="90" rx="8" class="visual-box"/>
  <text x="720" y="685" text-anchor="middle" class="component-title">[Search] Zipkin UI</text>
  <text x="720" y="705" text-anchor="middle" class="label-text">:9411/zipkin</text>
  <text x="720" y="722" text-anchor="middle" class="detail-text">链路可视化</text>
  <text x="720" y="737" text-anchor="middle" class="detail-text">调用时序图</text>
  
  <!-- Trace Context -->
  <rect x="880" y="660" width="620" height="90" rx="8" fill="#fff9e6" stroke="#ffc107" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="900" y="685" class="component-text" font-weight="bold">[Target] Trace Context 传播</text>
  <text x="900" y="705" class="detail-text">• HTTP请求: Header携带 X-B3-TraceId / X-B3-SpanId</text>
  <text x="900" y="722" class="detail-text">• 消息队列: Message Property携带TraceID</text>
  <text x="900" y="737" class="detail-text">• 数据库: 慢SQL日志关联TraceID (注释注入)</text>
  
  <!-- Arrows Traces -->
  <path d="M 300 705 L 360 705" class="trace-arrow"/>
  <path d="M 560 705 L 620 705" class="trace-arrow"/>
  
  <path d="M 190 260 L 190 640 L 200 640 L 200 660" class="trace-arrow"/>
  <path d="M 410 260 L 410 650 L 200 650 L 200 660" class="trace-arrow"/>
  <text x="195" y="450" class="label-text" fill="#e91e63">Span上报</text>

  <!-- ==================== Alert Flow ==================== -->
  <rect x="50" y="810" width="1500" height="200" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="840" class="section-title">[Alert] Alert 流 (告警系统)</text>
  
  <!-- AlertManager -->
  <rect x="100" y="870" width="240" height="110" rx="8" class="alert-box"/>
  <text x="220" y="895" text-anchor="middle" class="component-title">[Alert] AlertManager</text>
  <text x="220" y="915" text-anchor="middle" class="label-text">:9093</text>
  <text x="220" y="935" text-anchor="middle" class="component-text">告警聚合/去重/静默</text>
  <text x="220" y="952" text-anchor="middle" class="detail-text">• 告警分组: 按服务/级别</text>
  <text x="220" y="967" text-anchor="middle" class="detail-text">• 告警抑制: 关联告警去重</text>
  
  <!-- Notification Channels -->
  <rect x="400" y="870" width="150" height="50" rx="8" fill="#fff3e0" stroke="#ff9800" stroke-width="2"/>
  <text x="475" y="895" text-anchor="middle" class="component-text">📧 邮件</text>
  <text x="475" y="912" text-anchor="middle" class="detail-text">SMTP</text>
  
  <rect x="400" y="930" width="150" height="50" rx="8" fill="#e1f5fe" stroke="#03a9f4" stroke-width="2"/>
  <text x="475" y="955" text-anchor="middle" class="component-text">[Chat] 钉钉</text>
  <text x="475" y="972" text-anchor="middle" class="detail-text">Webhook</text>
  
  <rect x="600" y="870" width="150" height="50" rx="8" fill="#f3e5f5" stroke="#9c27b0" stroke-width="2"/>
  <text x="675" y="895" text-anchor="middle" class="component-text">[Phone] 短信</text>
  <text x="675" y="912" text-anchor="middle" class="detail-text">阿里云SMS</text>
  
  <rect x="600" y="930" width="150" height="50" rx="8" fill="#e8f5e9" stroke="#4caf50" stroke-width="2"/>
  <text x="675" y="955" text-anchor="middle" class="component-text">[Tel] 电话</text>
  <text x="675" y="972" text-anchor="middle" class="detail-text">语音通知</text>
  
  <!-- Alert Rules -->
  <rect x="820" y="870" width="680" height="110" rx="8" fill="#ffebee" stroke="#f44336" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="840" y="895" class="component-text" font-weight="bold">⚠️ 告警规则 (66条)</text>
  <text x="840" y="915" class="detail-text">• P0: 服务不可用 (5xx错误率>10%) → 立即电话+短信</text>
  <text x="840" y="933" class="detail-text">• P1: QPS异常 (QPS &lt; 正常值50% 持续5分钟) → 钉钉+邮件</text>
  <text x="840" y="951" class="detail-text">• P2: 延迟告警 (P95延迟 &gt; 500ms 持续10分钟) → 钉钉</text>
  <text x="840" y="969" class="detail-text">• P3: 消息堆积 (RocketMQ堆积 &gt; 10万) → 邮件</text>
  
  <!-- Arrows Alert -->
  <path d="M 230 550 L 230 820 L 220 820 L 220 870" class="alert-arrow"/>
  <path d="M 340 895 L 400 895" class="alert-arrow"/>
  <path d="M 340 955 L 400 955" class="alert-arrow"/>
  <path d="M 550 895 L 600 895" class="alert-arrow"/>
  <path d="M 550 955 L 600 955" class="alert-arrow"/>
  <text x="235" y="685" class="label-text" fill="#f44336">触发告警</text>

  <!-- ==================== Monitoring Metrics ==================== -->
  <rect x="50" y="1040" width="1500" height="240" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="1070" class="section-title">[Graph] 监控指标详情</text>
  
  <!-- JVM Metrics -->
  <rect x="100" y="1090" width="320" height="170" rx="8" fill="#e8f5e9" stroke="#4caf50" stroke-width="2"/>
  <text x="120" y="1115" class="component-text" font-weight="bold">[Java] JVM 指标</text>
  <text x="120" y="1135" class="detail-text">• 堆内存: heap_used / heap_max / heap_committed</text>
  <text x="120" y="1153" class="detail-text">• GC: gc_count / gc_time / gc_pause_duration</text>
  <text x="120" y="1171" class="detail-text">• 线程: thread_count / thread_peak / thread_daemon</text>
  <text x="120" y="1189" class="detail-text">• 类加载: classes_loaded / classes_unloaded</text>
  <text x="120" y="1207" class="detail-text">• CPU: process_cpu_usage / system_cpu_usage</text>
  <text x="120" y="1225" class="detail-text">• 文件描述符: process_files_open / process_files_max</text>
  <text x="120" y="1243" class="detail-text">采集间隔: 15s | 保留: 15天</text>
  
  <!-- HTTP Metrics -->
  <rect x="460" y="1090" width="320" height="170" rx="8" fill="#fff3e0" stroke="#ff9800" stroke-width="2"/>
  <text x="480" y="1115" class="component-text" font-weight="bold">[Globe] HTTP 指标</text>
  <text x="480" y="1135" class="detail-text">• QPS: http_requests_total (rate)</text>
  <text x="480" y="1153" class="detail-text">• 延迟: http_request_duration_seconds (histogram)</text>
  <text x="480" y="1171" class="detail-text">• 错误率: http_errors_total / http_requests_total</text>
  <text x="480" y="1189" class="detail-text">• 状态码分布: 2xx / 4xx / 5xx</text>
  <text x="480" y="1207" class="detail-text">• 慢请求: P95 / P99 / P999 延迟</text>
  <text x="480" y="1225" class="detail-text">• 并发连接: http_connections_active</text>
  <text x="480" y="1243" class="detail-text">标签维度: uri | method | status</text>
  
  <!-- Database Metrics -->
  <rect x="820" y="1090" width="320" height="170" rx="8" fill="#e1f5fe" stroke="#03a9f4" stroke-width="2"/>
  <text x="840" y="1115" class="component-text" font-weight="bold">[DB] 数据库指标</text>
  <text x="840" y="1135" class="detail-text">• 连接池: active / idle / waiting / max</text>
  <text x="840" y="1153" class="detail-text">• SQL执行: query_count / query_time_avg</text>
  <text x="840" y="1171" class="detail-text">• 慢查询: slow_queries (>1s)</text>
  <text x="840" y="1189" class="detail-text">• 主从延迟: replication_lag_seconds</text>
  <text x="840" y="1207" class="detail-text">• 缓存命中率: cache_hit_ratio</text>
  <text x="840" y="1225" class="detail-text">• 表空间: table_rows / data_size</text>
  <text x="840" y="1243" class="detail-text">Exporter: mysqld_exporter:9104</text>
  
  <!-- Business Metrics -->
  <rect x="1180" y="1090" width="320" height="170" rx="8" fill="#f3e5f5" stroke="#9c27b0" stroke-width="2"/>
  <text x="1200" y="1115" class="component-text" font-weight="bold">[Chart] 业务指标</text>
  <text x="1200" y="1135" class="detail-text">• 用户注册数: user_register_total (Counter)</text>
  <text x="1200" y="1153" class="detail-text">• 登录成功率: login_success_rate (Gauge)</text>
  <text x="1200" y="1171" class="detail-text">• 订单创建量: order_create_total (Counter)</text>
  <text x="1200" y="1189" class="detail-text">• 支付成功率: payment_success_rate (Gauge)</text>
  <text x="1200" y="1207" class="detail-text">• 审批耗时: approval_duration_seconds (Histogram)</text>
  <text x="1200" y="1225" class="detail-text">• 文件上传量: file_upload_bytes (Summary)</text>
  <text x="1200" y="1243" class="detail-text">自定义埋点: Micrometer API</text>
</svg>