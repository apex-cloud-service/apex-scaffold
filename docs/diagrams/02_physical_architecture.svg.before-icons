<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 720" width="900" height="720">
  <defs>
    <style>
      .zone { fill: #f8fafc; stroke: #e2e8f0; stroke-width: 1; stroke-dasharray: 4 2; rx: 10; }
      .zone-title { font: 600 15px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: start; }
      .node { fill: #ffffff; stroke-width: 2; rx: 8; }
      .node-client { stroke: #a78bfa; }
      .node-network { stroke: #4f46e5; }
      .node-app { stroke: #0891b2; }
      .node-data { stroke: #059669; }
      .node-ops { stroke: #d97706; }
      .node-name { font: 500 13px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .node-desc { font: 11px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
      .link { fill: none; stroke: #64748b; stroke-width: 1.8; }
      .link-label { font: 10px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
    </style>
    <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M1 1 L7 4 L1 7 Z" fill="#64748b"/>
    </marker>
  </defs>

  <!-- Title -->
  <text x="450" y="30" style="font:700 22px system-ui, -apple-system, sans-serif;fill:#0f172a;text-anchor:middle">Apex Scaffold 网络部署架构图</text>
  <text x="450" y="50" style="font:12px system-ui, -apple-system, sans-serif;fill:#475569;text-anchor:middle">物理拓扑 · Docker Compose 默认栈 · Kubernetes 扩展拓扑</text>

  <!-- Zone 1: Client Zone -->
  <rect class="zone" x="20" y="70" width="860" height="100"/>
  <text class="zone-title" x="30" y="90">🌐 客户端层 (Internet)</text>
  
  <rect class="node node-client" x="60" y="110" width="120" height="45"/>
  <text class="node-name" x="120" y="132">Web 浏览器</text>
  <text class="node-desc" x="120" y="145">Vue 3 + Element</text>

  <rect class="node node-client" x="200" y="110" width="120" height="45"/>
  <text class="node-name" x="260" y="132">移动端 APP</text>
  <text class="node-desc" x="260" y="145">H5 / 小程序</text>

  <rect class="node node-client" x="340" y="110" width="120" height="45"/>
  <text class="node-name" x="400" y="132">第三方系统</text>
  <text class="node-desc" x="400" y="145">OpenAPI对接</text>

  <rect class="node node-client" x="480" y="110" width="120" height="45"/>
  <text class="node-name" x="540" y="132">运维人员</text>
  <text class="node-desc" x="540" y="145">SSH / kubectl</text>

  <rect class="node node-client" x="620" y="110" width="120" height="45"/>
  <text class="node-name" x="680" y="132">CDN加速</text>
  <text class="node-desc" x="680" y="145">静态资源缓存</text>

  <rect class="node node-client" x="760" y="110" width="100" height="45"/>
  <text class="node-name" x="810" y="132">DNS</text>
  <text class="node-desc" x="810" y="145">域名解析</text>

  <!-- Zone 2: Network / Security -->
  <rect class="zone" x="20" y="190" width="860" height="90"/>
  <text class="zone-title" x="30" y="210">🛡️ 网络安全层 (DMZ)</text>

  <rect class="node node-network" x="60" y="220" width="130" height="45"/>
  <text class="node-name" x="125" y="242">WAF防火墙</text>
  <text class="node-desc" x="125" y="255">防SQL注入/XSS</text>

  <rect class="node node-network" x="220" y="220" width="130" height="45"/>
  <text class="node-name" x="285" y="242">Nginx/ALB</text>
  <text class="node-desc" x="285" y="255">HTTPS 负载均衡</text>

  <rect class="node node-network" x="380" y="220" width="130" height="45"/>
  <text class="node-name" x="445" y="242">API 网关</text>
  <text class="node-desc" x="445" y="255">限流/熔断/鉴权</text>

  <rect class="node node-network" x="540" y="220" width="130" height="45"/>
  <text class="node-name" x="605" y="242">Sentinel</text>
  <text class="node-desc" x="605" y="255">流量治理中心</text>

  <rect class="node node-network" x="700" y="220" width="150" height="45"/>
  <text class="node-name" x="775" y="242">SSO/IAM</text>
  <text class="node-desc" x="775" y="255">统一身份认证 (可选)</text>

  <!-- Zone 3: Application Cluster -->
  <rect class="zone" x="20" y="300" width="860" height="120"/>
  <text class="zone-title" x="30" y="320">⚙️ 应用服务层 (K8s Pods / Docker)</text>

  <rect class="node node-app" x="60" y="340" width="180" height="60"/>
  <text class="node-name" x="150" y="365">Apex Application #1</text>
  <text class="node-desc" x="150" y="380">Spring Boot WebFlux</text>
  <text class="node-desc" x="150" y="393">JDK 17 · 资源按环境配置</text>

  <rect class="node node-app" x="270" y="340" width="180" height="60"/>
  <text class="node-name" x="360" y="365">Apex Application #2</text>
  <text class="node-desc" x="360" y="380">水平扩展 Pod</text>
  <text class="node-desc" x="360" y="393">HPA自动伸缩</text>

  <rect class="node node-app" x="480" y="340" width="180" height="60"/>
  <text class="node-name" x="570" y="365">Apex Application #N</text>
  <text class="node-desc" x="570" y="380">多实例扩展 (建议)</text>
  <text class="node-desc" x="570" y="393">滚动发布 (建议)</text>

  <rect class="node node-app" x="690" y="340" width="160" height="60"/>
  <text class="node-name" x="770" y="365">消息消费者</text>
  <text class="node-desc" x="770" y="380">异步任务处理 (可选)</text>
  <text class="node-desc" x="770" y="393">RocketMQ 配置启用</text>

  <!-- Zone 4: Data Layer -->
  <rect class="zone" x="20" y="440" width="860" height="120"/>
  <text class="zone-title" x="30" y="460">💾 数据存储层 (持久化 · 高可用集群)</text>

  <rect class="node node-data" x="40" y="480" width="150" height="60"/>
  <text class="node-name" x="115" y="505">MySQL 8.0</text>
  <text class="node-desc" x="115" y="520">Compose: mysql:8.0</text>
  <text class="node-desc" x="115" y="533">生产高可用需另行规划</text>

  <rect class="node node-data" x="210" y="480" width="150" height="60"/>
  <text class="node-name" x="285" y="505">Redis Cluster</text>
  <text class="node-desc" x="285" y="520">Compose: redis:7-alpine</text>
  <text class="node-desc" x="285" y="533">缓存/分布式锁</text>

  <rect class="node node-data" x="380" y="480" width="150" height="60"/>
  <text class="node-name" x="455" y="505">MinIO / TOS</text>
  <text class="node-desc" x="455" y="520">对象存储集群</text>
  <text class="node-desc" x="455" y="533">文件/图片存储</text>

  <rect class="node node-data" x="550" y="480" width="150" height="60"/>
  <text class="node-name" x="625" y="505">RocketMQ (可选)</text>
  <text class="node-desc" x="625" y="520">消息队列集群</text>
  <text class="node-desc" x="625" y="533">异步解耦/削峰</text>

  <rect class="node node-data" x="720" y="480" width="140" height="60"/>
  <text class="node-name" x="790" y="505">Meilisearch</text>
  <text class="node-desc" x="790" y="520">Compose 默认启用</text>
  <text class="node-desc" x="790" y="533">全文检索</text>

  <!-- Zone 5: Operations / Monitoring -->
  <rect class="zone" x="20" y="580" width="860" height="120"/>
  <text class="zone-title" x="30" y="600">🔍 运维监控层 (可观测性)</text>

  <rect class="node node-ops" x="40" y="620" width="130" height="55"/>
  <text class="node-name" x="105" y="642">Prometheus</text>
  <text class="node-desc" x="105" y="658">指标采集</text>
  <text class="node-desc" x="105" y="670">/actuator/prometheus</text>

  <rect class="node node-ops" x="190" y="620" width="130" height="55"/>
  <text class="node-name" x="255" y="642">Grafana</text>
  <text class="node-desc" x="255" y="658">可视化监控大盘</text>
  <text class="node-desc" x="255" y="670">Dashboard JSON 配置</text>

  <rect class="node node-ops" x="340" y="620" width="130" height="55"/>
  <text class="node-name" x="405" y="642">Loki / Alloy</text>
  <text class="node-desc" x="405" y="658">日志聚合检索</text>
  <text class="node-desc" x="405" y="670">traceId链路追踪</text>

  <rect class="node node-ops" x="490" y="620" width="130" height="55"/>
  <text class="node-name" x="555" y="642">Zipkin</text>
  <text class="node-desc" x="555" y="658">分布式链路追踪</text>
  <text class="node-desc" x="555" y="670">性能瓶颈分析</text>

  <rect class="node node-ops" x="640" y="620" width="100" height="55"/>
  <text class="node-name" x="690" y="642">AlertMgr</text>
  <text class="node-desc" x="690" y="658">告警中心</text>
  <text class="node-desc" x="690" y="670">飞书/短信/邮件</text>

  <rect class="node node-ops" x="760" y="620" width="100" height="55"/>
  <text class="node-name" x="810" y="642">CICD</text>
  <text class="node-desc" x="810" y="658">发布工具 (建议)</text>
  <text class="node-desc" x="810" y="670">按组织流水线接入</text>

  <!-- Connection lines - Client to Security -->
  <path class="link" d="M120 170 L120 190 L125 220" marker-end="url(#arr)"/>
  <path class="link" d="M260 170 L260 190 L285 220" marker-end="url(#arr)"/>
  <path class="link" d="M400 170 L400 190 L445 220" marker-end="url(#arr)"/>
  <path class="link" d="M540 170 L540 190 L285 220" marker-end="url(#arr)"/>
  <path class="link" d="M680 170 L680 190 L285 220" marker-end="url(#arr)"/>
  <path class="link" d="M810 170 L810 190 L285 220" marker-end="url(#arr)"/>
  <text class="link-label" x="400" y="185">HTTPS / WSS (443)</text>

  <!-- Connection: Security -> App -->
  <path class="link" d="M285 265 L285 300 L150 300 L150 340" marker-end="url(#arr)"/>
  <path class="link" d="M445 265 L445 300 L360 300 L360 340" marker-end="url(#arr)"/>
  <path class="link" d="M605 265 L605 300 L570 300 L570 340" marker-end="url(#arr)"/>
  <path class="link" d="M775 265 L775 300 L770 300 L770 340" marker-end="url(#arr)"/>
  <text class="link-label" x="450" y="290">HTTP (8080) 内网负载均衡</text>

  <!-- Connection: App -> Data -->
  <path class="link" d="M150 400 L150 440 L115 440 L115 480" marker-end="url(#arr)"/>
  <path class="link" d="M360 400 L360 440 L285 440 L285 480" marker-end="url(#arr)"/>
  <path class="link" d="M570 400 L570 440 L455 440 L455 480" marker-end="url(#arr)"/>
  <path class="link" d="M770 400 L770 440 L625 440 L625 480" marker-end="url(#arr)"/>
  <path class="link" d="M150 400 L150 440 L790 440 L790 480" marker-end="url(#arr)" stroke-dasharray="4 2"/>
  <text class="link-label" x="450" y="425">JDBC(3306) / Redis(6379) / S3(9000) / RocketMQ(9876)</text>

  <!-- Connection: All -> Monitoring (scrape / push) -->
  <path class="link" d="M150 540 L150 580 L105 580 L105 620" marker-end="url(#arr)" stroke-dasharray="2 2"/>
  <path class="link" d="M360 540 L360 580 L255 580 L255 620" marker-end="url(#arr)" stroke-dasharray="2 2"/>
  <path class="link" d="M570 540 L570 580 L405 580 L405 620" marker-end="url(#arr)" stroke-dasharray="2 2"/>
  <path class="link" d="M150 340 L150 300 L850 300 L850 580 L555 580 L555 620" marker-end="url(#arr)" stroke-dasharray="2 2"/>
  <text class="link-label" x="450" y="565">Prometheus 指标抓取 + 日志推送 + 链路上报</text>
</svg>
