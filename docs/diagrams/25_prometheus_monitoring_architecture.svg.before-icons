<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1800 2000">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #F8FAFC; }
      .subtitle { font: 16px sans-serif; fill: #94A3B8; }
      .section-title { font: bold 20px sans-serif; fill: #38BDF8; }
      .layer-title { font: bold 16px sans-serif; fill: #F8FAFC; }
      .group-title { font: bold 14px sans-serif; fill: #F8FAFC; }
      .panel-desc { font: 12px sans-serif; fill: #CBD5E1; }
      .metric-name { font: 11px monospace; fill: #4FD1C5; }
      .config-key { font: 11px monospace; fill: #F59E0B; }
      .port { font: 11px monospace; fill: #38BDF8; }
      .count { font: bold 16px sans-serif; fill: #F97316; }
      
      .prometheus-bg { fill: #1E293B; stroke: #E85D35; stroke-width: 3; }
      .target-bg { fill: #0F172A; stroke: #10B981; stroke-width: 2; }
      .storage-bg { fill: #0F172A; stroke: #38BDF8; stroke-width: 2; }
      .alert-bg { fill: #0F172A; stroke: #EF4444; stroke-width: 2; }
      .query-bg { fill: #0F172A; stroke: #F59E0B; stroke-width: 2; }
      .exporter-box { fill: #1E293B; stroke: #4FD1C5; stroke-width: 1.5; }
      
      .scrape-flow { stroke: #10B981; stroke-width: 2.5; fill: none; marker-end: url(#scrapehead); }
      .query-flow { stroke: #F59E0B; stroke-width: 2; fill: none; stroke-dasharray: 5,5; marker-end: url(#queryhead); }
      .alert-flow { stroke: #EF4444; stroke-width: 2.5; fill: none; marker-end: url(#alerthead); }
    </style>
    <marker id="scrapehead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#10B981" />
    </marker>
    <marker id="queryhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#F59E0B" />
    </marker>
    <marker id="alerthead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#EF4444" />
    </marker>
  </defs>

  <!-- Background -->
  <rect width="1800" height="2000" fill="#0B0E14"/>

  <!-- Title -->
  <text x="900" y="40" text-anchor="middle" class="title">Apex Scaffold Prometheus 监控体系架构</text>
  <text x="900" y="65" text-anchor="middle" class="subtitle">6个抓取目标 · 100+指标类型 · 15天数据保留 · 10组告警规则</text>

  <!-- Center: Prometheus Core -->
  <rect x="650" y="120" width="500" height="320" rx="8" class="prometheus-bg"/>
  <text x="900" y="160" text-anchor="middle" class="section-title">Prometheus Server</text>
  <text x="900" y="185" text-anchor="middle" class="port">http://prometheus:9090</text>

  <!-- Core Components -->
  <rect x="670" y="200" width="220" height="220" rx="6" class="storage-bg"/>
  <text x="780" y="230" text-anchor="middle" class="layer-title">时间序列数据库 TSDB</text>
  <text x="685" y="255" class="panel-desc">存储引擎: LevelDB</text>
  <text x="685" y="275" class="panel-desc">数据保留: 15 days</text>
  <text x="685" y="295" class="panel-desc">压缩率: ~10:1</text>
  <text x="685" y="315" class="panel-desc">WAL预写日志</text>
  <text x="685" y="335" class="panel-desc">样本/秒: ~10k</text>
  <text x="685" y="355" class="config-key">--storage.tsdb.retention.time=15d</text>
  <text x="685" y="375" class="config-key">--storage.tsdb.path=/data</text>
  <text x="685" y="395" class="metric-name">prometheus_tsdb_head_samples</text>

  <rect x="910" y="200" width="220" height="220" rx="6" class="query-bg"/>
  <text x="1020" y="230" text-anchor="middle" class="layer-title">PromQL 查询引擎</text>
  <text x="925" y="255" class="panel-desc">即时查询 Instant</text>
  <text x="925" y="275" class="panel-desc">范围查询 Range</text>
  <text x="925" y="295" class="panel-desc">聚合函数 Aggregation</text>
  <text x="925" y="315" class="panel-desc">数学运算 Math</text>
  <text x="925" y="335" class="panel-desc">Top K / Bottom K</text>
  <text x="925" y="355" class="metric-name">rate() / irate()</text>
  <text x="925" y="375" class="metric-name">histogram_quantile()</text>
  <text x="925" y="395" class="metric-name">increase() / sum()</text>

  <!-- Left: Scrape Targets -->
  <rect x="50" y="120" width="550" height="1800" rx="8" class="target-bg"/>
  <text x="325" y="160" text-anchor="middle" class="section-title">抓取目标 Scrape Targets</text>
  <text x="325" y="185" text-anchor="middle" class="subtitle">6个服务端点 · 15秒抓取周期</text>

  <!-- Target 1: Apex Scaffold -->
  <rect x="70" y="210" width="510" height="260" rx="6" class="exporter-box"/>
  <text x="325" y="240" text-anchor="middle" class="group-title">① Apex Scaffold 应用 (主要)</text>
  <text x="325" y="260" text-anchor="middle" class="port">http://apex-scaffold:8081/actuator/prometheus</text>
  <text x="325" y="280" text-anchor="middle" class="config-key">scrape_interval: 15s | scrape_timeout: 10s</text>
  
  <text x="85" y="305" class="layer-title">核心业务指标 (20+)</text>
  <text x="95" y="325" class="metric-name">apex_api_request_count_total</text>
  <text x="95" y="345" class="metric-name">apex_api_response_time_seconds</text>
  <text x="95" y="365" class="metric-name">apex_exception_total</text>
  <text x="95" y="385" class="metric-name">apex_business_login_total</text>
  <text x="95" y="405" class="metric-name">apex_business_upload_total</text>
  
  <text x="340" y="305" class="layer-title">JVM运行时 (30+)</text>
  <text x="350" y="325" class="metric-name">jvm_memory_used_bytes</text>
  <text x="350" y="345" class="metric-name">jvm_gc_pause_seconds_count</text>
  <text x="350" y="365" class="metric-name">jvm_threads_live_threads</text>
  <text x="350" y="385" class="metric-name">hikaricp_connections_active</text>
  <text x="350" y="405" class="metric-name">druid_connections_max</text>
  
  <text x="85" y="435" class="layer-title">安全防护 (10+)</text>
  <text x="95" y="455" class="metric-name">apex_security_ip_blocked_total</text>
  
  <text x="340" y="435" class="layer-title">阻塞IO (5+)</text>
  <text x="350" y="455" class="metric-name">apex_blocking_io_queued_tasks</text>

  <!-- Target 2: Sentinel -->
  <rect x="70" y="490" width="510" height="140" rx="6" class="exporter-box"/>
  <text x="325" y="520" text-anchor="middle" class="group-title">② Sentinel 治理平台</text>
  <text x="325" y="540" text-anchor="middle" class="port">http://sentinel:8720/metrics</text>
  <text x="325" y="560" text-anchor="middle" class="config-key">scrape_interval: 15s</text>
  <text x="85" y="585" class="metric-name">sentinel_block_qps_total (限流拦截)</text>
  <text x="85" y="605" class="metric-name">sentinel_pass_qps (通过请求)</text>
  <text x="350" y="585" class="metric-name">resilience4j_circuitbreaker_state</text>
  <text x="350" y="605" class="metric-name">resilience4j_retry_calls_total</text>

  <!-- Target 3: Blackbox Exporter -->
  <rect x="70" y="650" width="510" height="140" rx="6" class="exporter-box"/>
  <text x="325" y="680" text-anchor="middle" class="group-title">③ Blackbox Exporter 健康探针</text>
  <text x="325" y="700" text-anchor="middle" class="port">http://blackbox-exporter:9115/probe</text>
  <text x="325" y="720" text-anchor="middle" class="config-key">scrape_interval: 30s | module: http_2xx</text>
  <text x="85" y="745" class="metric-name">probe_success{} (探测成功 0/1)</text>
  <text x="85" y="765" class="metric-name">probe_http_status_code (HTTP状态码)</text>
  <text x="350" y="745" class="metric-name">probe_duration_seconds (探测耗时)</text>
  <text x="350" y="765" class="metric-name">probe_http_ssl_expiry_seconds (SSL过期)</text>

  <!-- Target 4: Grafana -->
  <rect x="70" y="810" width="510" height="120" rx="6" class="exporter-box"/>
  <text x="325" y="840" text-anchor="middle" class="group-title">④ Grafana 自监控</text>
  <text x="325" y="860" text-anchor="middle" class="port">http://grafana:3000/metrics</text>
  <text x="325" y="880" text-anchor="middle" class="config-key">scrape_interval: 30s</text>
  <text x="85" y="905" class="metric-name">grafana_api_dashboard_get_total</text>
  <text x="350" y="905" class="metric-name">grafana_database_query_duration_seconds</text>

  <!-- Target 5: Zipkin -->
  <rect x="70" y="950" width="510" height="120" rx="6" class="exporter-box"/>
  <text x="325" y="980" text-anchor="middle" class="group-title">⑤ Zipkin 链路追踪</text>
  <text x="325" y="1000" text-anchor="middle" class="port">http://zipkin:9411/prometheus</text>
  <text x="325" y="1020" text-anchor="middle" class="config-key">scrape_interval: 15s</text>
  <text x="85" y="1045" class="metric-name">zipkin_collector_spans_total</text>
  <text x="350" y="1045" class="metric-name">zipkin_collector_messages_dropped_total</text>

  <!-- Target 6: Node Exporter (Optional) -->
  <rect x="70" y="1090" width="510" height="180" rx="6" class="exporter-box"/>
  <text x="325" y="1120" text-anchor="middle" class="group-title">⑥ Node Exporter 主机监控 (可选)</text>
  <text x="325" y="1140" text-anchor="middle" class="port">http://node-exporter:9100/metrics</text>
  <text x="325" y="1160" text-anchor="middle" class="config-key">scrape_interval: 30s</text>
  <text x="85" y="1185" class="metric-name">node_cpu_seconds_total (CPU)</text>
  <text x="85" y="1205" class="metric-name">node_memory_MemAvailable_bytes</text>
  <text x="85" y="1225" class="metric-name">node_disk_io_time_seconds_total</text>
  <text x="85" y="1245" class="metric-name">node_network_receive_bytes_total</text>
  <text x="350" y="1185" class="metric-name">node_filesystem_avail_bytes</text>
  <text x="350" y="1205" class="metric-name">node_load1 / node_load5</text>
  <text x="350" y="1225" class="metric-name">node_netstat_Tcp_CurrEstab</text>
  <text x="350" y="1245" class="metric-name">node_time_seconds (时间同步)</text>

  <!-- Scrape Config -->
  <rect x="70" y="1290" width="510" height="610" rx="6" style="fill:#0B0E14;stroke:#F59E0B;stroke-width:2;"/>
  <text x="325" y="1320" text-anchor="middle" class="layer-title">prometheus.yml 抓取配置</text>
  
  <text x="85" y="1350" class="config-key">global:</text>
  <text x="95" y="1370" class="panel-desc">scrape_interval: 15s</text>
  <text x="95" y="1390" class="panel-desc">scrape_timeout: 10s</text>
  <text x="95" y="1410" class="panel-desc">evaluation_interval: 15s</text>
  <text x="95" y="1430" class="panel-desc">external_labels:</text>
  <text x="105" y="1450" class="panel-desc">cluster: 'apex-prod'</text>
  
  <text x="85" y="1480" class="config-key">scrape_configs:</text>
  <text x="95" y="1500" class="panel-desc">- job_name: 'apex-scaffold'</text>
  <text x="105" y="1520" class="panel-desc">static_configs:</text>
  <text x="115" y="1540" class="panel-desc">- targets: ['apex:8081']</text>
  <text x="105" y="1560" class="panel-desc">metrics_path: '/actuator/prometheus'</text>
  
  <text x="95" y="1590" class="panel-desc">- job_name: 'sentinel'</text>
  <text x="105" y="1610" class="panel-desc">static_configs:</text>
  <text x="115" y="1630" class="panel-desc">- targets: ['sentinel:8720']</text>
  
  <text x="95" y="1660" class="panel-desc">- job_name: 'blackbox'</text>
  <text x="105" y="1680" class="panel-desc">metrics_path: '/probe'</text>
  <text x="105" y="1700" class="panel-desc">params:</text>
  <text x="115" y="1720" class="panel-desc">module: [http_2xx]</text>
  <text x="105" y="1740" class="panel-desc">static_configs:</text>
  <text x="115" y="1760" class="panel-desc">- targets:</text>
  <text x="125" y="1780" class="panel-desc">- http://apex:8081/actuator/health</text>
  <text x="105" y="1800" class="panel-desc">relabel_configs:</text>
  <text x="115" y="1820" class="panel-desc">- source_labels: [__address__]</text>
  <text x="115" y="1840" class="panel-desc">target_label: __param_target</text>
  
  <text x="95" y="1870" class="panel-desc">- job_name: 'grafana'</text>
  <text x="95" y="1890" class="panel-desc">- job_name: 'zipkin'</text>

  <!-- Right Top: Alertmanager -->
  <rect x="1200" y="120" width="550" height="600" rx="8" class="alert-bg"/>
  <text x="1475" y="160" text-anchor="middle" class="section-title">Alertmanager 告警管理</text>
  <text x="1475" y="185" text-anchor="middle" class="port">http://alertmanager:9093</text>

  <!-- Alert Rules -->
  <rect x="1220" y="200" width="510" height="500" rx="6" style="fill:#0B0E14;stroke:#EF4444;stroke-width:2;"/>
  <text x="1475" y="230" text-anchor="middle" class="layer-title">10组告警规则 (rules/)</text>
  
  <text x="1235" y="260" class="group-title">🚨 服务可用性告警 (2条)</text>
  <text x="1245" y="280" class="panel-desc">• ApexServiceDown</text>
  <text x="1250" y="300" class="metric-name">expr: up{job="apex-scaffold"} == 0</text>
  <text x="1250" y="320" class="metric-name">for: 1m | severity: critical</text>
  <text x="1245" y="340" class="panel-desc">• ApexHealthCheckFailed</text>
  <text x="1250" y="360" class="metric-name">expr: probe_success{} == 0</text>
  
  <text x="1235" y="390" class="group-title">⚠️ 接口质量告警 (5条)</text>
  <text x="1245" y="410" class="panel-desc">• High5xxErrorRate</text>
  <text x="1250" y="430" class="metric-name">rate(apex_api_*{status="5xx"}[5m]) &gt; 0.05</text>
  <text x="1245" y="450" class="panel-desc">• HighP95Latency</text>
  <text x="1250" y="470" class="metric-name">histogram_quantile(0.95, ...) &gt; 2</text>
  <text x="1245" y="490" class="panel-desc">• TrafficDrop (流量骤降)</text>
  <text x="1245" y="510" class="panel-desc">• ExceptionSpike (异常突增)</text>
  <text x="1245" y="530" class="panel-desc">• AlertStorm (告警风暴)</text>
  
  <text x="1235" y="560" class="group-title">☕ JVM健康告警 (4条)</text>
  <text x="1245" y="580" class="panel-desc">• HighHeapUsage (&gt; 85%)</text>
  <text x="1245" y="600" class="panel-desc">• FrequentFullGC (&gt; 5/min)</text>
  <text x="1245" y="620" class="panel-desc">• LongGCPause (&gt; 1s)</text>
  <text x="1245" y="640" class="panel-desc">• HighThreadCount (&gt; 2000)</text>
  
  <text x="1235" y="670" class="group-title">💾 数据库与中间件 (3条)</text>
  <text x="1245" y="690" class="panel-desc">• ConnectionPoolHigh (&gt; 80%)</text>

  <!-- Right Bottom: Query Clients -->
  <rect x="1200" y="740" width="550" height="480" rx="8" class="query-bg"/>
  <text x="1475" y="780" text-anchor="middle" class="section-title">查询客户端 Query Clients</text>
  
  <!-- Grafana Query -->
  <rect x="1220" y="800" width="510" height="120" rx="6" style="fill:#0B0E14;stroke:#F59E0B;stroke-width:2;"/>
  <text x="1475" y="830" text-anchor="middle" class="layer-title">Grafana 数据可视化</text>
  <text x="1235" y="855" class="panel-desc">66个监控面板实时查询</text>
  <text x="1235" y="875" class="panel-desc">PromQL查询语句</text>
  <text x="1235" y="895" class="metric-name">rate(apex_api_request_count_total[5m])</text>
  <text x="1235" y="915" class="metric-name">histogram_quantile(0.95, ...)</text>

  <!-- API Query -->
  <rect x="1220" y="940" width="510" height="100" rx="6" style="fill:#0B0E14;stroke:#F59E0B;stroke-width:2;"/>
  <text x="1475" y="970" text-anchor="middle" class="layer-title">HTTP API 直接查询</text>
  <text x="1235" y="995" class="panel-desc">GET /api/v1/query (即时查询)</text>
  <text x="1235" y="1015" class="panel-desc">GET /api/v1/query_range (范围查询)</text>
  <text x="1235" y="1035" class="panel-desc">GET /api/v1/series (序列查询)</text>

  <!-- Recording Rules -->
  <rect x="1220" y="1060" width="510" height="140" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:2;"/>
  <text x="1475" y="1090" text-anchor="middle" class="layer-title">Recording Rules 预聚合</text>
  <text x="1235" y="1115" class="panel-desc">定时计算复杂查询结果</text>
  <text x="1235" y="1135" class="metric-name">job:apex_api_qps:rate5m</text>
  <text x="1250" y="1155" class="panel-desc">= rate(apex_api_request_count_total[5m])</text>
  <text x="1235" y="1175" class="metric-name">job:apex_api_p95:histogram_quantile</text>
  <text x="1250" y="1195" class="panel-desc">= histogram_quantile(0.95, ...)</text>

  <!-- Right Bottom: Alert Notification -->
  <rect x="1200" y="1240" width="550" height="660" rx="8" style="fill:#1E293B;stroke:#F59E0B;stroke-width:2;"/>
  <text x="1475" y="1280" text-anchor="middle" class="section-title">告警通知配置</text>

  <!-- Notification Channels -->
  <rect x="1220" y="1300" width="510" height="180" rx="6" style="fill:#0B0E14;stroke:#EF4444;stroke-width:2;"/>
  <text x="1475" y="1330" text-anchor="middle" class="layer-title">通知渠道 (alertmanager.yml)</text>
  <text x="1235" y="1355" class="config-key">receivers:</text>
  <text x="1245" y="1375" class="panel-desc">- name: 'email-team'</text>
  <text x="1255" y="1395" class="panel-desc">email_configs:</text>
  <text x="1265" y="1415" class="panel-desc">to: 'ops@example.com'</text>
  <text x="1245" y="1435" class="panel-desc">- name: 'dingtalk-webhook'</text>
  <text x="1255" y="1455" class="panel-desc">webhook_configs:</text>
  <text x="1265" y="1475" class="panel-desc">url: 'https://oapi.dingtalk.com/...'</text>

  <!-- Alert Routing -->
  <rect x="1220" y="1500" width="510" height="180" rx="6" style="fill:#0B0E14;stroke:#F59E0B;stroke-width:2;"/>
  <text x="1475" y="1530" text-anchor="middle" class="layer-title">路由规则 (route)</text>
  <text x="1235" y="1555" class="config-key">route:</text>
  <text x="1245" y="1575" class="panel-desc">group_by: ['alertname', 'severity']</text>
  <text x="1245" y="1595" class="panel-desc">group_wait: 30s</text>
  <text x="1245" y="1615" class="panel-desc">group_interval: 5m</text>
  <text x="1245" y="1635" class="panel-desc">repeat_interval: 4h</text>
  <text x="1245" y="1655" class="panel-desc">receiver: 'email-team'</text>
  <text x="1245" y="1675" class="panel-desc">routes: (按severity分发)</text>

  <!-- Inhibition Rules -->
  <rect x="1220" y="1700" width="510" height="180" rx="6" style="fill:#0B0E14;stroke:#10B981;stroke-width:2;"/>
  <text x="1475" y="1730" text-anchor="middle" class="layer-title">抑制规则 (inhibit_rules)</text>
  <text x="1235" y="1755" class="panel-desc">场景: 服务Down时抑制其他告警</text>
  <text x="1235" y="1775" class="config-key">- source_match:</text>
  <text x="1245" y="1795" class="panel-desc">severity: 'critical'</text>
  <text x="1245" y="1815" class="panel-desc">alertname: 'ApexServiceDown'</text>
  <text x="1235" y="1835" class="config-key">target_match:</text>
  <text x="1245" y="1855" class="panel-desc">severity: 'warning'</text>
  <text x="1235" y="1875" class="panel-desc">抑制低级别相关告警</text>

  <!-- Bottom: Data Flow -->
  <rect x="50" y="1940" width="1700" height="40" rx="6" style="fill:#1E293B;stroke:#4FD1C5;stroke-width:2;"/>
  <text x="900" y="1970" text-anchor="middle" class="panel-desc">
    🟢 15秒抓取周期 · 💾 15天数据保留 · 📊 PromQL查询 · 🚨 实时告警 · 📧 多渠道通知 · 🔄 自动发现服务
  </text>

  <!-- Data Flow Arrows -->
  <!-- Targets -> Prometheus -->
  <path d="M 600 400 L 650 400" class="scrape-flow"/>
  <text x="605" y="390" class="panel-desc" style="fill:#10B981;">抓取指标</text>

  <!-- Prometheus -> Alertmanager -->
  <path d="M 1150 280 L 1200 280" class="alert-flow"/>
  <text x="1155" y="270" class="panel-desc" style="fill:#EF4444;">触发告警</text>

  <!-- Prometheus -> Grafana -->
  <path d="M 1150 360 L 1200 860" class="query-flow"/>
  <text x="1155" y="600" class="panel-desc" style="fill:#F59E0B;">PromQL查询</text>

  <!-- Legend -->
  <g transform="translate(650, 460)">
    <text x="0" y="0" class="layer-title">配置文件位置:</text>
    <text x="0" y="20" class="config-key">/etc/prometheus/prometheus.yml</text>
    <text x="0" y="40" class="config-key">/etc/prometheus/rules/*.yml</text>
    <text x="0" y="60" class="config-key">/etc/alertmanager/alertmanager.yml</text>
  </g>

  <g transform="translate(650, 550)">
    <text x="0" y="0" class="layer-title">数据目录:</text>
    <text x="0" y="20" class="config-key">/data/prometheus/ (TSDB数据)</text>
    <text x="0" y="40" class="config-key">/data/alertmanager/ (告警状态)</text>
  </g>

  <g transform="translate(650, 630)">
    <text x="0" y="0" class="layer-title">端口映射:</text>
    <text x="0" y="20" class="port">9090 - Prometheus Web UI</text>
    <text x="0" y="40" class="port">9093 - Alertmanager UI</text>
    <text x="0" y="60" class="port">9115 - Blackbox Exporter</text>
    <text x="0" y="80" class="port">9100 - Node Exporter</text>
  </g>

  <g transform="translate(650, 750)">
    <text x="0" y="0" class="layer-title">运维命令:</text>
    <text x="0" y="20" class="config-key">promtool check config prometheus.yml</text>
    <text x="0" y="40" class="config-key">promtool check rules rules/*.yml</text>
    <text x="0" y="60" class="config-key">curl http://prometheus:9090/-/reload</text>
    <text x="0" y="80" class="config-key">amtool alert query</text>
  </g>

  <g transform="translate(650, 870)">
    <text x="0" y="0" class="layer-title">高可用方案 (可选):</text>
    <text x="0" y="20" class="panel-desc">• Prometheus联邦 (Federation)</text>
    <text x="0" y="40" class="panel-desc">• Thanos长期存储</text>
    <text x="0" y="60" class="panel-desc">• Cortex多租户</text>
    <text x="0" y="80" class="panel-desc">• VictoriaMetrics替代</text>
  </g>

  <g transform="translate(650, 990)">
    <text x="0" y="0" class="layer-title">性能优化:</text>
    <text x="0" y="20" class="panel-desc">• 调整scrape_interval降低负载</text>
    <text x="0" y="40" class="panel-desc">• 使用Recording Rules预聚合</text>
    <text x="0" y="60" class="panel-desc">• 设置metric_relabel_configs过滤</text>
    <text x="0" y="80" class="panel-desc">• 启用远程存储Remote Write</text>
  </g>

  <g transform="translate(650, 1110)">
    <text x="0" y="0" class="section-title">指标命名规范:</text>
    <text x="0" y="25" class="metric-name">apex_&lt;subsystem&gt;_&lt;name&gt;_&lt;unit&gt;</text>
    <text x="0" y="45" class="panel-desc">示例: apex_api_request_count_total</text>
    <text x="0" y="65" class="panel-desc">类型: Counter / Gauge / Histogram / Summary</text>
  </g>

  <g transform="translate(650, 1210)">
    <text x="0" y="0" class="section-title">PromQL查询示例:</text>
    <text x="0" y="25" class="metric-name">rate(apex_api_request_count_total[5m])</text>
    <text x="10" y="45" class="panel-desc">5分钟平均QPS</text>
    <text x="0" y="70" class="metric-name">histogram_quantile(0.95, rate(apex_api_response_time_seconds_bucket[5m]))</text>
    <text x="10" y="90" class="panel-desc">P95响应时间</text>
    <text x="0" y="115" class="metric-name">sum(rate(apex_exception_total[5m])) by (exception_type)</text>
    <text x="10" y="135" class="panel-desc">按异常类型分组统计</text>
    <text x="0" y="160" class="metric-name">topk(10, rate(apex_api_request_count_total[5m]))</text>
    <text x="10" y="180" class="panel-desc">QPS Top 10 接口</text>
  </g>

  <g transform="translate(650, 1430)">
    <text x="0" y="0" class="section-title">告警最佳实践:</text>
    <text x="0" y="25" class="panel-desc">✅ 设置合理的for时长避免抖动</text>
    <text x="0" y="45" class="panel-desc">✅ 使用severity分级(critical/warning/info)</text>
    <text x="0" y="65" class="panel-desc">✅ 告警消息包含明确的修复建议</text>
    <text x="0" y="85" class="panel-desc">✅ 配置告警抑制规则避免风暴</text>
    <text x="0" y="105" class="panel-desc">✅ 定期review和优化告警规则</text>
  </g>

  <g transform="translate(650, 1570)">
    <text x="0" y="0" class="section-title">监控黄金指标 (Google SRE):</text>
    <text x="0" y="25" class="panel-desc">1. Latency (延迟) - P50/P90/P95/P99响应时间</text>
    <text x="0" y="45" class="panel-desc">2. Traffic (流量) - QPS / RPS请求速率</text>
    <text x="0" y="65" class="panel-desc">3. Errors (错误) - 错误率 / 5xx比例</text>
    <text x="0" y="85" class="panel-desc">4. Saturation (饱和度) - CPU/内存/连接池水位</text>
  </g>

  <g transform="translate(650, 1690)">
    <text x="0" y="0" class="section-title">容量规划参考:</text>
    <text x="0" y="25" class="panel-desc">• 每个时间序列: ~1-2 bytes/sample</text>
    <text x="0" y="45" class="panel-desc">• 10k指标 × 15s间隔 = 667样本/秒</text>
    <text x="0" y="65" class="panel-desc">• 15天数据: ~86M样本 (~172MB未压缩)</text>
    <text x="0" y="85" class="panel-desc">• 实际压缩后: ~17MB (10:1压缩比)</text>
    <text x="0" y="105" class="panel-desc">• 内存需求: 样本数 × 2 bytes + 索引开销</text>
  </g>

  <g transform="translate(650, 1830)">
    <text x="0" y="0" class="section-title">故障排查:</text>
    <text x="0" y="25" class="panel-desc">🔍 检查Targets页面抓取状态</text>
    <text x="0" y="45" class="panel-desc">🔍 查看Graph页面测试PromQL</text>
    <text x="0" y="65" class="panel-desc">🔍 检查Alerts页面告警状态</text>
    <text x="0" y="85" class="panel-desc">🔍 查看日志: docker logs prometheus</text>
  </g>
</svg>