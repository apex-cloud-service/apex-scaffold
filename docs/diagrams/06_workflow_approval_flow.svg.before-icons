<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 930" width="720" height="930">
  <defs>
    <style>
      .s { font:12px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .node { fill:#ffffff; stroke-width:2; rx:6; }
      .s1 { stroke:#4f46e5; }
      .s2 { stroke:#0891b2; }
      .s3 { stroke:#d97706; }
      .ok { stroke:#059669; stroke-width:3; }
      .er { stroke:#dc2626; stroke-width:3; }
      .dia { fill:#ffffff; stroke:#d97706; stroke-width:2; }
      .lb { font:500 13px system-ui, -apple-system, sans-serif; fill:#0f172a; text-anchor:middle; }
      .d { font:11px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .ar { fill:none; stroke:#64748b; stroke-width:2; }
      .al { font:11px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .sb { fill:#f8fafc; stroke:#e2e8f0; stroke-width:1; stroke-dasharray:3 3; rx:6; }
    </style>
    <marker id="a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M1 1 L7 4 L1 7 Z" fill="#64748b"/></marker>
  </defs>

  <text class="t" x="360" y="28">工作流审批业务流程图</text>
  <text class="s" x="360" y="48">BPMN 解析 · 状态机流转 · 三级审批：部门主管 → 财务 → 总经理</text>

  <!-- Start Event -->
  <circle class="node s1" cx="360" cy="75" r="22"/>
  <text class="lb" x="360" y="80">开始</text>

  <!-- Step 1: 发起流程 -->
  <rect class="node s1" x="290" y="120" width="140" height="48"/>
  <text class="lb" x="360" y="140">1. 申请人发起流程</text>
  <text class="d" x="360" y="156">选择流程定义 + 填写表单</text>
  <path class="ar" d="M360 97 L360 120" marker-end="url(#a)"/>

  <!-- Step 2: 创建实例 -->
  <rect class="node s2" x="290" y="190" width="140" height="48"/>
  <text class="lb" x="360" y="210">2. 创建流程实例</text>
  <text class="d" x="360" y="226">wf_instance · status=RUNNING</text>
  <path class="ar" d="M360 168 L360 190" marker-end="url(#a)"/>

  <!-- Step 3: 解析BPMN -->
  <rect class="node s2" x="290" y="260" width="140" height="48"/>
  <text class="lb" x="360" y="280">3. 解析BPMN XML</text>
  <text class="d" x="360" y="296">获取首个UserTask节点</text>
  <path class="ar" d="M360 238 L360 260" marker-end="url(#a)"/>

  <!-- Task 1: 主管审批 -->
  <rect class="node s2" x="290" y="330" width="140" height="54"/>
  <text class="lb" x="360" y="350">Task#1: 部门主管审批</text>
  <text class="d" x="360" y="366">wf_task · status=PENDING</text>
  <text class="d" x="360" y="378">assignee_id=主管ID</text>
  <path class="ar" d="M360 308 L360 330" marker-end="url(#a)"/>

  <!-- Decision 1 -->
  <path class="dia d" d="M360 402 L418 442 L360 482 L302 442 Z" fill="#ffffff" stroke="#d97706" stroke-width="2"/>
  <text class="lb" x="360" y="447">主管审批?</text>
  <path class="ar" d="M360 384 L360 402" marker-end="url(#a)"/>

  <!-- Reject 1 -->
  <rect class="node er" x="490" y="418" width="110" height="48"/>
  <text class="lb" x="545" y="438">❌ 驳回</text>
  <text class="d" x="545" y="454">wf_instance=TERMINATED</text>
  <path class="ar" d="M418 442 L490 442" marker-end="url(#a)"/>
  <text class="al" x="450" y="433">驳回</text>

  <!-- Back to restart loop -->
  <path class="ar" d="M490 442 L520 442 L520 140 L430 140" stroke-dasharray="4 3" marker-end="url(#a)"/>
  <text class="al" x="505" y="260">申请人修改后重提</text>

  <!-- Pass 1: 财务审批 -->
  <path class="ar" d="M360 482 L360 514" marker-end="url(#a)"/>
  <text class="al" x="348" y="500">通过</text>
  <rect class="node s2" x="290" y="514" width="140" height="54"/>
  <text class="lb" x="360" y="534">Task#2: 财务部审批</text>
  <text class="d" x="360" y="550">创建待办任务</text>
  <text class="d" x="360" y="562">财务主管签收审批</text>

  <!-- Decision 2 -->
  <path class="dia d" d="M360 586 L418 626 L360 666 L302 626 Z" fill="#ffffff" stroke="#d97706" stroke-width="2"/>
  <text class="lb" x="360" y="631">财务审批?</text>
  <path class="ar" d="M360 568 L360 586" marker-end="url(#a)"/>

  <!-- Reject 2 -->
  <path class="ar" d="M302 626 L160 626 L160 350 L290 350" stroke-dasharray="4 3" marker-end="url(#a)"/>
  <text class="al" x="145" y="500">驳回上一级</text>

  <!-- Pass 2: 总经理 -->
  <path class="ar" d="M360 666 L360 698" marker-end="url(#a)"/>
  <text class="al" x="348" y="684">通过</text>
  <rect class="node s2" x="290" y="698" width="140" height="54"/>
  <text class="lb" x="360" y="718">Task#3: 总经理审批</text>
  <text class="d" x="360" y="734">金额≥1万需终级审批</text>
  <text class="d" x="360" y="746">否则跳过此节点</text>

  <!-- Decision 3 -->
  <path class="dia d" d="M360 770 L418 810 L360 850 L302 810 Z" fill="#ffffff" stroke="#d97706" stroke-width="2"/>
  <text class="lb" x="360" y="815">总经理审批?</text>
  <path class="ar" d="M360 752 L360 770" marker-end="url(#a)"/>

  <!-- Reject 3 -->
  <path class="ar" d="M418 810 L480 810 L480 534 L430 534" stroke-dasharray="4 3" marker-end="url(#a)"/>
  <text class="al" x="495" y="680">驳回上一级</text>

  <!-- Pass 3: 状态流转 -->
  <path class="ar" d="M302 810 L140 810 L140 874" marker-end="url(#a)"/>
  <text class="al" x="180" y="800">通过</text>
  <rect class="node s3" x="60" y="874" width="160" height="48"/>
  <text class="lb" x="140" y="894">更新实例状态</text>
  <text class="d" x="140" y="910">status=COMPLETED</text>

  <!-- End success -->
  <circle class="node ok" cx="360" cy="900" r="22"/>
  <text class="lb" x="360" y="904">完成</text>
  <path class="ar" d="M140 922 L140 940 L338 940 L338 920" marker-end="url(#a)"/>

  <!-- Sidebar A: Task Lifecycle -->
  <rect class="sb" x="510" y="120" width="190" height="200"/>
  <text class="lb" x="605" y="142">📋 任务状态机</text>
  <text class="d" x="520" y="165">PENDING — 待签收</text>
  <text class="d" x="520" y="182">  ↓ claim()</text>
  <text class="d" x="520" y="199">CLAIMED — 已签收</text>
  <text class="d" x="520" y="216">  ↓ complete(APPROVE/REJECT)</text>
  <text class="d" x="520" y="233">COMPLETED — 已办结</text>
  <text class="d" x="520" y="250">REJECTED  — 已驳回</text>
  <text class="d" x="520" y="270">实例状态:</text>
  <text class="d" x="520" y="285">RUNNING · SUSPENDED</text>
  <text class="d" x="520" y="300">COMPLETED · TERMINATED</text>

  <!-- Sidebar B: Data Model -->
  <rect class="sb" x="510" y="514" width="190" height="250"/>
  <text class="lb" x="605" y="536">🗃️ 核心表结构</text>
  <text class="d" x="520" y="558">wf_definition — 流程定义</text>
  <text class="d" x="520" y="573">  · key / version / bpmn_xml</text>
  <text class="d" x="520" y="590">wf_instance — 流程实例</text>
  <text class="d" x="520" y="605">  · def_id / status / creator</text>
  <text class="d" x="520" y="620">wf_task — 审批任务</text>
  <text class="d" x="520" y="635">  · instance_id / task_key</text>
  <text class="d" x="520" y="650">  · assignee / claim_time</text>
  <text class="d" x="520" y="665">  · result / comment</text>
  <text class="d" x="520" y="685">wf_hi_task — 历史轨迹</text>
  <text class="d" x="520" y="700">  · 永久保存审批记录</text>
  <text class="d" x="520" y="715">  · 用于审计与回溯</text>

  <!-- Sidebar C: Trigger -->
  <rect class="sb" x="60" y="350" width="210" height="130"/>
  <text class="lb" x="165" y="372">⚡ 审批触发条件</text>
  <text class="d" x="70" y="395">金额 &lt; 1000 → 跳过财务</text>
  <text class="d" x="70" y="412">金额 &lt; 10000 → 跳过总经理</text>
  <text class="d" x="70" y="429">≥5万 → 必须总经理</text>
  <text class="d" x="70" y="446">超48h未审批 → 自动提醒</text>
  <text class="d" x="70" y="463">指定代理人 → 代审批</text>

  <!-- Sidebar D: Callback -->
  <rect class="sb" x="60" y="698" width="210" height="150"/>
  <text class="lb" x="165" y="720">🔗 完成后业务回调</text>
  <text class="d" x="70" y="743">① 状态更新至业务主表</text>
  <text class="d" x="70" y="760">② 发Kafka领域事件</text>
  <text class="d" x="70" y="777">  topic: wf.instance.completed</text>
  <text class="d" x="70" y="794">③ 通知申请人(站内信)</text>
  <text class="d" x="70" y="811">④ 生成审批PDF归档</text>
  <text class="d" x="70" y="828">⑤ 同步企业OA系统(可选)</text>
</svg>
