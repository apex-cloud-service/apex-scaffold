flowchart TD
    subgraph P1["① 多通道认证入口"]
        A1["用户名密码登录<br/>POST /auth/v1/login"]
        A2["短信验证码登录<br/>POST /api/auth/sms/code → /api/auth/login"]
        A3["OAuth2 授权码 PKCE S256<br/>GET /oauth2/authorize → POST /oauth2/token"]
        A4["Keycloak OIDC<br/>GET /auth/oidc/login → 回调"]
    end

    subgraph P2["② 统一令牌签发与生命周期"]
        B1["JWT 密钥管理 V26 jwt_keys<br/>PENDING→ACTIVE→ROTATING→DEPRECATED→REVOKED"]
        B2["TokenService 签发 access(2h)+refresh(7d)"]
        B3["令牌轮换与重放检测 V42<br/>token_family · previous_jti · Redis 一次性刷新"]
        B4["刷新/注销撤销<br/>POST /auth/v1/refresh · /auth/v1/logout/{userId}"]
    end

    subgraph P3["③ 安全加固链路"]
        C1["IP 访问控制 V53<br/>黑名单优先 · CIDR/通配符"]
        C2["MFA 多因素 V27<br/>TOTP/SMS/EMAIL/BACKUP"]
        C3["生物识别 V55<br/>WebAuthn · 挑战 TTL 60s"]
        C4["设备信任 V56<br/>UNTRUSTED→FULL · riskScore"]
        C5["防爆破与账号锁定<br/>login:fail:ip / username · locked_until"]
    end

    subgraph P4["④ 业务 API 过滤器"]
        D1["JwtAuthenticationFilter<br/>黑名单→验签→type=access→撤销检查→滑动续期→权限→TenantContext"]
        D2["OAuth2ResourceServerFilter<br/>/oauth2/api/** → SCOPE_* 权限"]
    end

    A1 --> B2
    A2 --> B2
    A3 --> B2
    A4 --> B2
    B1 --> B2
    B2 --> B3
    B3 --> B4
    B4 --> C1
    C1 --> C2
    C2 --> C3
    C3 --> C4
    C4 --> C5
    C5 --> D1
    D1 --> D2

