<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 1000">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #F8FAFC; }
      .subtitle { font: 16px sans-serif; fill: #94A3B8; }
      .section-title { font: bold 18px sans-serif; fill: #38BDF8; }
      .tech-name { font: bold 14px sans-serif; fill: #F8FAFC; }
      .tech-desc { font: 12px sans-serif; fill: #CBD5E1; }
      .version { font: 11px monospace; fill: #4FD1C5; }
      .layer-bg { fill: #1E293B; stroke: #334155; stroke-width: 2; }
      .tech-box { fill: #0F172A; stroke: #38BDF8; stroke-width: 1.5; }
      .highlight-box { fill: #0F172A; stroke: #F97316; stroke-width: 2; }
      .arrow { stroke: #38BDF8; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
      .data-flow { stroke: #4FD1C5; stroke-width: 2; stroke-dasharray: 5,3; fill: none; }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#38BDF8" />
    </marker>
  </defs>

  <!-- Title -->
  <text x="700" y="40" text-anchor="middle" class="title">Apex Admin Web 前端技术栈架构</text>
  <text x="700" y="65" text-anchor="middle" class="subtitle">Vue 3.5 + Vite 6 + TypeScript 5 + Pinia + Element Plus</text>

  <!-- Layer 1: 构建工具与开发环境 -->
  <rect x="50" y="100" width="1300" height="140" rx="8" class="layer-bg"/>
  <text x="70" y="125" class="section-title">构建工具与开发环境</text>
  
  <rect x="80" y="140" width="180" height="80" rx="4" class="highlight-box"/>
  <text x="170" y="165" text-anchor="middle" class="tech-name">Vite 6</text>
  <text x="170" y="185" text-anchor="middle" class="tech-desc">极速构建工具</text>
  <text x="170" y="200" text-anchor="middle" class="version">HMR &lt; 50ms</text>
  <text x="170" y="215" text-anchor="middle" class="tech-desc">ESBuild + Rollup</text>

  <rect x="280" y="140" width="180" height="80" rx="4" class="tech-box"/>
  <text x="370" y="165" text-anchor="middle" class="tech-name">TypeScript 5.x</text>
  <text x="370" y="185" text-anchor="middle" class="tech-desc">类型安全</text>
  <text x="370" y="200" text-anchor="middle" class="version">严格模式</text>
  <text x="370" y="215" text-anchor="middle" class="tech-desc">TSConfig 配置</text>

  <rect x="480" y="140" width="180" height="80" rx="4" class="tech-box"/>
  <text x="570" y="165" text-anchor="middle" class="tech-name">Node.js 18+</text>
  <text x="570" y="185" text-anchor="middle" class="tech-desc">运行时环境</text>
  <text x="570" y="200" text-anchor="middle" class="version">pnpm 8.x</text>
  <text x="570" y="215" text-anchor="middle" class="tech-desc">包管理器</text>

  <rect x="680" y="140" width="180" height="80" rx="4" class="tech-box"/>
  <text x="770" y="165" text-anchor="middle" class="tech-name">ESLint + Prettier</text>
  <text x="770" y="185" text-anchor="middle" class="tech-desc">代码规范</text>
  <text x="770" y="200" text-anchor="middle" class="version">自动格式化</text>
  <text x="770" y="215" text-anchor="middle" class="tech-desc">Lint on Save</text>

  <rect x="880" y="140" width="180" height="80" rx="4" class="tech-box"/>
  <text x="970" y="165" text-anchor="middle" class="tech-name">Husky + lint-staged</text>
  <text x="970" y="185" text-anchor="middle" class="tech-desc">Git Hooks</text>
  <text x="970" y="200" text-anchor="middle" class="version">提交前检查</text>
  <text x="970" y="215" text-anchor="middle" class="tech-desc">代码质量保证</text>

  <rect x="1080" y="140" width="250" height="80" rx="4" class="tech-box"/>
  <text x="1205" y="165" text-anchor="middle" class="tech-name">Vite Plugins</text>
  <text x="1205" y="185" text-anchor="middle" class="tech-desc">vite-plugin-vue-devtools</text>
  <text x="1205" y="200" text-anchor="middle" class="tech-desc">vite-plugin-compression</text>
  <text x="1205" y="215" text-anchor="middle" class="tech-desc">unplugin-auto-import</text>

  <!-- Layer 2: 核心框架层 -->
  <rect x="50" y="260" width="1300" height="140" rx="8" class="layer-bg"/>
  <text x="70" y="285" class="section-title">核心框架层</text>

  <rect x="80" y="300" width="250" height="80" rx="4" class="highlight-box"/>
  <text x="205" y="325" text-anchor="middle" class="tech-name">Vue 3.5</text>
  <text x="205" y="345" text-anchor="middle" class="tech-desc">渐进式框架</text>
  <text x="205" y="360" text-anchor="middle" class="version">Composition API</text>
  <text x="205" y="375" text-anchor="middle" class="tech-desc">&lt;script setup&gt; + TypeScript</text>

  <rect x="350" y="300" width="200" height="80" rx="4" class="tech-box"/>
  <text x="450" y="325" text-anchor="middle" class="tech-name">Vue Router 4</text>
  <text x="450" y="345" text-anchor="middle" class="tech-desc">路由管理</text>
  <text x="450" y="360" text-anchor="middle" class="version">动态路由</text>
  <text x="450" y="375" text-anchor="middle" class="tech-desc">权限守卫 + 路由懒加载</text>

  <rect x="570" y="300" width="200" height="80" rx="4" class="tech-box"/>
  <text x="670" y="325" text-anchor="middle" class="tech-name">Pinia 2</text>
  <text x="670" y="345" text-anchor="middle" class="tech-desc">状态管理</text>
  <text x="670" y="360" text-anchor="middle" class="version">轻量级 Vuex 替代</text>
  <text x="670" y="375" text-anchor="middle" class="tech-desc">TypeScript 友好</text>

  <rect x="790" y="300" width="250" height="80" rx="4" class="tech-box"/>
  <text x="915" y="325" text-anchor="middle" class="tech-name">Vite + HMR</text>
  <text x="915" y="345" text-anchor="middle" class="tech-desc">热模块替换</text>
  <text x="915" y="360" text-anchor="middle" class="version">开发服务器 :5173</text>
  <text x="915" y="375" text-anchor="middle" class="tech-desc">ESM 原生支持</text>

  <rect x="1060" y="300" width="270" height="80" rx="4" class="tech-box"/>
  <text x="1195" y="325" text-anchor="middle" class="tech-name">Vue Devtools</text>
  <text x="1195" y="345" text-anchor="middle" class="tech-desc">开发调试工具</text>
  <text x="1195" y="360" text-anchor="middle" class="version">组件树 + Pinia + Router</text>
  <text x="1195" y="375" text-anchor="middle" class="tech-desc">性能分析 + 时间旅行</text>

  <!-- Layer 3: UI组件库与样式 -->
  <rect x="50" y="420" width="1300" height="140" rx="8" class="layer-bg"/>
  <text x="70" y="445" class="section-title">UI组件库与样式</text>

  <rect x="80" y="460" width="280" height="80" rx="4" class="highlight-box"/>
  <text x="220" y="485" text-anchor="middle" class="tech-name">Element Plus 2.x</text>
  <text x="220" y="505" text-anchor="middle" class="tech-desc">企业级组件库</text>
  <text x="220" y="520" text-anchor="middle" class="version">60+ 组件</text>
  <text x="220" y="535" text-anchor="middle" class="tech-desc">Table + Form + Dialog + 树形</text>

  <rect x="380" y="460" width="200" height="80" rx="4" class="tech-box"/>
  <text x="480" y="485" text-anchor="middle" class="tech-name">Sass/SCSS</text>
  <text x="480" y="505" text-anchor="middle" class="tech-desc">CSS 预处理器</text>
  <text x="480" y="520" text-anchor="middle" class="version">变量 + 混入</text>
  <text x="480" y="535" text-anchor="middle" class="tech-desc">主题定制</text>

  <rect x="600" y="460" width="200" height="80" rx="4" class="tech-box"/>
  <text x="700" y="485" text-anchor="middle" class="tech-name">ECharts 5</text>
  <text x="700" y="505" text-anchor="middle" class="tech-desc">数据可视化</text>
  <text x="700" y="520" text-anchor="middle" class="version">图表库</text>
  <text x="700" y="535" text-anchor="middle" class="tech-desc">柱状图 + 折线图 + 饼图</text>

  <rect x="820" y="460" width="230" height="80" rx="4" class="tech-box"/>
  <text x="935" y="485" text-anchor="middle" class="tech-name">@vueuse/core</text>
  <text x="935" y="505" text-anchor="middle" class="tech-desc">组合式工具库</text>
  <text x="935" y="520" text-anchor="middle" class="version">200+ Hooks</text>
  <text x="935" y="535" text-anchor="middle" class="tech-desc">useRequest + useDebounce</text>

  <rect x="1070" y="460" width="260" height="80" rx="4" class="tech-box"/>
  <text x="1200" y="485" text-anchor="middle" class="tech-name">@iconify/vue</text>
  <text x="1200" y="505" text-anchor="middle" class="tech-desc">图标库</text>
  <text x="1200" y="520" text-anchor="middle" class="version">10万+ 图标</text>
  <text x="1200" y="535" text-anchor="middle" class="tech-desc">EP Icons + Lucide</text>

  <!-- Layer 4: 数据请求与工具 -->
  <rect x="50" y="580" width="1300" height="140" rx="8" class="layer-bg"/>
  <text x="70" y="605" class="section-title">数据请求与工具</text>

  <rect x="80" y="620" width="220" height="80" rx="4" class="highlight-box"/>
  <text x="190" y="645" text-anchor="middle" class="tech-name">Axios 1.x</text>
  <text x="190" y="665" text-anchor="middle" class="tech-desc">HTTP 客户端</text>
  <text x="190" y="680" text-anchor="middle" class="version">请求拦截器</text>
  <text x="190" y="695" text-anchor="middle" class="tech-desc">Token 注入 + 错误处理</text>

  <rect x="320" y="620" width="200" height="80" rx="4" class="tech-box"/>
  <text x="420" y="645" text-anchor="middle" class="tech-name">Day.js</text>
  <text x="420" y="665" text-anchor="middle" class="tech-desc">日期处理</text>
  <text x="420" y="680" text-anchor="middle" class="version">2KB 轻量级</text>
  <text x="420" y="695" text-anchor="middle" class="tech-desc">Moment.js 替代</text>

  <rect x="540" y="620" width="200" height="80" rx="4" class="tech-box"/>
  <text x="640" y="645" text-anchor="middle" class="tech-name">js-cookie</text>
  <text x="640" y="665" text-anchor="middle" class="tech-desc">Cookie 管理</text>
  <text x="640" y="680" text-anchor="middle" class="version">Token 存储</text>
  <text x="640" y="695" text-anchor="middle" class="tech-desc">会话管理</text>

  <rect x="760" y="620" width="200" height="80" rx="4" class="tech-box"/>
  <text x="860" y="645" text-anchor="middle" class="tech-name">NProgress</text>
  <text x="860" y="665" text-anchor="middle" class="tech-desc">进度条</text>
  <text x="860" y="680" text-anchor="middle" class="version">路由切换</text>
  <text x="860" y="695" text-anchor="middle" class="tech-desc">用户体验优化</text>

  <rect x="980" y="620" width="170" height="80" rx="4" class="tech-box"/>
  <text x="1065" y="645" text-anchor="middle" class="tech-name">Lodash-es</text>
  <text x="1065" y="665" text-anchor="middle" class="tech-desc">工具库</text>
  <text x="1065" y="680" text-anchor="middle" class="version">ESM 版本</text>
  <text x="1065" y="695" text-anchor="middle" class="tech-desc">Tree-shaking</text>

  <rect x="1170" y="620" width="160" height="80" rx="4" class="tech-box"/>
  <text x="1250" y="645" text-anchor="middle" class="tech-name">crypto-js</text>
  <text x="1250" y="665" text-anchor="middle" class="tech-desc">加密库</text>
  <text x="1250" y="680" text-anchor="middle" class="version">AES/MD5</text>
  <text x="1250" y="695" text-anchor="middle" class="tech-desc">密码加密</text>

  <!-- Layer 5: 功能模块与服务 -->
  <rect x="50" y="740" width="1300" height="120" rx="8" class="layer-bg"/>
  <text x="70" y="765" class="section-title">功能模块与服务</text>

  <rect x="80" y="780" width="180" height="60" rx="4" class="tech-box"/>
  <text x="170" y="800" text-anchor="middle" class="tech-name">认证授权模块</text>
  <text x="170" y="815" text-anchor="middle" class="tech-desc">登录 + JWT Token</text>
  <text x="170" y="830" text-anchor="middle" class="tech-desc">权限指令 v-permission</text>

  <rect x="280" y="780" width="180" height="60" rx="4" class="tech-box"/>
  <text x="370" y="800" text-anchor="middle" class="tech-name">系统管理模块</text>
  <text x="370" y="815" text-anchor="middle" class="tech-desc">用户/角色/菜单</text>
  <text x="370" y="830" text-anchor="middle" class="tech-desc">部门/字典/配置</text>

  <rect x="480" y="780" width="180" height="60" rx="4" class="tech-box"/>
  <text x="570" y="800" text-anchor="middle" class="tech-name">监控审计模块</text>
  <text x="570" y="815" text-anchor="middle" class="tech-desc">登录日志</text>
  <text x="570" y="830" text-anchor="middle" class="tech-desc">操作日志/在线用户</text>

  <rect x="680" y="780" width="180" height="60" rx="4" class="tech-box"/>
  <text x="770" y="800" text-anchor="middle" class="tech-name">工作流模块</text>
  <text x="770" y="815" text-anchor="middle" class="tech-desc">流程设计器</text>
  <text x="770" y="830" text-anchor="middle" class="tech-desc">任务审批/流程监控</text>

  <rect x="880" y="780" width="180" height="60" rx="4" class="tech-box"/>
  <text x="970" y="800" text-anchor="middle" class="tech-name">代码生成模块</text>
  <text x="970" y="815" text-anchor="middle" class="tech-desc">CRUD 自动生成</text>
  <text x="970" y="830" text-anchor="middle" class="tech-desc">Vue + API + Store</text>

  <rect x="1080" y="780" width="250" height="60" rx="4" class="tech-box"/>
  <text x="1205" y="800" text-anchor="middle" class="tech-name">文件管理模块</text>
  <text x="1205" y="815" text-anchor="middle" class="tech-desc">文件上传/预览/下载</text>
  <text x="1205" y="830" text-anchor="middle" class="tech-desc">MinIO 集成</text>

  <!-- Data Flow Arrows -->
  <path d="M 170 220 L 170 300" class="arrow"/>
  <path d="M 370 220 L 370 300" class="arrow"/>
  <path d="M 205 380 L 205 460" class="arrow"/>
  <path d="M 450 380 L 450 460" class="arrow"/>
  <path d="M 670 380 L 670 460" class="arrow"/>
  <path d="M 220 540 L 220 620" class="arrow"/>
  <path d="M 190 700 L 190 780" class="arrow"/>

  <!-- Legend -->
  <rect x="50" y="880" width="1300" height="100" rx="8" class="layer-bg"/>
  <text x="70" y="905" class="section-title">技术统计</text>
  
  <text x="80" y="930" class="tech-desc">• 核心依赖: 30+ npm packages</text>
  <text x="80" y="950" class="tech-desc">• 构建产物: dist/ (Gzip压缩后 &lt; 500KB)</text>
  <text x="80" y="970" class="tech-desc">• 开发服务器: http://localhost:5173 (HMR &lt; 50ms)</text>
  
  <text x="500" y="930" class="tech-desc">• 代码规范: ESLint + Prettier + TypeScript Strict</text>
  <text x="500" y="950" class="tech-desc">• 浏览器支持: Chrome 90+, Edge 90+, Firefox 88+, Safari 14+</text>
  <text x="500" y="970" class="tech-desc">• 打包优化: Tree-shaking + Code-splitting + Lazy-loading</text>

  <text x="1050" y="930" class="tech-desc">• 响应式设计: PC端 1920x1080 优先</text>
  <text x="1050" y="950" class="tech-desc">• 状态持久化: Pinia + LocalStorage</text>
  <text x="1050" y="970" class="tech-desc">• 路由模式: Hash (#/) 或 History (/)</text>

</svg>