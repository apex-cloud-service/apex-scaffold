%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#ecfdf5','primaryTextColor':'#0f172a','primaryBorderColor':'#059669','lineColor':'#64748b','fontFamily':'sans-serif'}}}%%
classDiagram
    direction TB

    class OfficePlatformApp {
        «aggregate root · 平台应用配置»
        - Long id
        - String tenantId
        - OfficePlatform platform
        - String appId
        - String secretReference
        - String redirectUri
        - String signingSecretReference
        - String capabilities
        - boolean enabled
        - Integer version
        - Integer deleted
    }
    note for OfficePlatformApp "@Value 不可变\n仅存 secret 引用名，不落库密钥\n每租户-平台唯一启用配置"

    class OfficePlatform {
        «enumeration»
        FEISHU
        DINGTALK
        WECOM
    }

    class OfficeMessage {
        «aggregate root · 办公消息 @Data»
        - Long id
        - String tenantId
        - OfficePlatform platform
        - MessageType messageType
        - MessageTarget target
        - MessageContent content
        - String sendStatus
        - String platformMessageId
        - String failureReason
        - Integer retryCount
        - LocalDateTime createdAt / sentAt
        - Integer version
        + canSend() boolean
        + markAsSent(platformMessageId)
        + markAsFailed(reason)
        + canRecall() boolean
        + markAsRecalled()
    }
    note for OfficeMessage "sendStatus: PENDING/SUCCESS/FAILED/RECALLED\n支持文本/Markdown/卡片消息\nState 防重放: Redis setIfAbsent 原子签发"

    class MessageContent {
        «interface · 消息内容»
        + getType() MessageType
        + getText() String
        + isValid() boolean
        + toPlatformContent() Object
    }
    class TextMessageContent
    class MarkdownMessageContent
    class CardMessageContent

    class MessageType {
        «enumeration»
        TEXT
        MARKDOWN
        CARD
    }

    class MessageTarget {
        «value object · 收件目标»
        - RecipientType recipientType
        - List~String~ recipientIds
    }

    class MessageStatus {
        «enumeration»
        PENDING
        SUCCESS
        FAILED
        RECALLED
    }

    class ApprovalProcess {
        «aggregate root · 审批流程 @Data»
        - Long id
        - Long tenantId
        - String platform
        - String platformInstanceId
        - String processInstanceId
        - String templateId
        - String title
        - String initiatorId / initiatorName
        - ApprovalStatus status
        - String formData
        - List~ApprovalRecord~ records
        - String currentApproverIds
        - LocalDateTime initiateTime
        + isCompleted() boolean
        + isCancellable() boolean
        + updateStatus(newStatus)
        + addRecord(record)
    }
    note for ApprovalProcess "ApprovalStatus: PENDING/IN_PROGRESS/APPROVED/REJECTED/CANCELLED/TRANSFERRED"

    class ApprovalRecord {
        «value object · 审批记录»
        - String approverId / approverName
        - ApprovalAction action
        - String comment
        - LocalDateTime approvalTime
        - Boolean isCurrent
        - Integer nodeOrder
    }

    class ApprovalStatus {
        «enumeration»
        PENDING
        IN_PROGRESS
        APPROVED
        REJECTED
        CANCELLED
        TRANSFERRED
    }

    class CalendarEvent {
        «aggregate root · 日历事件 @Data»
        - Long id
        - Long tenantId
        - String platform
        - String platformEventId
        - String title
        - String description
        - CalendarEventType eventType
        - String organizerId / organizerName
        - LocalDateTime startTime / endTime
        + cancel() / confirm()
        + updateTime(start, end)
        + isTimeRangeValid() boolean
    }

    class DocumentInfo {
        «aggregate root · 文档信息 @Data»
        - Long id
        - Long tenantId
        - String platform
        - String platformDocumentId
        - DocumentType documentType
        - String permission
        - String collaboratorIds
        - Boolean isArchived
        + archive() / unarchive()
        + updateTitle(newTitle)
        + updatePermission(permission)
    }

    class MessagePort {
        «outbound port · 消息端口»
        + sendMessage(target, content) Mono~String~
        + queryMessageStatus(messageId) Mono~String~
        + recallMessage(messageId) Mono~Boolean~
    }

    class ApprovalPort {
        «outbound port · 审批端口»
        + createApproval(...) Mono~String~
        + getApprovalStatus(id) Mono~String~
        + approveProcess(id, approverId, action, comment) Mono~Boolean~
        + cancelApproval(id, initiatorId) Mono~Boolean~
        + getApprovalDetail(id) Mono~Map~
    }

    class CalendarPort {
        «outbound port · 日历端口»
        + createEvent(...) Mono~String~
        + getEventDetail(id) Mono~Map~
        + updateEvent(...) Mono~Boolean~
        + cancelEvent(id, organizerId) Mono~Boolean~
        + deleteEvent(id, organizerId) Mono~Boolean~
        + listEvents(userId, start, end) Mono~List~
    }

    class DocumentPort {
        «outbound port · 文档端口»
        + createDocument(folderId, title, type) Mono~String~
        + getDocumentDetail(id) Mono~Map~
        + updateDocumentTitle(id, newTitle) Mono~Boolean~
        + moveDocument(id, targetFolderId) Mono~Boolean~
        + copyDocument(id, targetFolderId, newTitle) Mono~String~
        + deleteDocument(id) Mono~Boolean~
    }

    class AbstractOfficeClient {
        «abstract · 统一 OAuth 基类»
        + getAccessToken() Mono~String~
        + refreshAccessToken() Mono~String~
    }
    note for AbstractOfficeClient "各平台子类覆盖业务方法\n统一使用 WebClient 原生异步\n不引入阻塞调度池\nfeishu/dingtalk/wecom 三个实现"

    OfficeMessage *-- MessageContent : content 组合
    OfficeMessage *-- MessageTarget : target 组合
    ApprovalProcess o-- ApprovalRecord : records 聚合
    ApprovalProcess *-- ApprovalStatus : 状态机
    OfficePlatformApp ..> OfficePlatform : «use» 平台枚举
    MessageContent <|.. TextMessageContent : 实现
    MessageContent <|.. MarkdownMessageContent : 实现
    MessageContent <|.. CardMessageContent : 实现

    MessagePort <|.. AbstractOfficeClient : 实现
    ApprovalPort <|.. AbstractOfficeClient : 实现
    CalendarPort <|.. AbstractOfficeClient : 实现
    DocumentPort <|.. AbstractOfficeClient : 实现

    OfficeMessage ..> MessagePort : «use» 发送/查询/撤回
    ApprovalProcess ..> ApprovalPort : «use» 创建/审批/取消
    CalendarEvent ..> CalendarPort : «use» 创建/更新/取消
    DocumentInfo ..> DocumentPort : «use» 创建/移动/删除
