%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#eff6ff','primaryTextColor':'#0f172a','primaryBorderColor':'#3b82f6','lineColor':'#64748b','fontFamily':'sans-serif'}}}%%
erDiagram
    FILE_RECORD ||--o{ FILE_CHUNK : "file_id 分片"
    FILE_RECORD ||--o{ FILE_SHARE : "file_id 分享"
    FILE_DOCUMENT ||--o{ FILE_DOCUMENT : "独立聚合"

    FILE_RECORD {
        bigint id PK "主键 雪花"
        varchar tenant_id "租户 ID"
        varchar storage_type "MINIO/VOLCENGINE/LOCAL/OSS/QINIU"
        int total_chunks "总分片数"
        bigint chunk_size "分片大小(字节)"
        varchar file_name "存储文件名"
        varchar original_name "原始文件名"
        varchar file_path "存储路径"
        varchar file_url "访问 URL"
        bigint file_size "文件大小"
        varchar file_type "文件类型"
        varchar content_type "MIME 类型"
        varchar bucket_name "存储桶"
        varchar md5 "MD5 秒传去重"
        varchar sha256 "SHA-256 完整性"
        bigint user_id "上传用户"
        varchar business_type "GENERIC/VOTE_PHOTO"
        varchar storage_status "STORED/ORPHANED/DELETED"
        datetime create_time "创建时间"
        datetime update_time "更新时间"
        int version "乐观锁"
        tinyint deleted "逻辑删除"
    }

    FILE_CHUNK {
        bigint id PK "主键 雪花"
        varchar tenant_id "租户 ID"
        bigint file_id FK "关联 file_record.id"
        varchar storage_type "存储类型"
        int chunk_index "分片序号(从0)"
        bigint chunk_size "分片大小"
        int total_chunks "总分片数"
        varchar md5 "分片 MD5"
        varchar object_name "对象存储键"
        varchar bucket_name "存储桶"
        varchar storage_status "STORED/ORPHANED"
        bigint user_id "上传用户"
        datetime create_time "创建时间"
        int version "乐观锁"
        tinyint deleted "逻辑删除"
    }

    FILE_SHARE {
        bigint id PK "主键 雪花"
        bigint file_id FK "关联 file_record.id"
        varchar tenant_id "租户 ID"
        bigint creator_id "创建者 ID"
        varchar token_hash "SHA-256(token) 不存明文"
        datetime expire_at "过期时间"
        varchar status "ACTIVE/REVOKED"
        datetime create_time "创建时间"
        datetime update_time "更新时间"
        int version "乐观锁"
        tinyint deleted "逻辑删除"
    }

    FILE_DOCUMENT {
        bigint id PK "主键 AUTO"
        varchar title "标题"
        varchar doc_type "文档类型"
        varchar category "分类"
        text content "内容"
        varchar file_url "附件 URL"
        bigint file_size "附件大小"
        bigint author_id "作者 ID"
        varchar author_name "作者名"
        int status "DRAFT/NORMAL/ARCHIVED"
        json tags "标签列表"
        int view_count "浏览数"
        int download_count "下载数"
        varchar tenant_id "租户 ID"
        datetime create_time "创建时间"
        datetime update_time "更新时间"
        int version "乐观锁"
        tinyint deleted "逻辑删除"
    }

    FILE_CHART {
        bigint id PK "主键 AUTO"
        varchar chart_name "图表名称"
        varchar chart_type "LINE/BAR/PIE/SCATTER/RADAR"
        varchar category "分类"
        varchar description "描述"
        varchar data_source "数据源"
        json config "ECharts JSON 配置"
        int status "DRAFT/NORMAL"
        bigint creator_id "创建者 ID"
        varchar creator_name "创建者名"
        int view_count "浏览数"
        varchar tenant_id "租户 ID"
        datetime create_time "创建时间"
        datetime update_time "更新时间"
        int version "乐观锁"
        tinyint deleted "逻辑删除"
    }
