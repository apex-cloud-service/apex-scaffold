flowchart TB
    ROOT["模块结构：apex-common<br/>com.apex.scaffold.common · 通用基础能力 · 无启动入口 · 被 27 个模块直接依赖 · v1.3.1"]

    subgraph PKG["包结构（com.apex.scaffold.common.*）"]
        direction TB
        P1["dto / result / context / enums"]
        P2["exception / error / constant"]
        P3["util / util.ratelimit / util.ratelimit.algorithm"]
        P4["util.id / id"]
        P5["config / security / annotation"]
        P6["scheduler / state / event"]
        P7["audit / masking / openapi"]
        P8["persistence / persistence.util / persistence.po"]
        P9["governance / capability / internal"]
        P10["autoconfigure（InternalAuth/Jwks/OpenApiGuard/OperationAudit）"]
        P1 --> P2 --> P3 --> P4 --> P5 --> P6 --> P7 --> P8 --> P9 --> P10
    end

    subgraph CAP["核心能力域"]
        direction LR
        C1["统一模型<br/>dto / result / enums<br/>exception / error<br/>Result&lt;T&gt; · ResultCode<br/>BusinessException · PageResponse"]
        C2["上下文 / 安全<br/>context / security<br/>annotation<br/>TenantContext · DataScopeContext<br/>@DataScope · @IdempotentApi · @OperationLog"]
        C3["限流算法<br/>util.ratelimit.algorithm<br/>util.id / id<br/>TokenBucket · LeakyBucket<br/>SlidingWindow · Snowflake"]
        C4["事件 / 状态机 / 治理<br/>event / state / governance<br/>scheduler / capability<br/>DomainEvent 基类 · EventChannel<br/>StateTransitionMachine · BlockingIoSchedulers"]
        C1 --- C2 --- C3 --- C4
    end

    subgraph SUP["通用支撑组件"]
        direction LR
        S1["persistence<br/>持久化基类与工具<br/>persistence.util / persistence.po<br/>多租户 / 数据权限 SQL 注入支持<br/>字段自动填充（审计字段）"]
        S2["audit<br/>审计日志抽象与切面<br/>SecurityAuditService · AuditLogService<br/>ReactiveOperationLogAspect<br/>配合 @OperationLog 操作日志"]
        S3["masking / openapi<br/>脱敏序列化与 OpenAPI 门卫<br/>DataMaskSerializer · JsonFieldMasker<br/>OpenApiCapabilityGuardFilter<br/>配合 @DataMask / capability 门控"]
        S1 --- S2 --- S3
    end

    subgraph RULE["设计约束 · 职责定位"]
        direction TB
        R0["职责定位：跨模块复用的通用能力，零业务耦合"]
        R1["1. 无业务语义：不得出现 User/Role/Workflow 等领域概念，保证可被所有层安全引用。"]
        R2["2. 仅引入 WebFlux 响应式栈（compile scope），不引入 Servlet web-starter。"]
        R3["3. 限流算法为纯函数式实现，可被本地限流与 Sentinel 自适应策略共同复用。"]
        R4["4. 上下文使用 ThreadLocal + Reactor Context 双通道，兼容 WebFlux 异步链路。"]
        R5["5. 事件契约作为领域与基础设施的解耦边界，不含具体实现。"]
        R6["依赖：仅依赖 Spring 基础 / 工具库（无内部模块）；被 27 个模块直接依赖；license-tools/兼容 infrastructure/job-service 仅传递依赖"]
        R7["典型引用方：apex-domain · 五个 infrastructure 能力 JAR · 六个业务库（system/auth/workflow/file/office/integration）<br/>apex-api-contract · 各 service 运行模块 · license/storage/job/seata starter"]
        R0 --> R1 --> R2 --> R3 --> R4 --> R5 --> R6 --> R7
    end

    NOTE["apex-common 是全局依赖根（L0），承载通用能力/上下文/限流算法/持久化与事件契约<br/>无直接依赖的内部模块：license-tools · 兼容 infrastructure · job-service · generator · tools-deployment · tools-build"]

