<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 700" width="900" height="700">
  <defs>
    <style>
      .title { font: 700 20px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .subtitle { font: 12px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
      .zone-title { font: 600 14px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: start; }
      .node { fill: #ffffff; stroke-width: 2; rx: 8; }
      .node-normal { stroke: #059669; }
      .node-warn { stroke: #d97706; }
      .node-error { stroke: #dc2626; }
      .node-action { stroke: #4f46e5; }
      .label { font: 500 13px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .desc { font: 11px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
      .time { font: 10px system-ui, -apple-system, sans-serif; fill: #d97706; text-anchor: middle; }
      .arrow { stroke: #64748b; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
      .arrow-error { stroke: #dc2626; stroke-width: 2; fill: none; marker-end: url(#arrowhead-error); }
      .zone { fill: #f8fafc; stroke: #e2e8f0; stroke-width: 1; stroke-dasharray: 4 2; rx: 8; }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#64748b" />
    </marker>
    <marker id="arrowhead-error" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#dc2626" />
    </marker>
  </defs>

  <!-- Title -->
  <text class="title" x="450" y="30">容灾切换与故障恢复流程图</text>
  <text class="subtitle" x="450" y="50">RTO &lt; 5min · RPO &lt; 1min · 自动切换 + 手动降级 · 多级容灾</text>

  <!-- Zone: Normal Operation -->
  <rect class="zone" x="20" y="70" width="860" height="100"/>
  <text class="zone-title" x="30" y="90">🟢 正常运行状态</text>
  
  <rect class="node node-normal" x="50" y="100" width="120" height="50"/>
  <text class="label" x="110" y="120">主库 (Master)</text>
  <text class="desc" x="110" y="138">MySQL 8.0 主实例</text>

  <rect class="node node-normal" x="200" y="100" width="120" height="50"/>
  <text class="label" x="260" y="120">从库 (Slave)</text>
  <text class="desc" x="260" y="138">实时同步 (&lt; 1s)</text>

  <rect class="node node-normal" x="350" y="100" width="140" height="50"/>
  <text class="label" x="420" y="120">应用实例 #1-3</text>
  <text class="desc" x="420" y="138">K8s Pod × 3</text>

  <rect class="node node-normal" x="520" y="100" width="120" height="50"/>
  <text class="label" x="580" y="120">Redis Sentinel</text>
  <text class="desc" x="580" y="138">哨兵监控</text>

  <rect class="node node-normal" x="670" y="100" width="120" height="50"/>
  <text class="label" x="730" y="120">备份存储</text>
  <text class="desc" x="730" y="138">每日全量 + 实时增量</text>

  <!-- Zone: Failure Detection -->
  <rect class="zone" x="20" y="190" width="860" height="120"/>
  <text class="zone-title" x="30" y="210">🔴 故障检测阶段 (&lt; 30s)</text>

  <rect class="node node-error" x="50" y="220" width="140" height="60"/>
  <text class="label" x="120" y="242">1. 主库故障</text>
  <text class="desc" x="120" y="258">连接超时</text>
  <text class="desc" x="120" y="272">健康检查失败</text>

  <rect class="node node-warn" x="220" y="220" width="140" height="60"/>
  <text class="label" x="290" y="242">2. Sentinel 检测</text>
  <text class="desc" x="290" y="258">连续 3 次心跳失败</text>
  <text class="time" x="290" y="272">检测时间: 15s</text>

  <rect class="node node-warn" x="390" y="220" width="140" height="60"/>
  <text class="label" x="460" y="242">3. 集群投票</text>
  <text class="desc" x="460" y="258">Sentinel 多数派确认</text>
  <text class="time" x="460" y="272">投票时间: 10s</text>

  <rect class="node node-action" x="560" y="220" width="140" height="60"/>
  <text class="label" x="630" y="242">4. 触发告警</text>
  <text class="desc" x="630" y="258">飞书/邮件/短信</text>
  <text class="desc" x="630" y="272">Prometheus Alert</text>

  <!-- Zone: Automatic Failover -->
  <rect class="zone" x="20" y="330" width="860" height="160"/>
  <text class="zone-title" x="30" y="350">⚡ 自动切换阶段 (&lt; 2min)</text>

  <rect class="node node-action" x="50" y="360" width="130" height="60"/>
  <text class="label" x="115" y="382">5. 从库提升</text>
  <text class="desc" x="115" y="398">Slave → Master</text>
  <text class="time" x="115" y="412">切换时间: 30s</text>

  <rect class="node node-action" x="210" y="360" width="130" height="60"/>
  <text class="label" x="275" y="382">6. 配置更新</text>
  <text class="desc" x="275" y="398">更新 DNS/VIP</text>
  <text class="time" x="275" y="412">生效时间: 10s</text>

  <rect class="node node-action" x="370" y="360" width="130" height="60"/>
  <text class="label" x="435" y="382">7. 应用重连</text>
  <text class="desc" x="435" y="398">连接池刷新</text>
  <text class="time" x="435" y="412">重连时间: 5s</text>

  <rect class="node node-action" x="530" y="360" width="130" height="60"/>
  <text class="label" x="595" y="382">8. 数据校验</text>
  <text class="desc" x="595" y="398">一致性检查</text>
  <text class="time" x="595" y="412">校验时间: 30s</text>

  <rect class="node node-normal" x="690" y="360" width="130" height="60"/>
  <text class="label" x="755" y="382">✓ 服务恢复</text>
  <text class="desc" x="755" y="398">RTO 达成</text>
  <text class="time" x="755" y="412">总计: &lt; 2min</text>

  <!-- Manual Intervention -->
  <rect class="node node-warn" x="50" y="440" width="180" height="40"/>
  <text class="label" x="140" y="458">人工介入点 (可选)</text>
  <text class="desc" x="140" y="472">手动确认/强制切换</text>

  <!-- Zone: Recovery & Verification -->
  <rect class="zone" x="20" y="510" width="860" height="110"/>
  <text class="zone-title" x="30" y="530">🔧 恢复与验证阶段</text>

  <rect class="node node-action" x="50" y="540" width="130" height="60"/>
  <text class="label" x="115" y="562">9. 旧主修复</text>
  <text class="desc" x="115" y="578">问题诊断</text>
  <text class="desc" x="115" y="592">数据恢复</text>

  <rect class="node node-action" x="210" y="540" width="130" height="60"/>
  <text class="label" x="275" y="562">10. 同步追赶</text>
  <text class="desc" x="275" y="578">binlog 追赶</text>
  <text class="desc" x="275" y="592">数据一致性</text>

  <rect class="node node-action" x="370" y="540" width="130" height="60"/>
  <text class="label" x="435" y="562">11. 角色降级</text>
  <text class="desc" x="435" y="578">旧主 → 从库</text>
  <text class="desc" x="435" y="592">重新加入集群</text>

  <rect class="node node-action" x="530" y="540" width="130" height="60"/>
  <text class="label" x="595" y="562">12. 压测验证</text>
  <text class="desc" x="595" y="578">性能测试</text>
  <text class="desc" x="595" y="592">稳定性观察</text>

  <rect class="node node-normal" x="690" y="540" width="130" height="60"/>
  <text class="label" x="755" y="562">✓ 架构恢复</text>
  <text class="desc" x="755" y="578">主从拓扑</text>
  <text class="desc" x="755" y="592">完全恢复</text>

  <!-- Arrows: Normal to Detection -->
  <path class="arrow-error" d="M 110 150 L 110 220"/>
  <path class="arrow" d="M 190 250 L 220 250"/>
  <path class="arrow" d="M 360 250 L 390 250"/>
  <path class="arrow" d="M 530 250 L 560 250"/>

  <!-- Arrows: Detection to Failover -->
  <path class="arrow" d="M 120 280 L 115 360"/>
  <path class="arrow" d="M 180 390 L 210 390"/>
  <path class="arrow" d="M 340 390 L 370 390"/>
  <path class="arrow" d="M 500 390 L 530 390"/>
  <path class="arrow" d="M 660 390 L 690 390"/>

  <!-- Arrows: Failover to Recovery -->
  <path class="arrow" d="M 115 420 L 115 540"/>
  <path class="arrow" d="M 180 570 L 210 570"/>
  <path class="arrow" d="M 340 570 L 370 570"/>
  <path class="arrow" d="M 500 570 L 530 570"/>
  <path class="arrow" d="M 660 570 L 690 570"/>

  <!-- Notes -->
  <text class="desc" x="450" y="690" text-anchor="middle" fill="#d97706">
    💡 RTO (Recovery Time Objective) &lt; 5min | RPO (Recovery Point Objective) &lt; 1min | 数据丢失 &lt; 60s
  </text>
</svg>