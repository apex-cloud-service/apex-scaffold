<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 780" width="700" height="780">
  <defs>
    <style>
      .s { font:12px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .node { fill:#ffffff; stroke-width:2; rx:6; }
      .fe { stroke:#ec4899; }
      .gw { stroke:#4f46e5; }
      .sv { stroke:#0891b2; }
      .st { stroke:#059669; }
      .wr { stroke:#d97706; }
      .er { stroke:#dc2626; }
      .dia { fill:#ffffff; stroke:#d97706; stroke-width:2; }
      .lb { font:500 13px system-ui, -apple-system, sans-serif; fill:#0f172a; text-anchor:middle; }
      .d { font:11px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .ar { fill:none; stroke:#64748b; stroke-width:2; }
      .al { font:11px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .sb { fill:#f8fafc; stroke:#e2e8f0; stroke-width:1; stroke-dasharray:3 3; rx:6; }
    </style>
    <marker id="a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M1 1 L7 4 L1 7 Z" fill="#64748b"/></marker>
  </defs>

  <text class="t" x="350" y="28">文件上传业务流程图</text>
  <text class="s" x="350" y="48">分片上传 + 秒传 + MinIO 对象存储 · 支持断点续传 · 租户级配额校验</text>

  <!-- Swimlanes -->
  <line x1="230" y1="60" x2="230" y2="760" stroke="#e2e8f0" stroke-dasharray="3 3"/>
  <line x1="480" y1="60" x2="480" y2="760" stroke="#e2e8f0" stroke-dasharray="3 3"/>
  <text class="lb" x="30" y="78" style="text-anchor:start;font:600 13px system-ui, -apple-system, sans-serif">👤 客户端</text>
  <text class="lb" x="250" y="78" style="text-anchor:start;font:600 13px system-ui, -apple-system, sans-serif">🌐 网关+服务层</text>
  <text class="lb" x="500" y="78" style="text-anchor:start;font:600 13px system-ui, -apple-system, sans-serif">💾 存储/DB</text>

  <!-- Step 1 Select file -->
  <rect class="node fe" x="30" y="95" width="170" height="54"/>
  <text class="lb" x="115" y="117">1. 选择文件</text>
  <text class="d" x="115" y="133">前端校验: type/size</text>
  <text class="d" x="115" y="145">图片&lt;20MB · 文档&lt;100MB</text>

  <!-- Step 2 Chunk -->
  <rect class="node fe" x="30" y="170" width="170" height="54"/>
  <text class="lb" x="115" y="192">2. 分片计算</text>
  <text class="d" x="115" y="208">文件MD5 + SHA256</text>
  <text class="d" x="115" y="220">chunk_size = 5MB</text>
  <path class="ar" d="M115 149 L115 170" marker-end="url(#a)"/>

  <!-- Step 3: quick upload request -->
  <rect class="node gw" x="250" y="95" width="210" height="54"/>
  <text class="lb" x="355" y="117">Gateway → 路由鉴权</text>
  <text class="d" x="355" y="133">JWT校验 · 限流 · CORS</text>
  <text class="d" x="355" y="145">POST /admin-api/v1/storage/**</text>
  <path class="ar" d="M200 122 L250 122" marker-end="url(#a)"/>

  <rect class="node sv" x="250" y="170" width="210" height="54"/>
  <text class="lb" x="355" y="192">3. 请求秒传接口</text>
  <text class="d" x="355" y="208">POST /storage/check</text>
  <text class="d" x="355" y="220">{ md5, size, suffix }</text>
  <path class="ar" d="M200 197 L250 197" marker-end="url(#a)"/>

  <!-- Decision MD5 exists? -->
  <path class="dia d" d="M355 240 L415 280 L355 320 L295 280 Z" fill="#ffffff" stroke="#d97706" stroke-width="2"/>
  <text class="lb" x="355" y="285">命中秒传?</text>
  <path class="ar" d="M355 224 L355 240" marker-end="url(#a)"/>

  <!-- Yes: Direct return -->
  <path class="ar" d="M295 280 L245 280 L245 297" marker-end="url(#a)"/>
  <text class="al" x="255" y="272">是</text>
  <rect class="node st" x="30" y="280" width="170" height="54"/>
  <text class="lb" x="115" y="302">⏩ 秒传成功</text>
  <text class="d" x="115" y="318">直接拿到访问URL</text>
  <text class="d" x="115" y="330">无需再传分片</text>
  <path class="ar" d="M200 307 L200 280" marker-end="url(#a)"/>

  <!-- No: Continue -->
  <path class="ar" d="M355 320 L355 344" marker-end="url(#a)"/>
  <text class="al" x="340" y="334">否</text>

  <!-- Step 4: Quota check -->
  <rect class="node sv" x="250" y="344" width="210" height="54"/>
  <text class="lb" x="355" y="366">4. 配额校验</text>
  <text class="d" x="355" y="382">租户已用空间 + 当前文件 ≤ 限额</text>
  <path class="ar" d="M460 366 L480 366 L480 380 L520 380" marker-end="url(#a)"/>
  <rect class="node st" x="500" y="355" width="180" height="54"/>
  <text class="lb" x="590" y="377">sys_tenant.storage_quota</text>
  <text class="d" x="590" y="393">used字段实时累加</text>

  <!-- Step 5: Allocate -->
  <path class="ar" d="M355 398 L355 420" marker-end="url(#a)"/>
  <rect class="node sv" x="250" y="420" width="210" height="54"/>
  <text class="lb" x="355" y="442">5. 存储分配</text>
  <text class="d" x="355" y="458">按storage_type策略</text>
  <text class="d" x="355" y="470">MinIO / S3 / LOCAL</text>

  <!-- Step 6: Client upload chunks -->
  <path class="ar" d="M355 474 L355 498 L230 498 L230 520" marker-end="url(#a)"/>
  <rect class="node fe" x="30" y="520" width="170" height="80"/>
  <text class="lb" x="115" y="542">6. 上传全部分片</text>
  <text class="d" x="115" y="558">POST /storage/chunk</text>
  <text class="d" x="115" y="572">multipart/form-data</text>
  <text class="d" x="115" y="586">chunkIndex + uploadId</text>
  <text class="d" x="115" y="599">并行3线程并发</text>

  <rect class="node sv" x="250" y="520" width="210" height="80"/>
  <text class="lb" x="355" y="542">Chunk接收处理器</text>
  <text class="d" x="355" y="558">校验 uploadId / chunkIdx</text>
  <text class="d" x="355" y="572">写 MinIO 分片临时目录</text>
  <text class="d" x="355" y="586">Redis记录进度 key</text>
  <text class="d" x="355" y="599">断点续传断点位置</text>
  <path class="ar" d="M200 560 L250 560" marker-end="url(#a)"/>

  <!-- MinIO store chunks -->
  <path class="ar" d="M460 542 L480 542 L480 560 L520 560" marker-end="url(#a)"/>
  <rect class="node st" x="500" y="520" width="180" height="110"/>
  <text class="lb" x="590" y="542">MinIO 对象存储</text>
  <text class="d" x="590" y="558">Bucket: apex-files</text>
  <text class="d" x="590" y="572">/tmp/{uploadId}/</text>
  <text class="d" x="590" y="586">       chunk_000.bin</text>
  <text class="d" x="590" y="600">       chunk_001.bin</text>
  <text class="d" x="590" y="614">       ... chunk_N.bin</text>

  <!-- Step 7 Merge -->
  <path class="ar" d="M115 600 L115 620" marker-end="url(#a)"/>
  <rect class="node fe" x="30" y="620" width="170" height="48"/>
  <text class="lb" x="115" y="640">7. 请求合并分片</text>
  <text class="d" x="115" y="656">POST /storage/merge/{uploadId}</text>

  <path class="ar" d="M200 644 L250 644" marker-end="url(#a)"/>
  <rect class="node wr" x="250" y="620" width="210" height="68"/>
  <text class="lb" x="355" y="642">服务端合并</text>
  <text class="d" x="355" y="658">MinIO composeObject拼接</text>
  <text class="d" x="355" y="672">校验总MD5匹配 → 落最终对象</text>
  <text class="d" x="355" y="686">→ /{tenantId}/{yyyymm}/{uuid}.bin</text>

  <!-- Step 8 DB record -->
  <path class="ar" d="M355 688 L355 708" marker-end="url(#a)"/>
  <rect class="node st" x="250" y="708" width="210" height="52"/>
  <text class="lb" x="355" y="730">8. 写 sys_file 记录</text>
  <text class="d" x="355" y="746">md5/size/url/storage_type/tenant</text>

  <path class="ar" d="M460 728 L480 728 L480 708" marker-end="url(#a)"/>
  <rect class="node st" x="500" y="660" width="180" height="96"/>
  <text class="lb" x="590" y="682">MySQL + Redis 二级缓存</text>
  <text class="d" x="590" y="698">MySQL: sys_file 行落地</text>
  <text class="d" x="590" y="712">Redis: apex:file:{md5}</text>
  <text class="d" x="590" y="726">     = file_id (1小时)</text>
  <text class="d" x="590" y="740">下次秒传直接命中!</text>

  <!-- Step 9 Result -->
  <path class="ar" d="M250 734 L230 734 L230 774 L200 774" marker-end="url(#a)"/>
  <rect class="node st" x="30" y="754" width="170" height="48"/>
  <text class="lb" x="115" y="774">✅ 返回结果</text>
  <text class="d" x="115" y="790">fileId + previewUrl</text>

  <!-- Sidebar: Errors -->
  <rect class="sb" x="500" y="95" width="180" height="240"/>
  <text class="lb" x="590" y="117">⚠️ 异常场景处理</text>
  <text class="d" x="510" y="140">❌ 超限 → 413 Payload Too Large</text>
  <text class="d" x="510" y="156">❌ 类型不允许 → 400</text>
  <text class="d" x="510" y="172">❌ 配额不足 → 403</text>
  <text class="d" x="510" y="188">❌ 单片损坏 → 重试N次</text>
  <text class="d" x="510" y="204">❌ 单片缺失 → 409返回缺失idx列表</text>
  <text class="d" x="510" y="220">🔁 断点续传: 客户端记录进度</text>
  <text class="d" x="510" y="236">   下次可从idx=N继续</text>
  <text class="d" x="510" y="252">💥 网络闪断: 30s超时重连</text>
  <text class="d" x="510" y="268">🧹 7天未合并临时分片删除</text>
  <text class="d" x="510" y="284">🛡️ 所有文件加安全扫描</text>
  <text class="d" x="510" y="300">   ClamAV 病毒扫描</text>
  <text class="d" x="510" y="316">   敏感内容检测(可选)</text>

  <!-- Sidebar: Post actions -->
  <rect class="sb" x="30" y="354" width="180" height="150"/>
  <text class="lb" x="120" y="376">📤 上传成功后处理</text>
  <text class="d" x="40" y="399">① 生成缩略图(图片)</text>
  <text class="d" x="40" y="415">② PDF转预览图</text>
  <text class="d" x="40" y="431">③ 视频转码抽帧</text>
  <text class="d" x="40" y="447">④ OCR文字识别(可选)</text>
  <text class="d" x="40" y="463">⑤ 异步同步到备份桶</text>
  <text class="d" x="40" y="479">⑥ 写 sys_audit_log</text>
  <text class="d" x="40" y="495">⑦ 租户used字段累加</text>
</svg>
