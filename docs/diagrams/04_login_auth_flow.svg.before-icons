<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 750 820" width="750" height="820">
  <defs>
    <style>
      .subtitle { font:12px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .node { fill:#ffffff; stroke-width:2; rx:6; }
      .n1 { stroke:#4f46e5; }
      .n2 { stroke:#0891b2; }
      .n3 { stroke:#d97706; }
      .nok { stroke:#059669; }
      .nerr { stroke:#dc2626; }
      .diamond { fill:#ffffff; stroke:#d97706; stroke-width:2; }
      .lbl { font:500 13px system-ui, -apple-system, sans-serif; fill:#0f172a; text-anchor:middle; }
      .desc { font:11px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .arrow { fill:none; stroke:#64748b; stroke-width:2; }
      .arrowlbl { font:11px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .group-lbl { font:600 13px system-ui, -apple-system, sans-serif; fill:#0f172a; text-anchor:start; }
    </style>
    <marker id="a1" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M1 1 L7 4 L1 7 Z" fill="#64748b"/>
    </marker>
  </defs>

  <text class="title" x="375" y="28">登录认证业务流程图</text>
  <text class="subtitle" x="375" y="48">基于 JWT 双令牌机制 · Spring Security 6.x · TenantContext 租户隔离</text>

  <!-- Swimlanes -->
  <line x1="250" y1="60" x2="250" y2="810" stroke="#e2e8f0" stroke-dasharray="3 3"/>
  <line x1="500" y1="60" x2="500" y2="810" stroke="#e2e8f0" stroke-dasharray="3 3"/>
  <text class="group-lbl" x="30" y="78">👤 前端浏览器</text>
  <text class="group-lbl" x="280" y="78">🌐 后端服务</text>
  <text class="group-lbl" x="530" y="78">💾 存储层</text>

  <!-- Step 1: Submit Login -->
  <rect class="node n1" x="60" y="100" width="130" height="50" rx="6"/>
  <text class="lbl" x="125" y="122">1. 提交登录表单</text>
  <text class="desc" x="125" y="140">username + password + tenantId</text>

  <rect class="node n2" x="290" y="100" width="160" height="50" rx="6"/>
  <text class="lbl" x="370" y="122">AuthController.login()</text>
  <text class="desc" x="370" y="140">POST /admin-api/v1/auth/login</text>

  <!-- Step 2: AuthenticationManager -->
  <path class="arrow" d="M190 125 L290 125" marker-end="url(#a1)"/>
  <rect class="node n1" x="290" y="180" width="160" height="50" rx="6"/>
  <text class="lbl" x="370" y="202">AuthenticationManager</text>
  <text class="desc" x="370" y="220">ReactiveAuthenticationManager</text>
  <path class="arrow" d="M370 150 L370 180" marker-end="url(#a1)"/>

  <!-- Step 3: Query user -->
  <path class="arrow" d="M450 205 L500 205 L500 220 L540 220" marker-end="url(#a1)"/>
  <rect class="node nok" x="540" y="220" width="170" height="50" rx="6"/>
  <text class="lbl" x="625" y="242">查询用户表</text>
  <text class="desc" x="625" y="258">sys_user + sys_tenant + sys_post</text>

  <!-- Step 4: Password check -->
  <path class="arrow" d="M540 245 L500 245 L500 280 L450 280" marker-end="url(#a1)"/>
  <rect class="node n3" x="290" y="280" width="160" height="50" rx="6"/>
  <text class="lbl" x="370" y="302">PasswordEncoder.matches()</text>
  <text class="desc" x="370" y="318">BCrypt · 强度10</text>

  <!-- Decision: Password OK? -->
  <path class="arrow" d="M370 330 L370 360" marker-end="url(#a1)"/>
  <path class="diamond" d="M370 360 L440 400 L370 440 L300 400 Z"/>
  <text class="lbl" x="370" y="405">密码正确?</text>

  <!-- Password fail path -->
  <rect class="node nerr" x="560" y="375" width="140" height="50" rx="6"/>
  <text class="lbl" x="630" y="397">❌ 登录失败</text>
  <text class="desc" x="630" y="413">返回 401 + i18n 错误</text>
  <path class="arrow" d="M440 400 L560 400" marker-end="url(#a1)"/>
  <text class="arrowlbl" x="490" y="392">否</text>

  <!-- Login fail: back to frontend -->
  <path class="arrow" d="M560 400 L500 400 L500 125 L190 125" marker-end="url(#a1)" stroke-dasharray="4 3"/>
  <rect class="node nerr" x="60" y="375" width="130" height="50" rx="6"/>
  <text class="lbl" x="125" y="397">提示错误信息</text>
  <text class="desc" x="125" y="413">msg: 用户名或密码错误</text>
  <path class="arrow" d="M190 395 L190 395" marker-end="url(#a1)"/>

  <!-- Password OK path: Step 5 Gen JWT -->
  <path class="arrow" d="M370 440 L370 470" marker-end="url(#a1)"/>
  <text class="arrowlbl" x="355" y="455">是</text>
  <rect class="node n2" x="290" y="470" width="160" height="50" rx="6"/>
  <text class="lbl" x="370" y="492">5. JwtService.generate()</text>
  <text class="desc" x="370" y="508">access_token + refresh_token</text>

  <!-- Step 5.1 Token spec box -->
  <rect class="node n2" x="540" y="470" width="180" height="70" rx="6" fill="#f8fafc"/>
  <text class="lbl" x="630" y="489">令牌规格</text>
  <text class="desc" x="630" y="505">access: 2小时 · HS256</text>
  <text class="desc" x="630" y="519">refresh: 7天 · Redis存储</text>
  <text class="desc" x="630" y="533">claims: sub/uid/tid/roles</text>
  <path class="arrow" d="M450 495 L540 495" marker-end="url(#a1)"/>

  <!-- Step 6: Save refresh_token to Redis -->
  <path class="arrow" d="M630 540 L630 570" marker-end="url(#a1)"/>
  <rect class="node nok" x="540" y="570" width="180" height="50" rx="6"/>
  <text class="lbl" x="630" y="592">Redis 存储 refresh_token</text>
  <text class="desc" x="630" y="608">Key: apex:auth:refresh:{tid}:{uid}</text>

  <!-- Step 7: Write login log -->
  <path class="arrow" d="M370 520 L370 550" marker-end="url(#a1)"/>
  <rect class="node n3" x="290" y="550" width="160" height="50" rx="6"/>
  <text class="lbl" x="370" y="572">异步写登录日志</text>
  <text class="desc" x="370" y="588">sys_login_log · IP + UA</text>
  <path class="arrow" d="M450 575 L500 575 L500 575 L540 575" marker-end="url(#a1)" stroke-dasharray="4 3"/>

  <!-- Step 8: Return tokens -->
  <path class="arrow" d="M290 495 L250 495 L250 630 L190 630" marker-end="url(#a1)"/>
  <rect class="node nok" x="60" y="630" width="130" height="50" rx="6"/>
  <text class="lbl" x="125" y="652">8. 存储双令牌</text>
  <text class="desc" x="125" y="668">localStorage / Pinia</text>

  <!-- Step 9: Subsequent requests -->
  <path class="arrow" d="M125 680 L125 700" marker-end="url(#a1)"/>
  <rect class="node n1" x="60" y="700" width="130" height="50" rx="6"/>
  <text class="lbl" x="125" y="722">9. 后续请求携带</text>
  <text class="desc" x="125" y="738">Authorization: Bearer xxx</text>

  <rect class="node n2" x="290" y="700" width="160" height="50" rx="6"/>
  <text class="lbl" x="370" y="722">JwtAuthenticationFilter</text>
  <text class="desc" x="370" y="738">解析 → 校验 → SecurityContext</text>
  <path class="arrow" d="M190 725 L290 725" marker-end="url(#a1)"/>

  <!-- Decision: Access Token expired? -->
  <path class="arrow" d="M370 750 L370 775" marker-end="url(#a1)"/>
  <path class="diamond" d="M370 775 L440 805 L370 835 L300 805 Z"/>
  <text class="lbl" x="370" y="810">过期?</text>

  <!-- Refresh Token -->
  <rect class="node n2" x="530" y="780" width="170" height="50" rx="6"/>
  <text class="lbl" x="615" y="802">/auth/refresh</text>
  <text class="desc" x="615" y="818">Redis校验 → 重新颁发</text>
  <path class="arrow" d="M440 805 L530 805" marker-end="url(#a1)"/>
  <text class="arrowlbl" x="480" y="797">是</text>

  <!-- Continue normal -->
  <path class="arrow" d="M300 805 L260 805 L260 725 L290 725" marker-end="url(#a1)" stroke-dasharray="4 3"/>
  <text class="arrowlbl" x="260" y="795">否 · 正常执行</text>

  <!-- Side notes box -->
  <rect class="node n2" x="10" y="470" width="230" height="180" rx="6" fill="#f8fafc" opacity="0.8"/>
  <text class="lbl" x="125" y="492">🔐 安全加固</text>
  <text class="desc" x="22" y="512">1. 登录失败连续5次 → 锁定15分钟</text>
  <text class="desc" x="22" y="528">2. 密码错误次数 Redis计数</text>
  <text class="desc" x="22" y="544">3. 图形/滑动验证码 (登录保护)</text>
  <text class="desc" x="22" y="560">4. IP黑白名单 · 异地登录告警</text>
  <text class="desc" x="22" y="576">5. 支持验证码开关配置</text>
  <text class="desc" x="22" y="592">6. Single Sign-On: 单点在线踢下线</text>
  <text class="desc" x="22" y="608">7. X-Tenant-Id 头校验租户</text>
  <text class="desc" x="22" y="624">8. 每次颁发前主动注销旧refresh</text>
</svg>
