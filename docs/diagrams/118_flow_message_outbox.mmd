      'primaryColor': '#eef2ff',
      'primaryTextColor': '#0f172a',
      'primaryBorderColor': '#4f46e5',
      'lineColor': '#475569',
      'fontFamily': 'system-ui, sans-serif'
    }
  }
}%%
flowchart TD
    subgraph P1["① 业务事务内写入发件箱"]
        A1["业务操作（同事务）"] --> A2["DomainEventPublisherImpl.publish()<br/>先落箱 append(event)"]
        A2 --> A3["MessageOutboxServiceImpl.append<br/>INSERT sys_message_outbox"]
        A3 --> A4["status = PENDING<br/>attempts = 0 · max_attempts = 5<br/>retry_delay_seconds = 10 · next_attempt_at = now"]
        A4 --> A5["MqProducerService.sendSyncWithOutbox<br/>先落箱 → 同步发送"]
        A5 --> A6{"同步发送成功?"}
        A6 -- "是" --> A7["标记 DELIVERED<br/>delivered_at = now"]
        A6 -- "否" --> A8["保留 PENDING 并抛出<br/>交由调度器重试"]
    end

    subgraph P2["② 调度器扫描投递"]
        B1["@Scheduled fixedDelay=5000ms<br/>MessageOutboxDispatcher.dispatch()"] --> B2["releaseExpiredLocks()<br/>释放超时锁（lock_timeout=300s）"]
        B2 --> B3["fetchPendingMessages(100)<br/>status = PENDING"]
        B3 --> B4["lockMessage(messageId, instanceId)<br/>CAS 抢锁 locked_by"]
        B4 --> B5{"抢锁成功?"}
        B5 -- "否（他实例占用）" --> B6["跳过，等待下次扫描"]
        B5 -- "是" --> B7["status = PROCESSING<br/>mqProducerService.sendSync(topic, tag, payload)"]
    end

    subgraph P3["③ 重试与死信"]
        B7 --> C1{"投递结果"}
        C1 -- "成功" --> C2["markAsDelivered<br/>status = DELIVERED"]
        C1 -- "失败且未耗尽" --> C3["markAsFailed<br/>attempts+1 · status = PENDING<br/>next_attempt_at = now + retry_delay × 2^(attempts-1)"]
        C1 -- "失败且 attempts >= max_attempts" --> C4["markAsFailed<br/>status = DEAD（死信）"]
        C3 --> B1
        C4 --> C5["死信处置<br/>告警 / 人工介入"]
    end

    subgraph P4["④ 保留与清理"]
        C2 --> D1["purgeRetained（保留策略）"]
        C4 --> D1
        D1 --> D2["DELIVERED 保留 168h<br/>DEAD 保留 7 天"]
        D2 --> D3["分批物理删除<br/>retention-batch-size = 5000"]
    end

    classDef biz fill:#eef2ff,stroke:#4f46e5,stroke-width:1.8px,color:#0f172a;
    classDef disp fill:#ecfdf5,stroke:#059669,stroke-width:1.8px,color:#0f172a;
    classDef retry fill:#fffbeb,stroke:#d97706,stroke-width:1.8px,color:#0f172a;
    classDef dead fill:#fef2f2,stroke:#dc2626,stroke-width:1.4px,color:#b91c1c;
    classDef clean fill:#eff6ff,stroke:#3b82f6,stroke-width:1.8px,color:#0f172a;

    class A1,A2,A3,A4,A5,A6,A7,A8 biz;
    class B1,B2,B3,B4,B5,B6,B7 disp;
    class C1,C2,C3 retry;
    class C4,C5 dead;
    class D1,D2,D3 clean;
