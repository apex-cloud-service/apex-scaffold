%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#eef2ff','primaryTextColor':'#0f172a','primaryBorderColor':'#4f46e5','lineColor':'#64748b','fontFamily':'sans-serif'}}}%%
flowchart TD
    subgraph T1["① MQ 业务消息 Outbox（sys_message_outbox · apex-infrastructure-messaging）"]
        A1["业务同步事务内追加<br/>MessageOutboxServiceImpl.append<br/>（不自动创建/继承事务，需调用方同事务）"] --> A2["status=PENDING · attempts=0<br/>max_attempts=5 · next_attempt_at=now<br/>含 tenant_id · 参与行级隔离"]
        A2 --> A3["MqProducerService.sendSyncWithOutbox<br/>先落箱 → 同步发 RocketMQ"]
        A3 --> A4{"同步发送成功?"}
        A4 -- "是" --> A5["标记 DELIVERED<br/>delivered_at = now"]
        A4 -- "否" --> A6["保留 PENDING<br/>交由调度器重试"]
    end

    subgraph T2["② 共享领域事件 Outbox（sys_domain_event_outbox · DomainEventOutboxStore）"]
        C1["DomainEventOutboxStore.appendSync(Connection)<br/>绑定调用方事务连接 · 事件 ID 幂等"] --> C2["DomainEventOutboxDispatcher<br/>@Scheduled poll-delay-ms:1000<br/>apex.events.outbox.enabled 控制"]
        C2 --> C3["claim：PENDING → PROCESSING<br/>单实例同一时刻单批在途"]
    end

    subgraph T3["③ workflow 专用事件落箱（WorkflowEventOutbox）"]
        W1["JdbcWorkflowTaskTransaction.appendSync<br/>TransactionTemplate 同步事务内<br/>业务写与事件追加同事务"] --> W2["JdbcWorkflowEventOutbox<br/>直写 sys_domain_event_outbox<br/>事件 ID 唯一约束防重复落箱"]
        W2 --> W3["WorkflowEventOutboxDispatcher<br/>按 apex.events.channel 本地/远程发布"]
    end

    subgraph T4["④ 重试与死信（消息/事件 Outbox 同型）"]
        R1["markFailed：attempts+1<br/>指数退避 next_attempt_at"] --> R2{"attempts >= max_attempts?"}
        R2 -- "否" --> R3["恢复 PENDING · 清锁<br/>等待下次扫描"]
        R2 -- "是" --> R4["DEAD 死信<br/>告警 / 人工介入"]
        R3 --> CL["purgeRetained 清理<br/>DELIVERED/DEAD 按保留期分批删除"]
    end

    subgraph T5["⑤ 约束与开关"]
        S1["SeataOutboxGuard：存在全局事务 XID 时拒绝写入<br/>拦截 TransactionalOutboxExecutor / append*"]
        S2["apex.events.outbox.enabled<br/>auth 生产默认 true · basic/H2 关闭"]
        S1 --> S2
    end

    A5 --> R1
    A6 --> R1
    C3 --> R1
    W3 --> R1

    classDef biz fill:#eef2ff,stroke:#4f46e5,stroke-width:1.8px,color:#0f172a;
    classDef evt fill:#eff6ff,stroke:#3b82f6,stroke-width:1.8px,color:#0f172a;
    classDef wf fill:#fdf2f8,stroke:#ec4899,stroke-width:1.8px,color:#0f172a;
    classDef retry fill:#fffbeb,stroke:#d97706,stroke-width:1.8px,color:#0f172a;
    classDef dead fill:#fef2f2,stroke:#dc2626,stroke-width:1.4px,color:#b91c1c;
    classDef clean fill:#ecfdf5,stroke:#059669,stroke-width:1.8px,color:#0f172a;
    classDef guard fill:#f8fafc,stroke:#64748b,stroke-width:1.4px,color:#0f172a;

    class A1,A2,A3,A4,A5,A6 biz;
    class C1,C2,C3 evt;
    class W1,W2,W3 wf;
    class R1,R2,R3 retry;
    class R4 dead;
    class CL clean;
    class S1,S2 guard;
