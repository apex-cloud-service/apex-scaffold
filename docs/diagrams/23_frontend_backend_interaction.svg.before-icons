<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 1100">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #F8FAFC; }
      .subtitle { font: 16px sans-serif; fill: #94A3B8; }
      .section-title { font: bold 18px sans-serif; fill: #38BDF8; }
      .layer-title { font: bold 16px sans-serif; fill: #F8FAFC; }
      .tech-name { font: bold 14px sans-serif; fill: #F8FAFC; }
      .tech-desc { font: 12px sans-serif; fill: #CBD5E1; }
      .port { font: 11px monospace; fill: #4FD1C5; }
      .step-num { font: bold 14px sans-serif; fill: #F97316; }
      .step-desc { font: 12px sans-serif; fill: #F8FAFC; }
      .frontend-bg { fill: #1E293B; stroke: #38BDF8; stroke-width: 2; }
      .backend-bg { fill: #1E293B; stroke: #F97316; stroke-width: 2; }
      .component-box { fill: #0F172A; stroke: #38BDF8; stroke-width: 1.5; }
      .service-box { fill: #0F172A; stroke: #F97316; stroke-width: 1.5; }
      .data-flow { stroke: #4FD1C5; stroke-width: 2.5; fill: none; marker-end: url(#datahead); }
      .request-flow { stroke: #F97316; stroke-width: 2.5; fill: none; marker-end: url(#reqhead); }
      .response-flow { stroke: #38BDF8; stroke-width: 2.5; fill: none; marker-end: url(#reshead); }
    </style>
    <marker id="datahead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#4FD1C5" />
    </marker>
    <marker id="reqhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#F97316" />
    </marker>
    <marker id="reshead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#38BDF8" />
    </marker>
  </defs>

  <!-- Title -->
  <text x="700" y="40" text-anchor="middle" class="title">Apex Scaffold 前后端交互架构</text>
  <text x="700" y="65" text-anchor="middle" class="subtitle">Vue 3 (apex-admin-web) ⟷ Spring Boot WebFlux (apex-scaffold)</text>

  <!-- Frontend Section -->
  <rect x="50" y="100" width="550" height="750" rx="8" class="frontend-bg"/>
  <text x="325" y="130" text-anchor="middle" class="section-title">前端 (apex-admin-web)</text>
  <text x="325" y="150" text-anchor="middle" class="port">http://localhost:5173</text>

  <!-- Frontend Layers -->
  <!-- User Interface -->
  <rect x="80" y="170" width="490" height="100" rx="6" class="component-box"/>
  <text x="95" y="195" class="layer-title">用户界面层</text>
  <rect x="100" y="205" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="170" y="225" text-anchor="middle" class="tech-name">Vue 3 组件</text>
  <text x="170" y="240" text-anchor="middle" class="tech-desc">&lt;script setup&gt;</text>
  <text x="170" y="252" text-anchor="middle" class="tech-desc">响应式UI</text>

  <rect x="260" y="205" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="330" y="225" text-anchor="middle" class="tech-name">Element Plus</text>
  <text x="330" y="240" text-anchor="middle" class="tech-desc">Table/Form</text>
  <text x="330" y="252" text-anchor="middle" class="tech-desc">Dialog/Tree</text>

  <rect x="420" y="205" width="130" height="50" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="485" y="225" text-anchor="middle" class="tech-name">ECharts</text>
  <text x="485" y="240" text-anchor="middle" class="tech-desc">数据可视化</text>
  <text x="485" y="252" text-anchor="middle" class="tech-desc">Dashboard</text>

  <!-- State Management -->
  <rect x="80" y="290" width="490" height="100" rx="6" class="component-box"/>
  <text x="95" y="315" class="layer-title">状态管理层</text>
  <rect x="100" y="325" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="170" y="345" text-anchor="middle" class="tech-name">Pinia Store</text>
  <text x="170" y="360" text-anchor="middle" class="tech-desc">authStore</text>
  <text x="170" y="372" text-anchor="middle" class="tech-desc">userStore</text>

  <rect x="260" y="325" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="330" y="345" text-anchor="middle" class="tech-name">Vue Router</text>
  <text x="330" y="360" text-anchor="middle" class="tech-desc">动态路由</text>
  <text x="330" y="372" text-anchor="middle" class="tech-desc">权限守卫</text>

  <rect x="420" y="325" width="130" height="50" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="485" y="345" text-anchor="middle" class="tech-name">LocalStorage</text>
  <text x="485" y="360" text-anchor="middle" class="tech-desc">状态持久化</text>
  <text x="485" y="372" text-anchor="middle" class="tech-desc">Token缓存</text>

  <!-- API Layer -->
  <rect x="80" y="410" width="490" height="120" rx="6" class="component-box"/>
  <text x="95" y="435" class="layer-title">API 请求层</text>
  <rect x="100" y="445" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="170" y="465" text-anchor="middle" class="tech-name">Axios</text>
  <text x="170" y="480" text-anchor="middle" class="tech-desc">HTTP Client</text>
  <text x="170" y="492" text-anchor="middle" class="port">baseURL: /api</text>
  <text x="170" y="507" text-anchor="middle" class="tech-desc">请求/响应拦截</text>

  <rect x="260" y="445" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="330" y="465" text-anchor="middle" class="tech-name">API 模块</text>
  <text x="330" y="480" text-anchor="middle" class="tech-desc">auth.ts</text>
  <text x="330" y="492" text-anchor="middle" class="tech-desc">system.ts</text>
  <text x="330" y="507" text-anchor="middle" class="tech-desc">monitor.ts</text>

  <rect x="420" y="445" width="130" height="70" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="485" y="465" text-anchor="middle" class="tech-name">类型定义</text>
  <text x="485" y="480" text-anchor="middle" class="tech-desc">TypeScript</text>
  <text x="485" y="492" text-anchor="middle" class="tech-desc">Request/</text>
  <text x="485" y="507" text-anchor="middle" class="tech-desc">Response DTO</text>

  <!-- Authentication -->
  <rect x="80" y="550" width="490" height="120" rx="6" class="component-box"/>
  <text x="95" y="575" class="layer-title">认证授权层</text>
  <rect x="100" y="585" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="170" y="605" text-anchor="middle" class="tech-name">JWT Token</text>
  <text x="170" y="620" text-anchor="middle" class="tech-desc">Authorization:</text>
  <text x="170" y="632" text-anchor="middle" class="tech-desc">Bearer &lt;token&gt;</text>
  <text x="170" y="647" text-anchor="middle" class="port">请求头注入</text>

  <rect x="260" y="585" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="330" y="605" text-anchor="middle" class="tech-name">权限控制</text>
  <text x="330" y="620" text-anchor="middle" class="tech-desc">v-permission</text>
  <text x="330" y="632" text-anchor="middle" class="tech-desc">按钮级权限</text>
  <text x="330" y="647" text-anchor="middle" class="tech-desc">路由守卫</text>

  <rect x="420" y="585" width="130" height="70" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="485" y="605" text-anchor="middle" class="tech-name">会话管理</text>
  <text x="485" y="620" text-anchor="middle" class="tech-desc">Token刷新</text>
  <text x="485" y="632" text-anchor="middle" class="tech-desc">登出清理</text>
  <text x="485" y="647" text-anchor="middle" class="tech-desc">超时处理</text>

  <!-- Error Handling -->
  <rect x="80" y="690" width="490" height="140" rx="6" class="component-box"/>
  <text x="95" y="715" class="layer-title">错误处理与优化</text>
  <rect x="100" y="725" width="140" height="90" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="170" y="745" text-anchor="middle" class="tech-name">错误处理</text>
  <text x="170" y="760" text-anchor="middle" class="tech-desc">401 → 跳转登录</text>
  <text x="170" y="772" text-anchor="middle" class="tech-desc">403 → 权限提示</text>
  <text x="170" y="784" text-anchor="middle" class="tech-desc">500 → 错误提示</text>
  <text x="170" y="806" text-anchor="middle" class="tech-desc">ElMessage 提示</text>

  <rect x="260" y="725" width="140" height="90" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="330" y="745" text-anchor="middle" class="tech-name">Loading 状态</text>
  <text x="330" y="760" text-anchor="middle" class="tech-desc">NProgress</text>
  <text x="330" y="772" text-anchor="middle" class="tech-desc">ElLoading</text>
  <text x="330" y="784" text-anchor="middle" class="tech-desc">Skeleton</text>
  <text x="330" y="806" text-anchor="middle" class="tech-desc">用户体验优化</text>

  <rect x="420" y="725" width="130" height="90" rx="4" style="fill:#0B0E14;stroke:#38BDF8;"/>
  <text x="485" y="745" text-anchor="middle" class="tech-name">性能优化</text>
  <text x="485" y="760" text-anchor="middle" class="tech-desc">请求防抖</text>
  <text x="485" y="772" text-anchor="middle" class="tech-desc">虚拟滚动</text>
  <text x="485" y="784" text-anchor="middle" class="tech-desc">分页加载</text>
  <text x="485" y="806" text-anchor="middle" class="tech-desc">Lazy Loading</text>

  <!-- Backend Section -->
  <rect x="800" y="100" width="550" height="750" rx="8" class="backend-bg"/>
  <text x="1075" y="130" text-anchor="middle" class="section-title">后端 (apex-scaffold)</text>
  <text x="1075" y="150" text-anchor="middle" class="port">http://localhost:8080</text>

  <!-- Backend Layers -->
  <!-- API Gateway -->
  <rect x="830" y="170" width="490" height="100" rx="6" class="service-box"/>
  <text x="845" y="195" class="layer-title">API网关层</text>
  <rect x="850" y="205" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="920" y="225" text-anchor="middle" class="tech-name">RouterFunction</text>
  <text x="920" y="240" text-anchor="middle" class="tech-desc">WebFlux路由</text>
  <text x="920" y="252" text-anchor="middle" class="port">/api/**</text>

  <rect x="1010" y="205" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1080" y="225" text-anchor="middle" class="tech-name">GlobalFilter</text>
  <text x="1080" y="240" text-anchor="middle" class="tech-desc">CORS跨域</text>
  <text x="1080" y="252" text-anchor="middle" class="tech-desc">请求日志</text>

  <rect x="1170" y="205" width="130" height="50" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1235" y="225" text-anchor="middle" class="tech-name">异常处理</text>
  <text x="1235" y="240" text-anchor="middle" class="tech-desc">统一响应</text>
  <text x="1235" y="252" text-anchor="middle" class="tech-desc">Result&lt;T&gt;</text>

  <!-- Security -->
  <rect x="830" y="290" width="490" height="100" rx="6" class="service-box"/>
  <text x="845" y="315" class="layer-title">安全认证层</text>
  <rect x="850" y="325" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="920" y="345" text-anchor="middle" class="tech-name">JWT验证</text>
  <text x="920" y="360" text-anchor="middle" class="tech-desc">Token解析</text>
  <text x="920" y="372" text-anchor="middle" class="tech-desc">签名验证</text>

  <rect x="1010" y="325" width="140" height="50" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1080" y="345" text-anchor="middle" class="tech-name">RBAC权限</text>
  <text x="1080" y="360" text-anchor="middle" class="tech-desc">角色权限</text>
  <text x="1080" y="372" text-anchor="middle" class="tech-desc">数据权限</text>

  <rect x="1170" y="325" width="130" height="50" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1235" y="345" text-anchor="middle" class="tech-name">租户隔离</text>
  <text x="1235" y="360" text-anchor="middle" class="tech-desc">tenant_id</text>
  <text x="1235" y="372" text-anchor="middle" class="tech-desc">多租户</text>

  <!-- Business Logic -->
  <rect x="830" y="410" width="490" height="120" rx="6" class="service-box"/>
  <text x="845" y="435" class="layer-title">业务逻辑层</text>
  <rect x="850" y="445" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="920" y="465" text-anchor="middle" class="tech-name">Handler</text>
  <text x="920" y="480" text-anchor="middle" class="tech-desc">业务处理器</text>
  <text x="920" y="492" text-anchor="middle" class="tech-desc">Mono/Flux</text>
  <text x="920" y="507" text-anchor="middle" class="tech-desc">响应式流</text>

  <rect x="1010" y="445" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1080" y="465" text-anchor="middle" class="tech-name">Service</text>
  <text x="1080" y="480" text-anchor="middle" class="tech-desc">领域服务</text>
  <text x="1080" y="492" text-anchor="middle" class="tech-desc">@Transactional</text>
  <text x="1080" y="507" text-anchor="middle" class="tech-desc">事务管理</text>

  <rect x="1170" y="445" width="130" height="70" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1235" y="465" text-anchor="middle" class="tech-name">DTO转换</text>
  <text x="1235" y="480" text-anchor="middle" class="tech-desc">MapStruct</text>
  <text x="1235" y="492" text-anchor="middle" class="tech-desc">Entity ⟷</text>
  <text x="1235" y="507" text-anchor="middle" class="tech-desc">DTO</text>

  <!-- Data Layer -->
  <rect x="830" y="550" width="490" height="120" rx="6" class="service-box"/>
  <text x="845" y="575" class="layer-title">数据访问层</text>
  <rect x="850" y="585" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="920" y="605" text-anchor="middle" class="tech-name">MyBatis-Plus</text>
  <text x="920" y="620" text-anchor="middle" class="tech-desc">BaseMapper</text>
  <text x="920" y="632" text-anchor="middle" class="tech-desc">Wrapper查询</text>
  <text x="920" y="647" text-anchor="middle" class="port">R2DBC响应式</text>

  <rect x="1010" y="585" width="140" height="70" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1080" y="605" text-anchor="middle" class="tech-name">Redis缓存</text>
  <text x="1080" y="620" text-anchor="middle" class="tech-desc">@Cacheable</text>
  <text x="1080" y="632" text-anchor="middle" class="tech-desc">分布式缓存</text>
  <text x="1080" y="647" text-anchor="middle" class="port">:6379</text>

  <rect x="1170" y="585" width="130" height="70" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1235" y="605" text-anchor="middle" class="tech-name">MySQL</text>
  <text x="1235" y="620" text-anchor="middle" class="tech-desc">主从复制</text>
  <text x="1235" y="632" text-anchor="middle" class="tech-desc">读写分离</text>
  <text x="1235" y="647" text-anchor="middle" class="port">:3306</text>

  <!-- Middleware -->
  <rect x="830" y="690" width="490" height="140" rx="6" class="service-box"/>
  <text x="845" y="715" class="layer-title">中间件与监控</text>
  <rect x="850" y="725" width="140" height="90" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="920" y="745" text-anchor="middle" class="tech-name">RocketMQ</text>
  <text x="920" y="760" text-anchor="middle" class="tech-desc">消息队列</text>
  <text x="920" y="772" text-anchor="middle" class="tech-desc">异步解耦</text>
  <text x="920" y="784" text-anchor="middle" class="port">:9876</text>
  <text x="920" y="806" text-anchor="middle" class="tech-desc">事务消息</text>

  <rect x="1010" y="725" width="140" height="90" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1080" y="745" text-anchor="middle" class="tech-name">Sentinel</text>
  <text x="1080" y="760" text-anchor="middle" class="tech-desc">流控限流</text>
  <text x="1080" y="772" text-anchor="middle" class="tech-desc">熔断降级</text>
  <text x="1080" y="784" text-anchor="middle" class="port">QPS限制</text>
  <text x="1080" y="806" text-anchor="middle" class="tech-desc">Dashboard</text>

  <rect x="1170" y="725" width="130" height="90" rx="4" style="fill:#0B0E14;stroke:#F97316;"/>
  <text x="1235" y="745" text-anchor="middle" class="tech-name">监控追踪</text>
  <text x="1235" y="760" text-anchor="middle" class="tech-desc">Prometheus</text>
  <text x="1235" y="772" text-anchor="middle" class="tech-desc">Zipkin</text>
  <text x="1235" y="784" text-anchor="middle" class="tech-desc">链路追踪</text>
  <text x="1235" y="806" text-anchor="middle" class="tech-desc">Metrics</text>

  <!-- Data Flow Arrows -->
  <!-- Request Flow -->
  <path d="M 570 250 L 800 250" class="request-flow"/>
  <text x="685" y="240" class="step-num">① HTTP POST</text>
  <text x="685" y="265" class="step-desc">/api/auth/login</text>

  <!-- Token Flow -->
  <path d="M 570 350 L 800 350" class="request-flow"/>
  <text x="650" y="340" class="step-num">② JWT Token</text>
  <text x="650" y="365" class="step-desc">Authorization Header</text>

  <!-- API Call -->
  <path d="M 570 480 L 800 480" class="request-flow"/>
  <text x="655" y="470" class="step-num">③ REST API</text>
  <text x="655" y="495" class="step-desc">CRUD Operations</text>

  <!-- Response Flow -->
  <path d="M 800 620 L 570 620" class="response-flow"/>
  <text x="685" y="610" class="step-num">④ JSON 响应</text>
  <text x="685" y="635" class="step-desc">Result&lt;T&gt; 包装</text>

  <!-- Error Flow -->
  <path d="M 800 770 L 570 770" class="response-flow"/>
  <text x="670" y="760" class="step-num">⑤ 错误处理</text>
  <text x="670" y="785" class="step-desc">401/403/500</text>

  <!-- Legend -->
  <rect x="50" y="880" width="1300" height="200" rx="8" style="fill:#1E293B;stroke:#334155;stroke-width:2;"/>
  <text x="70" y="910" class="section-title">交互流程说明</text>

  <!-- Flow Steps -->
  <text x="80" y="940" class="step-desc">1️⃣ <tspan class="tech-name">用户登录流程</tspan>: 用户输入账密 → Vue组件 → Axios POST /api/auth/login → JWT验证 → 返回Token → Pinia Store存储 → LocalStorage持久化</text>
  
  <text x="80" y="970" class="step-desc">2️⃣ <tspan class="tech-name">权限验证流程</tspan>: Axios请求拦截器 → 注入Token到Header → RouterFunction接收 → JWT解析 → RBAC权限校验 → 数据权限过滤 → 返回业务数据</text>
  
  <text x="80" y="1000" class="step-desc">3️⃣ <tspan class="tech-name">业务请求流程</tspan>: Vue组件触发 → API模块调用 → Axios发送请求 → Handler处理 → Service业务逻辑 → MyBatis-Plus数据查询 → Redis缓存 → JSON响应</text>
  
  <text x="80" y="1030" class="step-desc">4️⃣ <tspan class="tech-name">错误处理流程</tspan>: 后端异常 → GlobalExceptionHandler捕获 → Result统一包装 → HTTP状态码 → Axios响应拦截器 → ElMessage提示 → 特殊状态处理(401跳登录)</text>
  
  <text x="80" y="1060" class="step-desc">5️⃣ <tspan class="tech-name">实时通信</tspan>: WebSocket /ws/notify (待实现) | <tspan class="tech-name">文件上传</tspan>: MultipartFile → MinIO存储 | <tspan class="tech-name">批量导出</tspan>: EasyExcel → 文件流下载</text>

</svg>