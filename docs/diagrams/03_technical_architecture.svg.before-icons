<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 800" width="900" height="800">
  <defs>
    <style>
      .layer { fill: #f8fafc; stroke: #e2e8f0; rx: 8; stroke-width: 1; }
      .layer-title { font: 600 14px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: start; }
      .tag { font: 500 12px system-ui, -apple-system, sans-serif; fill: #fff; text-anchor: middle; rx: 4; }
      .tag-fe { fill: #ec4899; }
      .tag-gw { fill: #7c3aed; }
      .tag-be { fill: #0891b2; }
      .tag-data { fill: #059669; }
      .tag-infra { fill: #d97706; }
      .tag-sec { fill: #2563eb; }
      .tag-mon { fill: #64748b; }
      .tech-name { font: 500 12px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .tech-desc { font: 10px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
    </style>
  </defs>

  <text x="450" y="28" style="font:700 22px system-ui, -apple-system, sans-serif;fill:#0f172a;text-anchor:middle">Apex Scaffold 技术架构全景图</text>
  <text x="450" y="48" style="font:12px system-ui, -apple-system, sans-serif;fill:#64748b;text-anchor:middle">全栈技术选型 · 各层级组件依赖关系 · 以源码与配置为准</text>

  <!-- Layer: Frontend -->
  <rect class="layer" x="20" y="60" width="860" height="95"/>
  <text class="layer-title" x="30" y="80">💻 前端层 - Vue 3 技术栈</text>
  <g>
    <rect class="tag tag-fe" x="50" y="90" width="100" height="20" rx="4"/>
    <text class="tech-name" x="100" y="105" fill="#fff">Vue 3.5.13</text>
    <text class="tech-desc" x="100" y="145">Composition API · Vue 3 工程</text>

    <rect class="tag tag-fe" x="170" y="90" width="100" height="20" rx="4"/>
    <text class="tech-name" x="220" y="105" fill="#fff">TypeScript 5.7.2</text>
    <text class="tech-desc" x="220" y="145">类型安全 · strict模式</text>

    <rect class="tag tag-fe" x="290" y="90" width="100" height="20" rx="4"/>
    <text class="tech-name" x="340" y="105" fill="#fff">Vite 6.0.7</text>
    <text class="tech-desc" x="340" y="145">Rolldown构建 · HMR热更新</text>

    <rect class="tag tag-fe" x="410" y="90" width="100" height="20" rx="4"/>
    <text class="tech-name" x="460" y="105" fill="#fff">Element Plus 2.9.1</text>
    <text class="tech-desc" x="460" y="145">UI组件库 · 暗黑模式</text>

    <rect class="tag tag-fe" x="530" y="90" width="100" height="20" rx="4"/>
    <text class="tech-name" x="580" y="105" fill="#fff">Pinia 2.3.0</text>
    <text class="tech-desc" x="580" y="145">状态管理 · 持久化插件</text>

    <rect class="tag tag-fe" x="650" y="90" width="100" height="20" rx="4"/>
    <text class="tech-name" x="700" y="105" fill="#fff">Vue Router 4</text>
    <text class="tech-desc" x="700" y="145">动态路由 · 权限加载</text>

    <rect class="tag tag-fe" x="770" y="90" width="90" height="20" rx="4"/>
    <text class="tech-name" x="815" y="105" fill="#fff">Axios 1.7.9</text>
    <text class="tech-desc" x="815" y="145">HTTP客户端 · 拦截器</text>
  </g>

  <!-- Layer: API Gateway -->
  <rect class="layer" x="20" y="165" width="860" height="85"/>
  <text class="layer-title" x="30" y="185">🌐 接入层 - API 网关与认证</text>
  <g>
    <rect class="tag tag-gw" x="60" y="195" width="130" height="20" rx="4"/>
    <text class="tech-name" x="125" y="210" fill="#fff">Nginx / ALB</text>
    <text class="tech-desc" x="125" y="240">反向代理 · SSL终止 · 静态资源</text>

    <rect class="tag tag-gw" x="210" y="195" width="130" height="20" rx="4"/>
    <text class="tech-name" x="275" y="210" fill="#fff">Sentinel 1.8.9</text>
    <text class="tech-desc" x="275" y="240">限流 · 熔断 · 热点参数 · 系统规则</text>

    <rect class="tag tag-sec" x="360" y="195" width="130" height="20" rx="4"/>
    <text class="tech-name" x="425" y="210" fill="#fff">JWT / Bearer</text>
    <text class="tech-desc" x="425" y="240">无状态认证 · access+refresh双令牌</text>

    <rect class="tag tag-sec" x="510" y="195" width="130" height="20" rx="4"/>
    <text class="tech-name" x="575" y="210" fill="#fff">Spring Security 6.5.0</text>
    <text class="tech-desc" x="575" y="240">SecurityWebFilterChain · 方法级鉴权</text>

    <rect class="tag tag-gw" x="660" y="195" width="100" height="20" rx="4"/>
    <text class="tech-name" x="710" y="210" fill="#fff">RouterFunction</text>
    <text class="tech-desc" x="710" y="240">WebFlux函数式路由</text>

    <rect class="tag tag-gw" x="780" y="195" width="80" height="20" rx="4"/>
    <text class="tech-name" x="820" y="210" fill="#fff">CORS</text>
    <text class="tech-desc" x="820" y="240">跨域 · 预检缓存</text>
  </g>

  <!-- Layer: Backend Core -->
  <rect class="layer" x="20" y="260" width="860" height="130"/>
  <text class="layer-title" x="30" y="280">☕ 后端核心 - Spring Boot 3 + DDD</text>
  <g>
    <rect class="tag tag-be" x="40" y="290" width="130" height="20" rx="4"/>
    <text class="tech-name" x="105" y="305" fill="#fff">Spring Boot 3.5.15</text>
    <text class="tech-desc" x="105" y="340">Java 17 · WebFlux响应式 · Reactor 2025</text>

    <rect class="tag tag-be" x="190" y="290" width="130" height="20" rx="4"/>
    <text class="tech-name" x="255" y="305" fill="#fff">MyBatis-Plus 3.5.10.1</text>
    <text class="tech-desc" x="255" y="340">LambdaQuery · 代码生成 · 逻辑删除</text>

    <rect class="tag tag-be" x="340" y="290" width="130" height="20" rx="4"/>
    <text class="tech-name" x="405" y="305" fill="#fff">Resilience4j 2.2.0</text>
    <text class="tech-desc" x="405" y="340">CircuitBreaker · RateLimiter · TimeLimiter</text>

    <rect class="tag tag-be" x="490" y="290" width="130" height="20" rx="4"/>
    <text class="tech-name" x="555" y="305" fill="#fff">Flyway 10.15.0</text>
    <text class="tech-desc" x="555" y="340">V1-V20迁移脚本 · 版本化演进</text>

    <rect class="tag tag-be" x="640" y="290" width="100" height="20" rx="4"/>
    <text class="tech-name" x="690" y="305" fill="#fff">DDD 四层</text>
    <text class="tech-desc" x="690" y="340">接口/应用/领域/基础设施</text>

    <rect class="tag tag-be" x="760" y="290" width="100" height="20" rx="4"/>
    <text class="tech-name" x="810" y="305" fill="#fff">AOP / Aspect</text>
    <text class="tech-desc" x="810" y="340">审计 · 数据权限 · 租户拦截</text>
  </g>
  <!-- Sub row 2 -->
  <g transform="translate(0, 30)">
    <rect class="tag tag-sec" x="40" y="330" width="100" height="20" rx="4"/>
    <text class="tech-name" x="90" y="345" fill="#fff">TenantLine</text>
    <text class="tech-desc" x="90" y="380">多租户行级隔离</text>

    <rect class="tag tag-sec" x="160" y="330" width="100" height="20" rx="4"/>
    <text class="tech-name" x="210" y="345" fill="#fff">RBAC + 数据权限</text>
    <text class="tech-desc" x="210" y="380">菜单+按钮+部门级权限</text>

    <rect class="tag tag-infra" x="280" y="330" width="100" height="20" rx="4"/>
    <text class="tech-name" x="330" y="345" fill="#fff">Validation 3.1</text>
    <text class="tech-desc" x="330" y="380">JSR380参数校验</text>

    <rect class="tag tag-infra" x="400" y="330" width="100" height="20" rx="4"/>
    <text class="tech-name" x="450" y="345" fill="#fff">i18n Locale</text>
    <text class="tech-desc" x="450" y="380">中文/英文/日文 多语言</text>

    <rect class="tag tag-infra" x="520" y="330" width="120" height="20" rx="4"/>
    <text class="tech-name" x="580" y="345" fill="#fff">SpringDoc 2.8</text>
    <text class="tech-desc" x="580" y="380">OpenAPI 3.0 文档</text>

    <rect class="tag tag-infra" x="660" y="330" width="100" height="20" rx="4"/>
    <text class="tech-name" x="710" y="345" fill="#fff">Micrometer</text>
    <text class="tech-desc" x="710" y="380">Prometheus指标输出</text>

    <rect class="tag tag-infra" x="780" y="330" width="80" height="20" rx="4"/>
    <text class="tech-name" x="820" y="345" fill="#fff">Zipkin Brave</text>
    <text class="tech-desc" x="820" y="380">分布式追踪</text>
  </g>

  <!-- Layer: Data Layer -->
  <rect class="layer" x="20" y="400" width="860" height="105"/>
  <text class="layer-title" x="30" y="420">💾 数据层 - 持久化与缓存</text>
  <g>
    <rect class="tag tag-data" x="40" y="430" width="110" height="20" rx="4"/>
    <text class="tech-name" x="95" y="445" fill="#fff">MySQL 8.0</text>
    <text class="tech-desc" x="95" y="475">业务数据 · 迁移脚本 · 索引按需设计</text>

    <rect class="tag tag-data" x="170" y="430" width="110" height="20" rx="4"/>
    <text class="tech-name" x="225" y="445" fill="#fff">Redis (Compose: 7-alpine)</text>
    <text class="tech-desc" x="225" y="475">Redis 客户端 · 缓存 · 分布式锁</text>

    <rect class="tag tag-data" x="300" y="430" width="110" height="20" rx="4"/>
    <text class="tech-name" x="355" y="445" fill="#fff">L2 Caffeine</text>
    <text class="tech-desc" x="355" y="475">堆内一级缓存 · 本地热点 · TTL</text>

    <rect class="tag tag-data" x="430" y="430" width="110" height="20" rx="4"/>
    <text class="tech-name" x="485" y="445" fill="#fff">MinIO</text>
    <text class="tech-desc" x="485" y="475">S3兼容对象存储 · 分片上传 · 秒传</text>

    <rect class="tag tag-data" x="560" y="430" width="110" height="20" rx="4"/>
    <text class="tech-name" x="615" y="445" fill="#fff">RocketMQ (可选)</text>
    <text class="tech-desc" x="615" y="475">领域事件 · 异步解耦 · 消费者幂等</text>

    <rect class="tag tag-data" x="690" y="430" width="90" height="20" rx="4"/>
    <text class="tech-name" x="735" y="445" fill="#fff">Meilisearch</text>
    <text class="tech-desc" x="735" y="475">全文检索 · 日志归集</text>

    <rect class="tag tag-data" x="800" y="430" width="60" height="20" rx="4"/>
    <text class="tech-name" x="830" y="445" fill="#fff">H2</text>
    <text class="tech-desc" x="830" y="475">单元测试内嵌DB</text>
  </g>

  <!-- Layer: Infrastructure -->
  <rect class="layer" x="20" y="515" width="860" height="85"/>
  <text class="layer-title" x="30" y="535">🐳 运行时基础设施</text>
  <g>
    <rect class="tag tag-infra" x="50" y="545" width="110" height="20" rx="4"/>
    <text class="tech-name" x="105" y="560" fill="#fff">JDK 17 LTS</text>
    <text class="tech-desc" x="105" y="590">JVM 参数按运行环境选择</text>

    <rect class="tag tag-infra" x="180" y="545" width="110" height="20" rx="4"/>
    <text class="tech-name" x="235" y="560" fill="#fff">Docker</text>
    <text class="tech-desc" x="235" y="590">多阶段构建 · 优化镜像层</text>

    <rect class="tag tag-infra" x="310" y="545" width="110" height="20" rx="4"/>
    <text class="tech-name" x="365" y="560" fill="#fff">Kubernetes</text>
    <text class="tech-desc" x="365" y="590">HPA · Ingress · ConfigMap</text>

    <rect class="tag tag-infra" x="440" y="545" width="100" height="20" rx="4"/>
    <text class="tech-name" x="490" y="560" fill="#fff">Docker Compose</text>
    <text class="tech-desc" x="490" y="590">本地开发一键启动</text>

    <rect class="tag tag-infra" x="560" y="545" width="110" height="20" rx="4"/>
    <text class="tech-name" x="615" y="560" fill="#fff">Maven 3.9</text>
    <text class="tech-desc" x="615" y="590">多模块构建 · Spotless</text>

    <rect class="tag tag-infra" x="690" y="545" width="90" height="20" rx="4"/>
    <text class="tech-name" x="735" y="560" fill="#fff">JUnit 5</text>
    <text class="tech-desc" x="735" y="590">MockMvc · StepVerifier</text>

    <rect class="tag tag-infra" x="800" y="545" width="60" height="20" rx="4"/>
    <text class="tech-name" x="830" y="560" fill="#fff">Logback</text>
    <text class="tech-desc" x="830" y="590">结构化日志 · traceId</text>
  </g>

  <!-- Layer: Monitoring & Ops -->
  <rect class="layer" x="20" y="610" width="860" height="85"/>
  <text class="layer-title" x="30" y="630">🔍 可观测性与运维</text>
  <g>
    <rect class="tag tag-mon" x="40" y="640" width="120" height="20" rx="4"/>
    <text class="tech-name" x="100" y="655" fill="#fff">Prometheus 2.53.0</text>
    <text class="tech-desc" x="100" y="685">TSDB · 指标采集 · 告警规则</text>

    <rect class="tag tag-mon" x="180" y="640" width="110" height="20" rx="4"/>
    <text class="tech-name" x="235" y="655" fill="#fff">Grafana</text>
    <text class="tech-desc" x="235" y="685">Dashboard JSON 配置</text>

    <rect class="tag tag-mon" x="310" y="640" width="110" height="20" rx="4"/>
    <text class="tech-name" x="365" y="655" fill="#fff">Alertmanager</text>
    <text class="tech-desc" x="365" y="685">飞书/邮件 Webhook通知</text>

    <rect class="tag tag-mon" x="440" y="640" width="110" height="20" rx="4"/>
    <text class="tech-name" x="495" y="655" fill="#fff">Loki</text>
    <text class="tech-desc" x="495" y="685">日志聚合检索</text>

    <rect class="tag tag-mon" x="570" y="640" width="110" height="20" rx="4"/>
    <text class="tech-name" x="625" y="655" fill="#fff">Zipkin/Jaeger</text>
    <text class="tech-desc" x="625" y="685">分布式调用链</text>

    <rect class="tag tag-mon" x="700" y="640" width="90" height="20" rx="4"/>
    <text class="tech-name" x="745" y="655" fill="#fff">Actuator</text>
    <text class="tech-desc" x="745" y="685">健康检查 · 指标端点</text>

    <rect class="tag tag-mon" x="810" y="640" width="60" height="20" rx="4"/>
    <text class="tech-name" x="840" y="655" fill="#fff">ArgoCD</text>
    <text class="tech-desc" x="840" y="685">GitOps发布</text>
  </g>

  <!-- Layer: Code Quality -->
  <rect class="layer" x="20" y="705" width="860" height="80"/>
  <text class="layer-title" x="30" y="725">✅ 工程质量与规范</text>
  <g>
    <rect class="tag tag-sec" x="40" y="735" width="120" height="20" rx="4"/>
    <text class="tech-name" x="100" y="750" fill="#fff">Spotless</text>
    <text class="tech-desc" x="100" y="775">代码格式化 · Google Java Style</text>

    <rect class="tag tag-sec" x="180" y="735" width="120" height="20" rx="4"/>
    <text class="tech-name" x="240" y="750" fill="#fff">PMD / Checkstyle</text>
    <text class="tech-desc" x="240" y="775">静态代码分析 · 缺陷检测</text>

    <rect class="tag tag-sec" x="320" y="735" width="120" height="20" rx="4"/>
    <text class="tech-name" x="380" y="750" fill="#fff">SonarQube</text>
    <text class="tech-desc" x="380" y="775">质量门禁 · 覆盖率按构建结果统计</text>

    <rect class="tag tag-sec" x="460" y="735" width="100" height="20" rx="4"/>
    <text class="tech-name" x="510" y="750" fill="#fff">Javadoc</text>
    <text class="tech-desc" x="510" y="775">全量注释 · @author @since</text>

    <rect class="tag tag-sec" x="580" y="735" width="100" height="20" rx="4"/>
    <text class="tech-name" x="630" y="750" fill="#fff">Conventional Commits</text>
    <text class="tech-desc" x="630" y="775">语义化提交规范</text>

    <rect class="tag tag-sec" x="700" y="735" width="90" height="20" rx="4"/>
    <text class="tech-name" x="745" y="750" fill="#fff">阿里编码手册</text>
    <text class="tech-desc" x="745" y="775">强制/推荐/参考</text>

    <rect class="tag tag-sec" x="810" y="735" width="60" height="20" rx="4"/>
    <text class="tech-name" x="840" y="750" fill="#fff">SCA扫描</text>
    <text class="tech-desc" x="840" y="775">组件漏洞</text>
  </g>
</svg>
