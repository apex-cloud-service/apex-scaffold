<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1400">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #1a1a1a; }
      .subtitle { font: 16px sans-serif; fill: #666; }
      .section-title { font: bold 20px sans-serif; fill: #2c3e50; }
      .flow-title { font: bold 16px sans-serif; fill: #34495e; }
      .component-title { font: bold 14px sans-serif; fill: #34495e; }
      .component-text { font: 12px sans-serif; fill: #555; }
      .label-text { font: 11px sans-serif; fill: #666; }
      .step-text { font: 11px sans-serif; fill: #444; }
      
      .flow-box { fill: white; stroke: #495057; stroke-width: 2; }
      .client-box { fill: #e3f2fd; stroke: #2196f3; stroke-width: 2; }
      .gateway-box { fill: #fff3cd; stroke: #ffc107; stroke-width: 2; }
      .app-box { fill: #d1ecf1; stroke: #17a2b8; stroke-width: 2; }
      .service-box { fill: #f1f8e9; stroke: #8bc34a; stroke-width: 2; }
      .db-box { fill: #fff3e0; stroke: #ff9800; stroke-width: 2; }
      .cache-box { fill: #fce4ec; stroke: #e91e63; stroke-width: 2; }
      .mq-box { fill: #f3e5f5; stroke: #9c27b0; stroke-width: 2; }
      .external-box { fill: #e8eaf6; stroke: #5c6bc0; stroke-width: 2; }
      
      .data-arrow { fill: none; stroke: #495057; stroke-width: 2.5; marker-end: url(#data-arrow); }
      .read-arrow { fill: none; stroke: #28a745; stroke-width: 2.5; marker-end: url(#read-arrow); }
      .write-arrow { fill: none; stroke: #dc3545; stroke-width: 2.5; marker-end: url(#write-arrow); }
      .async-arrow { fill: none; stroke: #6f42c1; stroke-width: 2.5; stroke-dasharray: 6,4; marker-end: url(#async-arrow); }
      .cache-arrow { fill: none; stroke: #e91e63; stroke-width: 2.5; stroke-dasharray: 4,2; marker-end: url(#cache-arrow); }
    </style>
    
    <marker id="data-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#495057" />
    </marker>
    <marker id="read-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#28a745" />
    </marker>
    <marker id="write-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#dc3545" />
    </marker>
    <marker id="async-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#6f42c1" />
    </marker>
    <marker id="cache-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#e91e63" />
    </marker>
  </defs>

  <!-- Title -->
  <text x="800" y="40" text-anchor="middle" class="title">Apex Scaffold 数据流转架构图</text>
  <text x="800" y="65" text-anchor="middle" class="subtitle">Data Flow Architecture &amp; Integration Patterns</text>

  <!-- ==================== Flow 1: 用户请求处理流程 ==================== -->
  <rect x="50" y="100" width="1500" height="320" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="130" class="section-title">[Chart] Flow 1: 用户请求数据流 (同步)</text>
  
  <!-- Step 1: Client -->
  <rect x="100" y="160" width="120" height="80" rx="8" class="client-box"/>
  <text x="160" y="185" text-anchor="middle" class="component-title">[User] 客户端</text>
  <text x="160" y="205" text-anchor="middle" class="label-text">Web / Mobile</text>
  <text x="160" y="225" text-anchor="middle" class="step-text">① 发起HTTP请求</text>
  
  <!-- Step 2: Gateway -->
  <rect x="280" y="160" width="140" height="80" rx="8" class="gateway-box"/>
  <text x="350" y="185" text-anchor="middle" class="component-title">[Balance] 网关层</text>
  <text x="350" y="205" text-anchor="middle" class="label-text">Nginx / ALB</text>
  <text x="350" y="225" text-anchor="middle" class="step-text">② 路由+限流</text>
  
  <!-- Step 3: Controller -->
  <rect x="480" y="160" width="140" height="80" rx="8" class="app-box"/>
  <text x="550" y="185" text-anchor="middle" class="component-title">[Target] 控制器</text>
  <text x="550" y="205" text-anchor="middle" class="label-text">RouterFunction</text>
  <text x="550" y="225" text-anchor="middle" class="step-text">③ 参数验证</text>
  
  <!-- Step 4: Service -->
  <rect x="680" y="160" width="140" height="80" rx="8" class="service-box"/>
  <text x="750" y="185" text-anchor="middle" class="component-title">[Gear] 服务层</text>
  <text x="750" y="205" text-anchor="middle" class="label-text">Application</text>
  <text x="750" y="225" text-anchor="middle" class="step-text">④ 业务逻辑</text>
  
  <!-- Step 5: Cache Check -->
  <rect x="880" y="160" width="140" height="80" rx="8" class="cache-box"/>
  <text x="950" y="185" text-anchor="middle" class="component-title">[Cache] 缓存查询</text>
  <text x="950" y="205" text-anchor="middle" class="label-text">Redis L2</text>
  <text x="950" y="225" text-anchor="middle" class="step-text">⑤ Cache Hit?</text>
  
  <!-- Step 6: Database -->
  <rect x="1080" y="160" width="140" height="80" rx="8" class="db-box"/>
  <text x="1150" y="185" text-anchor="middle" class="component-title">[DB] 数据库</text>
  <text x="1150" y="205" text-anchor="middle" class="label-text">MySQL</text>
  <text x="1150" y="225" text-anchor="middle" class="step-text">⑥ 查询数据</text>
  
  <!-- Step 7: Response -->
  <rect x="1280" y="160" width="140" height="80" rx="8" class="app-box"/>
  <text x="1350" y="185" text-anchor="middle" class="component-title">[Upload] 响应返回</text>
  <text x="1350" y="205" text-anchor="middle" class="label-text">JSON Response</text>
  <text x="1350" y="225" text-anchor="middle" class="step-text">⑦ 数据封装</text>
  
  <!-- Arrows Flow 1 -->
  <path d="M 220 200 L 280 200" class="data-arrow"/>
  <path d="M 420 200 L 480 200" class="data-arrow"/>
  <path d="M 620 200 L 680 200" class="data-arrow"/>
  <path d="M 820 200 L 880 200" class="data-arrow"/>
  
  <!-- Cache Hit/Miss -->
  <path d="M 1020 200 L 1080 200" class="read-arrow"/>
  <text x="1030" y="195" class="label-text" fill="#dc3545">Miss</text>
  
  <path d="M 950 240 L 950 270 L 1350 270 L 1350 240" class="cache-arrow"/>
  <text x="1100" y="285" class="label-text" fill="#e91e63">Cache Hit直接返回</text>
  
  <path d="M 1220 200 L 1280 200" class="data-arrow"/>
  <path d="M 1350 240 L 1350 290 L 160 290 L 160 240" class="data-arrow"/>
  
  <!-- Cache Write Back -->
  <rect x="100" y="320" width="1320" height="80" rx="8" fill="#fff9e6" stroke="#ffc107" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="120" y="345" class="flow-title">[Refresh] 缓存回写策略 (Cache-Aside Pattern)</text>
  <text x="120" y="365" class="step-text">• 读流程: 先查缓存 → Miss则查DB → 写入缓存 → 返回数据</text>
  <text x="120" y="385" class="step-text">• 写流程: 先写DB → 成功后删除缓存 → 下次读取时重新加载</text>

  <!-- ==================== Flow 2: 写操作流程 ==================== -->
  <rect x="50" y="440" width="750" height="280" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="470" class="section-title">✍️ Flow 2: 写操作数据流 (事务)</text>
  
  <!-- Write Flow Components -->
  <rect x="100" y="500" width="130" height="70" rx="8" class="app-box"/>
  <text x="165" y="525" text-anchor="middle" class="component-title">[Note] 写请求</text>
  <text x="165" y="545" text-anchor="middle" class="label-text">POST/PUT</text>
  <text x="165" y="560" text-anchor="middle" class="step-text">① 数据校验</text>
  
  <rect x="270" y="500" width="130" height="70" rx="8" class="service-box"/>
  <text x="335" y="525" text-anchor="middle" class="component-title">[Lock] 事务开始</text>
  <text x="335" y="545" text-anchor="middle" class="label-text">@Transactional</text>
  <text x="335" y="560" text-anchor="middle" class="step-text">② 开启事务</text>
  
  <rect x="440" y="500" width="130" height="70" rx="8" class="db-box"/>
  <text x="505" y="525" text-anchor="middle" class="component-title">[Disk] 主库写入</text>
  <text x="505" y="545" text-anchor="middle" class="label-text">MySQL Master</text>
  <text x="505" y="560" text-anchor="middle" class="step-text">③ INSERT/UPDATE</text>
  
  <rect x="610" y="500" width="130" height="70" rx="8" class="cache-box"/>
  <text x="675" y="525" text-anchor="middle" class="component-title">🗑️ 缓存失效</text>
  <text x="675" y="545" text-anchor="middle" class="label-text">Redis DELETE</text>
  <text x="675" y="560" text-anchor="middle" class="step-text">④ 删除缓存</text>
  
  <!-- Write Arrows -->
  <path d="M 230 535 L 270 535" class="write-arrow"/>
  <path d="M 400 535 L 440 535" class="write-arrow"/>
  <path d="M 570 535 L 610 535" class="write-arrow"/>
  
  <!-- Replication -->
  <rect x="100" y="600" width="640" height="100" rx="8" fill="#e8f5e9" stroke="#4caf50" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="120" y="625" class="flow-title">[Recycle] 数据库主从复制 (异步)</text>
  <text x="120" y="645" class="step-text">• Master写入成功后立即返回客户端</text>
  <text x="120" y="665" class="step-text">• Binlog异步复制到Slave节点 (延迟 &lt; 1s)</text>
  <text x="120" y="685" class="step-text">• 读写分离: 写Master，读Slave (注意复制延迟)</text>

  <!-- ==================== Flow 3: 异步消息流程 ==================== -->
  <rect x="850" y="440" width="700" height="280" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="870" y="470" class="section-title">[Mail] Flow 3: 异步消息数据流</text>
  
  <!-- MQ Flow -->
  <rect x="900" y="500" width="120" height="70" rx="8" class="service-box"/>
  <text x="960" y="525" text-anchor="middle" class="component-title">[Upload] 生产者</text>
  <text x="960" y="545" text-anchor="middle" class="label-text">Publisher</text>
  <text x="960" y="560" text-anchor="middle" class="step-text">① 发送消息</text>
  
  <rect x="1070" y="500" width="120" height="70" rx="8" class="mq-box"/>
  <text x="1130" y="525" text-anchor="middle" class="component-title">[Mail] RocketMQ</text>
  <text x="1130" y="545" text-anchor="middle" class="label-text">Message Broker</text>
  <text x="1130" y="560" text-anchor="middle" class="step-text">② 持久化</text>
  
  <rect x="1240" y="500" width="120" height="70" rx="8" class="service-box"/>
  <text x="1300" y="525" text-anchor="middle" class="component-title">[Download] 消费者</text>
  <text x="1300" y="545" text-anchor="middle" class="label-text">Subscriber</text>
  <text x="1300" y="560" text-anchor="middle" class="step-text">③ 异步处理</text>
  
  <rect x="1410" y="500" width="100" height="70" rx="8" class="db-box"/>
  <text x="1460" y="525" text-anchor="middle" class="component-title">[Disk] 落库</text>
  <text x="1460" y="545" text-anchor="middle" class="label-text">MySQL</text>
  <text x="1460" y="560" text-anchor="middle" class="step-text">④ 持久化</text>
  
  <!-- MQ Arrows -->
  <path d="M 1020 535 L 1070 535" class="async-arrow"/>
  <path d="M 1190 535 L 1240 535" class="async-arrow"/>
  <path d="M 1360 535 L 1410 535" class="async-arrow"/>
  
  <!-- MQ Scenarios -->
  <rect x="900" y="600" width="610" height="100" rx="8" fill="#f3e5f5" stroke="#9c27b0" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="920" y="625" class="flow-title">[Target] 消息队列应用场景</text>
  <text x="920" y="645" class="step-text">• 异步解耦: 用户注册后发送欢迎邮件、短信通知</text>
  <text x="920" y="665" class="step-text">• 削峰填谷: 订单秒杀场景，缓冲高并发请求</text>
  <text x="920" y="685" class="step-text">• 事件驱动: 审批流程变更触发下游系统同步</text>

  <!-- ==================== Flow 4: 文件上传流程 ==================== -->
  <rect x="50" y="750" width="750" height="280" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="780" class="section-title">[Folder] Flow 4: 文件上传数据流</text>
  
  <!-- File Upload Flow -->
  <rect x="100" y="810" width="110" height="70" rx="8" class="client-box"/>
  <text x="155" y="835" text-anchor="middle" class="component-title">[Upload] 前端</text>
  <text x="155" y="855" text-anchor="middle" class="label-text">FormData</text>
  <text x="155" y="870" text-anchor="middle" class="step-text">① 分片</text>
  
  <rect x="250" y="810" width="110" height="70" rx="8" class="app-box"/>
  <text x="305" y="835" text-anchor="middle" class="component-title">[Target] 后端</text>
  <text x="305" y="855" text-anchor="middle" class="label-text">FileHandler</text>
  <text x="305" y="870" text-anchor="middle" class="step-text">② 校验</text>
  
  <rect x="400" y="810" width="110" height="70" rx="8" class="external-box"/>
  <text x="455" y="835" text-anchor="middle" class="component-title">[Bucket] MinIO</text>
  <text x="455" y="855" text-anchor="middle" class="label-text">S3 API</text>
  <text x="455" y="870" text-anchor="middle" class="step-text">③ 存储</text>
  
  <rect x="550" y="810" width="110" height="70" rx="8" class="db-box"/>
  <text x="605" y="835" text-anchor="middle" class="component-title">[Disk] 元数据</text>
  <text x="605" y="855" text-anchor="middle" class="label-text">file_info</text>
  <text x="605" y="870" text-anchor="middle" class="step-text">④ 记录</text>
  
  <rect x="700" y="810" width="110" height="70" rx="8" class="external-box"/>
  <text x="755" y="835" text-anchor="middle" class="component-title">[Cloud] CDN</text>
  <text x="755" y="855" text-anchor="middle" class="label-text">TOS</text>
  <text x="755" y="870" text-anchor="middle" class="step-text">⑤ 分发</text>
  
  <!-- File Arrows -->
  <path d="M 210 845 L 250 845" class="data-arrow"/>
  <path d="M 360 845 L 400 845" class="data-arrow"/>
  <path d="M 510 845 L 550 845" class="data-arrow"/>
  <path d="M 660 845 L 700 845" class="data-arrow"/>
  
  <!-- File Upload Details -->
  <rect x="100" y="910" width="700" height="100" rx="8" fill="#fff3e0" stroke="#ff9800" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="120" y="935" class="flow-title">[Flash] 大文件优化策略</text>
  <text x="120" y="955" class="step-text">• 分片上传: 2MB/片，并发上传，服务端合并</text>
  <text x="120" y="975" class="step-text">• 断点续传: Redis记录已上传分片，续传时跳过</text>
  <text x="120" y="995" class="step-text">• 秒传: 前端计算MD5，后端查重，命中则复用</text>

  <!-- ==================== Flow 5: 外部服务调用 ==================== -->
  <rect x="850" y="750" width="700" height="280" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="870" y="780" class="section-title">[Link] Flow 5: 第三方服务集成</text>
  
  <!-- External Service Flow -->
  <rect x="900" y="810" width="110" height="70" rx="8" class="service-box"/>
  <text x="955" y="835" text-anchor="middle" class="component-title">[Target] 业务层</text>
  <text x="955" y="855" text-anchor="middle" class="label-text">Service</text>
  <text x="955" y="870" text-anchor="middle" class="step-text">① 触发</text>
  
  <rect x="1050" y="810" width="110" height="70" rx="8" class="app-box"/>
  <text x="1105" y="835" text-anchor="middle" class="component-title">[Refresh] 适配器</text>
  <text x="1105" y="855" text-anchor="middle" class="label-text">Adapter</text>
  <text x="1105" y="870" text-anchor="middle" class="step-text">② 封装</text>
  
  <rect x="1200" y="810" width="110" height="70" rx="8" class="cache-box"/>
  <text x="1255" y="835" text-anchor="middle" class="component-title">⏱️ 限流器</text>
  <text x="1255" y="855" text-anchor="middle" class="label-text">RateLimiter</text>
  <text x="1255" y="870" text-anchor="middle" class="step-text">③ 控流</text>
  
  <rect x="1350" y="810" width="110" height="70" rx="8" class="external-box"/>
  <text x="1405" y="835" text-anchor="middle" class="component-title">[Cloud] 外部API</text>
  <text x="1405" y="855" text-anchor="middle" class="label-text">3rd Party</text>
  <text x="1405" y="870" text-anchor="middle" class="step-text">④ 调用</text>
  
  <!-- External Arrows -->
  <path d="M 1010 845 L 1050 845" class="data-arrow"/>
  <path d="M 1160 845 L 1200 845" class="data-arrow"/>
  <path d="M 1310 845 L 1350 845" class="data-arrow"/>
  <path d="M 1405 810 L 1405 780 L 1105 780 L 1105 810" class="async-arrow"/>
  <text x="1200" y="775" class="label-text" fill="#6f42c1">异步回调</text>
  
  <!-- External Service Details -->
  <rect x="900" y="910" width="610" height="100" rx="8" fill="#e8eaf6" stroke="#5c6bc0" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="920" y="935" class="flow-title">[Shield] 第三方服务集成最佳实践</text>
  <text x="920" y="955" class="step-text">• 熔断降级: Sentinel保护，失败率>50%触发降级</text>
  <text x="920" y="975" class="step-text">• 超时控制: WebClient设置5s超时，防止雪崩</text>
  <text x="920" y="995" class="step-text">• 重试机制: 指数退避重试3次 (1s, 2s, 4s)</text>

  <!-- ==================== Data Consistency ==================== -->
  <rect x="50" y="1060" width="1500" height="140" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="1090" class="section-title">[SecureLock] 数据一致性保障</text>
  
  <rect x="100" y="1110" width="330" height="70" rx="8" fill="#d4edda" stroke="#28a745" stroke-width="2"/>
  <text x="120" y="1135" class="flow-title">[Check] 强一致性 (同步)</text>
  <text x="120" y="1155" class="step-text">• 数据库事务: ACID保证</text>
  <text x="120" y="1170" class="step-text">• 分布式事务: Seata AT模式</text>
  
  <rect x="480" y="1110" width="330" height="70" rx="8" fill="#fff3cd" stroke="#ffc107" stroke-width="2"/>
  <text x="500" y="1135" class="flow-title">[Balance] 最终一致性 (异步)</text>
  <text x="500" y="1155" class="step-text">• 消息队列: 事务消息保证</text>
  <text x="500" y="1170" class="step-text">• 补偿机制: 定时任务兜底</text>
  
  <rect x="860" y="1110" width="330" height="70" rx="8" fill="#fce4ec" stroke="#e91e63" stroke-width="2"/>
  <text x="880" y="1135" class="flow-title">[Refresh] 缓存一致性</text>
  <text x="880" y="1155" class="step-text">• Cache-Aside: 先DB后删缓存</text>
  <text x="880" y="1170" class="step-text">• 延时双删: 防止脏读</text>
  
  <rect x="1240" y="1110" width="300" height="70" rx="8" fill="#e1f5fe" stroke="#03a9f4" stroke-width="2"/>
  <text x="1260" y="1135" class="flow-title">[Chart] 读写分离</text>
  <text x="1260" y="1155" class="step-text">• 写Master 读Slave</text>
  <text x="1260" y="1170" class="step-text">• 注意主从延迟</text>

  <!-- ==================== Legend ==================== -->
  <rect x="50" y="1230" width="1500" height="150" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="1260" class="section-title">[Clipboard] 图例说明</text>
  
  <!-- Arrow Types -->
  <line x1="100" y1="1290" x2="200" y2="1290" class="data-arrow"/>
  <text x="220" y="1295" class="label-text">同步调用 (阻塞等待响应)</text>
  
  <line x1="100" y1="1315" x2="200" y2="1315" class="async-arrow"/>
  <text x="220" y="1320" class="label-text">异步调用 (消息队列/事件驱动)</text>
  
  <line x1="100" y1="1340" x2="200" y2="1340" class="cache-arrow"/>
  <text x="220" y="1345" class="label-text">缓存操作 (查询/失效)</text>
  
  <line x1="450" y1="1290" x2="550" y2="1290" class="read-arrow"/>
  <text x="570" y="1295" class="label-text">读操作 (查询数据)</text>
  
  <line x1="450" y1="1315" x2="550" y2="1315" class="write-arrow"/>
  <text x="570" y="1320" class="label-text">写操作 (新增/更新/删除)</text>
  
  <!-- Performance Metrics -->
  <text x="900" y="1285" class="flow-title">[Flash] 性能指标</text>
  <text x="900" y="1305" class="step-text">• 读请求延迟: P95 &lt; 50ms (缓存命中), P95 &lt; 200ms (DB查询)</text>
  <text x="900" y="1325" class="step-text">• 写请求延迟: P95 &lt; 100ms (单表), P95 &lt; 500ms (事务)</text>
  <text x="900" y="1345" class="step-text">• 消息延迟: P99 &lt; 5s (异步处理), 重试机制保证最终送达</text>
  <text x="900" y="1365" class="step-text">• 文件上传: 10MB &lt; 5s (分片并发), 支持断点续传</text>
</svg>