<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1600 1200" width="1600" height="1200">
  <!-- 
    Apex Scaffold DDD 四层逻辑架构图
    版本: 2.0
    创建时间: 2026-09-04
    说明: DDD领域驱动设计，展示接口层、应用层、领域层、基础设施层的职责划分
  -->
  
  <metadata>
    <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
             xmlns:dc="http://purl.org/dc/elements/1.1/"
             xmlns:cc="http://creativecommons.org/ns#">
      <cc:Work>
        <dc:format>image/svg+xml</dc:format>
        <dc:type>Architecture Diagram</dc:type>
        <dc:title>Apex Scaffold DDD 四层逻辑架构图</dc:title>
        <dc:creator>Apex Team</dc:creator>
        <dc:date>2026-09-04</dc:date>
        <dc:version>2.0</dc:version>
        <dc:description>展示DDD领域驱动设计的四层架构：接口层、应用层、领域层、基础设施层</dc:description>
        <dc:rights>Apache 2.0 License</dc:rights>
      </cc:Work>
    </rdf:RDF>
  </metadata>
  
  <defs>
    <style>
      .title-main {
        font: 700 32px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #0f172a;
        text-anchor: middle;
      }
      .title-sub {
        font: 500 18px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #64748b;
        text-anchor: middle;
      }
      .layer-title {
        font: 600 24px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #0f172a;
      }
      .layer-subtitle {
        font: 500 14px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #64748b;
      }
      .module-name {
        font: 600 16px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #0f172a;
        text-anchor: middle;
      }
      .module-desc {
        font: 400 13px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #64748b;
        text-anchor: middle;
      }
      .module-tech {
        font: 400 12px 'SF Mono', Monaco, 'Cascadia Code', monospace;
        fill: #94a3b8;
        text-anchor: middle;
      }
      .label-primary {
        font: 500 14px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #0f172a;
      }
      .label-secondary {
        font: 400 13px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #64748b;
      }
      .label-muted {
        font: 400 12px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #94a3b8;
      }
      .layer-bg {
        fill: #f8fafc;
        stroke: #e2e8f0;
        stroke-width: 2;
        rx: 12;
        ry: 12;
      }
      .module-box {
        fill: #ffffff;
        stroke-width: 2.5;
        rx: 10;
        ry: 10;
      }
      .interfaces-stroke { stroke: #4f46e5; }
      .application-stroke { stroke: #0891b2; }
      .domain-stroke { stroke: #059669; }
      .infrastructure-stroke { stroke: #d97706; }
      .arrow-line {
        fill: none;
        stroke: #64748b;
        stroke-width: 2.5;
      }
      .arrow-line-dashed {
        fill: none;
        stroke: #64748b;
        stroke-width: 2.5;
        stroke-dasharray: 8 4;
      }
      .highlight-badge-bg {
        fill: #4f46e5;
        rx: 6;
        ry: 6;
      }
      .highlight-badge-text {
        font: 600 13px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        fill: #ffffff;
        text-anchor: middle;
      }
    </style>
    
    <!-- 箭头标记 -->
    <marker id="arrow-default" viewBox="0 0 10 10" refX="9" refY="5" 
            markerWidth="10" markerHeight="10" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#64748b"/>
    </marker>
    
    <marker id="arrow-interfaces" viewBox="0 0 10 10" refX="9" refY="5" 
            markerWidth="10" markerHeight="10" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#4f46e5"/>
    </marker>
    
    <marker id="arrow-application" viewBox="0 0 10 10" refX="9" refY="5" 
            markerWidth="10" markerHeight="10" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#0891b2"/>
    </marker>
    
    <marker id="arrow-domain" viewBox="0 0 10 10" refX="9" refY="5" 
            markerWidth="10" markerHeight="10" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#059669"/>
    </marker>
    
    <marker id="arrow-infrastructure" viewBox="0 0 10 10" refX="9" refY="5" 
            markerWidth="10" markerHeight="10" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#d97706"/>
    </marker>
  </defs>
  
  <!-- 背景 -->
  <rect width="1600" height="1200" fill="#ffffff"/>
  
  <!-- 标题区 -->
  <g id="title-section">
    <text x="800" y="70" class="title-main">Apex Scaffold DDD 四层逻辑架构图</text>
    <text x="800" y="105" class="title-sub">领域驱动设计 · 依赖倒置原则 · 清晰职责划分 · v2.0</text>
    <line x1="50" y1="130" x2="1550" y2="130" stroke="#e2e8f0" stroke-width="1"/>
  </g>
  
  <!-- Layer 4: 接口层 (Interfaces Layer) -->
  <g id="layer-interfaces">
    <rect class="layer-bg" x="60" y="160" width="1480" height="200"/>
    
    <!-- 层标题 -->
    <text x="80" y="195" class="layer-title">第4层：接口层 (Interfaces Layer)</text>
    <text x="80" y="218" class="layer-subtitle">对外暴露API、处理协议适配、请求路由、参数验证</text>
    
    <!-- 高亮标注 -->
    <g>
      <rect class="highlight-badge-bg" x="470" y="175" width="90" height="26"/>
      <text x="515" y="194" class="highlight-badge-text">用户入口</text>
    </g>
    
    <!-- 模块组件 -->
    <rect class="module-box interfaces-stroke" x="100" y="240" width="180" height="95"/>
    <text x="190" y="270" class="module-name">REST API</text>
    <text x="190" y="292" class="module-desc">RESTful 接口</text>
    <text x="190" y="310" class="module-tech">RouterFunction</text>
    <text x="190" y="325" class="label-muted">响应式函数端点</text>
    
    <rect class="module-box interfaces-stroke" x="310" y="240" width="180" height="95"/>
    <text x="400" y="270" class="module-name">WebSocket (扩展)</text>
    <text x="400" y="292" class="module-desc">实时双向通信方向</text>
    <text x="400" y="310" class="module-tech">WebFlux 扩展点</text>
    <text x="400" y="325" class="label-muted">以运行配置为准</text>
    
    <rect class="module-box interfaces-stroke" x="520" y="240" width="180" height="95"/>
    <text x="610" y="270" class="module-name">OpenAPI Docs</text>
    <text x="610" y="292" class="module-desc">API 文档自动生成</text>
    <text x="610" y="310" class="module-tech">SpringDoc 2.8.1</text>
    <text x="610" y="325" class="label-muted">Router OpenAPI</text>
    
    <rect class="module-box interfaces-stroke" x="730" y="240" width="180" height="95"/>
    <text x="820" y="270" class="module-name">消息消费者</text>
    <text x="820" y="292" class="module-desc">异步事件监听</text>
    <text x="820" y="310" class="module-tech">RocketMQ Listener</text>
    <text x="820" y="325" class="label-muted">企业版可选启用</text>
    
    <rect class="module-box interfaces-stroke" x="930" y="240" width="120" height="95"/>
    <text x="990" y="270" class="module-name" style="font-size:14px">定时任务</text>
    <text x="990" y="292" class="module-desc">调度执行器</text>
    <text x="990" y="310" class="module-tech">@Scheduled</text>
    <text x="990" y="325" class="label-muted">Cron 表达式</text>
    
    <rect class="module-box interfaces-stroke" x="1065" y="240" width="120" height="95"/>
    <text x="1125" y="270" class="module-name" style="font-size:13px">GraphQL (扩展)</text>
    <text x="1125" y="292" class="module-desc">灵活查询接口</text>
    <text x="1125" y="310" class="module-tech" style="font-size:10px">Spring GraphQL</text>
    <text x="1125" y="325" class="label-muted">按需加载字段</text>
    
    <rect class="module-box interfaces-stroke" x="1200" y="240" width="120" height="95"/>
    <text x="1260" y="270" class="module-name" style="font-size:13px">gRPC (扩展)</text>
    <text x="1260" y="292" class="module-desc">高性能RPC</text>
    <text x="1260" y="310" class="module-tech">Protobuf</text>
    <text x="1260" y="325" class="label-muted">微服务间调用</text>
  </g>
  
  <!-- 依赖箭头: 接口层 -> 应用层 -->
  <path class="arrow-line" d="M190 360 L190 405" marker-end="url(#arrow-default)"/>
  <path class="arrow-line" d="M400 360 L400 405" marker-end="url(#arrow-default)"/>
  <path class="arrow-line" d="M610 360 L610 405" marker-end="url(#arrow-default)"/>
  <path class="arrow-line" d="M820 360 L820 405" marker-end="url(#arrow-default)"/>
  <text x="800" y="388" class="label-secondary" text-anchor="middle">调用应用服务 (Application Services)</text>
  
  <!-- Layer 3: 应用层 (Application Layer) -->
  <g id="layer-application">
    <rect class="layer-bg" x="60" y="415" width="1480" height="210"/>
    
    <!-- 层标题 -->
    <text x="80" y="450" class="layer-title">第3层：应用层 (Application Layer)</text>
    <text x="80" y="473" class="layer-subtitle">业务流程编排、事务管理、DTO转换、应用级缓存</text>
    
    <!-- 高亮标注 -->
    <g>
      <rect class="highlight-badge-bg" x="520" y="430" width="110" height="26"/>
      <text x="575" y="449" class="highlight-badge-text">业务编排层</text>
    </g>
    
    <!-- 模块组件 -->
    <rect class="module-box application-stroke" x="100" y="495" width="160" height="105"/>
    <text x="180" y="525" class="module-name">UserService</text>
    <text x="180" y="545" class="module-desc">用户管理</text>
    <text x="180" y="562" class="module-tech">用户CRUD</text>
    <text x="180" y="577" class="module-tech">角色分配</text>
    <text x="180" y="592" class="label-muted">@Transactional</text>
    
    <rect class="module-box application-stroke" x="280" y="495" width="160" height="105"/>
    <text x="360" y="525" class="module-name">AuthService</text>
    <text x="360" y="545" class="module-desc">认证授权</text>
    <text x="360" y="562" class="module-tech">登录/登出</text>
    <text x="360" y="577" class="module-tech">JWT生成</text>
    <text x="360" y="592" class="label-muted">Token管理</text>
    
    <rect class="module-box application-stroke" x="460" y="495" width="160" height="105"/>
    <text x="540" y="525" class="module-name">DeptService</text>
    <text x="540" y="545" class="module-desc">组织管理</text>
    <text x="540" y="562" class="module-tech">部门树形结构</text>
    <text x="540" y="577" class="module-tech">岗位管理</text>
    <text x="540" y="592" class="label-muted">树形数据</text>
    
    <rect class="module-box application-stroke" x="640" y="495" width="160" height="105"/>
    <text x="720" y="525" class="module-name">WorkflowService</text>
    <text x="720" y="545" class="module-desc">工作流引擎</text>
    <text x="720" y="562" class="module-tech">流程定义</text>
    <text x="720" y="577" class="module-tech">实例管理</text>
    <text x="720" y="592" class="label-muted">BPMN 2.0</text>
    
    <rect class="module-box application-stroke" x="820" y="495" width="160" height="105"/>
    <text x="900" y="525" class="module-name">StorageService</text>
    <text x="900" y="545" class="module-desc">文件存储</text>
    <text x="900" y="562" class="module-tech">上传/下载</text>
    <text x="900" y="577" class="module-tech">多策略适配</text>
    <text x="900" y="592" class="label-muted">MinIO/TOS</text>
    
    <rect class="module-box application-stroke" x="1000" y="495" width="160" height="105"/>
    <text x="1080" y="525" class="module-name">NotificationService</text>
    <text x="1080" y="545" class="module-desc">通知服务</text>
    <text x="1080" y="562" class="module-tech">站内信</text>
    <text x="1080" y="577" class="module-tech">短信/邮件</text>
    <text x="1080" y="592" class="label-muted">模板渲染</text>
    
    <rect class="module-box application-stroke" x="1180" y="495" width="160" height="105"/>
    <text x="1260" y="525" class="module-name">DTO Assembler</text>
    <text x="1260" y="545" class="module-desc">对象转换</text>
    <text x="1260" y="562" class="module-tech">Domain → DTO</text>
    <text x="1260" y="577" class="module-tech">DTO → Domain</text>
    <text x="1260" y="592" class="label-muted">MapStruct</text>
    
    <rect class="module-box application-stroke" x="1360" y="495" width="160" height="105"/>
    <text x="1440" y="525" class="module-name">CacheService</text>
    <text x="1440" y="545" class="module-desc">应用级缓存</text>
    <text x="1440" y="562" class="module-tech">热点数据</text>
    <text x="1440" y="577" class="module-tech">缓存预热</text>
    <text x="1440" y="592" class="label-muted">@Cacheable</text>
  </g>
  
  <!-- 依赖箭头: 应用层 -> 领域层 -->
  <path class="arrow-line" d="M180 625 L180 685" marker-end="url(#arrow-default)"/>
  <path class="arrow-line" d="M360 625 L360 685" marker-end="url(#arrow-default)"/>
  <path class="arrow-line" d="M540 625 L540 685" marker-end="url(#arrow-default)"/>
  <path class="arrow-line" d="M720 625 L720 685" marker-end="url(#arrow-default)"/>
  <text x="800" y="660" class="label-secondary" text-anchor="middle">依赖领域模型 + 调用仓储接口 (Repository Interface)</text>
  
  <!-- Layer 2: 领域层 (Domain Layer) -->
  <g id="layer-domain">
    <rect class="layer-bg" x="60" y="695" width="1480" height="220"/>
    
    <!-- 层标题 -->
    <text x="80" y="730" class="layer-title">第2层：领域层 (Domain Layer) — 核心业务逻辑</text>
    <text x="80" y="753" class="layer-subtitle">聚合根、实体、值对象、领域服务、仓储接口定义</text>
    
    <!-- 高亮标注 -->
    <g>
      <rect class="highlight-badge-bg" x="685" y="710" width="130" height="26"/>
      <text x="750" y="729" class="highlight-badge-text">系统核心</text>
    </g>
    
    <!-- 聚合根 -->
    <rect class="module-box domain-stroke" x="100" y="775" width="180" height="115"/>
    <text x="190" y="805" class="module-name">User 聚合根</text>
    <text x="190" y="827" class="module-desc">用户聚合</text>
    <text x="190" y="844" class="module-tech">User 实体</text>
    <text x="190" y="859" class="module-tech">Email 值对象</text>
    <text x="190" y="874" class="module-tech">changePassword()</text>
    
    <rect class="module-box domain-stroke" x="300" y="775" width="180" height="115"/>
    <text x="390" y="805" class="module-name">Role 聚合根</text>
    <text x="390" y="827" class="module-desc">角色聚合</text>
    <text x="390" y="844" class="module-tech">Role 实体</text>
    <text x="390" y="859" class="module-tech">Permission 集合</text>
    <text x="390" y="874" class="module-tech">grantPermission()</text>
    
    <rect class="module-box domain-stroke" x="500" y="775" width="180" height="115"/>
    <text x="590" y="805" class="module-name">Department 聚合</text>
    <text x="590" y="827" class="module-desc">部门聚合</text>
    <text x="590" y="844" class="module-tech">Dept 实体</text>
    <text x="590" y="859" class="module-tech">树形结构</text>
    <text x="590" y="874" class="module-tech">addChild()</text>
    
    <rect class="module-box domain-stroke" x="700" y="775" width="180" height="115"/>
    <text x="790" y="805" class="module-name">WorkflowInstance</text>
    <text x="790" y="827" class="module-desc">流程实例</text>
    <text x="790" y="844" class="module-tech">状态机</text>
    <text x="790" y="859" class="module-tech">节点流转</text>
    <text x="790" y="874" class="module-tech">approve()</text>
    
    <!-- 领域服务 -->
    <rect class="module-box domain-stroke" x="900" y="775" width="180" height="115"/>
    <text x="990" y="805" class="module-name">领域服务</text>
    <text x="990" y="827" class="module-desc">DomainService</text>
    <text x="990" y="844" class="module-tech">跨聚合协作</text>
    <text x="990" y="859" class="module-tech">复杂业务规则</text>
    <text x="990" y="874" class="module-tech">PolicyChecker</text>
    
    <!-- 仓储接口 -->
    <rect class="module-box domain-stroke" x="1100" y="775" width="200" height="115"/>
    <text x="1200" y="805" class="module-name">仓储接口定义</text>
    <text x="1200" y="827" class="module-desc">Repository Interface</text>
    <text x="1200" y="844" class="module-tech">IUserRepository</text>
    <text x="1200" y="859" class="module-tech">IRoleRepository</text>
    <text x="1200" y="874" class="module-tech">IDeptRepository</text>
    
    <!-- 工厂 -->
    <rect class="module-box domain-stroke" x="1320" y="775" width="200" height="115"/>
    <text x="1420" y="805" class="module-name">领域工厂</text>
    <text x="1420" y="827" class="module-desc">Domain Factory</text>
    <text x="1420" y="844" class="module-tech">UserFactory</text>
    <text x="1420" y="859" class="module-tech">createUser()</text>
    <text x="1420" y="874" class="module-tech">复杂对象创建</text>
  </g>
  
  <!-- Layer 1: 基础设施层 (Infrastructure Layer) -->
  <g id="layer-infrastructure">
    <rect class="layer-bg" x="60" y="935" width="1480" height="190"/>
    
    <!-- 层标题 -->
    <text x="80" y="970" class="layer-title">第1层：基础设施层 (Infrastructure Layer)</text>
    <text x="80" y="993" class="layer-subtitle">技术实现细节、第三方集成、基础组件、仓储实现</text>
    
    <!-- 高亮标注 -->
    <g>
      <rect class="highlight-badge-bg" x="645" y="950" width="110" height="26"/>
      <text x="700" y="969" class="highlight-badge-text">技术支撑</text>
    </g>
    
    <!-- 模块组件 -->
    <rect class="module-box infrastructure-stroke" x="80" y="1015" width="150" height="90"/>
    <text x="155" y="1042" class="module-name">仓储实现</text>
    <text x="155" y="1062" class="module-desc">MyBatis-Plus</text>
    <text x="155" y="1077" class="module-tech">UserRepoImpl</text>
    <text x="155" y="1092" class="label-muted">CRUD + 复杂查询</text>
    
    <rect class="module-box infrastructure-stroke" x="250" y="1015" width="150" height="90"/>
    <text x="325" y="1042" class="module-name">缓存适配器</text>
    <text x="325" y="1062" class="module-desc">Redis / Caffeine</text>
    <text x="325" y="1077" class="module-tech">L1/L2 缓存</text>
    <text x="325" y="1092" class="label-muted">缓存穿透保护</text>
    
    <rect class="module-box infrastructure-stroke" x="420" y="1015" width="150" height="90"/>
    <text x="495" y="1042" class="module-name">消息发布器</text>
    <text x="495" y="1062" class="module-desc">RocketMQ</text>
    <text x="495" y="1077" class="module-tech">EventPublisher</text>
    <text x="495" y="1092" class="label-muted">事务消息</text>
    
    <rect class="module-box infrastructure-stroke" x="590" y="1015" width="150" height="90"/>
    <text x="665" y="1042" class="module-name">存储适配器</text>
    <text x="665" y="1062" class="module-desc">MinIO / TOS</text>
    <text x="665" y="1077" class="module-tech">本地/对象存储</text>
    <text x="665" y="1092" class="label-muted">策略模式</text>
    
    <rect class="module-box infrastructure-stroke" x="760" y="1015" width="150" height="90"/>
    <text x="835" y="1042" class="module-name">外部接口</text>
    <text x="835" y="1062" class="module-desc">HTTP Client</text>
    <text x="835" y="1077" class="module-tech">SMS / 邮件</text>
    <text x="835" y="1092" class="label-muted">WebClient</text>
    
    <rect class="module-box infrastructure-stroke" x="930" y="1015" width="150" height="90"/>
    <text x="1005" y="1042" class="module-name">搜索引擎</text>
    <text x="1005" y="1062" class="module-desc">Elasticsearch</text>
    <text x="1005" y="1077" class="module-tech">全文检索</text>
    <text x="1005" y="1092" class="label-muted">分词/高亮</text>
    
    <rect class="module-box infrastructure-stroke" x="1100" y="1015" width="150" height="90"/>
    <text x="1175" y="1042" class="module-name">定时调度</text>
    <text x="1175" y="1062" class="module-desc">Quartz / XXL-Job</text>
