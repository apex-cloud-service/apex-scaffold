%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#eff6ff','primaryTextColor':'#0f172a','primaryBorderColor':'#3b82f6','lineColor':'#64748b','fontFamily':'sans-serif'}}}%%
erDiagram
    sys_tenant ||--o{ sys_user : "tenant_id"
    sys_tenant ||--o{ sys_role : "tenant_id"
    sys_dept ||--o{ sys_dept : "parent_id 树形"
    sys_menu ||--o{ sys_menu : "parent_id 树形"

    sys_user ||--o{ sys_user_role : "user_id"
    sys_role ||--o{ sys_user_role : "role_id"
    sys_role ||--o{ sys_role_permission : "role_id"
    sys_permission ||--o{ sys_role_permission : "permission_id"

    sys_user {
        bigint id PK "主键 雪花"
        varchar open_id UK "uk_open_id 微信登录"
        varchar union_id "微信 UnionID"
        varchar nick_name "昵称"
        varchar phone "手机号"
        varchar email "V37 用户邮箱"
        varchar keycloak_sub UK "uk_keycloak_sub SSO 标识"
        varchar access_token "微信 AccessToken"
        varchar register_channel "V21 注册来源"
        varchar tenant_id FK "V14 租户"
        int status "0-禁用 1-正常"
        int version "乐观锁"
        tinyint deleted "逻辑删除"
    }

    sys_role {
        bigint id PK "主键"
        varchar name "角色名"
        varchar code UK "uk_tenant_code 租户内唯一"
        int data_scope "V18 数据权限 1全部/2本部门/3部门及以下/4本人/5自定义"
        varchar tenant_id FK "租户"
        int status "状态"
        tinyint deleted "逻辑删除"
    }

    sys_permission {
        bigint id PK "主键"
        varchar name "权限名"
        varchar code "权限编码"
        varchar description "描述"
        int type "类型"
        int status "状态"
        tinyint deleted "逻辑删除"
    }

    sys_menu {
        bigint id PK "主键"
        bigint parent_id FK "上级菜单"
        varchar menu_name "菜单名"
        varchar menu_type "菜单类型"
        varchar path "路由"
        varchar component "组件"
        varchar perms "权限标识"
        int sort "排序"
        int status "状态"
        tinyint deleted "逻辑删除"
    }

    sys_dept {
        bigint id PK "主键"
        bigint parent_id FK "上级部门"
        varchar ancestors "祖级路径"
        varchar name "部门名"
        varchar leader "负责人"
        int order_num "排序"
        int status "状态"
        tinyint deleted "逻辑删除"
    }

    sys_tenant {
        bigint id PK "主键"
        varchar tenant_code UK "uk_sys_tenant_code"
        varchar tenant_name "租户名"
        varchar admin_user_id "管理员用户"
        varchar package_code "套餐编码"
        varchar status "状态"
        int max_users "用户上限"
        int max_storage_mb "存储上限 MB"
        datetime expire_time "过期时间"
        int version "乐观锁"
        tinyint deleted "逻辑删除"
    }

    sys_user_role {
        bigint id PK "主键"
        bigint user_id FK "用户"
        bigint role_id FK "角色"
        varchar tenant_id FK "租户"
    }

    sys_role_permission {
        bigint id PK "主键"
        bigint role_id FK "角色"
        bigint permission_id FK "权限"
        varchar tenant_id FK "租户"
    }
