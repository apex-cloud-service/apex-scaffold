<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 750" width="1000" height="750">
  <defs>
    <style>
      .title { font: 700 20px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .subtitle { font: 12px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
      .stage-title { font: 600 14px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .step { fill: #ffffff; stroke-width: 2; rx: 6; }
      .step-dev { stroke: #4f46e5; }
      .step-build { stroke: #059669; }
      .step-test { stroke: #d97706; }
      .step-deploy { stroke: #dc2626; }
      .label { font: 500 12px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .desc { font: 10px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
      .time { font: 9px system-ui, -apple-system, sans-serif; fill: #059669; text-anchor: middle; }
      .arrow { stroke: #64748b; stroke-width: 2; fill: none; marker-end: url(#arr); }
      .lane { fill: #f8fafc; stroke: #e2e8f0; stroke-width: 1; rx: 6; }
    </style>
    <marker id="arr" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <polygon points="0 0, 8 4, 0 8" fill="#64748b"/>
    </marker>
  </defs>

  <text class="title" x="500" y="30">CI/CD 流水线详细流程图</text>
  <text class="subtitle" x="500" y="50">Git Push → Build → Test → Scan → Deploy · 全自动化交付流水线 · 多环境部署</text>

  <!-- Lane 1: Development -->
  <rect class="lane" x="20" y="70" width="960" height="90"/>
  <text class="stage-title" x="500" y="92">📝 开发阶段 (Development)</text>

  <rect class="step step-dev" x="40" y="105" width="110" height="45"/>
  <text class="label" x="95" y="123">代码提交</text>
  <text class="desc" x="95" y="138">git push</text>

  <rect class="step step-dev" x="170" y="105" width="110" height="45"/>
  <text class="label" x="225" y="123">代码审查</text>
  <text class="desc" x="225" y="138">Code Review</text>

  <rect class="step step-dev" x="300" y="105" width="110" height="45"/>
  <text class="label" x="355" y="123">合并请求</text>
  <text class="desc" x="355" y="138">Merge to main</text>

  <rect class="step step-dev" x="430" y="105" width="110" height="45"/>
  <text class="label" x="485" y="123">触发构建</text>
  <text class="desc" x="485" y="138">Webhook</text>

  <path class="arrow" d="M 150 127 L 170 127"/>
  <path class="arrow" d="M 280 127 L 300 127"/>
  <path class="arrow" d="M 410 127 L 430 127"/>

  <!-- Lane 2: Build -->
  <rect class="lane" x="20" y="175" width="960" height="110"/>
  <text class="stage-title" x="500" y="197">🔨 构建阶段 (Build) - 约 5min</text>

  <rect class="step step-build" x="40" y="210" width="100" height="60"/>
  <text class="label" x="90" y="228">拉取代码</text>
  <text class="desc" x="90" y="243">git clone</text>
  <text class="time" x="90" y="262">~30s</text>

  <rect class="step step-build" x="160" y="210" width="100" height="60"/>
  <text class="label" x="210" y="228">依赖安装</text>
  <text class="desc" x="210" y="243">Maven/npm</text>
  <text class="time" x="210" y="262">~2min</text>

  <rect class="step step-build" x="280" y="210" width="100" height="60"/>
  <text class="label" x="330" y="228">编译构建</text>
  <text class="desc" x="330" y="243">mvn package</text>
  <text class="time" x="330" y="262">~2min</text>

  <rect class="step step-build" x="400" y="210" width="100" height="60"/>
  <text class="label" x="450" y="228">镜像构建</text>
  <text class="desc" x="450" y="243">Docker build</text>
  <text class="time" x="450" y="262">~1min</text>

  <rect class="step step-build" x="520" y="210" width="100" height="60"/>
  <text class="label" x="570" y="228">推送镜像</text>
  <text class="desc" x="570" y="243">Harbor push</text>
  <text class="time" x="570" y="262">~30s</text>

  <path class="arrow" d="M 140 240 L 160 240"/>
  <path class="arrow" d="M 260 240 L 280 240"/>
  <path class="arrow" d="M 380 240 L 400 240"/>
  <path class="arrow" d="M 500 240 L 520 240"/>

  <path class="arrow" d="M 485 150 L 485 180 L 90 180 L 90 210"/>

  <!-- Lane 3: Test -->
  <rect class="lane" x="20" y="300" width="960" height="130"/>
  <text class="stage-title" x="500" y="322">🧪 测试阶段 (Test) - 约 8min</text>

  <rect class="step step-test" x="40" y="335" width="100" height="75"/>
  <text class="label" x="90" y="353">单元测试</text>
  <text class="desc" x="90" y="368">JUnit 5</text>
  <text class="desc" x="90" y="383">1200+ cases</text>
  <text class="time" x="90" y="402">~3min</text>

  <rect class="step step-test" x="160" y="335" width="100" height="75"/>
  <text class="label" x="210" y="353">集成测试</text>
  <text class="desc" x="210" y="368">Testcontainers</text>
  <text class="desc" x="210" y="383">300+ cases</text>
  <text class="time" x="210" y="402">~4min</text>

  <rect class="step step-test" x="280" y="335" width="100" height="75"/>
  <text class="label" x="330" y="353">API 测试</text>
  <text class="desc" x="330" y="368">Postman/REST</text>
  <text class="desc" x="330" y="383">150+ cases</text>
  <text class="time" x="330" y="402">~1min</text>

  <rect class="step step-test" x="400" y="335" width="100" height="75"/>
  <text class="label" x="450" y="353">覆盖率检查</text>
  <text class="desc" x="450" y="368">JaCoCo</text>
  <text class="desc" x="450" y="383">> 70%</text>
  <text class="time" x="450" y="402">~30s</text>

  <rect class="step step-test" x="520" y="335" width="100" height="75"/>
  <text class="label" x="570" y="353">性能测试</text>
  <text class="desc" x="570" y="368">JMeter</text>
  <text class="desc" x="570" y="383">基准测试</text>
  <text class="time" x="570" y="402">~2min</text>

  <path class="arrow" d="M 140 372 L 160 372"/>
  <path class="arrow" d="M 260 372 L 280 372"/>
  <path class="arrow" d="M 380 372 L 400 372"/>
  <path class="arrow" d="M 500 372 L 520 372"/>

  <path class="arrow" d="M 570 270 L 570 300 L 90 300 L 90 335"/>

  <!-- Lane 4: Security Scan -->
  <rect class="lane" x="20" y="445" width="960" height="110"/>
  <text class="stage-title" x="500" y="467">🔒 安全扫描阶段 (Security) - 约 3min</text>

  <rect class="step step-test" x="40" y="480" width="110" height="60"/>
  <text class="label" x="95" y="498">依赖扫描</text>
  <text class="desc" x="95" y="513">OWASP Dependency</text>
  <text class="time" x="95" y="532">~1min</text>

  <rect class="step step-test" x="170" y="480" width="110" height="60"/>
  <text class="label" x="225" y="498">代码扫描</text>
  <text class="desc" x="225" y="513">SonarQube</text>
  <text class="time" x="225" y="532">~1.5min</text>

  <rect class="step step-test" x="300" y="480" width="110" height="60"/>
  <text class="label" x="355" y="498">镜像扫描</text>
  <text class="desc" x="355" y="513">Trivy/Clair</text>
  <text class="time" x="355" y="532">~30s</text>

  <rect class="step step-test" x="430" y="480" width="110" height="60"/>
  <text class="label" x="485" y="498">质量门禁</text>
  <text class="desc" x="485" y="513">Quality Gate</text>
  <text class="time" x="485" y="532">~5s</text>

  <path class="arrow" d="M 150 510 L 170 510"/>
  <path class="arrow" d="M 280 510 L 300 510"/>
  <path class="arrow" d="M 410 510 L 430 510"/>

  <path class="arrow" d="M 570 430 L 570 460 L 95 460 L 95 480"/>

  <!-- Lane 5: Deploy -->
  <rect class="lane" x="20" y="570" width="960" height="110"/>
  <text class="stage-title" x="500" y="592">🚀 部署阶段 (Deploy) - 约 2min</text>

  <rect class="step step-deploy" x="40" y="605" width="100" height="60"/>
  <text class="label" x="90" y="623">更新配置</text>
  <text class="desc" x="90" y="638">ConfigMap</text>
  <text class="time" x="90" y="657">~10s</text>

  <rect class="step step-deploy" x="160" y="605" width="100" height="60"/>
  <text class="label" x="210" y="623">滚动发布</text>
  <text class="desc" x="210" y="638">K8s Rolling</text>
  <text class="time" x="210" y="657">~1.5min</text>

  <rect class="step step-deploy" x="280" y="605" width="100" height="60"/>
  <text class="label" x="330" y="623">健康检查</text>
  <text class="desc" x="330" y="638">/actuator/health</text>
  <text class="time" x="330" y="657">~15s</text>

  <rect class="step step-deploy" x="400" y="605" width="100" height="60"/>
  <text class="label" x="450" y="623">烟雾测试</text>
  <text class="desc" x="450" y="638">Smoke Test</text>
  <text class="time" x="450" y="657">~30s</text>

  <rect class="step step-deploy" x="520" y="605" width="100" height="60"/>
  <text class="label" x="570" y="623">✓ 部署成功</text>
  <text class="desc" x="570" y="638">通知飞书</text>
  <text class="time" x="570" y="657">完成</text>

  <path class="arrow" d="M 140 635 L 160 635"/>
  <path class="arrow" d="M 260 635 L 280 635"/>
  <path class="arrow" d="M 380 635 L 400 635"/>
  <path class="arrow" d="M 500 635 L 520 635"/>

  <path class="arrow" d="M 485 540 L 485 570 L 90 570 L 90 605"/>

  <!-- Rollback Path -->
  <rect class="step step-deploy" x="660" y="335" width="110" height="60" stroke-dasharray="4 2"/>
  <text class="label" x="715" y="353">回滚流程</text>
  <text class="desc" x="715" y="368">失败时触发</text>
  <text class="desc" x="715" y="383">kubectl rollout undo</text>

  <path class="arrow" d="M 620 372 L 660 372" stroke-dasharray="4 2" stroke="#dc2626"/>
  <text class="desc" x="640" y="395" fill="#dc2626" text-anchor="middle">失败</text>

  <!-- Summary -->
  <text class="desc" x="500" y="715" text-anchor="middle" fill="#059669">
    💡 总耗时约 18min | 全自动化 | 失败自动回滚 | 多环境支持 (dev/staging/prod)
  </text>
  <text class="desc" x="500" y="735" text-anchor="middle" fill="#64748b">
    工具: GitHub Actions / Jenkins / GitLab CI · K8s · Harbor · SonarQube · JaCoCo
  </text>
</svg>