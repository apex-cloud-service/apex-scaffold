<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 1100">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #0f172a; }
      .subtitle { font: 16px sans-serif; fill: #475569; }
      .zone-title { font: bold 20px sans-serif; fill: #1e293b; }
      .component-title { font: bold 14px sans-serif; fill: #334155; }
      .component-text { font: 12px sans-serif; fill: #475569; }
      .label-text { font: 11px sans-serif; fill: #64748b; }
      .rule-text { font: 10px monospace; fill: #334155; }
      
      .internet-zone { fill: #dbeafe; stroke: #2563eb; stroke-width: 3; }
      .dmz-zone { fill: #fef3c7; stroke: #d97706; stroke-width: 3; }
      .app-zone { fill: #ccfbf1; stroke: #0891b2; stroke-width: 3; }
      .data-zone { fill: #d1fae5; stroke: #059669; stroke-width: 3; }
      .management-zone { fill: #fecaca; stroke: #dc2626; stroke-width: 3; }
      
      .firewall-box { fill: #dc2626; stroke: #991b1b; stroke-width: 2; }
      .router-box { fill: #2563eb; stroke: #1e40af; stroke-width: 2; }
      .component-box { fill: white; stroke: #64748b; stroke-width: 1.5; }
      
      .allow-arrow { stroke: #059669; stroke-width: 2.5; fill: none; marker-end: url(#allow-arrow); }
      .deny-arrow { stroke: #dc2626; stroke-width: 2.5; fill: none; stroke-dasharray: 5,5; }
      .network-line { stroke: #64748b; stroke-width: 2; }
      
      .security-badge { fill: #dc2626; }
      .high-security { fill: #991b1b; }
      .medium-security { fill: #d97706; }
      .low-security { fill: #d97706; }
    </style>
    
    <marker id="allow-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#059669" />
    </marker>
    
    <!-- ========== 图标定义 ========== -->
    <!-- 云图标 -->
    <g id="icon-cloud">
      <path d="M 6 14 C 4 14 2 12 2 10 C 2 8.5 3 7 4.5 6.5 C 4.2 5.7 4 4.9 4 4 C 4 1.8 5.8 0 8 0 C 9.4 0 10.6 0.7 11.4 1.8 C 11.9 1.6 12.4 1.5 13 1.5 C 15 1.5 16.5 3 16.5 5 C 18 5.5 19 6.9 19 8.5 C 19 10.4 17.4 12 15.5 12 L 15 12" 
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    
    <!-- 用户组图标 -->
    <g id="icon-users">
      <circle cx="8" cy="6" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="13" cy="7" r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M 3 16 C 3 13 5 11 8 11 C 11 11 13 13 13 16" 
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M 13 16 C 13 14 14.5 12.5 16.5 12.5 C 18.5 12.5 20 14 20 16" 
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </g>
    
    <!-- 盾牌图标 -->
    <g id="icon-shield">
      <path d="M 10 1 L 17 4 L 17 9 C 17 13 14 16 10 17 C 6 16 3 13 3 9 L 3 4 Z" 
            fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M 7 9 L 9 11 L 13 7" 
            fill="none" stroke="currentColor" stroke-width="1.5" 
            stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    
    <!-- 火焰图标 (防火墙) -->
    <g id="icon-firewall">
      <path d="M 10 2 C 8 4 7 6 7 8 C 7 11 9 13 12 13 C 15 13 17 11 17 8 C 17 6 16 4 14 2 C 13.5 4 12.5 5 11 5 C 11 4 10.5 3 10 2 Z" 
            fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
      <circle cx="12" cy="9" r="1.5" fill="currentColor"/>
    </g>
    
    <!-- 负载均衡器图标 -->
    <g id="icon-load-balancer">
      <rect x="2" y="3" width="16" height="3" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <rect x="2" y="8" width="16" height="3" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <rect x="2" y="13" width="16" height="3" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <line x1="5" y1="4.5" x2="5" y2="4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="5" y1="9.5" x2="5" y2="9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="5" y1="14.5" x2="5" y2="14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </g>
    
    <!-- DNS/搜索图标 -->
    <g id="icon-dns">
      <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <line x1="13.5" y1="13.5" x2="17" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="9" cy="9" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
    </g>
    
    <!-- CDN图标 -->
    <g id="icon-cdn">
      <circle cx="5" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="15" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="10" cy="5" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <line x1="7.5" y1="7" x2="7" y2="8.5" stroke="currentColor" stroke-width="1.5"/>
      <line x1="12.5" y1="7" x2="13" y2="8.5" stroke="currentColor" stroke-width="1.5"/>
      <line x1="8" y1="10" x2="12" y2="10" stroke="currentColor" stroke-width="1.5"/>
    </g>
    
    <!-- 服务器图标 -->
    <g id="icon-server">
      <rect x="2" y="2" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <line x1="2" y1="7" x2="18" y2="7" stroke="currentColor" stroke-width="1.5"/>
      <line x1="2" y1="12" x2="18" y2="12" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="5" cy="4.5" r="0.8" fill="currentColor"/>
      <circle cx="5" cy="9.5" r="0.8" fill="currentColor"/>
      <circle cx="5" cy="15" r="0.8" fill="currentColor"/>
    </g>
  </defs>

  <!-- Title -->
  <text x="700" y="40" text-anchor="middle" class="title">Apex Scaffold 网络架构图</text>
  <text x="700" y="65" text-anchor="middle" class="subtitle">Network Architecture &amp; Security Zones</text>

  <!-- Internet Zone -->
  <rect x="50" y="100" width="1300" height="140" rx="10" class="internet-zone"/>
  <use href="#icon-cloud" x="50" y="108" width="24" height="24" color="#2563eb"/>
  <text x="80" y="130" class="zone-title">公网区域 (Internet)</text>
  <circle cx="100" cy="185" r="8" class="low-security"/>
  <text x="115" y="192" class="label-text">安全等级: 公开</text>
  
  <!-- Internet Users -->
  <ellipse cx="200" cy="175" rx="70" ry="45" fill="#fff" stroke="#2563eb" stroke-width="2"/>
  <use href="#icon-users" x="185" y="158" width="20" height="20" color="#2563eb"/>
  <text x="200" y="185" text-anchor="middle" class="component-title">外部用户</text>
  <text x="200" y="200" text-anchor="middle" class="label-text">Web/Mobile/API</text>
  
  <!-- CDN -->
  <rect x="340" y="140" width="130" height="80" rx="8" class="component-box" fill="#d1fae5"/>
  <use href="#icon-cdn" x="375" y="148" width="20" height="20" color="#059669"/>
  <text x="405" y="180" text-anchor="middle" class="component-title">CDN</text>
  <text x="405" y="195" text-anchor="middle" class="label-text">全球加速</text>
  <text x="405" y="210" text-anchor="middle" class="label-text">静态资源分发</text>
  
  <!-- DNS -->
  <rect x="510" y="140" width="130" height="80" rx="8" class="component-box" fill="#e1f5fe"/>
  <text x="575" y="185" text-anchor="middle" class="label-text">域名解析</text>
  <text x="575" y="202" text-anchor="middle" class="label-text">GeoDNS智能调度</text>

  <!-- Firewall 1 (Internet to DMZ) -->
  <rect x="700" y="120" width="180" height="100" rx="8" class="firewall-box"/>
  <use href="#icon-firewall" x="780" y="128" width="20" height="20" color="white"/>
  <text x="790" y="155" text-anchor="middle" class="component-title" fill="white">防火墙-1</text>
  <text x="790" y="175" text-anchor="middle" class="label-text" fill="white">Internet → DMZ</text>
  <text x="790" y="190" text-anchor="middle" class="rule-text" fill="white">Allow: 443 (HTTPS)</text>
  <text x="790" y="205" text-anchor="middle" class="rule-text" fill="white">Deny: All Others</text>
  <circle cx="750" cy="125" r="5" fill="white"/>
  <text x="760" cy="130" class="label-text" fill="white" font-size="10">状态检测</text>

  <!-- Arrows Internet Zone -->
  <path d="M 270 175 L 340 175" class="allow-arrow"/>
  <path d="M 470 175 L 510 175" class="allow-arrow"/>
  <path d="M 640 175 L 700 175" class="allow-arrow"/>
  <text x="285" y="170" class="label-text" fill="#28a745">HTTPS</text>

  <!-- DMZ Zone -->
  <rect x="50" y="270" width="1300" height="160" rx="10" class="dmz-zone"/>
  <circle cx="100" cy="345" r="8" class="medium-security"/>
  <text x="115" y="352" class="label-text">安全等级: 中等</text>
  
  <!-- WAF -->
  <rect x="120" y="320" width="140" height="90" rx="8" class="component-box" fill="#ffebee"/>
  <text x="190" y="365" text-anchor="middle" class="label-text">Web应用防火墙</text>
  <text x="190" y="382" text-anchor="middle" class="label-text">SQL注入防护</text>
  <text x="190" y="399" text-anchor="middle" class="label-text">XSS/CSRF过滤</text>
  
  <!-- Load Balancer -->
  <rect x="300" y="320" width="150" height="90" rx="8" class="router-box"/>
  <text x="375" y="365" text-anchor="middle" class="label-text" fill="white">ALB / Nginx</text>
  <text x="375" y="382" text-anchor="middle" class="label-text" fill="white">:443 (HTTPS)</text>
  <text x="375" y="399" text-anchor="middle" class="label-text" fill="white">SSL Termination</text>
  
  <!-- NAT Gateway -->
  <rect x="490" y="320" width="140" height="90" rx="8" class="router-box"/>
  <use href="#icon-cloud" x="540" y="328" width="20" height="20" color="white"/>
  <text x="560" y="358" text-anchor="middle" class="component-title" fill="white">NAT网关</text>
  <text x="560" y="375" text-anchor="middle" class="label-text" fill="white">出网访问</text>
  <text x="560" y="390" text-anchor="middle" class="label-text" fill="white">公网IP转换</text>
  <text x="560" y="405" text-anchor="middle" class="label-text" fill="white">外部API调用</text>
  
  <!-- Bastion Host -->
  <rect x="670" y="320" width="140" height="90" rx="8" class="component-box" fill="#fecaca"/>
  <use href="#icon-server" x="720" y="328" width="20" height="20" color="#dc2626"/>
  <text x="740" y="358" text-anchor="middle" class="component-title">跳板机</text>
  <text x="740" y="375" text-anchor="middle" class="label-text">Bastion Host</text>
  <text x="740" y="390" text-anchor="middle" class="label-text">:22 (SSH)</text>
  <text x="740" y="405" text-anchor="middle" class="label-text">VPN + 2FA</text>

  <!-- Arrows in DMZ -->
  <path d="M 790 220 L 790 250 L 190 250 L 190 320" class="allow-arrow"/>
  <path d="M 260 365 L 300 365" class="allow-arrow"/>
  <text x="265" y="360" class="label-text" fill="#28a745">过滤后流量</text>

  <!-- Firewall 2 (DMZ to App) -->
  <rect x="920" y="290" width="200" height="120" rx="8" class="firewall-box"/>
  <text x="1020" y="335" text-anchor="middle" class="label-text" fill="white">DMZ → Application</text>
  <text x="1020" y="355" text-anchor="middle" class="rule-text" fill="white">Allow: 8080 (from LB)</text>
  <text x="1020" y="370" text-anchor="middle" class="rule-text" fill="white">Allow: 22 (from Bastion)</text>
  <text x="1020" y="385" text-anchor="middle" class="rule-text" fill="white">Deny: All Direct Access</text>
  <text x="1020" y="400" text-anchor="middle" class="rule-text" fill="white">IDS/IPS Enabled</text>
  <circle cx="970" cy="295" r="5" fill="white"/>
  <text x="980" cy="300" class="label-text" fill="white" font-size="10">深度包检测</text>

  <!-- Arrows from DMZ to Firewall -->
  <path d="M 450 365 L 920 365" class="allow-arrow"/>
  <path d="M 810 365 L 810 340 L 740 340 L 740 320" class="allow-arrow" stroke="#dc3545"/>
  <text x="460" y="360" class="label-text" fill="#28a745">业务流量</text>
  <text x="815" y="335" class="label-text" fill="#dc3545">运维通道</text>

  <!-- Application Zone -->
  <rect x="50" y="460" width="1300" height="180" rx="10" class="app-zone"/>
  <circle cx="100" cy="535" r="8" class="high-security"/>
  <text x="115" y="542" class="label-text">安全等级: 高</text>
  
  <!-- App Cluster -->
  <rect x="100" y="510" width="450" height="110" rx="8" fill="#fff" stroke="#0891b2" stroke-width="2" stroke-dasharray="8,4"/>
  <text x="120" y="535" class="component-title">Apex 应用集群 (K8s)</text>
  
  <!-- App Pods -->
  <rect x="130" y="550" width="100" height="60" rx="6" class="component-box" fill="#f1f8e9"/>
  <text x="180" y="570" text-anchor="middle" class="component-text">Pod-1</text>
  <text x="180" y="587" text-anchor="middle" class="label-text">:8080</text>
  <text x="180" y="602" text-anchor="middle" class="label-text">2C4G</text>
  
  <rect x="250" y="550" width="100" height="60" rx="6" class="component-box" fill="#f1f8e9"/>
  <text x="300" y="570" text-anchor="middle" class="component-text">Pod-2</text>
  <text x="300" y="587" text-anchor="middle" class="label-text">:8080</text>
  <text x="300" y="602" text-anchor="middle" class="label-text">2C4G</text>
  
  <rect x="370" y="550" width="100" height="60" rx="6" class="component-box" fill="#f1f8e9"/>
  <text x="420" y="570" text-anchor="middle" class="component-text">Pod-N</text>
  <text x="420" y="587" text-anchor="middle" class="label-text">:8080</text>
  <text x="420" y="602" text-anchor="middle" class="label-text">2C4G</text>
  
  <!-- Service Mesh -->
  <rect x="580" y="510" width="180" height="110" rx="8" class="component-box" fill="#f3e5f5"/>
  <text x="670" y="535" text-anchor="middle" class="component-title">[Web] Service Mesh</text>
  <text x="670" y="555" text-anchor="middle" class="label-text">Istio (可选)</text>
  <text x="670" y="575" text-anchor="middle" class="label-text">• 流量管理</text>
  <text x="670" y="592" text-anchor="middle" class="label-text">• mTLS加密</text>
  <text x="670" y="609" text-anchor="middle" class="label-text">• 熔断降级</text>
  
  <!-- Registry -->
  <rect x="790" y="510" width="150" height="110" rx="8" class="component-box" fill="#e8eaf6"/>
  <text x="865" y="535" text-anchor="middle" class="component-title">[Compass] Nacos</text>
  <text x="865" y="555" text-anchor="middle" class="label-text">服务注册</text>
  <text x="865" y="575" text-anchor="middle" class="label-text">配置中心</text>
  <text x="865" y="592" text-anchor="middle" class="label-text">:8848</text>
  <text x="865" y="609" text-anchor="middle" class="label-text">内网访问</text>

  <!-- Firewall 3 (App to Data) -->
  <rect x="980" y="480" width="200" height="140" rx="8" class="firewall-box"/>
  <text x="1080" y="525" text-anchor="middle" class="label-text" fill="white">Application → Data</text>
  <text x="1080" y="545" text-anchor="middle" class="rule-text" fill="white">Allow: 3306 (MySQL)</text>
  <text x="1080" y="560" text-anchor="middle" class="rule-text" fill="white">Allow: 6379 (Redis)</text>
  <text x="1080" y="575" text-anchor="middle" class="rule-text" fill="white">Allow: 9876 (RocketMQ)</text>
  <text x="1080" y="590" text-anchor="middle" class="rule-text" fill="white">Allow: 9000 (MinIO)</text>
  <text x="1080" y="605" text-anchor="middle" class="rule-text" fill="white">Source IP Whitelist</text>

  <!-- Arrows from Firewall-2 to App -->
  <path d="M 1020 410 L 1020 440 L 325 440 L 325 510" class="allow-arrow"/>
  <text x="330" y="475" class="label-text" fill="#059669">HTTP请求</text>
  
  <!-- Arrows from App to Firewall-3 -->
  <path d="M 550 565 L 980 565" class="allow-arrow"/>
  <text x="730" y="560" class="label-text" fill="#28a745">数据访问</text>

  <!-- Data Zone -->
  <rect x="50" y="670" width="1300" height="180" rx="10" class="data-zone"/>
  <text x="70" y="700" class="zone-title">[Disk] 数据区域 (Data)</text>
  <circle cx="100" cy="745" r="8" class="high-security"/>
  <text x="115" y="752" class="label-text">安全等级: 最高</text>
  
  <!-- MySQL -->
  <rect x="100" y="720" width="140" height="110" rx="8" class="component-box" fill="#fff3e0"/>
  <text x="170" y="745" text-anchor="middle" class="component-title">[DB] MySQL</text>
  <text x="170" y="765" text-anchor="middle" class="label-text">主从复制</text>
  <text x="170" y="782" text-anchor="middle" class="label-text">:3306</text>
  <text x="170" y="799" text-anchor="middle" class="label-text">内网IP</text>
  <text x="170" y="816" text-anchor="middle" class="label-text" font-weight="bold" fill="#dc3545">禁止公网</text>
  
  <!-- Redis -->
  <rect x="270" y="720" width="140" height="110" rx="8" class="component-box" fill="#fce4ec"/>
  <text x="340" y="745" text-anchor="middle" class="component-title">[Cache] Redis</text>
  <text x="340" y="765" text-anchor="middle" class="label-text">Cluster 3主3从</text>
  <text x="340" y="782" text-anchor="middle" class="label-text">:6379</text>
  <text x="340" y="799" text-anchor="middle" class="label-text">密码认证</text>
  <text x="340" y="816" text-anchor="middle" class="label-text" font-weight="bold" fill="#dc3545">禁止公网</text>
  
  <!-- RocketMQ -->
  <rect x="440" y="720" width="140" height="110" rx="8" class="component-box" fill="#f3e5f5"/>
  <text x="510" y="745" text-anchor="middle" class="component-title">[Mail] RocketMQ</text>
  <text x="510" y="765" text-anchor="middle" class="label-text">消息队列</text>
  <text x="510" y="782" text-anchor="middle" class="label-text">:9876 NS</text>
  <text x="510" y="799" text-anchor="middle" class="label-text">:10911 Broker</text>
  <text x="510" y="816" text-anchor="middle" class="label-text" font-weight="bold" fill="#dc3545">禁止公网</text>
  
  <!-- MinIO -->
  <rect x="610" y="720" width="140" height="110" rx="8" class="component-box" fill="#c51162"/>
  <text x="680" y="745" text-anchor="middle" class="component-title" fill="white">[Bucket] MinIO</text>
  <text x="680" y="765" text-anchor="middle" class="label-text" fill="white">对象存储</text>
  <text x="680" y="782" text-anchor="middle" class="label-text" fill="white">:9000 API</text>
  <text x="680" y="799" text-anchor="middle" class="label-text" fill="white">:9001 Console</text>
  <text x="680" y="816" text-anchor="middle" class="label-text" fill="white" font-weight="bold">内网访问</text>
  
  <!-- Backup -->
  <rect x="780" y="720" width="140" height="110" rx="8" class="component-box" fill="#607d8b"/>
  <text x="850" y="745" text-anchor="middle" class="component-title" fill="white">[Disk] 备份存储</text>
  <text x="850" y="765" text-anchor="middle" class="label-text" fill="white">全量+增量</text>
  <text x="850" y="782" text-anchor="middle" class="label-text" fill="white">异地灾备</text>
  <text x="850" y="799" text-anchor="middle" class="label-text" fill="white">保留30天</text>
  <text x="850" y="816" text-anchor="middle" class="label-text" fill="white" font-weight="bold">加密存储</text>

  <!-- Arrows from Firewall-3 to Data -->
  <path d="M 1080 620 L 1080 650 L 170 650 L 170 720" class="allow-arrow"/>
  <path d="M 1080 650 L 340 650 L 340 720" class="allow-arrow"/>
  <path d="M 1080 650 L 510 650 L 510 720" class="allow-arrow"/>
  <path d="M 1080 650 L 680 650 L 680 720" class="allow-arrow"/>
  <text x="175" y="685" class="label-text" fill="#28a745">读写</text>

  <!-- Management Zone -->
  <rect x="50" y="880" width="1300" height="140" rx="10" class="management-zone"/>
  <text x="70" y="910" class="zone-title">🔧 运维管理区域 (Management)</text>
  <circle cx="100" cy="955" r="8" class="high-security"/>
  <text x="115" y="962" class="label-text">安全等级: 高 (VPN)</text>
  
  <!-- VPN Gateway -->
  <rect x="120" y="930" width="140" height="70" rx="8" class="component-box" fill="#ffebee"/>
  <text x="190" y="955" text-anchor="middle" class="component-title">[Lock] VPN网关</text>
  <text x="190" y="975" text-anchor="middle" class="label-text">IPSec / SSL VPN</text>
  <text x="190" y="992" text-anchor="middle" class="label-text">2FA认证</text>
  
  <!-- Prometheus -->
  <rect x="290" y="930" width="130" height="70" rx="8" class="component-box" fill="#e0f2f1"/>
  <text x="355" y="955" text-anchor="middle" class="component-text">Prometheus</text>
  <text x="355" y="975" text-anchor="middle" class="label-text">:9090</text>
  <text x="355" y="992" text-anchor="middle" class="label-text">内网监控</text>
  
  <!-- Grafana -->
  <rect x="450" y="930" width="130" height="70" rx="8" class="component-box" fill="#e0f2f1"/>
