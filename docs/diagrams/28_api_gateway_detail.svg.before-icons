<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 950 800" width="950" height="800">
  <defs>
    <style>
      .title { font: 700 20px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .subtitle { font: 12px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
      .zone-title { font: 600 14px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: start; }
      .layer { fill: #f8fafc; stroke: #e2e8f0; stroke-width: 1; rx: 8; }
      .box { fill: #ffffff; stroke-width: 2; rx: 6; }
      .box-client { stroke: #a78bfa; }
      .box-gateway { stroke: #4f46e5; }
      .box-auth { stroke: #059669; }
      .box-route { stroke: #0891b2; }
      .box-plugin { stroke: #d97706; }
      .box-backend { stroke: #64748b; }
      .label { font: 500 12px system-ui, -apple-system, sans-serif; fill: #0f172a; text-anchor: middle; }
      .desc { font: 10px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
      .arrow { stroke: #64748b; stroke-width: 1.8; fill: none; marker-end: url(#arr); }
      .arrow-label { font: 9px system-ui, -apple-system, sans-serif; fill: #64748b; text-anchor: middle; }
    </style>
    <marker id="arr" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <polygon points="0 0, 8 4, 0 8" fill="#64748b"/>
    </marker>
  </defs>

  <text class="title" x="475" y="30">API 网关详细架构图</text>
  <text class="subtitle" x="475" y="50">路由 · 认证 · 限流 · 熔断 · 监控 · 统一接入层 · Sentinel 治理</text>

  <!-- Layer 1: Client -->
  <rect class="layer" x="20" y="70" width="910" height="80"/>
  <text class="zone-title" x="30" y="90">🌐 客户端层</text>
  
  <rect class="box box-client" x="50" y="100" width="120" height="40"/>
  <text class="label" x="110" y="118">Web 浏览器</text>
  <text class="desc" x="110" y="132">Vue 3 SPA</text>

  <rect class="box box-client" x="190" y="100" width="120" height="40"/>
  <text class="label" x="250" y="118">移动端 APP</text>
  <text class="desc" x="250" y="132">iOS/Android</text>

  <rect class="box box-client" x="330" y="100" width="120" height="40"/>
  <text class="label" x="390" y="118">第三方系统</text>
  <text class="desc" x="390" y="132">OpenAPI 对接</text>

  <rect class="box box-client" x="470" y="100" width="120" height="40"/>
  <text class="label" x="530" y="118">内部服务</text>
  <text class="desc" x="530" y="132">微服务调用</text>

  <!-- Layer 2: Load Balancer -->
  <rect class="layer" x="20" y="165" width="910" height="70"/>
  <text class="zone-title" x="30" y="185">⚖️ 负载均衡层</text>

  <rect class="box box-gateway" x="150" y="195" width="200" height="35"/>
  <text class="label" x="250" y="210">Nginx / ALB</text>
  <text class="desc" x="250" y="223">HTTPS · 负载均衡 · SSL 卸载</text>

  <rect class="box box-gateway" x="370" y="195" width="200" height="35"/>
  <text class="label" x="470" y="210">WAF 防火墙</text>
  <text class="desc" x="470" y="223">SQL注入 · XSS · DDoS 防护</text>

  <!-- Layer 3: API Gateway Core -->
  <rect class="layer" x="20" y="250" width="910" height="200"/>
  <text class="zone-title" x="30" y="270">🚪 API 网关核心层 (Spring Cloud Gateway / Sentinel)</text>

  <!-- Auth Module -->
  <rect class="box box-auth" x="40" y="285" width="140" height="150"/>
  <text class="label" x="110" y="303">认证授权模块</text>
  <text class="desc" x="110" y="320">JWT Token 验证</text>
  <text class="desc" x="110" y="334">Refresh Token</text>
  <text class="desc" x="110" y="348">OAuth2 / OIDC</text>
  <text class="desc" x="110" y="362">RBAC 权限</text>
  <text class="desc" x="110" y="376">数据权限过滤</text>
  <text class="desc" x="110" y="390" fill="#059669">✓ Spring Security</text>
  <text class="desc" x="110" y="404" fill="#059669">✓ JJWT 库</text>
  <text class="desc" x="110" y="418">缓存: Redis</text>

  <!-- Route Module -->
  <rect class="box box-route" x="200" y="285" width="140" height="150"/>
  <text class="label" x="270" y="303">路由转发模块</text>
  <text class="desc" x="270" y="320">路径匹配</text>
  <text class="desc" x="270" y="334">请求重写</text>
  <text class="desc" x="270" y="348">Header 转换</text>
  <text class="desc" x="270" y="362">服务发现</text>
  <text class="desc" x="270" y="376">负载均衡</text>
  <text class="desc" x="270" y="390" fill="#0891b2">✓ RouterFunction</text>
  <text class="desc" x="270" y="404" fill="#0891b2">✓ Nacos (可选)</text>
  <text class="desc" x="270" y="418">策略: RoundRobin</text>

  <!-- Rate Limit Module -->
  <rect class="box box-plugin" x="360" y="285" width="140" height="150"/>
  <text class="label" x="430" y="303">限流熔断模块</text>
  <text class="desc" x="430" y="320">QPS 限流</text>
  <text class="desc" x="430" y="334">并发线程限流</text>
  <text class="desc" x="430" y="348">热点参数限流</text>
  <text class="desc" x="430" y="362">熔断降级</text>
  <text class="desc" x="430" y="376">系统自适应</text>
  <text class="desc" x="430" y="390" fill="#d97706">✓ Sentinel 1.8.9</text>
  <text class="desc" x="430" y="404" fill="#d97706">✓ Resilience4j</text>
  <text class="desc" x="430" y="418">规则: 动态配置</text>

  <!-- Monitor Module -->
  <rect class="box box-plugin" x="520" y="285" width="140" height="150"/>
  <text class="label" x="590" y="303">监控插件模块</text>
  <text class="desc" x="590" y="320">请求日志</text>
  <text class="desc" x="590" y="334">性能指标</text>
  <text class="desc" x="590" y="348">链路追踪</text>
  <text class="desc" x="590" y="362">告警通知</text>
  <text class="desc" x="590" y="376">慢请求分析</text>
  <text class="desc" x="590" y="390" fill="#d97706">✓ Micrometer</text>
  <text class="desc" x="590" y="404" fill="#d97706">✓ Zipkin Brave</text>
  <text class="desc" x="590" y="418">采样率: 10%</text>

  <!-- Security Module -->
  <rect class="box box-plugin" x="680" y="285" width="140" height="150"/>
  <text class="label" x="750" y="303">安全防护模块</text>
  <text class="desc" x="750" y="320">IP 黑白名单</text>
  <text class="desc" x="750" y="334">API 签名验证</text>
  <text class="desc" x="750" y="348">请求加密</text>
  <text class="desc" x="750" y="362">防重放攻击</text>
  <text class="desc" x="750" y="376">CORS 跨域</text>
  <text class="desc" x="750" y="390" fill="#d97706">✓ 自定义 Filter</text>
  <text class="desc" x="750" y="404" fill="#d97706">✓ AES/RSA</text>
  <text class="desc" x="750" y="418">timestamp + nonce</text>

  <!-- Layer 4: Backend Services -->
  <rect class="layer" x="20" y="465" width="910" height="110"/>
  <text class="zone-title" x="30" y="485">⚙️ 后端服务层</text>

  <rect class="box box-backend" x="50" y="495" width="130" height="65"/>
  <text class="label" x="115" y="513">用户服务</text>
  <text class="desc" x="115" y="528">/api/v1/users</text>
  <text class="desc" x="115" y="543">端口: 8080</text>

  <rect class="box box-backend" x="200" y="495" width="130" height="65"/>
  <text class="label" x="265" y="513">部门服务</text>
  <text class="desc" x="265" y="528">/api/v1/depts</text>
  <text class="desc" x="265" y="543">端口: 8080</text>

  <rect class="box box-backend" x="350" y="495" width="130" height="65"/>
  <text class="label" x="415" y="513">文件服务</text>
  <text class="desc" x="415" y="528">/api/v1/files</text>
  <text class="desc" x="415" y="543">端口: 8080</text>

  <rect class="box box-backend" x="500" y="495" width="130" height="65"/>
  <text class="label" x="565" y="513">工作流服务</text>
  <text class="desc" x="565" y="528">/api/v1/workflows</text>
  <text class="desc" x="565" y="543">端口: 8080</text>

  <rect class="box box-backend" x="650" y="495" width="130" height="65"/>
  <text class="label" x="715" y="513">监控大盘</text>
  <text class="desc" x="715" y="528">/admin-api/v1/monitor</text>
  <text class="desc" x="715" y="543">端口: 8080</text>

  <!-- Layer 5: Data Flow -->
  <rect class="layer" x="20" y="590" width="910" height="90"/>
  <text class="zone-title" x="30" y="610">📊 请求处理流程</text>

  <text class="desc" x="475" y="635" text-anchor="middle">
    1️⃣ 客户端请求 → 2️⃣ Nginx SSL 卸载 → 3️⃣ WAF 安全检查 → 4️⃣ 网关认证 →
  </text>
  <text class="desc" x="475" y="655" text-anchor="middle">
    5️⃣ Sentinel 限流 → 6️⃣ 路由匹配 → 7️⃣ 转发后端 → 8️⃣ 返回响应 → 9️⃣ 记录日志
  </text>

  <!-- Arrows -->
  <path class="arrow" d="M 110 140 L 110 165 L 250 165 L 250 195"/>
  <path class="arrow" d="M 250 140 L 250 195"/>
  <path class="arrow" d="M 390 140 L 390 165 L 470 165 L 470 195"/>
  <path class="arrow" d="M 530 140 L 530 165 L 250 165"/>

  <path class="arrow" d="M 250 230 L 250 250 L 110 250 L 110 285"/>
  <path class="arrow" d="M 470 230 L 470 250 L 270 250 L 270 285"/>

  <path class="arrow" d="M 110 435 L 110 455 L 115 455 L 115 495"/>
  <path class="arrow" d="M 270 435 L 270 455 L 265 455 L 265 495"/>
  <path class="arrow" d="M 430 435 L 430 455 L 415 455 L 415 495"/>
  <path class="arrow" d="M 590 435 L 590 455 L 565 455 L 565 495"/>
  <path class="arrow" d="M 750 435 L 750 455 L 715 455 L 715 495"/>

  <!-- Performance Notes -->
  <text class="desc" x="475" y="705" text-anchor="middle" fill="#059669">
    💡 P95 响应时间 &lt; 50ms | 吞吐量 &gt; 5000 QPS | 可用性 99.9% | 自动熔断与降级
  </text>
  <text class="desc" x="475" y="725" text-anchor="middle" fill="#64748b">
    技术栈: Spring Cloud Gateway · Sentinel · Nacos · Redis · Prometheus · Zipkin
  </text>
  <text class="desc" x="475" y="745" text-anchor="middle" fill="#d97706">
    ⚠️ 熔断阈值: 错误率 &gt; 50% 或 慢请求率 &gt; 30% 时触发 · 半开窗口: 10s
  </text>
  <text class="desc" x="475" y="765" text-anchor="middle" fill="#0891b2">
    🔐 安全: HTTPS only · JWT 15min 过期 · Refresh Token 7天 · IP 白名单
  </text>
</svg>