flowchart TB
  subgraph IF["接口层 interfaces"]
    I1["AuthenticationHandler · UnifiedAuthorizationHandler"]
    I2["OauthToken / OauthEndpoint / OauthMetadata"]
    I3["Mfa / Permission / Role / Session / IpAccessControl / AuditLog Handler"]
  end

  subgraph APP["应用层 application"]
    A1["service / service.impl · 认证/令牌/会话用例(事务边界)"]
    A2["assembler · dto · aspect · scheduler"]
  end

  subgraph DOM["领域层 domain"]
    D1["model.entity · UserEntity/TokenEntity/JwtKeyEntity/Session/Mfa/Totp"]
    D2["model.vo · AuthenticationRequest/Result · TokenPair"]
    D3["permission · ResourcePermission"]
    D4["service · AuthenticationProtocol/MfaService/JwtKeyRotation/BruteForce/DeviceTrust"]
    D5["repository · 仓储接口"]
  end

  subgraph INF["基础设施层 infrastructure"]
    N1["persistence · mapper/repository (auth_* 表 V44-V52)"]
    N2["crypto / encryption / kms / security"]
    N3["filter / audit / monitoring / scheduler"]
  end

  COMMON["apex-common"]
  INFRA["apex-infrastructure"]
  APPM["apex-application"]

  COMMON --> DOM
  INFRA --> INF
  APPM --> APP
  I1 --> A1
  I2 --> A1
  I3 --> A1
  A1 --> D4
  D4 --> D5
  D5 -. "被实现" .-> N1
  N2 --> D4
  A2 --> D2

  NOTE["独立 DDD 四层的统一认证域：统一授权 + OAuth2 + MFA + 生物识别 + 令牌生命周期，自有 auth_* 表"]
  DOM -.-> NOTE
