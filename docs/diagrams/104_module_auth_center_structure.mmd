flowchart TB
  subgraph DOM["领域层 domain"]
    D1["model.entity · UserEntity/TokenEntity/JwtKeyEntity/Session/Totp/MfaConfig/AuditLog"]
    D2["model.vo · AuthenticationRequest/Result · TokenPair"]
    D3["permission · ResourcePermission"]
    D4["service · AuthenticationProtocol/TokenService/MfaService/JwtKeyRotation/BruteForce/DeviceTrust"]
    D5["repository · 仓储接口"]
  end

  subgraph APP["应用层 application"]
    A1["service（含 impl）· 认证/OAuth2/统一授权用例（事务边界）"]
    A2["assembler · dto · aspect"]
  end

  subgraph INF["基础设施层 infrastructure"]
    N1["persistence · mapper/repository（auth_* 表，V44–V64 迁移随 apex-auth-service 发布）"]
    N2["encryption / kms / security"]
    N3["filter / event / monitoring / scheduler / service / support"]
  end

  subgraph TOP["顶层支撑"]
    T1["config · OAuth2Properties / AuthTrustedProxyProperties"]
    T2["autoconfigure · AuthComponentAutoConfiguration"]
    T3["openplatform · OpenAppScopes"]
  end

  HTTP["HTTP 出口（位于 apex-auth-service）\nauthservice.interfaces · router/handler/dto/util\n认证 + OAuth2 + 统一授权 + MFA/策略端点"]

  COMMON["apex-common"]
  SHAREDOM["apex-domain"]
  CONTRACT["apex-api-contract"]
  INTG["apex-infrastructure-integration"]

  COMMON --> DOM
  SHAREDOM --> DOM
  CONTRACT --> APP
  INTG --> INF
  A1 --> D4
  D4 --> D5
  D5 -. "被实现" .-> N1
  N2 -. "实现加密/安全端口" .-> D4
  A2 --> D2
  HTTP --> A1

  NOTE["包名 com.apex.scaffold.auth；本库无 interfaces 层，HTTP 入口由 apex-auth-service 承载（AuthServiceApplication 运行装配），可聚合部署或独立运行"]
  DOM -.-> NOTE
