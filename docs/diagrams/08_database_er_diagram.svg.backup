<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="1000" height="1000">
  <defs>
    <style>
      .s { font:12px system-ui, -apple-system, sans-serif; fill:#64748b; text-anchor:middle; }
      .tbl { fill:#ffffff; stroke-width:2; rx:5; }
      .tbl-user { stroke:#6366f1; }
      .tbl-rbac { stroke:#22d3ee; }
      .tbl-org { stroke:var(--c4); }
      .tbl-workflow { stroke:#f59e0b; }
      .tbl-storage { stroke:var(--c6); }
      .tbl-log { stroke:var(--c5); }
      .tbl-system { stroke:#10b981; }
      .tbl-infra { stroke:#64748b; }
      .hdr { font:600 13px system-ui, -apple-system, sans-serif; fill:#fff; text-anchor:middle; }
      .col { font:10px 'SF Mono', Menlo, monospace; fill:#1a1d29; text-anchor:start; }
      .pk { fill:#f59e0b; font-weight:700; }
      .fk { fill:#22d3ee; }
      .legend-label { font:10px system-ui, -apple-system, sans-serif; fill:#1a1d29; text-anchor:start; }
      .group-title { font:700 11px system-ui, -apple-system, sans-serif; fill:#1a1d29; text-anchor:start; }
      .rel { fill:none; stroke:#64748b; stroke-width:1.3; }
      .crow { fill:none; stroke:#64748b; stroke-width:1.3; }
    </style>
    <!-- Crow's foot markers for ER -->
    <marker id="one" viewBox="0 0 8 8" refX="1" refY="4" markerWidth="8" markerHeight="8" orient="auto">
      <line x1="1" y1="0" x2="1" y2="8" stroke="#64748b" stroke-width="2"/>
    </marker>
    <marker id="many" viewBox="0 0 10 8" refX="0" refY="4" markerWidth="10" markerHeight="8" orient="auto">
      <path d="M0 0 L8 4 L0 8" fill="none" stroke="#64748b" stroke-width="1.3"/>
      <line x1="3" y1="0" x2="3" y2="8" stroke="#64748b" stroke-width="1.3"/>
    </marker>
  </defs>

  <text class="t" x="500" y="26">Apex Scaffold 数据库 E-R 关系图</text>
  <text class="s" x="500" y="44">核心业务表 24 张 · 共 43 张表 · MySQL 8.0 · 多租户行级隔离 (tenant_id)</text>

  <!-- ====== USER MODULE ====== -->
  <g transform="translate(30,80)">
    <rect width="220" height="140" class="tbl tbl-user"/>
    <rect width="220" height="22" fill="#6366f1" rx="5"/>
    <rect width="220" height="22" fill="#6366f1"/>
    <text class="hdr" x="110" y="16">sys_user (用户表)</text>
    <text class="col pk" x="10" y="42">🔑 id (BIGINT, PK)</text>
    <text class="col" x="10" y="56">username (VARCHAR 64, UK)</text>
    <text class="col" x="10" y="70">password_hash (VARCHAR 128)</text>
    <text class="col" x="10" y="84">nickname / real_name</text>
    <text class="col fk" x="10" y="98">➝ dept_id FK → sys_dept</text>
    <text class="col fk" x="10" y="112">➝ post_id FK → sys_post</text>
    <text class="col" x="10" y="126">email · phone · avatar</text>
    <text class="col" x="10" y="140">status · tenant_id</text>
  </g>

  <!-- ====== ORG MODULE ====== -->
  <g transform="translate(30,245)">
    <rect width="220" height="100" class="tbl tbl-org"/>
    <rect width="220" height="22" fill="#ec4899" rx="5"/>
    <rect width="220" height="22" fill="#ec4899"/>
    <text class="hdr" x="110" y="16">sys_dept (部门树)</text>
    <text class="col pk" x="10" y="42">🔑 dept_id PK</text>
    <text class="col fk" x="10" y="56">➝ parent_id → self</text>
    <text class="col" x="10" y="70">name · ancestors 路径</text>
    <text class="col" x="10" y="84">order_num · leader</text>
    <text class="col" x="10" y="98">status · tenant_id</text>
  </g>

  <g transform="translate(30,365)">
    <rect width="220" height="80" class="tbl tbl-org"/>
    <rect width="220" height="22" fill="#ec4899" rx="5"/>
    <rect width="220" height="22" fill="#ec4899"/>
    <text class="hdr" x="110" y="16">sys_post (岗位)</text>
    <text class="col pk" x="10" y="42">🔑 post_id PK</text>
    <text class="col" x="10" y="56">post_code · post_name</text>
    <text class="col" x="10" y="70">sort · status · tenant_id</text>
  </g>

  <g transform="translate(30,465)">
    <rect width="220" height="80" class="tbl tbl-infra"/>
    <rect width="220" height="22" fill="#64748b" rx="5"/>
    <rect width="220" height="22" fill="#64748b"/>
    <text class="hdr" x="110" y="16">sys_tenant (租户)</text>
    <text class="col pk" x="10" y="42">🔑 tenant_id PK</text>
    <text class="col" x="10" y="56">name · code · contact</text>
    <text class="col" x="10" y="70">storage_quota · expire_time</text>
  </g>

  <!-- ====== RBAC MODULE ====== -->
  <g transform="translate(290,80)">
    <rect width="180" height="100" class="tbl tbl-rbac"/>
    <rect width="180" height="22" fill="#22d3ee" rx="5"/>
    <rect width="180" height="22" fill="#22d3ee"/>
    <text class="hdr" x="90" y="16">sys_role (角色)</text>
    <text class="col pk" x="10" y="42">🔑 role_id PK</text>
    <text class="col" x="10" y="56">name · code(ADMIN)</text>
    <text class="col" x="10" y="70">data_scope 权限范围</text>
    <text class="col" x="10" y="84">sort · status · tid</text>
  </g>

  <g transform="translate(290,205)">
    <rect width="180" height="120" class="tbl tbl-rbac"/>
    <rect width="180" height="22" fill="#22d3ee" rx="5"/>
    <rect width="180" height="22" fill="#22d3ee"/>
    <text class="hdr" x="90" y="16">sys_menu (菜单权限)</text>
    <text class="col pk" x="10" y="42">🔑 menu_id PK</text>
    <text class="col fk" x="10" y="56">➝ parent_id → self</text>
    <text class="col" x="10" y="70">type: DIR/MENU/BUTTON</text>
    <text class="col" x="10" y="84">path · component · icon</text>
    <text class="col" x="10" y="98">permission_code 权限码</text>
    <text class="col" x="10" y="112">visible · sort</text>
  </g>

  <!-- Junction tables -->
  <g transform="translate(290,345)">
    <rect width="180" height="55" class="tbl tbl-rbac" stroke-dasharray="4 2"/>
    <rect width="180" height="22" fill="#22d3ee" opacity="0.75" rx="5"/>
    <rect width="180" height="22" fill="#22d3ee" opacity="0.75"/>
    <text class="hdr" x="90" y="16">sys_user_role (关联表)</text>
    <text class="col fk" x="10" y="44">➝ user_id + ➝ role_id (PK)</text>
  </g>

  <g transform="translate(290,420)">
    <rect width="180" height="55" class="tbl tbl-rbac" stroke-dasharray="4 2"/>
    <rect width="180" height="22" fill="#22d3ee" opacity="0.75" rx="5"/>
    <rect width="180" height="22" fill="#22d3ee" opacity="0.75"/>
    <text class="hdr" x="90" y="16">sys_role_menu (关联表)</text>
    <text class="col fk" x="10" y="44">➝ role_id + ➝ menu_id (PK)</text>
  </g>

  <g transform="translate(290,495)">
    <rect width="180" height="55" class="tbl tbl-rbac" stroke-dasharray="4 2"/>
    <rect width="180" height="22" fill="#22d3ee" opacity="0.75" rx="5"/>
    <rect width="180" height="22" fill="#22d3ee" opacity="0.75"/>
    <text class="hdr" x="90" y="16">sys_role_dept (数据权限)</text>
    <text class="col fk" x="10" y="44">➝ role_id + ➝ dept_id (PK)</text>
  </g>

  <!-- ====== STORAGE MODULE ====== -->
  <g transform="translate(510,80)">
    <rect width="210" height="110" class="tbl tbl-storage"/>
    <rect width="210" height="22" fill="#14b8a6" rx="5"/>
    <rect width="210" height="22" fill="#14b8a6"/>
    <text class="hdr" x="105" y="16">sys_file (文件元数据)</text>
    <text class="col pk" x="10" y="42">🔑 file_id PK</text>
    <text class="col" x="10" y="56">md5 · sha256 · size_bytes</text>
    <text class="col" x="10" y="70">file_name · suffix · mime</text>
    <text class="col" x="10" y="84">storage_type: MINIO/S3/LOCAL</text>
    <text class="col" x="10" y="98">object_key · bucket · url</text>
    <text class="col" x="10" y="112">width/height · uploader_id</text>
  </g>

  <g transform="translate(510,210)">
    <rect width="210" height="90" class="tbl tbl-storage"/>
    <rect width="210" height="22" fill="#14b8a6" rx="5"/>
    <rect width="210" height="22" fill="#14b8a6"/>
    <text class="hdr" x="105" y="16">sys_storage_config</text>
    <text class="col pk" x="10" y="42">🔑 id PK</text>
    <text class="col" x="10" y="56">name · master(0/1)</text>
    <text class="col" x="10" y="70">endpoint · bucket · ak/sk</text>
    <text class="col" x="10" y="84">domain_prefix · status</text>
  </g>

  <!-- ====== WORKFLOW MODULE ====== -->
  <g transform="translate(510,320)">
    <rect width="210" height="80" class="tbl tbl-workflow"/>
    <rect width="210" height="22" fill="#f59e0b" rx="5"/>
    <rect width="210" height="22" fill="#f59e0b"/>
    <text class="hdr" x="105" y="16">wf_definition</text>
    <text class="col pk" x="10" y="42">🔑 def_id PK · biz_key UK</text>
    <text class="col" x="10" y="56">name · version · bpmn_xml</text>
    <text class="col" x="10" y="70">status · form_schema</text>
  </g>

  <g transform="translate(510,420)">
    <rect width="210" height="80" class="tbl tbl-workflow"/>
    <rect width="210" height="22" fill="#f59e0b" rx="5"/>
    <rect width="210" height="22" fill="#f59e0b"/>
    <text class="hdr" x="105" y="16">wf_instance</text>
    <text class="col pk" x="10" y="42">🔑 instance_id PK</text>
    <text class="col fk" x="10" y="56">➝ def_id → wf_definition</text>
    <text class="col" x="10" y="70">status · biz_id · creator_id</text>
    <text class="col" x="10" y="84">current_node_id</text>
  </g>

  <g transform="translate(510,520)">
    <rect width="210" height="100" class="tbl tbl-workflow"/>
    <rect width="210" height="22" fill="#f59e0b" rx="5"/>
    <rect width="210" height="22" fill="#f59e0b"/>
    <text class="hdr" x="105" y="16">wf_task (审批任务)</text>
    <text class="col pk" x="10" y="42">🔑 task_id PK</text>
    <text class="col fk" x="10" y="56">➝ instance_id → wf_instance</text>
    <text class="col" x="10" y="70">node_key · name</text>
    <text class="col fk" x="10" y="84">➝ assignee_id → sys_user</text>
    <text class="col" x="10" y="98">claim_time · result · comment</text>
    <text class="col" x="10" y="112">status: PENDING/CLAIMED/DONE</text>
  </g>

  <!-- ====== LOG/AUDIT MODULE ====== -->
  <g transform="translate(770,80)">
    <rect width="210" height="90" class="tbl tbl-log"/>
    <rect width="210" height="22" fill="#8b5cf6" rx="5"/>
    <rect width="210" height="22" fill="#8b5cf6"/>
    <text class="hdr" x="105" y="16">sys_login_log</text>
    <text class="col pk" x="10" y="42">🔑 log_id PK</text>
    <text class="col" x="10" y="56">username · tenant_id</text>
    <text class="col" x="10" y="70">login_ip · location · UA</text>
    <text class="col" x="10" y="84">status(成功/失败) · login_time</text>
  </g>

  <g transform="translate(770,190)">
    <rect width="210" height="90" class="tbl tbl-log"/>
    <rect width="210" height="22" fill="#8b5cf6" rx="5"/>
    <rect width="210" height="22" fill="#8b5cf6"/>
    <text class="hdr" x="105" y="16">sys_audit_log</text>
    <text class="col pk" x="10" y="42">🔑 audit_id PK</text>
    <text class="col" x="10" y="56">module · action · trace_id</text>
    <text class="col" x="10" y="70">method · params_json</text>
    <text class="col" x="10" y="84">operator_id · cost_ms</text>
  </g>

  <g transform="translate(770,300)">
    <rect width="210" height="90" class="tbl tbl-log"/>
    <rect width="210" height="22" fill="#8b5cf6" rx="5"/>
    <rect width="210" height="22" fill="#8b5cf6"/>
    <text class="hdr" x="105" y="16">api_call_log</text>
    <text class="col pk" x="10" y="42">🔑 id PK</text>
    <text class="col" x="10" y="56">service · method · path · url</text>
    <text class="col" x="10" y="70">response_status · exec_ms</text>
    <text class="col" x="10" y="84">trace_id · request_id · error</text>
  </g>

  <g transform="translate(770,410)">
    <rect width="210" height="70" class="tbl tbl-log"/>
    <rect width="210" height="22" fill="#8b5cf6" rx="5"/>
    <rect width="210" height="22" fill="#8b5cf6"/>
    <text class="hdr" x="105" y="16">sys_online_user</text>
    <text class="col pk" x="10" y="42">🔑 session_id PK</text>
    <text class="col" x="10" y="56">user_id · token_uuid</text>
    <text class="col" x="10" y="70">login_ip · last_active</text>
  </g>

  <!-- ====== SYSTEM DICT / CONFIG ====== -->
  <g transform="translate(770,500)">
    <rect width="210" height="90" class="tbl tbl-system"/>
    <rect width="210" height="22" fill="#10b981" rx="5"/>
    <rect width="210" height="22" fill="#10b981"/>
    <text class="hdr" x="105" y="16">sys_dict_type + sys_dict_item</text>
    <text class="col pk" x="10" y="42">🔑 dict_id / item_id PK</text>
    <text class="col" x="10" y="56">dict_code · dict_name</text>
    <text class="col" x="10" y="70">item_label · item_value</text>
    <text class="col" x="10" y="84">css_class · list_class · sort</text>
  </g>

  <g transform="translate(770,610)">
    <rect width="210" height="80" class="tbl tbl-system"/>
    <rect width="210" height="22" fill="#10b981" rx="5"/>
    <rect width="210" height="22" fill="#10b981"/>
    <text class="hdr" x="105" y="16">sys_config (系统参数)</text>
    <text class="col pk" x="10" y="42">🔑 config_id PK</text>
    <text class="col" x="10" y="56">config_key · value</text>
    <text class="col" x="10" y="70">type(Y/N内置) · remark</text>
    <text class="col" x="10" y="84">tenant_id</text>
  </g>

  <g transform="translate(770,710)">
    <rect width="210" height="80" class="tbl tbl-system"/>
    <rect width="210" height="22" fill="#10b981" rx="5"/>
    <rect width="210" height="22" fill="#10b981"/>
    <text class="hdr" x="105" y="16">sys_notice (公告通知)</text>
    <text class="col pk" x="10" y="42">🔑 notice_id PK</text>
    <text class="col" x="10" y="56">title · type(通知/公告)</text>
    <text class="col" x="10" y="70">content_html · status</text>
    <text class="col" x="10" y="84">creator_id · tenant_id</text>
  </g>

  <!-- ====== RELATIONSHIPS ====== -->
  <!-- sys_user → sys_dept -->
  <path class="rel" d="M250 165 L260 165 L260 280 L250 280" marker-start="url(#many)" marker-end="url(#one)"/>
  <text class="s" x="240" y="220" style="font:10px system-ui, -apple-system, sans-serif">N-1</text>
  <!-- sys_user → sys_post -->
  <path class="rel" d="M250 195 L260 195 L260 395 L250 395" marker-start="url(#many)" marker-end="url(#one)"/>
  <text class="s" x="240" y="300" style="font:10px system-ui, -apple-system, sans-serif">N-1</text>

  <!-- sys_dept parent child -->
  <path class="rel" d="M140 245 L140 235 L140 235 L140 235" />
  <path class="rel" d="M80 345 L80 335 L80 245 L130 245" marker-start="url(#many)" marker-end="url(#one)" stroke-dasharray="2 3"/>

  <!-- RBAC user-role-user -->
  <path class="rel" d="M250 140 L260 140 L260 130 L290 130" marker-start="url(#many)" marker-end="url(#many)"/>
  <!-- sys_role via user_role -->
  <path class="rel" d="M290 360 L170 360 L170 180 L290 180" stroke-dasharray="3 3"/>
  <!-- sys_menu via role_menu -->
  <path class="rel" d="M380 205 L380 180 L470 180 L470 130 L510 130" marker-start="url(#many)" marker-end="url(#many)"/>
  <path class="rel" d="M380 315 L380 372" marker-start="url(#many)" marker-end="url(#one)" stroke-dasharray="2 2"/>
  <path class="rel" d="M380 440 L380 495" marker-start="url(#many)" marker-end="url(#one)" stroke-dasharray="2 2"/>

  <!-- wf_instance → wf_definition -->
  <path class="rel" d="M615 400 L615 390" marker-start="url(#many)" marker-end="url(#one)"/>
  <!-- wf_task → wf_instance -->
  <path class="rel" d="M615 500 L615 490" marker-start="url(#many)" marker-end="url(#one)"/>
  <!-- wf_task.assignee → sys_user -->
  <path class="rel" d="M720 580 L750 580 L750 170" marker-end="url(#one)" opacity="0.5"/>

  <!-- sys_file uploader → sys_user -->
  <path class="rel" d="M510 140 L480 140 L480 165 L250 165" marker-end="url(#one)" opacity="0.6"/>

  <!-- LEGEND -->
  <g transform="translate(30,870)">
    <text class="group-title" x="0" y="0">图例 Legend</text>
    <rect x="0" y="15" width="16" height="14" class="tbl tbl-user"/>
    <text class="legend-label" x="22" y="26">用户模块 🔑</text>
    <rect x="110" y="15" width="16" height="14" class="tbl tbl-rbac"/>
    <text class="legend-label" x="132" y="26">RBAC权限模块</text>
    <rect x="250" y="15" width="16" height="14" class="tbl tbl-org"/>
    <text class="legend-label" x="272" y="26">组织架构模块</text>
    <rect x="380" y="15" width="16" height="14" class="tbl tbl-workflow"/>
    <text class="legend-label" x="402" y="26">工作流模块</text>
    <rect x="510" y="15" width="16" height="14" class="tbl tbl-storage"/>
    <text class="legend-label" x="532" y="26">文件存储模块</text>
    <rect x="0" y="45" width="16" height="14" class="tbl tbl-log"/>
    <text class="legend-label" x="22" y="56">日志&amp;审计</text>
    <rect x="110" y="45" width="16" height="14" class="tbl tbl-system"/>
    <text class="legend-label" x="132" y="56">系统配置&amp;字典</text>
    <rect x="250" y="45" width="16" height="14" class="tbl tbl-infra"/>
    <text class="legend-label" x="272" y="56">多租户基础设施</text>
    <path d="M400 52 L440 52" stroke="#64748b" marker-start="url(#many)" marker-end="url(#one)"/>
    <text class="legend-label" x="448" y="56">一对多 (crow-foot)</text>
    <path d="M570 52 L610 52" stroke="#64748b" stroke-dasharray="3 3"/>
    <text class="legend-label" x="618" y="56">虚线 = 多对多</text>
    <text class="legend-label" x="0" y="85">🔑 主键 (PK) · ➝ 外键 (FK) · 所有表含 tenant_id 实现多租户行级隔离</text>
  </g>
</svg>
