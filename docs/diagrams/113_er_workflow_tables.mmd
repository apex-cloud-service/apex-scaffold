%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#eff6ff','primaryTextColor':'#0f172a','primaryBorderColor':'#3b82f6','lineColor':'#64748b','fontFamily':'sans-serif'}}}%%
erDiagram
    WF_WORKFLOW_DEFINITION ||--o{ WF_PROCESS_INSTANCE : "workflow_definition_id"
    WF_PROCESS_INSTANCE ||--o{ WF_TASK : "process_instance_id"
    WF_PROCESS_INSTANCE ||--o{ WF_APPROVAL_RECORD : "process_instance_id"
    WF_TASK ||--o{ WF_APPROVAL_RECORD : "task_id"

    WF_WORKFLOW_DEFINITION {
        bigint id PK "主键"
        varchar workflow_code UK "uk_tenant_code 租户内唯一"
        varchar workflow_name "流程名"
        varchar description "描述"
        text node_definition "节点定义 JSON（DAG 节点与连线）"
        int version "版本"
        tinyint enabled "是否启用"
        varchar remark "备注"
        bigint tenant_id "租户"
        tinyint deleted "逻辑删除"
    }

    WF_PROCESS_INSTANCE {
        bigint id PK "主键"
        bigint workflow_definition_id FK "流程定义"
        varchar business_key "业务主键"
        varchar current_node_key "当前节点"
        varchar status "RUNNING/COMPLETED/REJECTED/CANCELLED/SUSPENDED"
        varchar initiator_id "发起人"
        text form_data "表单数据 JSON（流程变量）"
        datetime start_time "开始时间"
        datetime end_time "结束时间"
        tinyint suspended "V21 是否挂起"
        varchar remark "备注"
        bigint tenant_id "租户"
        tinyint deleted "逻辑删除"
    }

    WF_TASK {
        bigint id PK "主键"
        bigint process_instance_id FK "流程实例"
        varchar node_code "节点编码"
        varchar task_name "任务名"
        varchar assignee_id "处理人"
        varchar status "PENDING/COMPLETED/REJECTED/CANCELLED/TRANSFERRED"
        datetime due_time "截止时间"
        datetime complete_time "完成时间"
        datetime timeout_at "超时时间"
        varchar timeout_strategy "超时策略 ESCALATE/AUTO_COMPLETE/NOTIFY"
        tinyint timeout_handled "超时是否已处理"
        varchar transferred_from "转办来源"
        varchar remark "备注"
        bigint tenant_id "租户"
        tinyint deleted "逻辑删除"
    }

    WF_APPROVAL_RECORD {
        bigint id PK "主键"
        bigint process_instance_id FK "流程实例"
        bigint task_id FK "任务"
        varchar node_code "节点编码"
        varchar approver_id "审批人"
        varchar action "审批动作"
        varchar opinion "审批意见"
        varchar remark "备注"
        bigint tenant_id "租户"
        tinyint deleted "逻辑删除"
    }

    WF_SCHEDULER_LEASE {
        varchar lock_name PK "锁名"
        varchar owner "持有者"
        datetime lease_until "租约截止"
        datetime update_time "更新时间"
    }
