        INT_SVC["apex-integration-service<br/>integration"]
        AGG_SVC["apex-aggregation-service<br/>common · api-contract（无业务库依赖、无 DB；gateway 仅 test）"]
        GW["apex-gateway<br/>common"]
        JOB_SVC["apex-job-service<br/>infrastructure-remote"]
        MASK["apex-masking-service<br/>common"]
    end

    subgraph L5["L5 组合部署 / 示例"]
        BOOT["apex-boot-all<br/>common · domain · api-contract · 六个业务库"]
        EXAMPLE["apex-example<br/>common · domain · cache · integration · system"]
    end

