        REMOTE["apex-infrastructure-remote<br/>common · domain"]
        MSG["apex-infrastructure-messaging<br/>common · domain · persistence"]
        INTEG["apex-infrastructure-integration<br/>common · domain · remote"]
        COMPAT["apex-infrastructure<br/>依赖五个能力 JAR（仅兼容旧坐标）"]
        LIC_S["apex-license-spring-boot-starter<br/>common"]
        LIC_T["apex-license-tools<br/>license-starter"]
        STO_S["apex-storage-spring-boot-starter<br/>common"]
        JOB_S["apex-job-spring-boot-starter<br/>common"]
        SEA_S["apex-seata-spring-boot-starter<br/>common"]
    end

    subgraph L3["L3 业务库"]
        SYSTEM["apex-system<br/>common · domain · api-contract · 5×设施JAR · license-starter"]
        AUTH["apex-auth<br/>common · domain · api-contract · infra-integration"]
        WORKFLOW["apex-workflow<br/>common · domain"]
        FILE["apex-file<br/>common · domain · storage-starter"]
        OFFICE["apex-office<br/>common · domain"]
        INTEGRATION["apex-integration<br/>common · domain · persistence · remote"]
    end

    subgraph L4["L4 运行模块（业务 service = 业务库 + common·domain + job/seata starter）"]
        SYS_SVC["apex-system-service<br/>system（另依赖 api-contract）"]
        AUTH_SVC["apex-auth-service<br/>auth（另依赖 api-contract·cache·messaging·integration；system 仅 test）"]
        WF_SVC["apex-workflow-service<br/>workflow（另依赖 api-contract）"]
        FILE_SVC["apex-file-service<br/>file（无 api-contract）"]
