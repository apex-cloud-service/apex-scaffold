flowchart LR
    subgraph L0["L0 共享基础"]
        COMMON["apex-common<br/>通用能力/上下文/调度器（无内部依赖）"]
    end

    subgraph L1["L1 共享领域 / 契约"]
        DOMAIN["apex-domain<br/>基础实体/事件/端口契约 · common"]
        CONTRACT["apex-api-contract<br/>跨服务内部 API 与 DTO · common"]
    end

    subgraph L2["L2 共享设施 / starter / 授权工具"]
        PERSIST["apex-infrastructure-persistence<br/>common · domain"]
