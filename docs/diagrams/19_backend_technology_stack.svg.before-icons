<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1400" width="1600" height="1400">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #0f172a; }
      .subtitle { font: 16px sans-serif; fill: #666; }
      .layer-title { font: bold 18px sans-serif; fill: #fff; }
      .tech-title { font: bold 14px sans-serif; fill: #0f172a; }
      .tech-desc { font: 12px sans-serif; fill: #666; }
      .version { font: 11px sans-serif; fill: #0ea5e9; }
      .layer-bg { fill: #0f172a; }
      .tech-box { fill: #fff; stroke: #e2e8f0; stroke-width: 2; }
      .tech-box:hover { fill: #f8fafc; stroke: #38bdf8; }
      .core-box { fill: #fef3c7; stroke: #d97706; stroke-width: 2; }
      .arrow { fill: none; stroke: #94a3b8; stroke-width: 2; marker-end: url(#arrowhead); }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#94a3b8"/>
    </marker>
  </defs>

  <!-- 标题 -->
  <text x="800" y="40" text-anchor="middle" class="title">Apex Scaffold 后端技术栈架构</text>
  <text x="800" y="65" text-anchor="middle" class="subtitle">Backend Technology Stack Architecture - Java 17 / Spring Boot 3.5 / WebFlux Reactive</text>

  <!-- Layer 1: 核心框架层 (Core Framework) -->
  <rect x="50" y="100" width="1500" height="180" rx="8" class="layer-bg"/>
  <text x="70" y="130" class="layer-title">[Layer 1] 核心框架层 Core Framework</text>

  <!-- Spring Boot 3.5.15 -->
  <rect x="70" y="145" width="220" height="120" rx="6" class="core-box"/>
  <text x="180" y="170" text-anchor="middle" class="tech-title">Spring Boot</text>
  <text x="180" y="188" text-anchor="middle" class="version">3.5.15</text>
  <text x="80" y="208" class="tech-desc">• spring-boot-starter-webflux</text>
  <text x="80" y="225" class="tech-desc">• spring-boot-starter-security</text>
  <text x="80" y="242" class="tech-desc">• spring-boot-starter-actuator</text>
  <text x="80" y="259" class="tech-desc">• spring-boot-starter-validation</text>

  <!-- Spring WebFlux -->
  <rect x="310" y="145" width="220" height="120" rx="6" class="core-box"/>
  <text x="420" y="170" text-anchor="middle" class="tech-title">Spring WebFlux</text>
  <text x="420" y="188" text-anchor="middle" class="version">Reactor 3.6.13</text>
  <text x="320" y="208" class="tech-desc">• 响应式Web框架</text>
  <text x="320" y="225" class="tech-desc">• Netty Server (NIO)</text>
  <text x="320" y="242" class="tech-desc">• Mono/Flux 响应式流</text>
  <text x="320" y="259" class="tech-desc">• 高并发低延迟</text>

  <!-- Spring Security -->
