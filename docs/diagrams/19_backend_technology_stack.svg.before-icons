  <text x="560" y="225" class="tech-desc">• RBAC 权限控制</text>
  <text x="560" y="242" class="tech-desc">• 数据权限过滤</text>
  <text x="560" y="259" class="tech-desc">• SecurityFilterChain</text>

  <!-- Java 17 -->
  <rect x="790" y="145" width="200" height="120" rx="6" class="core-box"/>
  <text x="890" y="170" text-anchor="middle" class="tech-title">Java</text>
  <text x="890" y="188" text-anchor="middle" class="version">17 LTS</text>
  <text x="800" y="208" class="tech-desc">• Records</text>
