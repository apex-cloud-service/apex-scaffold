flowchart TB
  subgraph Model["model.entity 基础实体"]
    M1["BaseEntity 业务实体公共基类"]
  end

  subgraph Event["event 通用领域事件契约"]
    E1["DomainEventBus · DomainEventHandler"]
    E2["TokenRevokedEvent"]
  end

  subgraph GW["gateway 外部平台 Gateway 契约"]
    G1["ChuanglanGateway 创蓝短信"]
    G2["WeChatGateway 微信平台"]
    G3["CircuitBreakerPort · Remote* 异常契约"]
  end

  subgraph Svc["service 跨域服务端口"]
    S1["DomainEventPublisher · CacheConsistencyPort"]
    S2["BusinessMetricsPort · CacheService"]
    S3["TokenService · TokenBlacklistService"]
    S4["SmsCodeService · SmsCodePurposeService"]
  end

  COMMON["apex-common（L0）"]
  INF["apex-infrastructure-integration / remote / persistence（实现 Gateway 与端口）"]
  BIZ["六个业务库（system/auth/workflow/file/office/integration）"]

  COMMON --> Model
  COMMON --> Event
  COMMON --> GW
  COMMON --> Svc
  GW -. "依赖倒置：由基础设施实现" .-> INF
  Svc -. "依赖倒置" .-> INF
  BIZ --> Model
  BIZ --> Event
  BIZ --> Svc

  NOTE["apex-domain 只容纳可跨域复用的契约（依赖深度 L1，被 19 个模块直接依赖）；system 专属实体在 apex-system，workflow/office 领域模型在各自业务库"]
  GW -.-> NOTE
