<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1200">
  <defs>
    <style>
      .title { font: bold 28px sans-serif; fill: #0f172a; }
      .subtitle { font: 16px sans-serif; fill: #666; }
      .section-title { font: bold 20px sans-serif; fill: #1e293b; }
      .component-title { font: bold 14px sans-serif; fill: #334155; }
      .component-text { font: 12px sans-serif; fill: #555; }
      .label-text { font: 11px sans-serif; fill: #666; }
      .detail-text { font: 10px sans-serif; fill: #444; }
      
      .producer-box { fill: #e8f5e9; stroke: #4caf50; stroke-width: 2; }
      .nameserver-box { fill: #e1f5fe; stroke: #03a9f4; stroke-width: 2; }
      .broker-master { fill: #fff3e0; stroke: #ff9800; stroke-width: 2; }
      .broker-slave { fill: #fff9c4; stroke: #fbc02d; stroke-width: 2; }
      .consumer-box { fill: #f3e5f5; stroke: #9c27b0; stroke-width: 2; }
      .storage-box { fill: #fce4ec; stroke: #e91e63; stroke-width: 2; }
      .component-box { fill: white; stroke: #495057; stroke-width: 1.5; }
      
      .msg-arrow { fill: none; stroke: #4caf50; stroke-width: 2.5; marker-end: url(#msg-arrow); }
      .reg-arrow { fill: none; stroke: #03a9f4; stroke-width: 2; marker-end: url(#reg-arrow); stroke-dasharray: 4,2; }
      .sync-arrow { fill: none; stroke: #ff9800; stroke-width: 2.5; marker-end: url(#sync-arrow); }
      .consume-arrow { fill: none; stroke: #9c27b0; stroke-width: 2.5; marker-end: url(#consume-arrow); }
    </style>
    
    <marker id="msg-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#4caf50" />
    </marker>
    <marker id="reg-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#03a9f4" />
    </marker>
    <marker id="sync-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#ff9800" />
    </marker>
    <marker id="consume-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#9c27b0" />
    </marker>
  </defs>

  <!-- Title -->
  <text x="800" y="40" text-anchor="middle" class="title">RocketMQ 消息队列架构</text>
  <text x="800" y="65" text-anchor="middle" class="subtitle">Message Queue Architecture &amp; HA Design</text>

  <!-- ==================== Producer Section ==================== -->
  <rect x="50" y="100" width="450" height="250" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="130" class="section-title">[Upload] 生产者集群</text>
  
  <!-- Producer 1 -->
  <rect x="100" y="160" width="150" height="90" rx="8" class="producer-box"/>
  <text x="175" y="185" text-anchor="middle" class="component-title">Producer-1</text>
  <text x="175" y="205" text-anchor="middle" class="label-text">apex-app-pod-1</text>
  <text x="175" y="225" text-anchor="middle" class="detail-text">• 同步发送</text>
  <text x="175" y="240" text-anchor="middle" class="detail-text">• 失败重试3次</text>
  
  <!-- Producer 2 -->
  <rect x="300" y="160" width="150" height="90" rx="8" class="producer-box"/>
  <text x="375" y="185" text-anchor="middle" class="component-title">Producer-2</text>
  <text x="375" y="205" text-anchor="middle" class="label-text">apex-app-pod-2</text>
  <text x="375" y="225" text-anchor="middle" class="detail-text">• 异步发送</text>
  <text x="375" y="240" text-anchor="middle" class="detail-text">• 批量发送</text>
  
  <!-- Producer Features -->
  <rect x="100" y="270" width="350" height="60" rx="8" fill="#e8f5e9" stroke="#4caf50" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="120" y="295" class="component-text">[Gear] 生产者特性</text>
  <text x="120" y="313" class="detail-text">• 负载均衡: 轮询选择Broker发送</text>
  <text x="120" y="325" class="detail-text">• 重试机制: 发送失败自动切换Broker重试</text>

  <!-- ==================== NameServer Section ==================== -->
  <rect x="550" y="100" width="500" height="250" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="570" y="130" class="section-title">[Compass] NameServer 集群</text>
  
  <!-- NameServer 1 -->
  <rect x="600" y="160" width="130" height="90" rx="8" class="nameserver-box"/>
  <text x="665" y="185" text-anchor="middle" class="component-title">NameServer-1</text>
  <text x="665" y="205" text-anchor="middle" class="label-text">:9876</text>
  <text x="665" y="225" text-anchor="middle" class="detail-text">路由注册</text>
  <text x="665" y="240" text-anchor="middle" class="detail-text">Broker管理</text>
  
  <!-- NameServer 2 -->
  <rect x="770" y="160" width="130" height="90" rx="8" class="nameserver-box"/>
  <text x="835" y="185" text-anchor="middle" class="component-title">NameServer-2</text>
  <text x="835" y="205" text-anchor="middle" class="label-text">:9876</text>
  <text x="835" y="225" text-anchor="middle" class="detail-text">路由注册</text>
  <text x="835" y="240" text-anchor="middle" class="detail-text">Broker管理</text>
  
  <!-- NameServer 3 -->
  <rect x="940" y="160" width="130" height="90" rx="8" class="nameserver-box"/>
  <text x="1005" y="185" text-anchor="middle" class="component-title">NameServer-3</text>
  <text x="1005" y="205" text-anchor="middle" class="label-text">:9876</text>
  <text x="1005" y="225" text-anchor="middle" class="detail-text">路由注册</text>
  <text x="1005" y="240" text-anchor="middle" class="detail-text">Broker管理</text>
  
  <!-- NameServer Features -->
  <rect x="600" y="270" width="470" height="60" rx="8" fill="#e1f5fe" stroke="#03a9f4" stroke-width="2" stroke-dasharray="4,4"/>
  <text x="620" y="295" class="component-text">[Target] NameServer 特性</text>
  <text x="620" y="313" class="detail-text">• 无状态设计: 节点之间不通信，独立服务</text>
  <text x="620" y="325" class="detail-text">• 路由信息: 维护Topic → Broker映射，30s心跳检测</text>

  <!-- ==================== Broker Section ==================== -->
  <rect x="50" y="380" width="1000" height="320" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="410" class="section-title">[Building] Broker 集群 (主从架构)</text>
  
  <!-- Broker Group 1 -->
  <g id="broker-group-1">
    <rect x="100" y="440" width="220" height="240" rx="8" fill="#fff" stroke="#607d8b" stroke-width="2" stroke-dasharray="6,3"/>
    <text x="120" y="465" class="component-text" font-weight="bold">Broker-Group-1</text>
    
    <!-- Master-1 -->
    <rect x="120" y="480" width="180" height="100" rx="8" class="broker-master"/>
    <text x="210" y="505" text-anchor="middle" class="component-title">[Blue] Broker-Master</text>
    <text x="210" y="525" text-anchor="middle" class="label-text">broker-a</text>
    <text x="210" y="545" text-anchor="middle" class="detail-text">:10911 (Broker)</text>
    <text x="210" y="560" text-anchor="middle" class="detail-text">:10912 (VIP)</text>
    <text x="210" y="572" text-anchor="middle" class="detail-text" font-weight="bold">读写</text>
    
    <!-- Slave-1 -->
    <rect x="120" y="600" width="180" height="60" rx="8" class="broker-slave"/>
    <text x="210" y="625" text-anchor="middle" class="component-title">[Yellow] Broker-Slave</text>
    <text x="210" y="645" text-anchor="middle" class="label-text">broker-a-s</text>
    <text x="210" y="655" text-anchor="middle" class="detail-text" font-weight="bold">只读</text>
    
    <!-- Replication Arrow -->
    <path d="M 210 580 L 210 600" class="sync-arrow"/>
    <text x="220" y="595" class="detail-text" fill="#ff9800">同步复制</text>
  </g>
  
  <!-- Broker Group 2 -->
  <g id="broker-group-2">
    <rect x="360" y="440" width="220" height="240" rx="8" fill="#fff" stroke="#607d8b" stroke-width="2" stroke-dasharray="6,3"/>
    <text x="380" y="465" class="component-text" font-weight="bold">Broker-Group-2</text>
    
    <!-- Master-2 -->
    <rect x="380" y="480" width="180" height="100" rx="8" class="broker-master"/>
    <text x="470" y="505" text-anchor="middle" class="component-title">[Blue] Broker-Master</text>
    <text x="470" y="525" text-anchor="middle" class="label-text">broker-b</text>
    <text x="470" y="545" text-anchor="middle" class="detail-text">:10911 (Broker)</text>
    <text x="470" y="560" text-anchor="middle" class="detail-text">:10912 (VIP)</text>
    <text x="470" y="572" text-anchor="middle" class="detail-text" font-weight="bold">读写</text>
    
    <!-- Slave-2 -->
    <rect x="380" y="600" width="180" height="60" rx="8" class="broker-slave"/>
    <text x="470" y="625" text-anchor="middle" class="component-title">[Yellow] Broker-Slave</text>
    <text x="470" y="645" text-anchor="middle" class="label-text">broker-b-s</text>
    <text x="470" y="655" text-anchor="middle" class="detail-text" font-weight="bold">只读</text>
    
    <!-- Replication Arrow -->
    <path d="M 470 580 L 470 600" class="sync-arrow"/>
    <text x="480" y="595" class="detail-text" fill="#ff9800">同步复制</text>
  </g>
  
  <!-- Broker Storage -->
  <rect x="640" y="440" width="380" height="240" rx="8" class="storage-box"/>
  <text x="830" y="465" text-anchor="middle" class="component-title">[Disk] 消息存储结构</text>
  
  <rect x="670" y="485" width="160" height="50" rx="6" fill="#fff" stroke="#e91e63" stroke-width="1.5"/>
  <text x="750" y="505" text-anchor="middle" class="component-text">CommitLog</text>
  <text x="750" y="523" text-anchor="middle" class="detail-text">顺序写，所有消息</text>
  
  <rect x="850" y="485" width="150" height="50" rx="6" fill="#fff" stroke="#e91e63" stroke-width="1.5"/>
  <text x="925" y="505" text-anchor="middle" class="component-text">ConsumeQueue</text>
  <text x="925" y="523" text-anchor="middle" class="detail-text">索引，按Topic</text>
  
  <rect x="670" y="555" width="160" height="50" rx="6" fill="#fff" stroke="#e91e63" stroke-width="1.5"/>
  <text x="750" y="575" text-anchor="middle" class="component-text">IndexFile</text>
  <text x="750" y="593" text-anchor="middle" class="detail-text">key索引查询</text>
  
  <rect x="850" y="555" width="150" height="50" rx="6" fill="#fff" stroke="#e91e63" stroke-width="1.5"/>
  <text x="925" y="575" text-anchor="middle" class="component-text">Config</text>
  <text x="925" y="593" text-anchor="middle" class="detail-text">配置文件</text>
  
  <rect x="670" y="625" width="330" height="40" rx="6" fill="#ffe8d6" stroke="#fd7e14" stroke-width="2"/>
  <text x="835" y="650" text-anchor="middle" class="detail-text">零拷贝 (mmap + sendfile) + 页缓存优化</text>

  <!-- ==================== Consumer Section ==================== -->
  <rect x="1100" y="100" width="450" height="600" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="1120" y="130" class="section-title">[Download] 消费者集群</text>
  
  <!-- Consumer Group 1 -->
  <g id="consumer-group-1">
    <rect x="1130" y="160" width="380" height="230" rx="8" fill="#fff" stroke="#9c27b0" stroke-width="2" stroke-dasharray="6,3"/>
    <text x="1150" y="185" class="component-text" font-weight="bold">ConsumerGroup-1 (集群模式)</text>
    
    <rect x="1150" y="200" width="140" height="70" rx="6" class="consumer-box"/>
    <text x="1220" y="225" text-anchor="middle" class="component-text">Consumer-1</text>
    <text x="1220" y="245" text-anchor="middle" class="detail-text">订阅: TopicA</text>
    <text x="1220" y="260" text-anchor="middle" class="detail-text">Queue: 0,1</text>
    
    <rect x="1330" y="200" width="140" height="70" rx="6" class="consumer-box"/>
    <text x="1400" y="225" text-anchor="middle" class="component-text">Consumer-2</text>
    <text x="1400" y="245" text-anchor="middle" class="detail-text">订阅: TopicA</text>
    <text x="1400" y="260" text-anchor="middle" class="detail-text">Queue: 2,3</text>
    
    <rect x="1150" y="290" width="320" height="80" rx="6" fill="#f3e5f5" stroke="#9c27b0" stroke-width="1.5"/>
    <text x="1170" y="313" class="component-text">消费模式: 集群消费</text>
    <text x="1170" y="333" class="detail-text">• 负载均衡: 平均分配Queue给消费者</text>
    <text x="1170" y="348" class="detail-text">• 消费进度: 存储在Broker</text>
    <text x="1170" y="363" class="detail-text">• 消息不重复: 每条消息只被一个消费者消费</text>
  </g>
  
  <!-- Consumer Group 2 -->
  <g id="consumer-group-2">
    <rect x="1130" y="420" width="380" height="200" rx="8" fill="#fff" stroke="#9c27b0" stroke-width="2" stroke-dasharray="6,3"/>
    <text x="1150" y="445" class="component-text" font-weight="bold">ConsumerGroup-2 (广播模式)</text>
    
    <rect x="1150" y="460" width="140" height="70" rx="6" class="consumer-box"/>
    <text x="1220" y="485" text-anchor="middle" class="component-text">Consumer-A</text>
    <text x="1220" y="505" text-anchor="middle" class="detail-text">订阅: TopicB</text>
    <text x="1220" y="520" text-anchor="middle" class="detail-text">消费全部</text>
    
    <rect x="1330" y="460" width="140" height="70" rx="6" class="consumer-box"/>
    <text x="1400" y="485" text-anchor="middle" class="component-text">Consumer-B</text>
    <text x="1400" y="505" text-anchor="middle" class="detail-text">订阅: TopicB</text>
    <text x="1400" y="520" text-anchor="middle" class="detail-text">消费全部</text>
    
    <rect x="1150" y="550" width="320" height="50" rx="6" fill="#f3e5f5" stroke="#9c27b0" stroke-width="1.5"/>
    <text x="1170" y="573" class="component-text">消费模式: 广播消费</text>
    <text x="1170" y="593" class="detail-text">• 每个消费者都接收全部消息</text>
  </g>
  
  <!-- Consumer Features -->
  <rect x="1130" y="640" width="380" height="40" rx="6" fill="#e8eaf6" stroke="#5c6bc0" stroke-width="2"/>
  <text x="1150" y="665" class="detail-text">[Idea] 消费特性: 顺序消费 | 并发消费 | 重试队列 | 死信队列</text>

  <!-- ==================== Message Flow ==================== -->
  <!-- Producer to NameServer -->
  <path d="M 275 250 L 275 380 L 665 380 L 665 250" class="reg-arrow"/>
  <text x="280" y="315" class="detail-text" fill="#03a9f4">路由查询</text>
  
  <!-- Producer to Broker -->
  <path d="M 175 250 L 175 380 L 210 380 L 210 440" class="msg-arrow"/>
  <path d="M 375 250 L 375 410 L 470 410 L 470 440" class="msg-arrow"/>
  <text x="180" y="345" class="detail-text" fill="#4caf50">发送消息</text>
  
  <!-- Broker to NameServer -->
  <path d="M 210 440 L 210 420 L 665 420 L 665 250" class="reg-arrow"/>
  <path d="M 470 440 L 470 430 L 835 430 L 835 250" class="reg-arrow"/>
  <text x="440" y="425" class="detail-text" fill="#03a9f4">注册路由</text>
  
  <!-- Consumer to NameServer -->
  <path d="M 1100 210 L 1070 210 L 1070 205 L 1005 205 L 1005 250" class="reg-arrow"/>
  <text x="1020" y="230" class="detail-text" fill="#03a9f4">路由发现</text>
  
  <!-- Broker to Consumer -->
  <path d="M 580 550 L 1050 550 L 1050 235 L 1100 235" class="consume-arrow"/>
  <path d="M 1050 550 L 1050 495 L 1100 495" class="consume-arrow"/>
  <text x="800" y="545" class="detail-text" fill="#9c27b0">Pull/Push消费</text>

  <!-- ==================== HA & Failover ==================== -->
  <rect x="50" y="730" width="1000" height="150" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="760" class="section-title">高可用与故障转移</text>
  
  <rect x="100" y="780" width="280" height="80" rx="8" fill="#e8f5e9" stroke="#4caf50" stroke-width="2"/>
  <text x="120" y="805" class="component-text">[Check] Master宕机</text>
  <text x="120" y="825" class="detail-text">• Slave自动接管读请求</text>
  <text x="120" y="840" class="detail-text">• 写请求路由到其他Broker Group</text>
  <text x="120" y="855" class="detail-text">• DLedger模式支持主从自动切换</text>
  
  <rect x="420" y="780" width="280" height="80" rx="8" fill="#e1f5fe" stroke="#03a9f4" stroke-width="2"/>
  <text x="440" y="805" class="component-text">NameServer宕机</text>
  <text x="440" y="825" class="detail-text">• 客户端本地缓存路由信息</text>
  <text x="440" y="840" class="detail-text">• 可继续发送消息到已知Broker</text>
  <text x="440" y="855" class="detail-text">• 其他NameServer节点正常服务</text>
  
  <rect x="740" y="780" width="280" height="80" rx="8" fill="#f3e5f5" stroke="#9c27b0" stroke-width="2"/>
  <text x="760" y="805" class="component-text">[Refresh] 消费失败</text>
  <text x="760" y="825" class="detail-text">• 重试队列: 延时重试16次</text>
  <text x="760" y="840" class="detail-text">• 死信队列: 超过重试次数存入DLQ</text>
  <text x="760" y="855" class="detail-text">• 人工介入处理死信消息</text>

  <!-- ==================== Performance & Config ==================== -->
  <rect x="50" y="910" width="1500" height="270" rx="10" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>
  <text x="70" y="940" class="section-title">[Flash] 性能优化与最佳实践</text>
  
  <!-- Performance Metrics -->
  <rect x="100" y="960" width="460" height="100" rx="8" fill="#fff3e0" stroke="#ff9800" stroke-width="2"/>
  <text x="120" y="985" class="component-text" font-weight="bold">[Chart] 性能指标</text>
  <text x="120" y="1005" class="detail-text">• 吞吐量: 单Broker &gt; 10万TPS (异步发送)</text>
  <text x="120" y="1025" class="detail-text">• 延迟: P99 &lt; 10ms (同步复制), P99 &lt; 5ms (异步复制)</text>
  <text x="120" y="1045" class="detail-text">• 消息堆积: 支持TB级消息堆积，性能不衰减</text>
  
  <!-- Best Practices -->
  <rect x="600" y="960" width="460" height="200" rx="8" fill="#e8eaf6" stroke="#5c6bc0" stroke-width="2"/>
  <text x="620" y="985" class="component-text" font-weight="bold">[Idea] 最佳实践</text>
  <text x="620" y="1005" class="detail-text">• 发送方式: 普通消息用异步，关键消息用同步</text>
  <text x="620" y="1025" class="detail-text">• 消息顺序: 使用MessageQueueSelector保证顺序</text>
  <text x="620" y="1045" class="detail-text">• 事务消息: 保证本地事务与消息发送一致性</text>
  <text x="620" y="1065" class="detail-text">• 消息过滤: Tag过滤减少消费者网络开销</text>
  <text x="620" y="1085" class="detail-text">• 消费幂等: 消费端根据MessageId去重</text>
  <text x="620" y="1105" class="detail-text">• 监控告警: 消息堆积 &gt; 10万触发告警</text>
  <text x="620" y="1125" class="detail-text">• 日志保留: 72小时，自动清理过期消息</text>
  <text x="620" y="1145" class="detail-text">• 集群规划: 3个NameServer + 4个Broker (2主2从)</text>
  
  <!-- Configuration -->
  <rect x="1100" y="960" width="420" height="200" rx="8" fill="#fce4ec" stroke="#e91e63" stroke-width="2"/>
  <text x="1120" y="985" class="component-text" font-weight="bold">[Gear] 关键配置</text>
  <text x="1120" y="1005" class="detail-text">• brokerRole: SYNC_MASTER (同步复制主)</text>
  <text x="1120" y="1025" class="detail-text">• flushDiskType: ASYNC_FLUSH (异步刷盘)</text>
  <text x="1120" y="1045" class="detail-text">• sendMsgTimeout: 3000ms (发送超时)</text>
  <text x="1120" y="1065" class="detail-text">• maxMessageSize: 4MB (最大消息)</text>
  <text x="1120" y="1085" class="detail-text">• consumerTimeout: 15min (消费超时)</text>
  <text x="1120" y="1105" class="detail-text">• retryTimesWhenSendFailed: 3 (重试次数)</text>
  <text x="1120" y="1125" class="detail-text">• fileReservedTime: 72 (文件保留小时)</text>
  <text x="1120" y="1145" class="detail-text">• diskMaxUsedSpaceRatio: 75% (磁盘水位)</text>
  
  <!-- Deployment Scenario -->
  <rect x="100" y="1080" width="460" height="80" rx="8" fill="#d4edda" stroke="#28a745" stroke-width="2"/>
  <text x="120" y="1105" class="component-text" font-weight="bold">🚀 部署场景</text>
  <text x="120" y="1125" class="detail-text">• 订单系统: 事务消息保证订单与支付一致性</text>
