{
  "dashboard": {
    "title": "Apex Scaffold 缓存监控",
    "tags": ["cache", "performance", "apex-scaffold"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "panels": [
      {
        "id": 1,
        "title": "缓存命中率",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(cache_hits_total{application=\"apex-scaffold\"}[5m])) / sum(rate(cache_requests_total{application=\"apex-scaffold\"}[5m]))",
            "legendFormat": "总命中率",
            "refId": "A"
          },
          {
            "expr": "sum(rate(l1_cache_hits_total{application=\"apex-scaffold\"}[5m])) / sum(rate(l1_cache_requests_total{application=\"apex-scaffold\"}[5m]))",
            "legendFormat": "L1 命中率",
            "refId": "B"
          },
          {
            "expr": "sum(rate(l2_cache_hits_total{application=\"apex-scaffold\"}[5m])) / sum(rate(l2_cache_requests_total{application=\"apex-scaffold\"}[5m]))",
            "legendFormat": "L2 命中率",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "命中率",
            "max": 1,
            "min": 0
          },
          {"format": "short"}
        ],
        "alert": {
          "name": "缓存命中率过低",
          "conditions": [
            {
              "evaluator": {"params": [0.8], "type": "lt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "缓存命中率低于 80%",
          "noDataState": "no_data"
        }
      },
      {
        "id": 2,
        "title": "缓存请求 QPS",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(cache_requests_total{application=\"apex-scaffold\"}[1m]))",
            "legendFormat": "总请求",
            "refId": "A"
          },
          {
            "expr": "sum(rate(cache_hits_total{application=\"apex-scaffold\"}[1m]))",
            "legendFormat": "命中",
            "refId": "B"
          },
          {
            "expr": "sum(rate(cache_misses_total{application=\"apex-scaffold\"}[1m]))",
            "legendFormat": "未命中",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "请求/秒"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "缓存穿透防护",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "rate(apex_cache_penetration_blocked_total{application=\"apex-scaffold\"}[1m]) * 60",
            "legendFormat": "布隆过滤器拦截/分钟",
            "refId": "A"
          },
          {
            "expr": "rate(apex_cache_empty_marker_hits_total{application=\"apex-scaffold\"}[1m]) * 60",
            "legendFormat": "空值标记命中/分钟",
            "refId": "B"
          },
          {
            "expr": "rate(apex_cache_db_fallback_total{application=\"apex-scaffold\"}[1m]) * 60",
            "legendFormat": "DB回源/分钟",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "次数/分钟"},
          {"format": "short"}
        ],
        "alert": {
          "name": "缓存穿透频繁",
          "conditions": [
            {
              "evaluator": {"params": [100], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "缓存穿透次数过高，每分钟超过 100 次",
          "noDataState": "no_data"
        }
      },
      {
        "id": 4,
        "title": "缓存击穿防护",
        "type": "graph",
        "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "rate(apex_cache_lock_failed_total{application=\"apex-scaffold\"}[1m]) * 60",
            "legendFormat": "分布式锁失败/分钟",
            "refId": "A"
          },
          {
            "expr": "rate(apex_cache_lock_success_total{application=\"apex-scaffold\"}[1m]) * 60",
            "legendFormat": "分布式锁成功/分钟",
            "refId": "B"
          },
          {
            "expr": "rate(apex_cache_inflight_merge_total{application=\"apex-scaffold\"}[1m]) * 60",
            "legendFormat": "Single-Flight合并/分钟",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "次数/分钟"},
          {"format": "short"}
        ],
        "alert": {
          "name": "缓存击穿检测",
          "conditions": [
            {
              "evaluator": {"params": [10], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "2m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "检测到缓存击穿，分布式锁失败次数过高",
          "noDataState": "no_data"
        }
      },
      {
        "id": 5,
        "title": "读降级监控",
        "type": "graph",
        "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "rate(apex_cache_read_degradation_total{application=\"apex-scaffold\"}[1m]) * 60",
            "legendFormat": "读降级次数/分钟",
            "refId": "A"
          },
          {
            "expr": "rate(apex_cache_read_degradation_total{application=\"apex-scaffold\"}[5m]) / rate(apex_cache_requests_total{application=\"apex-scaffold\"}[5m])",
            "legendFormat": "读降级占比",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "次数/分钟"},
          {"format": "percentunit", "label": "占比"}
        ],
        "alert": {
          "name": "读降级启用",
          "conditions": [
            {
              "evaluator": {"params": [0], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "1m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "数据库故障，读降级已启用",
          "noDataState": "no_data"
        }
      },
      {
        "id": 6,
        "title": "分布式锁等待时间 (P95)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(apex_cache_lock_wait_duration_seconds_bucket{application=\"apex-scaffold\"}[5m]))",
            "legendFormat": "P95 等待时间",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, rate(apex_cache_lock_wait_duration_seconds_bucket{application=\"apex-scaffold\"}[5m]))",
            "legendFormat": "P99 等待时间",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "ms", "label": "等待时间"},
          {"format": "short"}
        ],
        "alert": {
          "name": "锁等待时间过长",
          "conditions": [
            {
              "evaluator": {"params": [500], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "分布式锁等待时间过长，P95 超过 500ms",
          "noDataState": "no_data"
        }
      },
      {
        "id": 7,
        "title": "缓存预热状态",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(apex_cache_prewarm_success_total{application=\"apex-scaffold\"}[5m]) * 60",
            "legendFormat": "预热成功/分钟",
            "refId": "A"
          },
          {
            "expr": "rate(apex_cache_prewarm_failed_total{application=\"apex-scaffold\"}[5m]) * 60",
            "legendFormat": "预热失败/分钟",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "次数/分钟"},
          {"format": "short"}
        ],
        "alert": {
          "name": "缓存预热失败",
          "conditions": [
            {
              "evaluator": {"params": [0], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["B", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "5m",
          "handler": 1,
          "message": "缓存预热出现失败",
          "noDataState": "no_data"
        }
      },
      {
        "id": 8,
        "title": "布隆过滤器容量",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "apex_cache_bloom_filter_count{application=\"apex-scaffold\"} / apex_cache_bloom_filter_capacity{application=\"apex-scaffold\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.7, "color": "yellow"},
                {"value": 0.8, "color": "orange"},
                {"value": 0.9, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "TTL Jitter 应用统计",
        "type": "stat",
        "gridPos": {"x": 6, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(increase(apex_cache_ttl_jitter_applied_total{application=\"apex-scaffold\"}[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "displayName": "最近1小时应用次数"
          }
        }
      },
      {
        "id": 10,
        "title": "Redis 连接池状态",
        "type": "graph",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "redis_connection_active{application=\"apex-scaffold\"}",
            "legendFormat": "活跃连接",
            "refId": "A"
          },
          {
            "expr": "redis_connection_idle{application=\"apex-scaffold\"}",
            "legendFormat": "空闲连接",
            "refId": "B"
          },
          {
            "expr": "redis_connection_total{application=\"apex-scaffold\"}",
            "legendFormat": "总连接数",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "连接数"},
          {"format": "short"}
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 27,
    "style": "dark",
    "version": 1
  }
}
