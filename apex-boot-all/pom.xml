<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - 组合部署包（all-in-one 拓扑）
  - 方案 M3 / 批次 C9：单进程装配全部业务组件，用于 basic/示例/演示档；
  - 企业部署仍为五服务拆分（apex-*-service）。
  - 约束：本模块仅装配，不含业务实现；依赖均为组件库。
  - @author Apex Team
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-services-bom</artifactId>
        <version>1.3.1</version>
        <relativePath>../apex-services-bom/pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>apex-boot-all</artifactId>
    <packaging>jar</packaging>
    <name>apex-boot-all</name>
    <description>组合部署包：单进程装配全部业务组件（basic/示例档）</description>

    <dependencies>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-api-contract</artifactId>
        </dependency>
        <!-- 业务组件：组件入口自动装配（C7） -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-office</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
