<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - 工作流服务模块 POM
  - 微服务化改造 Phase 3：将工作流能力独立为可单独启动/发布/扩展的服务。
  - 功能：路由/处理器/DTO（interfaces 层）+ 工作流应用服务（引用 apex-workflow）
  -       + 独立 ape_workflow 库 Flyway 迁移 + 审批事件发布（apex-workflow-events）。
  - 约束：本模块 <parent> 指向 apex-services-bom；业务代码禁止自行声明第三方版本号（版本单源）。
  - @author Apex Team
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- 通过 apex-services-bom 统一管理与微服务相关的版本（工作流服务属于微服务一员） -->
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-services-bom</artifactId>
        <version>1.3.1</version>
        <!-- 显式指向 BOM 源码位置：默认 ../pom.xml 会落到根 POM，导致依赖版本管理失效 -->
        <relativePath>../apex-services-bom/pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>apex-workflow-service</artifactId>
    <packaging>jar</packaging>
    <name>apex-workflow-service</name>
    <description>Apex Scaffold - 工作流服务 (启动类 / WorkflowRouter+Handler / 独立 apex_workflow 库 / 事件)</description>

    <dependencies>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-logback-1.x</artifactId>
        </dependency>
        <!-- 共享基础: Result / ResultCode / TraceIdUtil / BlockingIoSchedulers / OperationLog / TenantAware -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>

        <!-- 工作流领域/应用层：WorkflowService / WorkflowQueryService / WorkflowStatisticsService / 领域模型 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-workflow</artifactId>
        </dependency>

        <!-- 领域层：工作流仓储契约所引用的领域模型取事件（经 api-contract）所需的共享 DTO -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-domain</artifactId>
        </dependency>

        <!-- 跨服务内部 API 契约：workflow 实例状态内部接口 + 事件 DTO 共享（Phase 3.4 事件改造） -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-api-contract</artifactId>
        </dependency>

        <!-- ==================== Spring Cloud / Nacos 服务治理（迁移方案 Phase 2） ==================== -->
        <!-- Nacos 服务注册与发现：本服务以 apex-workflow-service 注册，供网关 lb://apex-workflow-service 路由 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心：加载 apex-workflow-service.yaml 等远端配置分层 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Spring Cloud Bootstrap Starter：启用 bootstrap.yml 早于 application.yml 加载 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!-- Spring Boot WebFlux -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Spring Security（ReactiveSecurityContextHolder 读取当前认证用户 AuthenticatedUser） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 参数校验：请求 DTO 的声明式校验（BaseHandler validateAndThrow 依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 健康检查与指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- MyBatis Plus：工作流持久化（与主应用一致） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- SpringDoc（OpenAPI 3.0） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Flyway 数据库迁移（独立 apex_workflow 库，MySQL/PostgreSQL 双套） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- MySQL / PostgreSQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- H2（basic profile 本地/测试环境使用） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- RocketMQ：审批事件发布（Phase 3.4 事件改造 topic apex-workflow-events） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>${rocketmq-spring.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ==================== 测试依赖 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              Phase 3 起工作流服务开启 JaCoCo 覆盖率门禁：
              继承 apex-services-bom 根门禁（LINE >= 0.60 / BRANCH >= 0.50），
              由接口层测试与上下文加载测试保障说明（见迁移方案 §3.6）。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>