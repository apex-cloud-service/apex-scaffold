    <testcontainers.version>1.20.0</testcontainers.version>
    <keycloak.version>26.0.7</keycloak.version>
    <junit.version>5.10.2</junit.version>
    <junit-platform.version>1.10.2</junit-platform.version>
    <mockito.version>5.11.0</mockito.version>
    <!-- Surefire 显式加载 Byte Buddy agent，避免受限 JVM 中 Mockito inline mock maker 自附加失败。 -->
    <argLine></argLine>
    <!--
      保留 skip.unit.tests 供 stress-tests Profile 单独控制，同时默认透传 Maven 标准
      -DskipTests 参数，避免 clean install -DskipTests 仍执行 Surefire 单元测试。
    -->
    <skipTests>false</skipTests>
    <skip.unit.tests>${skipTests}</skip.unit.tests>
    <!-- 跳过测试时同步关闭覆盖率采集与校验，避免输出缺少 jacoco.exec 的误导性提示。 -->
    <jacoco.skip>${skipTests}</jacoco.skip>
    <archunit.version>1.3.0</archunit.version>
    <assertj.version>3.25.3</assertj.version>
    <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-javadoc-plugin.version>3.6.3</maven-javadoc-plugin.version>
    <sonar.version>5.8.0.7211</sonar.version>
    <maven.version>3.9.16</maven.version>
    <sonar.host.url>http://localhost:9000</sonar.host.url>
    <sonar.projectKey>apex-scaffold</sonar.projectKey>
    <sonar.projectName>Apex Scaffold</sonar.projectName>
    <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <maven-pmd-plugin.version>3.21.2</maven-pmd-plugin.version>
    <!--
      p3c-pmd 2.1.1 的规则实现基于 PMD 6 API（如 AbstractCommentRule），无法在 PMD 7 下加载，
      因此 PMD 插件固定在 3.21.2（PMD 6.55.0，PMD 6 线最后一个版本）。PMD 6 最高只识别到
      targetJdk 20，故 PMD 分析级别单独固定在 20；编译与运行仍是 Java 21。
    -->
    <pmd.targetJdk>20</pmd.targetJdk>
    <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
    <spotless.version>2.43.0</spotless.version>
    <p6spy.version>3.9.1</p6spy.version>
