    <!-- 华为云 Maven 镜像 -->
    <profile>
      <id>huawei-mirror</id>
      <repositories>
        <repository>
          <id>huawei</id>
          <name>HuaweiCloud Maven Mirror</name>
          <url>https://repo.huaweicloud.com/repository/maven/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>huawei-plugin</id>
          <name>HuaweiCloud Maven Plugin</name>
          <url>https://repo.huaweicloud.com/repository/maven/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
