  <!-- 常用镜像私服 Profile -->
  <!--    使用方式: mvnd clean install -P aliyun-mirror                          -->
  <!--    activeByDefault: true 的 profile 默认激活                              -->
  <profiles>
    <!-- ============================================================ -->
    <!-- 商业化版本Profile                                             -->
    <!-- ============================================================ -->
    
    <!-- 基础版: 仅包含核心功能,适合小型项目 -->
    <profile>
      <id>basic</id>
      <properties>
        <!-- 构建产物标识: 写入 apex-build.properties，区分三档构建 -->
        <build.profile.id>basic</build.profile.id>
        <!-- 绑定 Spring Profile: 运行时激活 application-basic.yml -->
        <spring.profiles.active>basic</spring.profiles.active>
        <features.jwt-auth>true</features.jwt-auth>
        <features.rbac>false</features.rbac>
        <features.cache>false</features.cache>
        <features.message-queue>false</features.message-queue>
        <features.monitoring>false</features.monitoring>
        <features.tracing>false</features.tracing>
      </properties>
      <!--
        P0-3a 依赖真裁剪：
        1) 高级依赖（RocketMQ / Sentinel / resilience4j-circuitbreaker / sentinel-datasource-nacos /
           sentinel-prometheus-metric-exporter / simpleclient_httpserver / sentinel-logging-slf4j）
           在 basic profile 中以 <optional>true</optional> 重新声明，使它们不被传递到下游；
        2) 同时各子模块 basic profile 对上游依赖添加 exclusions，确保 spring-boot-maven-plugin
           打包时这些 jar 不进入 BOOT-INF/lib，运行期类不存在则 @ConditionalOnClass 自动跳过装配。
      -->
      <dependencyManagement>
        <dependencies>
          <!-- ===== apex-infrastructure 侧高级依赖（basic 不打包） ===== -->
          <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>${rocketmq-spring.version}</version>
            <optional>true</optional>
          </dependency>
          <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
            <optional>true</optional>
          </dependency>
          <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
            <optional>true</optional>
          </dependency>
          <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>${resilience4j.version}</version>
            <optional>true</optional>
          </dependency>

          <!-- ===== 业务库侧高级依赖（basic 不打包，Sentinel/Prometheus 相关） ===== -->
          <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
            <optional>true</optional>
          </dependency>
          <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-logging-slf4j</artifactId>
            <optional>true</optional>
          </dependency>
          <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
            <optional>true</optional>
          </dependency>
          <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-prometheus-metric-exporter</artifactId>
            <optional>true</optional>
          </dependency>
          <dependency>
            <groupId>io.prometheus</groupId>
            <artifactId>simpleclient_httpserver</artifactId>
            <optional>true</optional>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>
    
    <!-- 标准版: 包含常用功能,适合中型企业 (默认) -->
    <profile>
      <id>standard</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <build.profile.id>standard</build.profile.id>
        <spring.profiles.active>standard</spring.profiles.active>
        <features.jwt-auth>true</features.jwt-auth>
        <features.rbac>true</features.rbac>
        <features.cache>true</features.cache>
        <features.message-queue>false</features.message-queue>
        <features.monitoring>true</features.monitoring>
        <features.tracing>false</features.tracing>
      </properties>
    </profile>
    
    <!-- 企业版: 包含全部功能,适合大型系统 -->
    <profile>
      <id>enterprise</id>
      <properties>
        <build.profile.id>enterprise</build.profile.id>
        <spring.profiles.active>enterprise</spring.profiles.active>
        <features.jwt-auth>true</features.jwt-auth>
        <features.rbac>true</features.rbac>
        <features.cache>true</features.cache>
        <features.message-queue>true</features.message-queue>
        <features.monitoring>true</features.monitoring>
        <features.tracing>true</features.tracing>
      </properties>
    </profile>
    
    <!--
      压力/并发测试默认不混入日常单元测试，避免机器负载导致构建抖动。
      显式使用 -Pstress-tests 执行，报告输出到独立的 stress-test-reports 目录。
    -->
    <profile>
      <id>stress-tests</id>
      <properties>
        <skip.unit.tests>true</skip.unit.tests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>stress-tests</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <skipTests>false</skipTests>
                  <includes>
                    <include>**/*StressTest.java</include>
                  </includes>
                  <excludes combine.self="override"/>
                  <reportsDirectory>${project.build.directory}/stress-test-reports</reportsDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>remote-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes combine.self="override">
                <include>**/*IntegrationTest.java</include>
                <include>**/*E2ETest.java</include>
                <include>**/FlywayMigrationStartupTest.java</include>
                <include>**/*RemoteIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- 阿里云 Maven 镜像 (推荐国内用户) -->
