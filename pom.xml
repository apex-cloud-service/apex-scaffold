    <!-- sentinel-prometheus-metric-exporter 将 simpleclient_httpserver 声明为 provided，
         需由应用显式提供；版本与 micrometer 引入的 simpleclient 兼容层保持一致。 -->
    <simpleclient-httpserver.version>0.16.0</simpleclient-httpserver.version>
    <p3c-pmd.version>2.1.1</p3c-pmd.version>
    <junit4.version>4.13.2</junit4.version>
    <pmd.skip>false</pmd.skip>
