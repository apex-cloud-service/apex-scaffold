  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <!-- Stress / E2E / Live / Integration / Smoke 测试需外部依赖或长线资源，
                 从 surefire 单元测试阶段移除，由 failsafe / 特定 Profile 接管。
                 末尾通配符 * 兼容 JUnit 5 @Nested 内部类（如 XxxIntegrationTest$NestedTests）以及
                 Knife4jIntegrationContractTest 这类"ContractTest+Integration"混合后缀类。 -->
            <exclude>**/*StressTest*</exclude>
            <exclude>**/*E2ETest*</exclude>
            <exclude>**/FlywayMigrationStartupTest*</exclude>
            <exclude>**/test/Test*</exclude>
            <exclude>**/*IntegrationTest*</exclude>
            <exclude>**/*LiveTest*</exclude>
            <exclude>**/*SmokeTest*</exclude>
            <exclude>**/*RemoteIT</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${maven-pmd-plugin.version}</version>
        <configuration>
          <skip>${pmd.skip}</skip>
          <linkXRef>false</linkXRef>
          <!-- PMD 6（p3c-pmd 依赖的版本线）最高支持 targetJdk 20，编译级别见 maven.compiler.release。 -->
          <targetJdk>${pmd.targetJdk}</targetJdk>
          <rulesets>
            <ruleset>rulesets/java/ali-comment.xml</ruleset>
            <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
            <ruleset>rulesets/java/ali-constant.xml</ruleset>
            <ruleset>rulesets/java/ali-exception.xml</ruleset>
            <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
            <ruleset>rulesets/java/ali-naming.xml</ruleset>
            <ruleset>rulesets/java/ali-oop.xml</ruleset>
            <ruleset>rulesets/java/ali-orm.xml</ruleset>
            <ruleset>rulesets/java/ali-other.xml</ruleset>
            <ruleset>rulesets/java/ali-set.xml</ruleset>
          </rulesets>
          <excludeFromFailureFile>config/pmd-exclude.properties</excludeFromFailureFile>
          <printFailingErrors>true</printFailingErrors>
          <verbose>true</verbose>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <id>p3c-pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <failOnViolation>true</failOnViolation>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>com.alibaba.p3c</groupId>
            <artifactId>p3c-pmd</artifactId>
            <version>${p3c-pmd.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.source}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>0.2.0</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- 所有模块都必须采集覆盖率；report 在 verify 后生成，包含集成测试数据。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <!-- 所有模块的 *IntegrationTest/*E2ETest 都进入 verify 生命周期。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
              <configuration>
                <includes>
                  <include>com/apex/*</include>
                </includes>
              </configuration>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.60</minimum>
                      </limit>
                      <limit>
                        <counter>BRANCH</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.50</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- apex.log.dir: 将测试日志统一输出到项目根目录 logs/ 下，而非各模块 target/ 目录。
                 ${project.basedir} 在 apex-interfaces 模块解析为 .../apex-interfaces，../logs 即项目根 logs/。
                 单元测试使用 logback-test.xml，写入 logs/test/apex-test.log。 -->
            <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar -Djava.awt.headless=true -Dcsp.sentinel.log.dir=${project.build.directory}/sentinel-logs -Dapex.log.dir=${project.basedir}/../logs -DsocksNonProxyHosts=localhost|127.*|[::1]</argLine>
            <skipTests>${skip.unit.tests}</skipTests>
            <testFailureIgnore>false</testFailureIgnore>
            <excludes>
              <exclude>**/*StressTest*</exclude>
              <exclude>**/*E2ETest*</exclude>
              <exclude>**/FlywayMigrationStartupTest*</exclude>
              <exclude>**/test/Test*</exclude>
              <exclude>**/*IntegrationTest*</exclude>
              <exclude>**/*LiveTest*</exclude>
              <exclude>**/*SmokeTest*</exclude>
              <exclude>**/*RemoteIT</exclude>
            </excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- apex.log.dir: 将集成测试日志统一输出到项目根目录 logs/ 下。
                 集成测试使用 logback-spring.xml（it profile），写入 logs/apex-scaffold.log 等。 -->
            <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar -Dcsp.sentinel.log.dir=${project.build.directory}/sentinel-logs -Dapex.log.dir=${project.basedir}/../logs -DsocksNonProxyHosts=localhost|127.*|[::1]</argLine>
            <includes>
              <include>**/*IntegrationTest.java</include>
              <include>**/*E2ETest.java</include>
              <include>**/FlywayMigrationStartupTest.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <encoding>UTF-8</encoding>
            <charset>UTF-8</charset>
            <docencoding>UTF-8</docencoding>
            <failOnError>false</failOnError>
            <doclint>none</doclint>
            <source>${java.version}</source>
            <show>private</show>
            <links>
              <link>https://docs.oracle.com/en/java/javase/21/docs/api/</link>
            </links>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>enforce</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <requireMavenVersion>
                    <version>${maven.version}</version>
                  </requireMavenVersion>
                  <requireJavaVersion>
                    <version>${java.version}</version>
                  </requireJavaVersion>
                </rules>
                <fail>true</fail>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat/>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
