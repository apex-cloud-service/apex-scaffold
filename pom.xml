  <repositories>
    <repository>
      <id>central</id>
      <name>Maven Central Repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <name>Maven Central Repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>
  <!-- 常用镜像私服 Profile -->
  <!--    使用方式: mvnd clean install -P aliyun-mirror                          -->
  <!--    activeByDefault: true 的 profile 默认激活                              -->
  <profiles>
    <!-- ============================================================ -->
    <!-- 商业化版本Profile                                             -->
    <!-- ============================================================ -->
    
    <!-- 基础版: 仅包含核心功能,适合小型项目 -->
    <profile>
      <id>basic</id>
      <properties>
        <features.jwt-auth>true</features.jwt-auth>
        <features.rbac>false</features.rbac>
        <features.cache>false</features.cache>
        <features.message-queue>false</features.message-queue>
        <features.monitoring>false</features.monitoring>
      </properties>
    </profile>
    
    <!-- 标准版: 包含常用功能,适合中型企业 (默认) -->
    <profile>
      <id>standard</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <features.jwt-auth>true</features.jwt-auth>
        <features.rbac>true</features.rbac>
        <features.cache>true</features.cache>
        <features.message-queue>false</features.message-queue>
        <features.monitoring>true</features.monitoring>
      </properties>
    </profile>
    
    <!-- 企业版: 包含全部功能,适合大型系统 -->
    <profile>
      <id>enterprise</id>
      <properties>
        <features.jwt-auth>true</features.jwt-auth>
        <features.rbac>true</features.rbac>
        <features.cache>true</features.cache>
        <features.message-queue>true</features.message-queue>
        <features.monitoring>true</features.monitoring>
        <features.tracing>true</features.tracing>
      </properties>
    </profile>
    
    <!--
      压力/并发测试默认不混入日常单元测试，避免机器负载导致构建抖动。
      显式使用 -Pstress-tests 执行，报告输出到独立的 stress-test-reports 目录。
    -->
    <profile>
      <id>stress-tests</id>
      <properties>
        <skip.unit.tests>true</skip.unit.tests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>stress-tests</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <skipTests>false</skipTests>
                  <includes>
                    <include>**/*StressTest.java</include>
                  </includes>
                  <excludes combine.self="override"/>
                  <reportsDirectory>${project.build.directory}/stress-test-reports</reportsDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>remote-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes combine.self="override">
                <include>**/*IntegrationTest.java</include>
                <include>**/*E2ETest.java</include>
                <include>**/FlywayMigrationStartupTest.java</include>
                <include>**/*RemoteIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- 阿里云 Maven 镜像 (推荐国内用户) -->
    <profile>
      <id>aliyun-mirror</id>
      <repositories>
        <repository>
          <id>aliyun</id>
          <name>Aliyun Maven Mirror</name>
          <url>https://maven.aliyun.com/repository/public</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>aliyun-central</id>
          <name>Aliyun Maven Central</name>
          <url>https://maven.aliyun.com/repository/central</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>aliyun-plugin</id>
          <name>Aliyun Maven Plugin</name>
          <url>https://maven.aliyun.com/repository/public</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
    <!-- 腾讯云 Maven 镜像 -->
    <profile>
      <id>tencent-mirror</id>
      <repositories>
        <repository>
          <id>tencent</id>
          <name>Tencent Maven Mirror</name>
          <url>https://mirrors.cloud.tencent.com/nexus/repository/maven-public/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>tencent-plugin</id>
          <name>Tencent Maven Plugin</name>
          <url>https://mirrors.cloud.tencent.com/nexus/repository/maven-public/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
    <!-- 华为云 Maven 镜像 -->
    <profile>
      <id>huawei-mirror</id>
      <repositories>
        <repository>
          <id>huawei</id>
          <name>HuaweiCloud Maven Mirror</name>
          <url>https://repo.huaweicloud.com/repository/maven/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>huawei-plugin</id>
          <name>HuaweiCloud Maven Plugin</name>
          <url>https://repo.huaweicloud.com/repository/maven/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*StressTest.java</exclude>
            <exclude>**/*StressTest.class</exclude>
            <exclude>**/*E2ETest.java</exclude>
            <exclude>**/*E2ETest.class</exclude>
            <exclude>**/FlywayMigrationStartupTest.java</exclude>
            <exclude>**/FlywayMigrationStartupTest.class</exclude>
            <exclude>**/test/Test*.java</exclude>
            <exclude>**/test/Test*.class</exclude>
            <exclude>**/*IntegrationTest.java</exclude>
            <exclude>**/*IntegrationTest.class</exclude>
            <exclude>**/*LiveTest.java</exclude>
            <exclude>**/*LiveTest.class</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${maven-pmd-plugin.version}</version>
        <configuration>
          <skip>${pmd.skip}</skip>
          <linkXRef>false</linkXRef>
          <rulesets>
            <ruleset>rulesets/java/ali-comment.xml</ruleset>
            <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
            <ruleset>rulesets/java/ali-constant.xml</ruleset>
            <ruleset>rulesets/java/ali-exception.xml</ruleset>
            <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
            <ruleset>rulesets/java/ali-naming.xml</ruleset>
            <ruleset>rulesets/java/ali-oop.xml</ruleset>
            <ruleset>rulesets/java/ali-orm.xml</ruleset>
            <ruleset>rulesets/java/ali-other.xml</ruleset>
            <ruleset>rulesets/java/ali-set.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <verbose>true</verbose>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <id>p3c-pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <failOnViolation>true</failOnViolation>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>com.alibaba.p3c</groupId>
            <artifactId>p3c-pmd</artifactId>
            <version>${p3c-pmd.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.source}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- 所有模块都必须采集覆盖率；report 在 verify 后生成，包含集成测试数据。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <!-- 所有模块的 *IntegrationTest/*E2ETest 都进入 verify 生命周期。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- apex.log.dir: 将测试日志统一输出到项目根目录 logs/ 下，而非各模块 target/ 目录。
                 ${project.basedir} 在 apex-interfaces 模块解析为 .../apex-interfaces，../logs 即项目根 logs/。
                 单元测试使用 logback-test.xml，写入 logs/test/apex-test.log。 -->
            <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar -Djava.awt.headless=true -Dcsp.sentinel.log.dir=${project.build.directory}/sentinel-logs -Dapex.log.dir=${project.basedir}/../logs</argLine>
            <skipTests>${skip.unit.tests}</skipTests>
            <testFailureIgnore>false</testFailureIgnore>
            <excludes>
              <exclude>**/*StressTest.java</exclude>
              <exclude>**/*StressTest.class</exclude>
              <exclude>**/*E2ETest.java</exclude>
              <exclude>**/*E2ETest.class</exclude>
              <exclude>**/FlywayMigrationStartupTest.java</exclude>
              <exclude>**/FlywayMigrationStartupTest.class</exclude>
              <exclude>**/test/Test*.java</exclude>
              <exclude>**/test/Test*.class</exclude>
              <exclude>**/*IntegrationTest.java</exclude>
              <exclude>**/*IntegrationTest.class</exclude>
              <exclude>**/*LiveTest.java</exclude>
              <exclude>**/*LiveTest.class</exclude>
            </excludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- apex.log.dir: 将集成测试日志统一输出到项目根目录 logs/ 下。
                 集成测试使用 logback-spring.xml（it profile），写入 logs/apex-service.log 等。 -->
            <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar -Dcsp.sentinel.log.dir=${project.build.directory}/sentinel-logs -Dapex.log.dir=${project.basedir}/../logs</argLine>
            <includes>
              <include>**/*IntegrationTest.java</include>
              <include>**/*E2ETest.java</include>
              <include>**/FlywayMigrationStartupTest.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <encoding>UTF-8</encoding>
            <charset>UTF-8</charset>
            <docencoding>UTF-8</docencoding>
            <failOnError>false</failOnError>
            <doclint>none</doclint>
            <source>${java.version}</source>
            <show>private</show>
            <links>
              <link>https://docs.oracle.com/en/java/javase/17/docs/api/</link>
            </links>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>enforce</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <requireMavenVersion>
                    <version>${maven.version}</version>
                  </requireMavenVersion>
                  <requireJavaVersion>
                    <version>${java.version}</version>
                  </requireJavaVersion>
                </rules>
                <fail>true</fail>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat/>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
