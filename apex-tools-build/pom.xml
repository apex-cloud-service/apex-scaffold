<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        以 apex-tools-parent 为 parent（与 apex-tools-deployment 同构）：继续继承根 POM 的
        Java 21 编译、Spotless/PMD/JaCoCo 门禁与统一依赖及插件管理；Enforcer 仍仅为管理声明。
        版本随根 POM 管理，不单独声明。
    -->
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-tools-parent</artifactId>
        <version>1.3.1</version>
        <relativePath>../apex-tools-parent/pom.xml</relativePath>
    </parent>

    <artifactId>apex-tools-build</artifactId>
    <name>Apex Build Tools</name>
    <description>
        构建发布管理模块。

        - build-manifest.yaml：全部模块的注册表（单一事实来源），由 BuildManifestSyncTest
          与根 POM 递归聚合模块、各模块 POM 打包插件、scripts/release/release.sh SERVICES
          数组做一致性校验，防止模块清单/交付口径漂移
        - bin/apex.sh：编译/构建/打包/发布/镜像/部署的统一编排入口，
          委托 scripts/ 下既有脚本与 mvnd 执行，不承载第二套构建逻辑
        - 不参与服务运行期装配；不进交付发布包（与 apex-tools-deployment 同口径）
    </description>

    <!--
        零生产依赖模块：本模块不参与任何服务的运行期装配，也不进交付发布包。
        唯一的构件内容是 build-manifest.yaml 资源与 bin/apex.sh 编排脚本；
        下列依赖均为 test scope，仅用于 BuildManifestSyncTest 的注册表解析与一致性断言：
          - snakeyaml（父 BOM 已管版本）：解析注册表 YAML；
          - junit-jupiter：JUnit 5 测试引擎（仓库统一版本由 spring-boot-starter-parent 管理）。
    -->
    <dependencies>
        <!-- ===== 测试依赖：注册表解析与 POM/脚本一致性断言 ===== -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                向测试注入 apex.root = 仓库根目录（maven.multiModuleProjectDirectory）：
                BuildManifestSyncTest 需要跨模块读取根 POM、各模块 POM 与 scripts/release/release.sh
                做四方一致性校验。与 apex-tools-deployment 的 surefire 配置同款口径。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <apex.root>${maven.multiModuleProjectDirectory}</apex.root>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
