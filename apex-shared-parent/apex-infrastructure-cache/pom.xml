<?xml version="1.0" encoding="UTF-8"?>
<!-- 按能力发布的共享 JAR；包名、配置前缀和本地调用语义保持兼容。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.apex.scaffold</groupId><artifactId>apex-shared-parent</artifactId><version>1.3.1</version></parent>
    <artifactId>apex-infrastructure-cache</artifactId>
    <packaging>jar</packaging>
    <description>共享基础设施能力：cache；继承原质量门禁与构建档位</description>
    <dependencies>
        <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId></dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 项目统一使用 Logback，避免嵌入式 Redis 的测试日志实现造成多绑定。 -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
                <!-- 使用项目自身的 Spring Data Redis/Redisson 版本，避免旧测试依赖覆盖生产栈。 -->
                <exclusion>
                    <groupId>org.springframework.data</groupId>
                    <artifactId>spring-data-redis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <!-- 布隆过滤器预热使用 JdbcTemplate；不引入持久化自动装配或数据库驱动。 -->
        <dependency><groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId></dependency>
        <!-- 各能力独立声明指标 API，不依赖其他中间件的传递依赖。 -->
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-core</artifactId></dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- PMD 排除 MapStruct 等注解处理器生成的源码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <excludeRoots>
                        <excludeRoot>target/generated-sources/annotations</excludeRoot>
                    </excludeRoots>
                </configuration>
            </plugin>
            <!-- 编译器配置继承自父 POM，已包含 Lombok 和 MapStruct 注解处理器 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- 纯空实现 Repository 适配器：业务分支由 application 层验证 -->
                        <exclude>com/apex/scaffold/infrastructure/persistence/repository/**/*</exclude>
                        <!-- MapStruct 自动生成 Converter：仅 getter/setter 复制，无业务分支 -->
                        <exclude>com/apex/scaffold/infrastructure/persistence/converter/**/*</exclude>
                        <!-- 纯 PO / 持久化数据对象：无逻辑 -->
                        <exclude>com/apex/scaffold/infrastructure/persistence/po/**/*</exclude>
                        <!-- 纯 Moderation Repository 接口：无实现 -->
                        <exclude>com/apex/scaffold/infrastructure/persistence/moderation/**/*</exclude>
                        <!-- 缓存注解与拦截器基类：容器装配期生效，无单元可测决策 -->
                        <exclude>com/apex/scaffold/infrastructure/cache/*</exclude>
                        <!-- 纯 ConfigurationProperties 配置类 -->
                        <exclude>com/apex/scaffold/infrastructure/cache/config/**/*</exclude>
                        <exclude>com/apex/scaffold/infrastructure/circuitbreaker/**/*</exclude>
                        <exclude>com/apex/scaffold/infrastructure/remote/config/**/*</exclude>
                        <!-- 微信 SDK 薄封装：真实业务调用已通过 gateway 层验证 -->
                        <exclude>com/apex/scaffold/infrastructure/wechat/service/**/*</exclude>
                    </excludes>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <!-- 核心远程调用与三方网关：已达高覆盖基线 -->
                                <include>com.apex.scaffold.infrastructure.chaos.*</include>
                                <include>com.apex.scaffold.infrastructure.wechat.gateway.*</include>
                                <include>com.apex.scaffold.infrastructure.remote.interest.*</include>
                                <include>com.apex.scaffold.infrastructure.chuanglan.gateway.*</include>
                                <include>com.apex.scaffold.infrastructure.remote.service.*</include>
                                <include>com.apex.scaffold.infrastructure.remote.logging.*</include>
                                <include>com.apex.scaffold.infrastructure.chuanglan.service.*</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.90</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.75</minimum>
                                </limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <!-- 审核、安全、过滤、持久化兴趣域仓储：中等覆盖核心 -->
                                <include>com.apex.scaffold.infrastructure.moderation.*</include>
                                <include>com.apex.scaffold.infrastructure.security.service.*</include>
                                <include>com.apex.scaffold.infrastructure.remote.filter.*</include>
                                <include>com.apex.scaffold.infrastructure.persistence.interest.repository.*</include>
                                <include>com.apex.scaffold.infrastructure.persistence.service.*</include>
                                <include>com.apex.scaffold.infrastructure.persistence.util.*</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.75</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.55</minimum>
                                </limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <!-- 缓存/事件/MQ/调度/指标适配：薄封装且依赖外部中间件 -->
                                <include>com.apex.scaffold.infrastructure.cache.service.*</include>
                                <include>com.apex.scaffold.infrastructure.event.*</include>
                                <include>com.apex.scaffold.infrastructure.mq.service.*</include>
                                <include>com.apex.scaffold.infrastructure.mq.listener.*</include>
                                <include>com.apex.scaffold.infrastructure.scheduler.*</include>
                                <include>com.apex.scaffold.infrastructure.metrics.*</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.65</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.45</minimum>
                                </limit>
                            </limits>
                        </rule>
                        <!-- FaceAnalysisClient 与 FaceAnalysisAuthHeaderProvider 专项 -->
                        <rule>
                            <element>CLASS</element>
                            <includes>
                                <include>com.apex.scaffold.infrastructure.remote.service.FaceAnalysisClient</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.85</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.50</minimum>
                                </limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>CLASS</element>
                            <includes>
                                <include>com.apex.scaffold.infrastructure.remote.service.FaceAnalysisAuthHeaderProvider</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.60</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.45</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>infra-report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
                    <execution><id>infra-coverage-check</id><phase>test</phase><goals><goal>check</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
