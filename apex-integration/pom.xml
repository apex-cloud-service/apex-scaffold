<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - 集成能力库（连接器 + 设备接入）
  - 方案 M5 / 批次 E1：对外集成域（connector）与物联网设备域（device）双子域。
  - 约束：包结构隔离两个子域；MQTT 客户端依赖 optional（basic 档可裁剪）；
  -       自建库起即按租户行级隔离 + fail-closed 标准实现。
  - @author Apex Team
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-services-bom</artifactId>
        <version>1.3.1</version>
        <relativePath>../apex-services-bom/pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>apex-integration</artifactId>
    <packaging>jar</packaging>
    <name>apex-integration</name>
    <description>对外集成与物联网设备接入能力库</description>

    <dependencies>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-infrastructure-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-infrastructure-remote</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers：集成域迁移链真实双库回归（E1–E3） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- reactive MQTT 客户端（批次 E3；optional：basic 档可裁剪，classpath 无此依赖时
             IotMqttAutoConfiguration 以 @ConditionalOnClass 守卫，零 Bean）。
             项目依赖管理未纳管该坐标，故此处显式版本。 -->
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client</artifactId>
            <version>1.3.5</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- 纯接口 DTO：仅携带数据，无业务决策分支 -->
                        <exclude>com/apex/scaffold/integration/**/interfaces/dto/**/*</exclude>
                        <!-- 持久化对象、Mapper 与仓储适配：无业务决策分支 -->
                        <exclude>com/apex/scaffold/integration/**/infrastructure/persistence/po/**/*</exclude>
                        <exclude>com/apex/scaffold/integration/**/infrastructure/persistence/mapper/**/*</exclude>
                        <exclude>com/apex/scaffold/integration/**/infrastructure/persistence/repository/**/*</exclude>
                        <!-- 组件装配与连接器注册表：仅声明 Bean，无业务逻辑 -->
                        <exclude>com/apex/scaffold/integration/**/autoconfigure/**/*</exclude>
                        <exclude>com/apex/scaffold/integration/connector/application/ConnectorRegistryConfiguration.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- 覆盖父 POM 的同名 check 执行：门禁作用域收敛到两个子域的应用层编排 -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <includes>
                                        <include>com.apex.scaffold.integration.connector.application.*</include>
                                        <include>com.apex.scaffold.integration.device.application.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.55</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
