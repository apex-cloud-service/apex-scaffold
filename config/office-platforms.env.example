# ============================================================================
# 办公平台集成配置示例
# ============================================================================
# 
# 使用说明：
# 1. 复制本文件为 office-platforms.env（已在 .gitignore 中排除）
# 2. 根据实际申请的平台应用信息填写对应字段
# 3. 在启动脚本或 docker-compose 中通过 --env-file 加载
# 4. 后端通过 System.getenv() 读取这些环境变量
#
# 安全提示：
# - 本文件包含敏感信息，切勿提交到 Git
# - 生产环境建议使用 Kubernetes Secret 或云平台密钥管理服务
# - 定期轮换密钥，设置密钥过期策略
#
# ============================================================================

# ----------------------------------------------------------------------------
# 飞书（Feishu / Lark）配置
# ----------------------------------------------------------------------------
# 
# 获取方式：
# 1. 访问飞书开放平台：https://open.feishu.cn/
# 2. 创建企业自建应用
# 3. 获取 App ID 和 App Secret
# 4. 配置应用权限：contact:user.base, authen
# 5. 配置重定向 URL
#
# 应用密钥（对应后端 secretReference 字段值）
FEISHU_SECRET=your-feishu-app-secret-here

# 事件回调签名密钥（可选，用于验证平台推送事件的合法性）
FEISHU_SIGNING_SECRET=your-feishu-signing-secret-here

# ----------------------------------------------------------------------------
# 钉钉（DingTalk）配置
# ----------------------------------------------------------------------------
#
# 获取方式：
# 1. 访问钉钉开放平台：https://open.dingtalk.com/
# 2. 创建企业内部应用
# 3. 获取 AppKey 和 AppSecret
# 4. 配置应用权限：Contact.User.Read, openid
# 5. 配置回调域名
#
# 应用密钥（对应后端 secretReference 字段值）
DINGTALK_SECRET=your-dingtalk-app-secret-here

# 事件回调签名密钥（可选）
DINGTALK_SIGNING_SECRET=your-dingtalk-signing-secret-here

# ----------------------------------------------------------------------------
# 企业微信（WeCom）配置
# ----------------------------------------------------------------------------
#
# 获取方式：
# 1. 访问企业微信管理后台：https://work.weixin.qq.com/
# 2. 应用管理 -> 创建应用
# 3. 获取 AgentId 和 Secret
# 4. 配置应用可见范围
# 5. 配置网页授权回调域名
#
# 应用密钥（对应后端 secretReference 字段值）
WECOM_SECRET=your-wecom-corp-secret-here

# 事件回调签名密钥（可选）
WECOM_SIGNING_SECRET=your-wecom-signing-secret-here

# ----------------------------------------------------------------------------
# 企业微信额外配置（如需自建应用）
# ----------------------------------------------------------------------------
# 
# 自建应用 AgentId（用于发送应用消息）
# WECOM_AGENT_ID=1000001

# 通讯录同步 Secret（用于同步企业通讯录）
# WECOM_CONTACT_SECRET=your-wecom-contact-secret-here

# ----------------------------------------------------------------------------
# 全局配置
# ----------------------------------------------------------------------------

# 办公平台功能是否启用（true/false）
APEX_OFFICE_ENABLED=true

# HTTP 请求超时时间（秒，默认 5 秒）
APEX_OFFICE_TIMEOUT=5

# HTTP 请求最大重试次数（默认 2 次）
APEX_OFFICE_MAX_RETRIES=2

# OAuth state 有效期（分钟，默认 5 分钟）
APEX_OFFICE_STATE_TTL=5

# ----------------------------------------------------------------------------
# 应用回调地址配置
# ----------------------------------------------------------------------------
#
# 注意：
# 1. 回调地址必须是公网可访问的 HTTPS 地址
# 2. 开发环境可使用 ngrok 等内网穿透工具
# 3. 回调地址需要在各平台开放平台配置白名单
#
# 示例：
# APEX_OFFICE_CALLBACK_BASE_URL=https://your-domain.com

# 飞书回调地址（完整 URL，包含协议和域名）
# FEISHU_REDIRECT_URI=https://your-domain.com/api/v1/office/callback?platform=FEISHU

# 钉钉回调地址
# DINGTALK_REDIRECT_URI=https://your-domain.com/api/v1/office/callback?platform=DINGTALK

# 企业微信回调地址
# WECOM_REDIRECT_URI=https://your-domain.com/api/v1/office/callback?platform=WECOM

# ----------------------------------------------------------------------------
# 开发环境示例（使用 ngrok）
# ----------------------------------------------------------------------------
#
# 1. 启动 ngrok：ngrok http 8080
# 2. 获取公网地址：https://abc123.ngrok.io
# 3. 配置回调地址：https://abc123.ngrok.io/api/v1/office/callback
# 4. 在各平台开放平台配置此回调地址

# ----------------------------------------------------------------------------
# 生产环境配置建议
# ----------------------------------------------------------------------------
#
# 1. 使用环境变量注入，避免硬编码
# 2. 使用密钥管理服务（如 AWS Secrets Manager、Azure Key Vault）
# 3. 启用 HTTPS，配置 TLS 证书
# 4. 配置反向代理和负载均衡
# 5. 监控密钥使用情况，定期轮换
# 6. 审计日志记录所有密钥访问
# 7. 限制密钥访问权限，最小权限原则
