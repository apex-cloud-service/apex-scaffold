<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - API Contract 模块
  - 跨服务内部 API 契约: 提供方实现, 消费方引用的 DTO 与 Feign 接口集中定义
  - 约束: 本模块不含业务逻辑, 服务之间无编译期互相依赖, 仅依赖 common + 本契约
  - @author Apex Team
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-scaffold</artifactId>
        <version>1.3.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>apex-api-contract</artifactId>
    <packaging>jar</packaging>
    <name>apex-api-contract</name>
    <description>Apex Scaffold - 微服务间内部 API 契约 (Feign 接口 + 共享 DTO)</description>

    <dependencies>
        <!-- 统一响应体 Result / 分页 DTO 等 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>

        <!-- Feign 客户端注解 (@FeignClient) 与 spring-web 注解 (@GetMapping 等) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 参数校验注解 (契约 DTO 上的 @NotNull 等) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
