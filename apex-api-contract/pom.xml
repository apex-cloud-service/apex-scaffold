<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - API Contract 模块
  - 跨服务内部 API 契约: 提供方实现, 消费方引用的 DTO 与 Feign 接口集中定义
  - 约束: 本模块不含业务逻辑, 服务之间无编译期互相依赖, 仅依赖 common + 本契约
  - @author Apex Team
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- 通过 apex-services-bom 统一管理与微服务相关的版本（契约模块属于微服务一员） -->
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-services-bom</artifactId>
        <version>1.3.1</version>
        <!-- 显式指向 BOM 源码位置：默认 ../pom.xml 会落到根 POM，导致依赖版本管理失效 -->
        <relativePath>../apex-services-bom/pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>apex-api-contract</artifactId>
    <packaging>jar</packaging>
    <name>apex-api-contract</name>
    <description>Apex Scaffold - 微服务间内部 API 契约 (Feign 接口 + 共享 DTO)</description>

    <dependencies>
        <!-- 统一响应体 Result / 分页 DTO 等 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 参数校验注解 (契约 DTO 上的 @NotNull 等) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 契约测试: 校验同步 Feign 调用经 BlockingIoSchedulers.remote() 桥接后的响应式行为 (StepVerifier) -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
