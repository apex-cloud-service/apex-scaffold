<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-scaffold</artifactId>
        <version>1.1.2</version>
    </parent>
    
    <artifactId>apex-example</artifactId>
    <name>Apex Example Module</name>
    <description>示例模块 - 展示如何使用Apex Scaffold脚手架</description>
    
    <dependencies>
        <!-- 依赖脚手架核心模块 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-interfaces</artifactId>
        </dependency>
        
        <!-- Spring Boot WebFlux -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        
        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        
        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- H2数据库(用于集成测试) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.apex.example.ExampleApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
