<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-applications-parent</artifactId>
        <version>1.3.1</version>
        <relativePath>../apex-applications-parent/pom.xml</relativePath>
    </parent>
    
    <artifactId>apex-example</artifactId>
    <name>Apex Example Module</name>
    <description>示例与聚合运行模块 - basic/示例档与 k8s 单体形态的聚合装配入口(镜像构建经 Containerfile 以 SERVICE_MODULE=apex-example 产出 apex-scaffold:latest),含示例端点演示各库用法;artifactId 保留 example 名称以兼容既有交付与脚本</description>
    
    <dependencies>
        <!-- 依赖脚手架核心模块 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-infrastructure-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-infrastructure-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-system</artifactId>
        </dependency>
        
        <!-- Spring Boot WebFlux -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        
        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        
        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.apex.example.ExampleApplication</mainClass>
                </configuration>
            </plugin>
            <!--
                示例模块豁免 JaCoCo 覆盖率门禁：本模块是使用示范（12 个演示类、3 个测试类），
                不承载业务逻辑，父 POM 的行 60% / 分支 50% 门槛对其无实际质量意义。
                覆盖率要求仍适用于各业务模块，此处仅本地跳过，不放宽全局配置。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
