# ============================================================
# Apex Scaffold - Podman Compose 环境变量模板
# ============================================================
# 用法:
#   cp .env.example .env        # 填写全部安全密钥后启动（默认 prod,enterprise）
#   podman-compose -f podman-compose.yml up -d
#   podman-compose -f podman-compose.yml --profile rocketmq up -d   # 额外启动 RocketMQ
# 生产部署: 复制为 .env 并替换所有敏感值（密码/密钥/地址）。
# 注意: 复制后的 .env 中的值会被 podman-compose 自动读取为变量插值源。
# ============================================================

# ---------- 构建与运行 ----------
# 构建档位: basic | standard | enterprise
BUILD_PROFILE=enterprise
# 镜像标签（podman-compose -f podman-compose.yml build 时使用）
TAG=latest
# 激活的 Spring Profile（环境,档位），默认 prod,enterprise
SPRING_PROFILES_ACTIVE=prod,enterprise

# ---------- 端口映射（宿主机:容器） ----------
# 网关统一入口（旧单体 apex-scaffold 已退役，由 apex-gateway 承接）
APP_PORT=8080
# 各微服务对外端口（网关 8080 / 认证 8081 / 系统 8082 / 工作流 8093 / 办公 8084 / 文件 8085）
AUTH_PORT=8081
SYSTEM_PORT=8082
SYSTEM_MANAGEMENT_PORT=8083
WORKFLOW_PORT=8093
OFFICE_PORT=8084
FILE_PORT=8085
# Nacos 控制台端口
NACOS_PORT=8848

# ---------- MySQL ----------
# 引导库（旧单体 apex_data 已随单体退役收敛为 apex_system）；
# 各微服务经 createDatabaseIfNotExist 自建独立库（apex_auth/apex_system/apex_workflow/apex_office/apex_file）
MYSQL_DATABASE=apex_system
MYSQL_ROOT_PASSWORD=apex-root
# 宿主机 MySQL 端口（默认 3306；本机已有 MySQL 时改为 3307 避免冲突）
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379
# Redis 密码（prod 配置强制要求 REDIS_PASSWORD 非空；与 redis 服务 --requirepass 一致）
REDIS_PASSWORD=apex-redis-password
# Redis 数据库索引
REDIS_DATABASE=0
# Redis 主机地址
REDIS_HOST=redis
# Redis 连接池配置
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0
REDIS_POOL_MAX_WAIT=-1

# ---------- 应用数据库连接（指向 compose 内的 mysql 服务） ----------
# 微服务经 DB_HOST/DB_PORT + DB_NAME 或显式 SPRING_DATASOURCE_URL 连接各自独立库；
# 主机/端口在 compose 中固定为 mysql:3306，此处仅暴露账号密码覆盖项。
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=apex-root
# 数据库连接池配置
DB_MAX_ACTIVE=20
DB_MAX_WAIT_MILLIS=60000

# ---------- JWT（生产必须替换为 >=32 字节强随机密钥，否则 prod 启动校验失败） ----------
# 生成: openssl rand -base64 48
JWT_SECRET=
# JWT Token 过期时间配置
JWT_ACCESS_EXPIRE=7200000
JWT_REFRESH_EXPIRE=604800000
# JWT 自动续期阈值（秒）
JWT_ACCESS_RENEW_THRESHOLD=1800

APEX_DATA_ENCRYPTION_KEY=
SECURITY_ENCRYPTION_KEY=
CONFIG_ENCRYPTION_KEY=
APEX_CONFIG_ENCRYPTION_KEY=

# ---------- Nacos（服务发现 + 配置中心；微服务拓扑默认启用） ----------
NACOS_CONFIG_ENABLED=true
NACOS_DISCOVERY_ENABLED=true
NACOS_REGISTER_ENABLED=true
# Nacos 地址（compose 内为 nacos:8848）与命名空间
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=public

# ---------- RocketMQ（可选，配合 --profile rocketmq） ----------
# 启用时设置 NameServer，并按需开启业务消费者和领域事件广播。
ROCKETMQ_NAMESERVER=
ROCKETMQ_NAMESRV_ADDR=
ROCKETMQ_PRODUCER_GROUP=apex-producer-group
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
ROCKETMQ_SEND_TIMEOUT=30000
# RocketMQ 消费者配置
ROCKETMQ_CONSUMER_ENABLED=false
APEX_MQ_CONSUMER_ENABLED=false
APEX_MQ_DLQ_ENABLED=false
APEX_MQ_DOMAIN_EVENT_ENABLED=false
APEX_MQ_DOMAIN_EVENT_TOPIC=apex-domain-event
MQ_IDEMPOTENT_TTL_MINUTES=30
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_TIMEOUT_SECONDS=120
OUTBOX_PARALLELISM=4
OUTBOX_RETENTION_ENABLED=true
OUTBOX_RETENTION_DELIVERED_HOURS=168
OUTBOX_RETENTION_DEAD_DAYS=30
OUTBOX_RETENTION_BATCH_SIZE=5000

# ---------- License（商业授权文件，留空使用随包基础版） ----------
# 示例: APEX_LICENSE_FILE=/app/config/license.json （需挂载 config 卷）
APEX_LICENSE_FILE=
# License 功能开关和公钥配置
APEX_LICENSE_ENABLED=false
APEX_LICENSE_PUBLIC_KEY_FILE=

# ---------- 文件服务（apex-file-service）文件上传 ----------
# 文件域已迁出单体（迁移方案 Phase 4），由 apex-file-service 独立消费，
# 配置映射见 apex-file-service/src/main/resources/application.yml。
# 单文件最大字节数（默认 10MB，分片上传接口不受此限制）
FILE_MAX_SIZE_BYTES=10485760

# ---------- Keycloak（IAM 身份认证，可选，配合 --profile keycloak） ----------
# 启用 Keycloak 服务后，应用可通过 OIDC 协议对接，支持 SSO/社交登录/MFA
# 管理控制台: http://localhost:${KEYCLOAK_PORT}  管理员: KEYCLOAK_ADMIN_USERNAME / KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
# Keycloak 专用数据库（与应用库隔离），启动时自动创建
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=root
KEYCLOAK_DB_PASSWORD=apex-root
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_LOG_LEVEL=INFO
# Keycloak 应用集成配置
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=apex
KEYCLOAK_CLIENT_ID=apex-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/callback
KEYCLOAK_USER_SYNC_ENABLED=false

# ---------- Sentinel 限流熔断（Enterprise） ----------
# ⚠️ Sentinel Dashboard 用于动态规则管理，生产环境建议开启
SENTINEL_DASHBOARD_URL=
SENTINEL_TRANSPORT_PORT=8719
SENTINEL_CLIENT_IP=
SENTINEL_EAGER=true
# Sentinel 主机和端口配置
SENTINEL_HOST=localhost
SENTINEL_PORT=8719
# Nacos 动态规则下发（可选）
SENTINEL_NACOS_ENABLED=false
SENTINEL_NACOS_GROUP=SENTINEL_GROUP
SENTINEL_NACOS_FLOW_DATA_ID=apex-sentinel-flow-rules
SENTINEL_NACOS_DEGRADE_DATA_ID=apex-sentinel-degrade-rules

# ---------- Meilisearch 全文搜索（可选） ----------
# 轻量级全文搜索引擎，支持 CJK 分词
MEILISEARCH_ENABLED=false
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=apex_

# ---------- Loki 日志查询（可选） ----------
# 配合 Grafana 使用，轻量级日志聚合查询
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100

# ---------- Grafana 监控（可选） ----------
# 可视化监控大盘（66 个面板）
GRAFANA_ENABLED=false
GRAFANA_URL=http://localhost:3200

# ---------- 链路追踪（Enterprise） ----------
# Zipkin 分布式链路追踪
TRACING_ENABLED=true
TRACE_SAMPLING_RATE=0.1
ZIPKIN_BASE_URL=http://localhost:9411
# 链路追踪慢请求阈值（毫秒）
TRACE_SLOW_THRESHOLD_MS=1000

# ---------- 文件服务（apex-file-service）存储配置 ----------
# 文件域已迁出单体（迁移方案 Phase 4），由 apex-file-service 独立消费。
# 默认存储类型: local（本地文件）/ minio（MinIO 对象存储）/ volcengine（火山引擎 TOS）
STORAGE_DEFAULT_TYPE=local
STORAGE_BUCKET_NAME=apex
STORAGE_PRESIGNED_URL_EXPIRE_SECONDS=300
# 本地存储（兜底实现）
STORAGE_LOCAL_ENABLED=true
STORAGE_LOCAL_BASE_PATH=./data/storage
STORAGE_LOCAL_PUBLIC_BASE_URL=
# MinIO 对象存储
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
# 火山引擎 TOS
STORAGE_VOLCENGINE_ENABLED=false
STORAGE_VOLCENGINE_ENDPOINT=
STORAGE_VOLCENGINE_REGION=
STORAGE_VOLCENGINE_ACCESS_KEY=
STORAGE_VOLCENGINE_SECRET_KEY=

# ---------- 内容审核（百度 AI，独立内容安全能力） ----------
# 说明：内容审核属于独立的内容安全能力（非文件存储域），如启用相关入口请自行确保密钥已配置。
BAIDU_TEXT_MODERATION_API_KEY=
BAIDU_TEXT_MODERATION_SECRET_KEY=
BAIDU_IMAGE_MODERATION_API_KEY=
BAIDU_IMAGE_MODERATION_SECRET_KEY=

# ---------- 告警通知（钉钉） ----------
# 异常聚合告警推送到钉钉群
DINGDING_WEBHOOK=
DINGDING_SECRET=

# ---------- 邮件发送（SMTP） ----------
# 系统通知邮件发送配置
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 微信登录配置 ----------
# 微信开放平台应用配置
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_USER_INFO_URL=https://api.weixin.qq.com/sns/userinfo

# ---------- 企业微信配置 ----------
# 企业微信应用配置
WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_SECRET=
WEWORK_TOKEN=
WEWORK_ENCODING_AES_KEY=

# ---------- 创蓝短信服务配置 ----------
# 创蓝一键登录配置
CL_FLASH_HOST=
CL_FLASH_PORT=443
CL_FLASH_SSL=true
CL_FLASH_APP_ID=
CL_FLASH_APP_KEY=
CL_FLASH_ENCRYPT_TYPE=MD5
# 创蓝一键登录 - 多平台 App ID/Key
CL_FLASH_ANDROID_APP_ID=
CL_FLASH_ANDROID_APP_KEY=
CL_FLASH_IOS_APP_ID=
CL_FLASH_IOS_APP_KEY=
CL_FLASH_H5_APP_ID=
CL_FLASH_H5_APP_KEY=
CL_FLASH_WECHAT_APP_ID=
CL_FLASH_WECHAT_APP_KEY=
CL_FLASH_HARMONY_APP_ID=
CL_FLASH_HARMONY_APP_KEY=
# 创蓝短信验证码配置
CL_SMS_HOST=
CL_SMS_PORT=443
CL_SMS_SSL=true
CL_SMS_ACCOUNT=
CL_SMS_PASSWORD=
CL_SMS_SIGNATURE=
CL_SMS_TEMPLATE_ID=

# ---------- 安全配置 ----------
# 图形验证码
APEX_CAPTCHA_ENABLED=true
APEX_CAPTCHA_LENGTH=4
APEX_CAPTCHA_TTL_SECONDS=120
# 用户限流
APEX_USER_RATE_LIMIT_ENABLED=true
# 防重放攻击
APEX_ANTI_REPLAY_NONCE_TTL=360

# ---------- Redis 扩展配置 ----------
# Redis 键前缀（多应用共用同一 Redis 时隔离）
APEX_REDIS_KEY_PREFIX=
# Redisson 看门狗与超时配置
APEX_REDIS_LOCK_WATCHDOG_TIMEOUT=30000
APEX_REDIS_COMMAND_TIMEOUT=3000
APEX_REDIS_RETRY_ATTEMPTS=3
APEX_REDIS_RETRY_INTERVAL=1500
APEX_REDIS_CLEANUP_ON_STARTUP=true

# ---------- 数据库扩展配置 ----------
# 数据库类型: mysql（默认）/ postgresql
APEX_DATABASE_TYPE=mysql
# HikariCP 连接池配置
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
# 慢 SQL 监控
APEX_SQL_SLOW_ENABLED=true
APEX_SQL_SLOW_THRESHOLD_MS=1000

# ---------- 服务治理（Governance） ----------
# 统一 readiness、资源排空和优雅关停协调
APEX_GOVERNANCE_ENABLED=true
APEX_GOVERNANCE_DEPLOYMENT_MODE=auto
APEX_GOVERNANCE_AUTO_DETECTION_ENABLED=true
APEX_GOVERNANCE_FAIL_ON_AMBIGUOUS=true
APEX_GOVERNANCE_REGISTRATION_PROVIDER=auto
APEX_GOVERNANCE_REGISTRATION_FAIL_MODE=auto
APEX_GOVERNANCE_MQ_DRAIN_TIMEOUT=30s
APEX_GOVERNANCE_SHUTDOWN_TIMEOUT=90s
APEX_GOVERNANCE_READINESS_WITHDRAW_TIMEOUT=5s
APEX_GOVERNANCE_FORCE_SHUTDOWN=true

# ---------- 系统级配置 ----------
# 管理端口配置
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8081
# 全局响应超时
APEX_RESPONSE_TIMEOUT=30s
# 操作日志
OPERATION_LOG_ENABLED=true
# 请求体/响应体内存缓冲上限
MAX_IN_MEMORY_SIZE=10MB
# WebClient 超时配置
WEBCLIENT_CONNECT_TIMEOUT=5000
WEBCLIENT_READ_TIMEOUT=10000
WEBCLIENT_WRITE_TIMEOUT=10000
# 远程 API 调用配置
REMOTE_API_CONNECT_TIMEOUT=5000
REMOTE_API_READ_TIMEOUT=10000
REMOTE_API_RETRY_COUNT=2
REMOTE_API_RETRY_DELAY=1000
REMOTE_API_POOL_MAX_CONNECTIONS=100

# ---------- 其他 ----------
# 时区
TZ=Asia/Shanghai
# 环境名称标识（可选）
ENV_NAME=
# 通用变量占位符（保留，用于模板插值）
VAR=
