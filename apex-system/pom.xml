    <build>
        <resources>
            <!-- apex-build.properties 启用 Maven filtering，注入 build.profile.id / project.version -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>apex-build.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>apex-build.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <excludeRoots>
                        <excludeRoot>${project.build.directory}/generated-sources/annotations</excludeRoot>
                    </excludeRoots>
                    <excludes>
                        <exclude>**/OAuth2*.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- JSQLParser 由 JavaCC 生成，CONSTANT 池含 JaCoCo 0.8.12 无法识别的
                         block type 68；必须从 agent（instrumentation）和 report 两端同时排除，
                         否则 prepare-agent 仍会写入 jsqlparser 探针，report 阶段 Analyzer
                         回读 class 字节码时报 Unknown block type 68。 -->
                    <excludes>
                        <exclude>com/apex/scaffold/interfaces/tool/**/*</exclude>
                        <exclude>com/apex/scaffold/interfaces/service/**/*</exclude>
                        <exclude>com/apex/scaffold/interfaces/dto/**/*</exclude>
                        <exclude>com/apex/scaffold/application/dto/**/*</exclude>
                        <exclude>com/apex/scaffold/domain/gateway/**/*</exclude>
                        <exclude>com/apex/scaffold/domain/event/**/*</exclude>
                        <exclude>com/apex/scaffold/infrastructure/persistence/repository/**/*</exclude>
                        <exclude>com/apex/scaffold/infrastructure/persistence/converter/**/*</exclude>
                        <exclude>com/apex/scaffold/infrastructure/persistence/po/**/*</exclude>
                        <exclude>com/apex/scaffold/infrastructure/persistence/moderation/**/*</exclude>
                        <exclude>net/sf/jsqlparser/**/*</exclude>
                        <exclude>com/github/jsqlparser/**/*</exclude>
                    </excludes>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.interfaces.config.*</include>
                                <include>com.apex.scaffold.interfaces.interest.catalog.*</include>
                                <include>com.apex.scaffold.interfaces.router.*</include>
                                <include>com.apex.scaffold.interfaces.security.*</include>
                                <include>com.apex.scaffold.interfaces.util.*</include>
                                <include>com.apex.scaffold.interfaces.exception.*</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.90</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.75</minimum>
                                </limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.interfaces.handler.*</include>
                                <include>com.apex.scaffold.interfaces.filter.*</include>
                                <include>com.apex.scaffold.interfaces.aspect.*</include>
                                <include>com.apex.scaffold.interfaces.monitor.*</include>
                            </includes>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.70</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.50</minimum>
                                </limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.application.assembler.*</include>
                                <include>com.apex.scaffold.application.service.login.*</include>
                                <include>com.apex.scaffold.application.service.moderation.*</include>
                                <include>com.apex.scaffold.application.factory.report.*</include>
                                <include>com.apex.scaffold.application.service.photo.*</include>
                                <include>com.apex.scaffold.application.model.*</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.application.service.*</include>
                                <include>com.apex.scaffold.application.service.interest.*</include>
                                <include>com.apex.scaffold.application.service.interest.frequency.*</include>
                                <include>com.apex.scaffold.application.service.interest.governance.*</include>
                                <include>com.apex.scaffold.application.recommendation.*</include>
                                <include>com.apex.scaffold.application.service.radar.*</include>
                                <include>com.apex.scaffold.application.service.auth.*</include>
                                <include>com.apex.scaffold.application.config.*</include>
                                <include>com.apex.scaffold.application.util.*</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.65</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.application.listener.*</include>
                                <include>com.apex.scaffold.application.scheduler.*</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.65</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.45</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>CLASS</element>
                            <includes>
                                <include>com.apex.scaffold.application.service.EyesightScoringService</include>
                                <include>com.apex.scaffold.application.service.EyesightRankingService</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.application.service.AuthRegistrationService</include>
                                <include>com.apex.scaffold.application.service.auth.AuthTicketService</include>
                                <include>com.apex.scaffold.application.service.login.AbstractPhoneLoginStrategy</include>
                                <include>com.apex.scaffold.application.service.login.WeChatCodeLoginStrategy</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.domain.enums.*</include>
                                <include>com.apex.scaffold.domain.model.valueobject.*</include>
                                <include>com.apex.scaffold.domain.model.moderation.*</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.domain.model.entity.*</include>
                                <include>com.apex.scaffold.domain.service.*</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.65</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.infrastructure.moderation.*</include>
                                <include>com.apex.scaffold.infrastructure.persistence.service.*</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.55</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>BUNDLE</element>
                            <includes>
                                <include>com.apex.scaffold.infrastructure.cache.service.*</include>
                                <include>com.apex.scaffold.infrastructure.mq.listener.*</include>
                                <include>com.apex.scaffold.infrastructure.scheduler.*</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.65</minimum></limit>
                                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.45</minimum></limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <excludes>
                                <exclude>net.sf.jsqlparser.*</exclude>
                                <exclude>com.github.jsqlparser.*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution><id>interfaces-report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
                    <execution><id>interfaces-coverage-check</id><phase>test</phase><goals><goal>check</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/ApiCallLogIntegrationTest.java</exclude>
                        <exclude>**/OpenApiEndpointsIntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      ============================================================
      商业化版本 Profile（依赖裁剪 + 与父 pom basic/standard/enterprise 对应）
      P0-3a basic 档依赖真裁剪：
      对上游 apex-application / apex-infrastructure 传递的高级依赖
      （RocketMQ / Sentinel / resilience4j / nacos-config+discovery
       等）加 exclusions，使 basic 打包产物 BOOT-INF/lib 不含这些 jar。
      父 pom basic 的 dependencyManagement 已将这些坐标标记为 <optional>true</optional>，
      两者叠加保证 basic 版 classpath 中确实没有这些类 → @ConditionalOnClass
      守护的 Bean 不会被装配，运行期行为与 features.* 配置一致。
      ============================================================
    -->
    <profiles>
      <profile>
        <id>basic</id>
        <dependencyManagement>
          <dependencies>
            <!-- 1. 高级依赖显式设为 optional，防止普通声明被传递 -->
            <dependency>
              <groupId>org.apache.rocketmq</groupId>
              <artifactId>rocketmq-spring-boot-starter</artifactId>
              <optional>true</optional>
            </dependency>
            <dependency>
              <groupId>io.github.resilience4j</groupId>
              <artifactId>resilience4j-circuitbreaker</artifactId>
              <optional>true</optional>
            </dependency>
            <dependency>
              <groupId>io.github.resilience4j</groupId>
              <artifactId>resilience4j-spring-boot3</artifactId>
              <optional>true</optional>
