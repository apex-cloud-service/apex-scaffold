    def test_v43_exact_binding_and_tamper_rejection(self):
        import hashlib
        import json
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_v43'), 'V43过程规划尚未实现')
        result = module.plan_v43()
        self.assertEqual({f'old-sql-{i:04d}' for i in range(449, 473)}, {i['id'] for i in result['items']})
        calls = [g for g in result['groups'] if g['target']['kind'] == 'index']
        self.assertEqual(21, len(calls))
        self.assertEqual(24, len({i for g in result['groups'] for i in g['old_ids']}))
        text = (ROOT / module.V43).read_text()
        for group in result['groups']:
            for statement, ids in zip(group['statements'], group['statement_ids']):
                self.assertEqual(statement['sql'], text[statement['start_offset']:statement['end_offset']])
                identity = f"{module.V43}:{statement['start_offset']}:{statement['end_offset']}:{statement['statement_sha256']}"
                self.assertEqual(['stmt-' + hashlib.sha256(identity.encode()).hexdigest()[:24]], ids)
        with self.assertRaisesRegex(ValueError, 'source hash'):
            module.plan_v43('SELECT 1;')
        baseline = json.loads(module.BASELINE.read_text())
        item = next(i for i in baseline['baseline_audit']['old_sql_items'] if i['id'] == 'old-sql-0450')
        item['statement_ids'] = ['stmt-tampered']
        original = pathlib.Path.read_text
        def read_text(path, *args, **kwargs):
            return json.dumps(baseline) if path == module.BASELINE else original(path, *args, **kwargs)
        with patch.object(pathlib.Path, 'read_text', read_text), self.assertRaisesRegex(ValueError, 'statement binding'):
            module.plan_v43()

    def v43_fixture(self, module, mutation=None):
        import re
        self.assertTrue(hasattr(module, 'verify_v43'), 'V43真实场景验证尚未实现')
        result = module.plan_v43()
        tables, indexes = {}, {}
        procedure = False
        def sql(text):
            nonlocal procedure
            if 'CREATE PROCEDURE' in text:
                procedure = True
            for table in re.findall(r'DROP TABLE IF EXISTS `([^`]+)`', text):
                tables.pop(table, None)
                indexes.pop(table, None)
            for table, body in re.findall(r'CREATE TABLE `([^`]+)` \((.*?)\);', text):
                tables[table] = set(re.findall(r'`(\w+)` VARCHAR', body))
                indexes[table] = {'PRIMARY': (0, ['id'])}
                for name in re.findall(r'UNIQUE INDEX `(\w+)`', body):
                    indexes[table][name] = (0, ['id'])
            for table, name, columns in re.findall(r"CALL add_index_if_columns_exist\('([^']+)', '([^']+)', '([^']+)'\)", text):
                cols = columns.split(',')
                if table in tables and name not in indexes[table]:
                    if set(cols) <= tables[table] or mutation == 'missing_column':
                        indexes[table][name] = (1, cols)
                        selected = 'CREATE INDEX `' + name + '` ON `' + table + '` (`' + '`,`'.join(cols) + '`)'
                    else:
                        selected = '<NULL>'
                else:
                    selected = '<NULL>'
                if 'SELECT COALESCE(@create_index_sql' in text:
                    return 'wrong' if mutation == 'selected_sql' else selected
            if text.rstrip().endswith('DROP PROCEDURE IF EXISTS add_index_if_columns_exist;'):
                procedure = False
            if 'information_schema.routines' in text:
                return '1' if procedure or mutation == 'procedure' else '0'
            if 'information_schema.tables' in text:
                return '1' if mutation == 'missing_table' else '0'
            if 'information_schema.columns' in text:
                return '\n'.join(sorted(t + '\t' + c for t in tables for c in tables[t]))
            if 'information_schema.statistics' in text:
                match = re.search(r"table_name='([^']+)'", text)
                names = re.search(r"index_name='([^']+)'", text)
                lines = []
                for table in sorted(tables):
                    if match and table != match[1]:
                        continue
                    for name, (unique, cols) in sorted(indexes[table].items(), key=lambda row: row[0].lower()):
                        if names and name != names[1]:
                            continue
                        for seq, col in enumerate(cols, 1):
                            line = '\t'.join(map(str, (name, unique, seq, col, 'BTREE')))
                            lines.append((table + '\t' if 'SELECT table_name,' in text else '') + line)
                output = '\n'.join(lines)
                if mutation == 'unique':
                    output = output.replace('\t1\t1\t', '\t0\t1\t')
                elif mutation == 'sequence':
                    output = output.replace('\t1\t2\t', '\t1\t3\t')
                elif mutation == 'column':
                    output = output.replace('\trecipient_id\t', '\tid\t')
                elif mutation == 'type':
                    output = output.replace('BTREE', 'HASH')
                return output
            if 'SELECT * FROM' in text:
                return 'changed' if mutation == 'data' and any(len(v) > 1 for v in indexes.values()) else '1\tfixture'
            return ''
        return result, sql

    def test_v43_all_calls_missing_columns_and_full_lifecycle(self):
        module = self.load()
        result, sql = self.v43_fixture(module)
        with patch.object(module, 'save'):
            module.verify_v43(result, sql)
        self.assertEqual('passed', result['status'])
        calls = [g for g in result['groups'] if g['target']['kind'] == 'index']
        self.assertTrue(all(module.closed(g['results']) for g in result['groups']))
        self.assertEqual(21, len(calls))
        for g in calls:
            self.assertTrue(g['observations']['missing_table']['table_still_absent'])
            self.assertEqual(set(g['columns']), set(g['observations']['missing_columns']))
            self.assertEqual(g['observations']['present']['before'], g['observations']['present']['after'])
        self.assertTrue(result['full_file']['procedure_removed'])
        self.assertEqual(result['full_file']['after_initial'], result['full_file']['after_replay'])
        for table, before in result['full_file']['before_initial'].items():
            self.assertEqual(before['data'], result['full_file']['after_initial'][table]['data'])

