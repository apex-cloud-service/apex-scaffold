import importlib.util
import hashlib
import json
import pathlib
import unittest
from unittest.mock import patch
from types import SimpleNamespace

ROOT = pathlib.Path(__file__).resolve().parents[2]
SCRIPT = ROOT / 'scripts/ci/auth_v45_dynamic_probe_20261018.py'
V52 = 'apex-auth-service/src/main/resources/db/migration/mysql/V52__align_auth_token_fields.sql'


class ProbeTest(unittest.TestCase):
    def load(self):
        self.assertTrue(SCRIPT.exists(), '独立 V45 验证器尚未实现')
        spec = importlib.util.spec_from_file_location('v45_probe', SCRIPT)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module

    def test_complete_exact_old_id_binding(self):
        module = self.load()
        plan = module.plan()
        self.assertEqual(24, len(plan['groups']))
        self.assertEqual(96, len(plan['items']))
        self.assertEqual({f'old-sql-{i:04d}' for i in range(96)}, {i['id'] for i in plan['items']})
        self.assertTrue(all(len(g['old_ids']) == 4 for g in plan['groups']))
        self.assertIn("DEFAULT 'ACTIVE'", plan['groups'][13]['absent_sql'])

    def test_v52_complete_binding_excludes_previous_credit(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_next'), '可复用下一批规划尚未实现')
        plan = module.plan_next(V52)
        self.assertEqual(9, len(plan['groups']))
        self.assertEqual(36, len(plan['items']))
        bound = [i for g in plan['groups'] for i in g['old_ids']]
        self.assertEqual(36, len(set(bound)))
        self.assertEqual({i['id'] for i in plan['items']}, set(bound))
        prior, _, denominator = module.verified_union()
        self.assertEqual(prior, plan['previous_verified_ids'])
        self.assertGreaterEqual(len(prior), 147)
        self.assertEqual(denominator - len(prior), plan['remaining_before'])
        self.assertTrue(all(len(g['statement_ids']) == 4 for g in plan['groups']))

    def test_v52_reference_catalog_is_explicit(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'expected_v52_catalog'), 'V52列定义校验尚未实现')
        self.assertEqual('int\tYES\t0\t', module.expected_v52_catalog('use_count'))
        self.assertEqual('timestamp\tYES\t<NULL>\t', module.expected_v52_catalog('last_used_at'))
        self.assertEqual('varchar(100)\tYES\t<NULL>\t', module.expected_v52_catalog('previous_jti'))

    def test_v14_binds_procedure_and_calls_without_literal_guard_assumption(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_v14'), 'V14过程探针尚未实现')
        plan = module.plan_v14()
        self.assertEqual({f'old-sql-{i:04d}' for i in range(140, 155)},
                         {i['id'] for i in plan['items']})
        self.assertEqual(15, len(plan['groups'][0]['old_ids']))
        self.assertEqual(15, len(plan['groups'][0]['statement_ids']))
        self.assertIn('CREATE PROCEDURE IF NOT EXISTS', plan['procedure_sql'])
        self.assertNotIn('ALTER TABLE `sys_user`', plan['procedure_sql'])
        self.assertIn('CALL add_tenant_id_if_not_exists', plan['calls_sql'])
        with self.assertRaisesRegex(ValueError, 'source hash'):
            module.plan_v14(source_text='SELECT 1;')

    def test_v55_binding_and_catalog_reference(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_v55'), 'V55列与索引规划尚未实现')
        plan = module.plan_v55()
        self.assertEqual({f'old-sql-{i:04d}' for i in range(132, 140)},
                         {i for g in plan['groups'] for i in g['old_ids']})
        self.assertEqual(['column', 'index'], [g['target']['kind'] for g in plan['groups']])
        self.assertGreaterEqual(len(plan['previous_verified_ids']), 147)
        self.assertEqual('bigint\tYES\t<NULL>\t\t统一账户ID(sys_user.id，主应用账户体系)', module.V55_COLUMN)
        self.assertEqual('idx_auth_user_account_id\t1\t1\taccount_id\tBTREE\t<NULL>\tA\tYES', module.V55_INDEX)
        with self.assertRaisesRegex(ValueError, 'source hash'):
            module.plan_v55(source_text='SELECT 1;')

    def v15_fixture(self, module, missing_sql='SELECT 1'):
        group = next(g for g in module.plan_v15()['groups'] if g['target']['kind'] == 'index')
        table, name = group['target']['table'], group['target']['name']
        expected = name + '\t1\t1\ttenant_id\tBTREE'
        snapshots = iter(('', expected, expected, expected, name + '\t0\t1\tid\tBTREE', name + '\t0\t1\tid\tBTREE'))
        outputs = iter((group['absent_sql'].replace("''", "'"), 'SELECT 1', 'SELECT 1', missing_sql))

        def sql(text):
            if 'SELECT @' in text:
                return next(outputs)
            if 'SELECT INDEX_NAME,' in text:
                return next(snapshots)
            if 'SELECT id,deleted' in text:
                return '1\tNULL'
            if 'SELECT table_name,column_name,column_type' in text:
                return table + '\ttenant_id\tvarchar(64)\tYES\t<NULL>'
            if 'FROM information_schema.statistics' in text:
                target = table + '\t' + name + '\ttenant_id'
                if 'NON_UNIQUE' in text:
                    target = table + '\t' + expected
                return target if 'index_name IN' in text else target + '\n' + table + '\tPRIMARY\tid'
            if 'information_schema.tables' in text:
                return '0'
            if 'SELECT COUNT(*)' in text:
                return '1'
            if 'SELECT *' in text:
                return '1\tNULL\tNULL'
            return ''

        return {'groups': [group], 'source': module.V15}, sql

    def test_v15_target_index_catalog_and_replay_fixture(self):
        module = self.load()
        result, sql = self.v15_fixture(module)
        with patch.object(module, 'save'):
            module.verify_v15(result, sql)
        self.assertEqual('passed', result['status'])
        self.assertEqual('reuse absent result', result['groups'][0]['observations']['replay']['fixture_sql'])
        self.assertEqual(1, result['full_file']['tenant_indexes_created'])
        self.assertEqual(result['full_file']['data_before_replay'], result['full_file']['data_after_replay'])
        self.assertEqual(1, len(result['full_file']['data_before_replay']))
        self.assertTrue(result['groups'][0]['observations']['missing_table']['table_still_absent'])

    def test_v15_full_file_rejects_wrong_target_index_definition(self):
        module = self.load()
        for old, new in (('\t1\t1\ttenant_id\tBTREE', '\t0\t1\ttenant_id\tBTREE'),
                         ('\ttenant_id\tBTREE', '\tid\tBTREE'),
                         ('\t1\t1\t', '\t1\t2\t')):
            with self.subTest(replacement=new):
                result, original_sql = self.v15_fixture(module)
                def sql(text):
                    output = original_sql(text)
                    return output.replace(old, new) if 'index_name IN' in text else output
                with patch.object(module, 'save'), self.assertRaises(AssertionError):
                    module.verify_v15(result, sql)

    def test_v15_missing_table_must_remain_absent(self):
        module = self.load()
        result, original_sql = self.v15_fixture(module)
        def sql(text):
            if 'information_schema.tables' in text:
                return '1'
            return original_sql(text)
        with patch.object(module, 'save'), self.assertRaisesRegex(AssertionError, 'missing-table was created'):
            module.verify_v15(result, sql)

    def test_v15_replay_must_preserve_all_table_data(self):
        module = self.load()
        result, original_sql = self.v15_fixture(module)
        data = iter(('1\tNULL\tNULL', '2\tNULL\tNULL'))
        def sql(text):
            if 'SELECT *' in text:
                return next(data)
            return original_sql(text)
        with patch.object(module, 'save'), self.assertRaises(AssertionError):
            module.verify_v15(result, sql)

