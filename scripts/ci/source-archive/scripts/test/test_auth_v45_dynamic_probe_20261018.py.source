    def v16_fixture(self, module, mutation=None):
        self.assertTrue(hasattr(module, 'verify_v16'), 'V16专用验证尚未实现')
        result = module.plan_v16()
        targets = {'idx_job_tenant_id': ('tenant_id',),
                   'idx_job_tenant_status': ('tenant_id', 'status'),
                   'idx_job_log_tenant_id': ('tenant_id',),
                   'idx_job_log_tenant_job_start': ('tenant_id', 'job_id', 'start_time')}
        counters = {}
        def sql(text):
            key = text
            counters[key] = counters.get(key, 0) + 1
            n = counters[key]
            if 'SELECT @' in text:
                group = next(g for g in result['groups'] if g['statements'][0]['sql'] in text)
                return (group['absent_sql'].replace("''", "'") if n == 1 else
                        'SELECT 2' if mutation == 'missing_selected' and n == 4 else 'SELECT 1')
            if 'information_schema.tables' in text:
                return '1' if mutation == 'missing_created' else '0'
            if 'SELECT COLUMN_TYPE,' in text:
                return ('', 'varchar(64)\tYES\t<NULL>\t\t租户ID（多租户隔离）\t3',
                        'varchar(64)\tYES\t<NULL>\t\t租户ID（多租户隔离）\t3',
                        'varchar(64)\tYES\t<NULL>\t\t租户ID（多租户隔离）\t3',
                        'varchar(7)\tYES\t<NULL>\t\t\t6', 'varchar(7)\tYES\t<NULL>\t\t\t6')[n - 1]
            if 'SELECT INDEX_NAME,' in text:
                name = next(name for name in targets if "index_name='" + name + "'" in text)
                expected = '\n'.join(name + '\t1\t' + str(i) + '\t' + col + '\tBTREE'
                                     for i, col in enumerate(targets[name], 1))
                return ('', expected, expected, expected, name + '\t0\t1\tid\tBTREE', name + '\t0\t1\tid\tBTREE')[n - 1]
            if 'SELECT id,deleted' in text:
                return '1\t0'
            if 'SELECT table_name,column_name,' in text:
                output = '\n'.join(t + '\ttenant_id\tvarchar(64)\tYES\t<NULL>\t3' for t in ('sys_job', 'sys_job_log'))
                return output + ('\nchanged' if mutation == 'schema_replay' and n == 2 else '')
            if 'SELECT table_name,index_name,' in text:
                lines = []
                for name, cols in targets.items():
                    table = 'sys_job_log' if name.startswith('idx_job_log') else 'sys_job'
                    lines.extend(table + '\t' + name + '\t1\t' + str(i) + '\t' + col + '\tBTREE'
                                 for i, col in enumerate(cols, 1))
                output = '\n'.join(sorted(lines))
                if mutation == 'index_order':
                    output = output.replace('\t2\tstatus\t', '\t2\ttenant_id\t')
                if mutation == 'index_job_order':
                    output = output.replace('\t2\tjob_id\t', '\t2\tstart_time\t')
                if mutation == 'index_unique':
                    output = output.replace('\t1\t1\t', '\t0\t1\t')
                return output
            if 'SELECT *' in text:
                return '1\t0\ttenant-a\t1\t7\t2026-01-02 03:04:05' + ('changed' if mutation == 'data_replay' and n == 2 else '')
            if 'SELECT tenant_id' in text:
                return 'NULL' if n == 1 or mutation == 'tenant_null' else 'tenant-a'
            return ''
        return result, sql

    def test_v16_composite_indexes_full_replay_and_missing_table(self):
        module = self.load()
        result, sql = self.v16_fixture(module)
        with patch.object(module, 'save'):
            module.verify_v16(result, sql)
        self.assertEqual('passed', result['status'])
        self.assertEqual(4, result['full_file']['tenant_indexes_created'])
        self.assertEqual(2, len(result['full_file']['data_before_replay']))
        self.assertEqual(result['full_file']['data_before_replay'], result['full_file']['data_after_replay'])
        self.assertTrue(result['full_file']['missing_tables']['table_still_absent'])
        self.assertTrue(all(g['observations']['missing_table']['table_still_absent'] for g in result['groups']))

    def test_v16_rejects_wrong_indexes_missing_table_and_replay_drift(self):
        module = self.load()
        for mutation in ('index_order', 'index_job_order', 'index_unique', 'missing_created',
                         'missing_selected', 'schema_replay', 'data_replay', 'tenant_null'):
            with self.subTest(mutation=mutation):
                result, sql = self.v16_fixture(module, mutation)
                with patch.object(module, 'save'), self.assertRaises(AssertionError):
