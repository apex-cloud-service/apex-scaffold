    def test_v43_union_rejects_tampered_statement_binding(self):
        import copy
        import json
        module = self.load()
        result = module.plan_v43()
        result['status'] = 'passed'
        result['cleanup']['container_and_anonymous_volumes_removed'] = True
        for group in result['groups']:
            group['results'] = {'absent': True, 'present': True, 'replay': True}
        for item in result['items']:
            item['verified_in_this_probe'] = True
            item['unpassed_branches'] = []
        result['coverage'] = {'verified_old_ids': [i['id'] for i in result['items']]}
        evidence_path = module.P0 / 'dynamic-v43-test-evidence.json'
        original = pathlib.Path.read_text
        for mutation in (None, 'statement_ids', 'offset', 'missing_group'):
            evidence = copy.deepcopy(result)
            if mutation == 'statement_ids':
                evidence['groups'][0]['statement_ids'] = [['stmt-tampered']]
            elif mutation == 'offset':
                evidence['groups'][0]['statements'][0]['start_offset'] += 1
            elif mutation == 'missing_group':
                evidence['groups'].pop()
            def read_text(path, *args, **kwargs):
                return json.dumps(evidence) if path == evidence_path else original(path, *args, **kwargs)
            original_bytes = pathlib.Path.read_bytes
            def read_bytes(path):
                return json.dumps(evidence).encode() if path == evidence_path else original_bytes(path)
            with patch.object(pathlib.Path, 'glob', return_value=[evidence_path]), patch.object(pathlib.Path, 'read_text', read_text), patch.object(pathlib.Path, 'read_bytes', read_bytes):
                verified, _, _ = module.verified_union()
            self.assertEqual(24 if mutation is None else 0, len(verified), mutation)

