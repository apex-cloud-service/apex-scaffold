    def test_v51_exact_binding_and_baseline_tamper(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_v51'), 'V51严格绑定尚未实现')
        result = module.plan_v51(include_prior=False)
        self.assertEqual(8, len(result['items']))
        self.assertEqual(['email', 'idx_email'], [g['target']['name'] for g in result['groups']])
        text = (ROOT / module.V51).read_text()
        for group in result['groups']:
            for statement, ids in zip(group['statements'], group['statement_ids']):
                self.assertEqual(statement['sql'], text[statement['start_offset']:statement['end_offset']])
                identity = f"{module.V51}:{statement['start_offset']}:{statement['end_offset']}:{statement['statement_sha256']}"
                self.assertEqual(['stmt-' + hashlib.sha256(identity.encode()).hexdigest()[:24]], ids)
        with self.assertRaisesRegex(ValueError, 'source hash'):
            module.plan_v51('SELECT 1;', include_prior=False)
        for field, value in [('statement_ids', ['stmt-wrong']), ('original', {'line': -1})]:
            baseline = json.loads(module.BASELINE.read_text())
            item = next(i for i in baseline['baseline_audit']['old_sql_items'] if i['source'] == module.V51 and i['category'] in ('dynamic_sql', 'procedure_or_prepared_control'))
            item[field] = value
            original = pathlib.Path.read_text
            with patch.object(pathlib.Path, 'read_text', lambda path, *a, **kw: json.dumps(baseline) if path == module.BASELINE else original(path, *a, **kw)):
                with self.assertRaisesRegex(ValueError, 'binding'):
                    module.plan_v51(include_prior=False)

    def v51_fixture(self, module, mutation=None):
        self.assertTrue(hasattr(module, 'verify_v51'), 'V51验证器尚未实现')
        result = module.plan_v51(include_prior=False)
        counters = {}
        def sql(text):
            counters[text] = counters.get(text, 0) + 1
            n = counters[text]
            if 'SELECT @sql' in text:
                group = next(g for g in result['groups'] if g['statements'][0]['sql'] in text)
                name = group['target']['name']
                if n == 4:
                    raise RuntimeError('ERROR 1146 missing table')
                if n == 5:
                    code = 1054 if group['target']['kind'] == 'column' else 1072
                    raise RuntimeError(f'ERROR {code} missing source column')
                return group['absent_sql'] if n == 1 else group['present_sql']
            if 'SELECT COLUMN_TYPE,' in text:
                expected = 'varchar(255)\tYES\t<NULL>\t3'
                if mutation in ('type', 'nullable', 'default', 'order'):
                    expected = {'type': 'text\tYES\t<NULL>\t3', 'nullable': 'varchar(255)\tNO\t<NULL>\t3', 'default': 'varchar(255)\tYES\tx\t3', 'order': 'varchar(255)\tYES\t<NULL>\t4'}[mutation]
                return ('', expected, expected, expected, 'varchar(7)\tNO\tlegacy\t4', 'varchar(7)\tNO\tlegacy\t4')[n - 1]
            if 'SELECT INDEX_NAME,' in text:
                expected = 'idx_email\t1\t1\temail\tBTREE'
                if mutation == 'index':
                    expected = expected.replace('\t1\t1\temail', '\t0\t2\tid')
                return ('', expected, expected, expected, 'idx_email\t0\t1\tid\tBTREE', 'idx_email\t0\t1\tid\tBTREE')[n - 1]
            if 'SELECT table_name,column_name,' in text:
                return module.v51_expected_columns()
            if 'SELECT table_name,index_name,' in text:
                return module.v51_expected_indexes()
            if 'SELECT id,phone,keycloak_sub' in text:
                return '1\t中文电话\tlegacy-sub'
            if 'SELECT * FROM sys_user' in text:
                return '1\t中文电话\tperson@example.test\tlegacy-sub' + ('changed' if mutation == 'data' and n > 1 else '')
            if 'SELECT TABLE_COMMENT' in text:
                return '系统用户表（支持本地JWT认证和Keycloak SSO认证）'
            if 'SELECT COUNT(*) FROM information_schema.tables' in text:
                return '0'
            if 'MODIFY COLUMN keycloak_sub' in text and text.startswith('USE probe; DROP TABLE'):
                raise RuntimeError('ERROR 1054 missing keycloak_sub' if 'CREATE TABLE' in text else 'ERROR 1146 missing table')
            return ''
        return result, sql

