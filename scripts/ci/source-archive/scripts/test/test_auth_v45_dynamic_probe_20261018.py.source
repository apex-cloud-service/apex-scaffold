            result['full_file'] = {'initial_execution': True, 'replay': True}
            path = module.P0 / 'dynamic-test-new-evidence.json'
            original_text, original_bytes = pathlib.Path.read_text, pathlib.Path.read_bytes
            for mutation in ('valid', 'offset', 'statement_id', 'item', 'missing_group', 'branch', 'cleanup', 'status', 'full_file'):
                evidence = copy.deepcopy(result)
                if mutation == 'offset': evidence['groups'][0]['statements'][0]['start_offset'] += 1
                if mutation == 'statement_id': evidence['groups'][0]['statement_ids'][0] = ['forged']
                if mutation == 'item': evidence['items'][0]['original']['line'] += 1
                if mutation == 'missing_group': evidence['groups'].pop()
                if mutation == 'branch': evidence['groups'][0]['results']['present'] = False
                if mutation == 'cleanup': evidence['cleanup']['container_and_anonymous_volumes_removed'] = False
                if mutation == 'status': evidence['status'] = 'partial_failure'
                if mutation == 'full_file': evidence['full_file']['replay'] = False
                payload = json.dumps(evidence)
                with patch.object(pathlib.Path, 'glob', return_value=[path]), patch.object(pathlib.Path, 'read_text', lambda p, *a, **kw: payload if p == path else original_text(p, *a, **kw)), patch.object(pathlib.Path, 'read_bytes', lambda p: payload.encode() if p == path else original_bytes(p)):
                    self.assertEqual(len(result['items']) if mutation == 'valid' else 0, len(module.verified_union()[0]), (version, mutation))

    def test_pg_multisource_union_validates_evidence_and_records_hash(self):
        import copy
        module = self.load()
        import pg_p0_dynamic_probe as pg
        result = pg.plan()
        result['status'] = 'passed'
        result['cleanup']['container_and_anonymous_volumes_removed'] = True
        for group in result['groups']:
            group['results'] = dict.fromkeys(pg.BRANCHES, True)
        pg.finalize(result)
        path = module.P0 / 'dynamic-test-pg-evidence.json'
        original_text, original_bytes = pathlib.Path.read_text, pathlib.Path.read_bytes
        for mutation in ('valid', 'baseline', 'source', 'statement', 'old_id', 'item',
                         'missing_group', 'cleanup', 'status', 'coverage', *pg.BRANCHES):
            with self.subTest(mutation=mutation):
                evidence = copy.deepcopy(result)
                if mutation == 'baseline': evidence['baseline_sha256'] = 'stale'
                if mutation == 'source': evidence['sources'][0]['source_sha256'] = 'stale'
                if mutation == 'statement': evidence['groups'][0]['statements'][0]['start_offset'] += 1
                if mutation == 'old_id': evidence['groups'][0]['old_ids'] = ['old-sql-0000']
                if mutation == 'item': evidence['items'][0]['original']['line'] += 1
                if mutation == 'missing_group': evidence['groups'].pop()
                if mutation == 'cleanup': evidence['cleanup']['container_and_anonymous_volumes_removed'] = False
                if mutation == 'status': evidence['status'] = 'failed'
                if mutation == 'coverage': evidence['coverage']['verified_old_ids'].pop()
                if mutation in pg.BRANCHES: evidence['groups'][0]['results'][mutation] = False
                payload = json.dumps(evidence)
                with patch.object(pathlib.Path, 'glob', return_value=[path]), patch.object(pathlib.Path, 'read_text', lambda p, *a, **kw: payload if p == path else original_text(p, *a, **kw)), patch.object(pathlib.Path, 'read_bytes', lambda p: payload.encode() if p == path else original_bytes(p)):
                    ids, hashes, denominator = module.verified_union()
                self.assertEqual(586, denominator)
                self.assertEqual(result['coverage']['verified_old_ids'] if mutation == 'valid' else [], ids)
                self.assertEqual({path.name: hashlib.sha256(payload.encode()).hexdigest()} if mutation == 'valid' else {}, hashes)

    def test_pg_multisource_duplicate_evidence_counts_old_ids_once(self):
        import pg_p0_dynamic_probe as pg
        module = self.load()
        evidence = pg.plan()
        evidence['status'] = 'passed'
        evidence['cleanup']['container_and_anonymous_volumes_removed'] = True
        for group in evidence['groups']:
            group['results'] = dict.fromkeys(pg.BRANCHES, True)
        pg.finalize(evidence)
        payload = json.dumps(evidence)
        paths = [module.P0 / f'dynamic-test-pg-{n}-evidence.json' for n in range(2)]
        original_text, original_bytes = pathlib.Path.read_text, pathlib.Path.read_bytes
        with patch.object(pathlib.Path, 'glob', return_value=paths), patch.object(
                pathlib.Path, 'read_text', lambda p, *a, **kw: payload if p in paths else original_text(p, *a, **kw)), patch.object(
                pathlib.Path, 'read_bytes', lambda p: payload.encode() if p in paths else original_bytes(p)):
            ids, hashes, denominator = module.verified_union()
        self.assertEqual(evidence['coverage']['verified_old_ids'], ids)
        self.assertEqual(31, len(ids))
        self.assertEqual(586, denominator)
        self.assertEqual({p.name: hashlib.sha256(payload.encode()).hexdigest() for p in paths}, hashes)

    def test_pg_source_drift_excludes_evidence_without_aborting_union(self):
        module = self.load()
        import pg_p0_dynamic_probe as pg
        evidence = pg.plan()
        evidence['status'] = 'passed'
        evidence['cleanup']['container_and_anonymous_volumes_removed'] = True
        for group in evidence['groups']:
            group['results'] = dict.fromkeys(pg.BRANCHES, True)
        pg.finalize(evidence)
        path = module.P0 / 'dynamic-test-pg-drift-evidence.json'
        payload = json.dumps(evidence)
        original = pathlib.Path.read_text
        with patch.object(pathlib.Path, 'glob', return_value=[path]), patch.object(
                pathlib.Path, 'read_text', lambda p, *a, **kw: payload if p == path else original(p, *a, **kw)), patch.object(
                pg, 'source_text', return_value='DO $$ BEGIN NULL; END $$;'):
            self.assertEqual(([], {}, 586), module.verified_union())

    def test_partial_branch_never_closes_old_id(self):
        module = self.load()
        self.assertFalse(module.closed({'absent': True, 'present': True, 'replay': False}))
        self.assertFalse(module.closed({'absent': True}))
        self.assertTrue(module.closed({'absent': True, 'present': True, 'replay': True}))

    def test_source_change_rejected(self):
        module = self.load()
        with self.assertRaisesRegex(ValueError, 'source hash'):
            module.plan(source_text='SELECT 1;')

    def test_readiness_excludes_entrypoint_temporary_socket_server(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'readiness_command'), '正式服务 TCP 就绪检查尚未实现')
        args = module.readiness_command('owned-container')
        self.assertIn('--protocol=TCP', args)
        self.assertIn('-h127.0.0.1', args)


if __name__ == '__main__':
    unittest.main()
