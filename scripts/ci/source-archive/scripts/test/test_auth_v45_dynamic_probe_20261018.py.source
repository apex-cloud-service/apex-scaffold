    def test_v16_cleanup_and_status_gate_credit(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_v16'), 'V16专用规划尚未实现')
        for status, removed, expected in (('passed', True, 24), ('passed', False, 0), ('partial_failure', True, 0)):
            def command(args, *unused, **kwargs):
                code = (1 if removed else 0) if args[1:3] == ['container', 'exists'] else 0
                return SimpleNamespace(returncode=code, stdout='8.0.46', stderr='')
            def verify(result, sql):
                for group in result['groups']:
                    group['results'] = {'absent': True, 'present': True, 'replay': True}
                result['status'] = status
            result = module.plan_v16()
            with patch.object(module, 'command', side_effect=command), patch.object(module, 'save'), patch.object(module, 'verify_v16', side_effect=verify):
                self.assertEqual(expected == 24, bool(module.run(result)))
            self.assertEqual(expected, result['coverage']['verified_old_id_count'])

    def test_v59_exact_binding_offsets_and_hash(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_v59'), 'V59专用规划尚未实现')
        result = module.plan_v59()
        self.assertEqual(4, len(result['groups']))
        self.assertEqual({f'old-sql-{i:04d}' for i in range(513, 529)},
                         {i['id'] for i in result['items']})
        self.assertLess(module.v59_expected_indexes().index('sys_user_social\tidx_union_id'),
                        module.v59_expected_indexes().index('sys_user_social\tPRIMARY'))
        text = (ROOT / module.V59).read_text()
        lines = []
        for group in result['groups']:
            self.assertEqual(4, len(group['old_ids']))
            for statement in group['statements']:
                self.assertEqual(statement['sql'], text[statement['start_offset']:statement['end_offset']])
                lines.append(statement['line'])
            self.assertTrue(all(len(ids) == 1 for ids in group['statement_ids']))
        self.assertEqual([15, 23, 24, 25, 28, 34, 35, 36, 72, 80, 81, 82, 84, 92, 93, 94], lines)
        with self.assertRaisesRegex(ValueError, 'source hash'):
            module.plan_v59('SELECT 1;')

    def test_v59_rejects_incorrect_baseline_statement_id(self):
        module = self.load()
        self.assertTrue(hasattr(module, 'plan_v59'), 'V59专用规划尚未实现')
        import json
        baseline = json.loads(module.BASELINE.read_text())
        item = next(i for i in baseline['baseline_audit']['old_sql_items'] if i['id'] == 'old-sql-0513')
        item['statement_ids'] = ['stmt-wrong-offset-or-hash']
        original = pathlib.Path.read_text
        def read_text(path, *args, **kwargs):
            return json.dumps(baseline) if path == module.BASELINE else original(path, *args, **kwargs)
        with patch.object(pathlib.Path, 'read_text', read_text), self.assertRaisesRegex(ValueError, 'statement binding'):
            module.plan_v59()

    def v59_fixture(self, module, mutation=None):
        self.assertTrue(hasattr(module, 'verify_v59'), 'V59专用验证尚未实现')
        result = module.plan_v59()
        counters = {}
        def sql(text):
            counters[text] = counters.get(text, 0) + 1
            n = counters[text]
            if 'SELECT @' in text:
                group = next(g for g in result['groups'] if g['statements'][0]['sql'] in text)
                if n == 4 and group['target']['kind'] == 'index':
                    raise RuntimeError("ERROR 1146 (42S02): Table 'probe.sys_user' doesn't exist")
                return group['absent_sql'] if n == 1 else 'SELECT 1'
            if 'SELECT COLUMN_TYPE,' in text:
                name = next(name for name in ('register_channel', 'client_type', 'platform') if "column_name='" + name + "'" in text)
                expected = 'varchar(32)\tNO\tUNKNOWN' if name == 'register_channel' else 'varchar(32)\tYES\t<NULL>'
                if mutation == 'default' and name == 'register_channel':
                    expected = expected.replace('UNKNOWN', 'BAD')
                if mutation == 'nullable' and name == 'register_channel':
                    expected = expected.replace('NO', 'YES')
                return ('', expected, expected, expected, 'varchar(7)\tYES\t<NULL>', 'varchar(7)\tYES\t<NULL>')[n - 1]
            if 'SELECT INDEX_NAME,' in text:
                expected = 'idx_sys_user_register_channel\t1\t1\tregister_channel\tBTREE'
                return ('', expected, expected, expected, 'idx_sys_user_register_channel\t0\t1\tid\tBTREE', 'idx_sys_user_register_channel\t0\t1\tid\tBTREE')[n - 1]
            if 'information_schema.tables' in text:
                return '0'
            if 'SELECT id FROM' in text:
                return '1'
            if 'SELECT table_name,column_name,' in text:
                return module.v59_expected_columns()
            if 'SELECT table_name,index_name,' in text:
                output = module.v59_expected_indexes()
                return output.replace('\t0\t2\topen_id', '\t0\t2\tid') if mutation == 'index' else output
            if 'SELECT * FROM sys_user_social' in text:
                output = module.v59_expected_social()
                if n == 1:
                    return module.v59_existing_social()
                return output.replace('union-a', 'wrong-union') if mutation == 'backfill' else output
            if 'SELECT * FROM' in text:
                suffix = '\tUNKNOWN' if 'FROM sys_user ' in text else '\tNULL\tNULL'
                if mutation == 'user_data' and n > 1:
                    return 'changed fixture' + suffix
                return 'preserved fixture' + (suffix if n > 1 else '')
            if 'CREATE TABLE IF NOT EXISTS `sys_user_social`' in text and 'SET @ddl_register_channel' in text:
                if 'DROP TABLE sys_user;' in text:
                    raise RuntimeError("ERROR 1146 (42S02): Table 'probe.sys_user' doesn't exist")
            return ''
        return result, sql

    def test_v59_branches_backfill_replay_and_missing_table_failures(self):
        module = self.load()
        result, sql = self.v59_fixture(module)
        with patch.object(module, 'save'):
            module.verify_v59(result, sql)
        self.assertEqual('passed', result['status'])
        self.assertTrue(all(module.closed(g['results']) for g in result['groups']))
        missing = result['groups'][1]['observations']['missing_table']
        self.assertEqual('expected_failure', missing['status'])
        self.assertFalse(missing['passed'])
        self.assertEqual('expected_failure', result['full_file']['missing_table']['status'])
        self.assertFalse(result['full_file']['missing_table']['passed'])
        self.assertEqual(result['full_file']['before_replay'], result['full_file']['after_replay'])
        self.assertIn('PHONE_', result['full_file']['fixture_sql'])
        self.assertIn('DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci', result['full_file']['fixture_sql'].split('CREATE TABLE sys_login_log')[0])
        self.assertIn('SET timestamp=', result['full_file']['execution_prefix'])
        self.assertFalse(result['full_file']['counts_as_branch_proof'])

