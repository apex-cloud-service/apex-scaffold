#!/usr/bin/env python3
"""Bounded auth V45 client probe; only owns its newly created Podman container."""
import argparse
import datetime
import hashlib
import json
import pathlib
import subprocess
import sys
import time
import uuid

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'scripts/ci'))
from collect_table_facts import expand_mysql_guards

P0 = ROOT / 'docs/06-testing/jdk21-unified-auth/20261016-p0'
BASELINE = P0 / 'table-source-facts-20261018-itemized-1905.json'
SOURCE = 'apex-auth-service/src/main/resources/db/migration/mysql/V45__align_auth_domain_fields.sql'
OUTPUT = P0 / 'dynamic-auth-v45-20261018-client-evidence.json'


def closed(results):
    return all(results.get(k) is True for k in ('absent', 'present', 'replay'))


def plan(source_text=None, source=SOURCE):
    baseline = json.loads(BASELINE.read_text())
    items = [i for i in baseline['baseline_audit']['old_sql_items'] if i['source'] == source]
    text = (ROOT / source).read_text() if source_text is None else source_text
    digest = hashlib.sha256(text.encode()).hexdigest()
    if not items or any(i['source_sha256'] != digest for i in items):
        raise ValueError('source hash differs from old ID baseline')
    groups = expand_mysql_guards(text)
    by_line = {i['original']['line']: i for i in items}
    for g in groups:
        g['old_ids'] = [by_line[s['line']]['id'] for s in g['statements']]
        g['statement_ids'] = [by_line[s['line']]['statement_ids'] for s in g['statements']]
        g['results'] = {}
        g['observations'] = {}
    bound = [i for g in groups for i in g['old_ids']]
    if len(bound) != len(set(bound)) or set(bound) != {i['id'] for i in items}:
        raise ValueError('incomplete or duplicate old ID binding')
    return {'schema_version': 1, 'source': source, 'source_sha256': digest,
            'baseline_sha256': hashlib.sha256(BASELINE.read_bytes()).hexdigest(),
            'baseline_dynamic_denominator': 586, 'groups': groups, 'items': items,
            'status': 'planned_not_run', 'cleanup': {'attempted': False},
            'limits': ['Synthetic fixtures, not production data or a full historical upgrade chain',
                       'Only MySQL V45; PostgreSQL and other 490 old items not tested',
                       'Existing-name branch intentionally accepts incompatible definitions; no equivalence claim',
                       'Closure means both explicit IF branches plus replay and catalog checks for these bound IDs only',
                       'Missing-table, privilege denial, concurrent migration and rollback behavior not covered']}


def verified_union():
    baseline_hash = hashlib.sha256(BASELINE.read_bytes()).hexdigest()
    baseline = json.loads(BASELINE.read_text())['baseline_audit']['old_sql_items']
    dynamic = {i['id']: i for i in baseline if i['category'] in ('dynamic_sql', 'procedure_or_prepared_control')}
    verified, hashes = set(), {}
    for path in sorted(P0.glob('dynamic-*-evidence.json')):
        evidence = json.loads(path.read_text())
        if evidence.get('probe_kind') in ('postgresql_p0_do_guard', 'postgresql_p0_remaining', 'postgresql_p0_final_four'):
            from pg_p0_dynamic_probe import verified_ids, verified_remaining_ids, verified_final_four_ids
            try:
                validator = {'postgresql_p0_do_guard': verified_ids,
                             'postgresql_p0_remaining': verified_remaining_ids,
                             'postgresql_p0_final_four': verified_final_four_ids}[evidence['probe_kind']]
                ids = validator(evidence)
            except ValueError:
                continue
            if ids:
                verified.update(ids)
                hashes[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()
            continue
        source = evidence.get('source')
        if (evidence.get('status') != 'passed' or evidence.get('baseline_sha256') != baseline_hash
                or not evidence.get('cleanup', {}).get('container_and_anonymous_volumes_removed')
                or not source or hashlib.sha256((ROOT / source).read_bytes()).hexdigest() != evidence.get('source_sha256')):
            continue
        if source in (V37, V44) and not all(evidence.get('full_file', {}).get(k) is True
                                               for k in ('initial_execution', 'replay')):
            continue
        if source in (V43, V40, V51, V37, V44):
            expected = {V43: plan_v43, V40: plan_v40, V51: plan_v51, V37: plan_v37, V44: plan_v44}[source](include_prior=False)
            if not all(closed(g.get('results', {})) for g in evidence.get('groups', [])):
                continue
            fields = ('target', 'columns', 'old_ids', 'statement_ids', 'statements')
            signature = lambda groups: [{k: g.get(k) for k in fields} for g in groups]
            if signature(evidence.get('groups', [])) != signature(expected['groups']):
                continue
            actual_items = [{k: v for k, v in item.items() if k not in ('verified_in_this_probe', 'unpassed_branches')}
                            for item in evidence.get('items', [])]
            if actual_items != expected['items']:
                continue
        closed_ids = {i for g in evidence.get('groups', []) if closed(g['results']) for i in g['old_ids']}
        flags = {i['id'] for i in evidence.get('items', []) if i.get('verified_in_this_probe')}
        ids = set(evidence.get('coverage', {}).get('verified_old_ids', [])) & closed_ids & flags
        ids = {i for i in ids if i in dynamic and dynamic[i]['source'] == source
               and dynamic[i]['source_sha256'] == evidence['source_sha256']}
        verified.update(ids)
        hashes[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()
    return sorted(verified), hashes, len(dynamic)


def attach_prior(result):
    prior, hashes, denominator = verified_union()
    result.update(previous_verified_ids=prior, remaining_before=denominator - len(prior),
                  previous_evidence_hashes=hashes, baseline_dynamic_denominator=denominator)
    result['limits'][1] = 'Only selected MySQL guards; no PostgreSQL or full historical upgrade chain'
    return result


def plan_next(source):
    return attach_prior(plan(source=source))


V37 = 'apex-system/src/main/resources/db/migration/mysql/V37__add_email_and_keycloak_sub_to_sys_user.sql'
V44 = 'apex-system/src/main/resources/db/migration/mysql/V44__initialize_default_tenant.sql'


def plan_bound_source(source, count, source_text=None):
    from collect_table_facts import statement_inventory
    text = (ROOT / source).read_text() if source_text is None else source_text
    items = [i for i in json.loads(BASELINE.read_text())['baseline_audit']['old_sql_items']
             if i['source'] == source and i['category'] in ('dynamic_sql', 'procedure_or_prepared_control')]
    digest = hashlib.sha256(text.encode()).hexdigest()
    if len(items) != count or any(i['source_sha256'] != digest for i in items):
        raise ValueError('source hash differs from old ID baseline')
    statements = []
    for item in items:
        matches = [s for s in statement_inventory(text, 'mysql') if s['line'] == item['original']['line']]
        if len(matches) != 1:
            raise ValueError('statement binding is ambiguous')
        statement = matches[0]
        identity = f"{source}:{statement['start_offset']}:{statement['end_offset']}:{statement['statement_sha256']}"
        statement['statement_id'] = 'stmt-' + hashlib.sha256(identity.encode()).hexdigest()[:24]
        if item['statement_ids'] != [statement['statement_id']]:
            raise ValueError('statement binding differs from baseline offset/hash')
        statements.append(statement)
    group = {'target': {'kind': 'source', 'name': source}, 'statements': statements,
             'old_ids': [i['id'] for i in items], 'statement_ids': [i['statement_ids'] for i in items],
             'results': {}, 'observations': {}}
    return {'schema_version': 1, 'source': source, 'source_sha256': digest,
            'baseline_sha256': hashlib.sha256(BASELINE.read_bytes()).hexdigest(),
            'items': items, 'groups': [group], 'status': 'planned_not_run', 'cleanup': {'attempted': False},
            'limits': ['Synthetic nonempty fixtures; not a historical upgrade chain', '',
                       'No Flyway startup, concurrent migration, privileges or production verification']}


def plan_v37(source_text=None, include_prior=True):
    result = plan_bound_source(V37, 15, source_text)
    statements = result['groups'][0]['statements']
    result['groups'] = [dict(target={'table': 'sys_user', 'kind': kind, 'name': name},
                             statements=statements[n:n + 5],
                             old_ids=[i['id'] for i in result['items'][n:n + 5]],
                             statement_ids=[i['statement_ids'] for i in result['items'][n:n + 5]],
                             results={}, observations={})
                        for n, kind, name in ((0, 'column', 'email'), (5, 'column', 'keycloak_sub'), (10, 'index', 'uk_keycloak_sub'))]
    return attach_prior(result) if include_prior else result


def verify_v37(result, sql):
    fixture = ("USE probe; DROP TABLE IF EXISTS sys_user; CREATE TABLE sys_user(id BIGINT PRIMARY KEY,phone VARCHAR(64));"
               " INSERT INTO sys_user VALUES(1,'中文电话'),(2,'kept');")
    data_query = 'USE probe; SELECT id,phone FROM sys_user ORDER BY id;'
    column_query = ("SELECT COLUMN_NAME,COLUMN_TYPE,IS_NULLABLE,COALESCE(COLUMN_DEFAULT,'<NULL>'),ORDINAL_POSITION,COLUMN_COMMENT "
                    "FROM information_schema.columns WHERE table_schema='probe' AND table_name='sys_user' ORDER BY ordinal_position;")
    index_query = ("SELECT INDEX_NAME,NON_UNIQUE,SEQ_IN_INDEX,COLUMN_NAME,INDEX_TYPE FROM information_schema.statistics "
                   "WHERE table_schema='probe' AND table_name='sys_user' ORDER BY INDEX_NAME,SEQ_IN_INDEX;")
    base_columns = 'id\tbigint\tNO\t<NULL>\t1\t\nphone\tvarchar(64)\tYES\t<NULL>\t2\t'
    email = '\nemail\tvarchar(100)\tYES\t<NULL>\t3\t用户邮箱'
    sub = '\nkeycloak_sub\tvarchar(100)\tYES\t<NULL>\t4\tKeycloak用户唯一标识'
    primary = 'PRIMARY\t0\t1\tid\tBTREE'
    full = (ROOT / V37).read_text()
    for group in result['groups']:
        name, kind = group['target']['name'], group['target']['kind']
        statements = group['statements']
        body = full[statements[0]['start_offset']:statements[-1]['end_offset']] + ';'
        setup = fixture
        if name != 'email':
            setup += ' ALTER TABLE sys_user ADD COLUMN email VARCHAR(100) NULL COMMENT \'用户邮箱\' AFTER phone;'
        if kind == 'index':
            setup += " ALTER TABLE sys_user ADD COLUMN keycloak_sub VARCHAR(100) NULL COMMENT 'Keycloak用户唯一标识' AFTER email;"
        expected_columns = base_columns + email + (sub if name != 'email' else '')
        expected_indexes = primary + ('\nuk_keycloak_sub\t0\t1\tkeycloak_sub\tBTREE' if kind == 'index' else '')
        for branch in ('absent', 'replay', 'present'):
            branch_setup = setup
            if branch == 'present':
                branch_setup += (' ALTER TABLE sys_user ADD UNIQUE INDEX uk_keycloak_sub(id);' if kind == 'index' else
                                 f" ALTER TABLE sys_user ADD COLUMN {name} VARCHAR(7) NOT NULL DEFAULT 'legacy';")
            if branch != 'replay':
                sql(branch_setup)
            before = {'columns': sql(column_query), 'indexes': sql(index_query), 'data': sql(data_query)}
            sql('USE probe; ' + body)
            after = {'columns': sql(column_query), 'indexes': sql(index_query), 'data': sql(data_query)}
            assert after['data'] == before['data'] == '1\t中文电话\n2\tkept', after
            if branch == 'present':
                assert before == after, 'present-name guard changed existing definition or data'
                assert ('uk_keycloak_sub\t0\t1\tid\tBTREE' in after['indexes'] if kind == 'index' else
                        f'{name}\tvarchar(7)\tNO\tlegacy' in after['columns']), after
            else:
                assert after['columns'] == expected_columns, after
                assert after['indexes'] == expected_indexes, after
                if branch == 'replay':
                    assert before == after, 'guard replay changed schema/data'
            group['results'][branch] = True
            group['observations'][branch] = {'fixture_sql': branch_setup if branch != 'replay' else 'reuse absent result',
                                              'executed_sql': body, 'before': before, 'after': after}
        save(result)
    sql(fixture)
    sql('USE probe; ' + full)
    assert sql(column_query) == base_columns + email + sub, sql(column_query)
    assert sql(index_query) == primary + '\nuk_keycloak_sub\t0\t1\tkeycloak_sub\tBTREE', sql(index_query)
    assert sql(data_query) == '1\t中文电话\n2\tkept'
    sql("USE probe; UPDATE sys_user SET email='person@example.test',keycloak_sub='retained-sub' WHERE id=1;")
    snapshot = lambda: {'columns': sql(column_query), 'indexes': sql(index_query), 'data': sql('USE probe; SELECT * FROM sys_user ORDER BY id;')}
    first = snapshot()
    sql('USE probe; ' + full)
    second = snapshot()
    assert first == second, 'full-file replay changed structure or nonempty data'
    result['full_file'] = {'fixture_sql': fixture, 'initial_execution': True, 'replay': True,
                           'before_replay': first, 'after_replay': second}
    verify_v37_refusals(result, sql)
    result['status'] = 'passed'


def verify_v37_refusals(result, sql):
    full = (ROOT / V37).read_text()
    statements = result['groups'][2]['statements']
    index_body = full[statements[0]['start_offset']:statements[-1]['end_offset']] + ';'
    cases = (
        ('missing_table', 'USE probe; DROP TABLE IF EXISTS sys_user;', full, '1146', False),
        ('missing_phone', 'USE probe; DROP TABLE IF EXISTS sys_user; CREATE TABLE sys_user(id BIGINT PRIMARY KEY); INSERT INTO sys_user VALUES(1),(2);', full, '1054', True),
        ('duplicate_sub', "USE probe; DROP TABLE IF EXISTS sys_user; CREATE TABLE sys_user(id BIGINT PRIMARY KEY,phone VARCHAR(64),email VARCHAR(100),keycloak_sub VARCHAR(100)); INSERT INTO sys_user VALUES(1,'中文',NULL,'duplicate'),(2,'kept',NULL,'duplicate');", index_body, '1062', True))
    observations = []
    for name, setup, body, error_code, has_table in cases:
        sql(setup)
        def snapshot():
            return {'columns': sql("SELECT COLUMN_NAME,COLUMN_TYPE,IS_NULLABLE FROM information_schema.columns WHERE table_schema='probe' AND table_name='sys_user' ORDER BY ORDINAL_POSITION;"),
                    'indexes': sql("SELECT INDEX_NAME,NON_UNIQUE,COLUMN_NAME FROM information_schema.statistics WHERE table_schema='probe' AND table_name='sys_user' ORDER BY INDEX_NAME,SEQ_IN_INDEX;"),
                    'data': sql('USE probe; SELECT * FROM sys_user ORDER BY id;') if has_table else None}
        before = snapshot()
        try:
            sql('USE probe; ' + body)
        except RuntimeError as exc:
            assert 'ERROR ' + error_code in str(exc), str(exc)
            after = snapshot()
            assert before == after, 'V37 refusal changed schema or data'
            observations.append({'case': name, 'fixture_sql': setup, 'executed_sql': body,
                                 'error': str(exc), 'before': before, 'after': after})
        else:
            raise AssertionError('expected V37 refusal: ' + name)
    result['refusal_checks'] = observations


def v44_fixture():
    return '''USE probe;
DROP TABLE IF EXISTS sys_tenant,sys_user,sys_dept,sys_user_role,sys_role_dept;
CREATE TABLE sys_tenant(id BIGINT PRIMARY KEY,tenant_code VARCHAR(64),tenant_name VARCHAR(100),status VARCHAR(20),admin_user_id VARCHAR(64),create_time DATETIME,update_time DATETIME,version INT,deleted INT);
CREATE TABLE sys_user(id BIGINT PRIMARY KEY,username VARCHAR(64),status INT,tenant_id VARCHAR(64),dept_id BIGINT,create_time DATETIME,update_time DATETIME,version INT,deleted INT);
CREATE TABLE sys_dept(id BIGINT PRIMARY KEY,parent_id BIGINT,ancestors VARCHAR(100),name VARCHAR(100),order_num INT,status INT,tenant_id VARCHAR(64),create_time DATETIME,update_time DATETIME,version INT,deleted INT);
CREATE TABLE sys_user_role(id BIGINT PRIMARY KEY,user_id BIGINT,role_id BIGINT,tenant_id VARCHAR(64),create_time DATETIME,update_time DATETIME,version INT,deleted INT);
CREATE TABLE sys_role_dept(id BIGINT PRIMARY KEY,role_id BIGINT,dept_id BIGINT,tenant_id VARCHAR(64),create_time DATETIME,update_time DATETIME,version INT,deleted INT);
INSERT INTO sys_user VALUES(7,'admin',1,NULL,NULL,'2020-01-01','2020-01-01',3,0),(8,'中文用户',1,'preserved',9,'2020-01-01','2020-01-01',4,0);
INSERT INTO sys_dept VALUES(9,0,'0','保留部门',2,1,'preserved','2020-01-01','2020-01-01',5,0);
INSERT INTO sys_user_role VALUES(10,7,2,NULL,'2020-01-01','2020-01-01',6,0),(11,8,3,'preserved','2020-01-01','2020-01-01',7,0);
INSERT INTO sys_role_dept VALUES(20,3,9,'preserved','2020-01-01','2020-01-01',8,0);
'''


def verify_v44(result, sql):
    full = (ROOT / V44).read_text()
    group = result['groups'][0]
    fixture = v44_fixture()
    tables = ('sys_tenant', 'sys_user', 'sys_dept', 'sys_user_role', 'sys_role_dept')
    catalog_query = ("SELECT TABLE_NAME,COLUMN_NAME,COLUMN_TYPE,IS_NULLABLE,COALESCE(COLUMN_DEFAULT,'<NULL>'),ORDINAL_POSITION "
                     "FROM information_schema.columns WHERE table_schema='probe' ORDER BY TABLE_NAME,ORDINAL_POSITION;")
    index_query = ("SELECT TABLE_NAME,INDEX_NAME,NON_UNIQUE,SEQ_IN_INDEX,COLUMN_NAME,INDEX_TYPE "
                   "FROM information_schema.statistics WHERE table_schema='probe' ORDER BY TABLE_NAME,INDEX_NAME,SEQ_IN_INDEX;")
    def snapshot():
        return {table: sql('USE probe; SELECT * FROM ' + table + ' ORDER BY id;') for table in tables}
    def execute():
        return sql('USE probe; SET timestamp=1767225600;\n' + full)
    expected = ('apex-default\tApex 默认租户\tACTIVE\t7\t0\t0\n'
                '7\tadmin\tapex-default\t1\t3\n8\t中文用户\tpreserved\t9\t4\n'
                '1\t0\t0\tApex 科技\tapex-default\t0\n9\t0\t0\t保留部门\tpreserved\t5\n'
                '10\t7\t2\tapex-default\t6\n11\t8\t3\tpreserved\t7\n'
                '20\t3\t9\tpreserved\t8\n21\t2\t1\tapex-default\t0')
    projection = '''USE probe;
SELECT tenant_code,tenant_name,status,admin_user_id,version,deleted FROM sys_tenant ORDER BY id;
SELECT id,username,tenant_id,dept_id,version FROM sys_user ORDER BY id;
SELECT id,parent_id,ancestors,name,tenant_id,version FROM sys_dept ORDER BY id;
SELECT id,user_id,role_id,tenant_id,version FROM sys_user_role ORDER BY id;
SELECT id,role_id,dept_id,tenant_id,version FROM sys_role_dept ORDER BY id;'''
    for branch in ('absent', 'present'):
        setup = fixture
        if branch == 'present':
            setup += ("INSERT INTO sys_tenant VALUES(42,'apex-default','old','DISABLED',NULL,'2020-01-01','2020-01-01',0,0);"
                      "INSERT INTO sys_dept VALUES(1,0,'0','Apex 科技',1,1,'apex-default','2020-01-01','2020-01-01',0,0);"
                      "INSERT INTO sys_role_dept VALUES(21,2,1,NULL,'2020-01-01','2020-01-01',0,0);")
        sql(setup)
        before_catalog, before_indexes = sql(catalog_query), sql(index_query)
        assert before_catalog and before_indexes, 'fixture catalog missing'
        before = snapshot()
        assert before['sys_user'] and before['sys_dept'] and before['sys_user_role'] and before['sys_role_dept'], 'fixture data missing'
        execute()
        assert sql(projection) == expected, sql(projection)
        assert sql('USE probe; SELECT id FROM sys_tenant;') == ('42' if branch == 'present' else '1')
        assert sql(catalog_query) == before_catalog and sql(index_query) == before_indexes, 'migration changed schema'
        assert sql("SELECT COUNT(*) FROM information_schema.routines WHERE routine_schema='probe';") == '0'
        first = snapshot()
        execute()
        second = snapshot()
        assert first == second, 'full original file replay changed retained IDs/data/timestamps'
        group['results'][branch] = True
        group['observations'][branch] = {'fixture_sql': setup, 'before': before, 'after': first,
                                          'catalog': before_catalog, 'indexes': before_indexes,
                                          'after_replay': second, 'projection': expected}
    refusals = (
        ("INSERT INTO sys_tenant(id,tenant_code,deleted) VALUES(2,'other',0);", 'another active tenant'),
        ("INSERT INTO sys_tenant(id,tenant_code,deleted) VALUES(2,'apex-default',0),(3,'apex-default',0);", 'duplicate active'),
        ("UPDATE sys_user SET status=0 WHERE username='admin';", 'exactly one active admin'),
        ("UPDATE sys_user SET tenant_id=NULL WHERE id=8;", 'unassigned non-admin users'),
        ("INSERT INTO sys_dept(id,parent_id,ancestors,name,tenant_id) VALUES(1,0,'0','conflict','preserved');", 'default root'),
        ("UPDATE sys_dept SET tenant_id=NULL WHERE id=9;", 'unassigned departments'),
        ("UPDATE sys_user_role SET tenant_id=NULL WHERE user_id=8;", 'unassigned roles'),
        ("INSERT INTO sys_role_dept(id,role_id,dept_id,tenant_id,deleted) VALUES(30,4,99,NULL,0);", 'ambiguous role department'))
    group['observations']['refusal_guards'] = []
    for mutation, message in refusals:
        sql(fixture + mutation)
        before = snapshot()
        try:
            execute()
        except RuntimeError as exc:
            assert 'ERROR 1644' in str(exc) and message in str(exc), str(exc)
            observation = {'mutation_sql': mutation, 'error': str(exc), 'before': before, 'after': snapshot()}
            assert observation['before'] == observation['after'], 'refusal changed persistent data'
            group['observations']['refusal_guards'].append(observation)
        else:
            raise AssertionError('expected V44 refusal: ' + message)
        sql('USE probe; DROP PROCEDURE IF EXISTS initialize_default_tenant;')
    group['results']['replay'] = True
    result['full_file'] = {'initial_execution': True, 'replay': True, 'original_file_used': True,
                           'tenant_paths': 2, 'refusal_guards': len(refusals), 'timestamp_fixed_for_comparison': 1767225600}
    result['status'] = 'passed'
    save(result)


def plan_v44(source_text=None, include_prior=True):
    result = plan_bound_source(V44, 32, source_text)
    result['limits'].append('One source-level closure requires all eight refusal guards and both tenant initialization paths')
    return attach_prior(result) if include_prior else result


V51 = 'apex-system/src/main/resources/db/migration/mysql/V51__add_keycloak_fields.sql'


def plan_v51(source_text=None, include_prior=True):
    from collect_table_facts import statement_inventory
    import re
    text = (ROOT / V51).read_text() if source_text is None else source_text
    items = [i for i in json.loads(BASELINE.read_text())['baseline_audit']['old_sql_items']
             if i['source'] == V51 and i['category'] in ('dynamic_sql', 'procedure_or_prepared_control')]
    digest = hashlib.sha256(text.encode()).hexdigest()
    if len(items) != 8 or any(i['source_sha256'] != digest for i in items):
        raise ValueError('source hash differs from old ID baseline')
    rows = statement_inventory(text, 'mysql')
    groups = []
    for offset, kind, name in ((1, 'column', 'email'), (5, 'index', 'idx_email')):
        statements = rows[offset:offset + 4]
        bound = []
        for statement in statements:
            identity = f"{V51}:{statement['start_offset']}:{statement['end_offset']}:{statement['statement_sha256']}"
            statement['statement_id'] = 'stmt-' + hashlib.sha256(identity.encode()).hexdigest()[:24]
            matches = [i for i in items if i['original']['line'] == statement['line']
                       and i['statement_ids'] == [statement['statement_id']]]
            if len(matches) != 1:
                raise ValueError('statement binding differs from baseline line/offset/hash')
            bound.append(matches[0])
        literals = re.findall(r"'((?:''|[^'])*)'", statements[0]['sql'])
        alternatives = [s.replace("''", "'") for s in literals if s.startswith(('ALTER TABLE', 'SELECT '))]
        if len(alternatives) != 2:
            raise ValueError('unexpected V51 branch binding')
        groups.append({'target': {'table': 'sys_user', 'kind': kind, 'name': name},
                       'variable': 'sql', 'absent_sql': alternatives[0], 'present_sql': alternatives[1],
                       'statements': statements, 'old_ids': [i['id'] for i in bound],
                       'statement_ids': [i['statement_ids'] for i in bound], 'results': {}, 'observations': {}})
    if {i for g in groups for i in g['old_ids']} != {i['id'] for i in items}:
        raise ValueError('incomplete old ID binding')
    result = {'schema_version': 1, 'source': V51, 'source_sha256': digest,
              'baseline_sha256': hashlib.sha256(BASELINE.read_bytes()).hexdigest(),
              'items': items, 'groups': groups, 'status': 'planned_not_run', 'cleanup': {'attempted': False},
              'limits': ['Synthetic fixtures only; no production data or full historical upgrade chain', '',
                         'Existing-name guards accept incompatible definitions; no equivalence claim',
                         'Missing table or required source column produces actual errors, not successful migration',
                         'No PostgreSQL, Flyway startup, concurrency, privileges or rollback verification']}
    return attach_prior(result) if include_prior else result


def v51_expected_columns():
    return '\n'.join(('sys_user\tid\tbigint\tNO\t<NULL>\t1',
                      'sys_user\tphone\tvarchar(64)\tYES\t<NULL>\t2',
                      'sys_user\temail\tvarchar(255)\tYES\t<NULL>\t3',
                      'sys_user\tkeycloak_sub\tvarchar(255)\tYES\t<NULL>\t4'))


def v51_expected_indexes():
    return 'sys_user\tidx_email\t1\t1\temail\tBTREE\nsys_user\tPRIMARY\t0\t1\tid\tBTREE'


def verify_v51(result, sql):
    fixture = ("USE probe; DROP TABLE IF EXISTS sys_user; CREATE TABLE sys_user(id BIGINT PRIMARY KEY,"
               "phone VARCHAR(64),keycloak_sub VARCHAR(100)); INSERT INTO sys_user VALUES(1,'中文电话','legacy-sub');")
    stable_query = 'USE probe; SELECT id,phone,keycloak_sub FROM sys_user ORDER BY id;'
    def expected_error(text, code):
        try:
            sql(text)
        except RuntimeError as exc:
            assert 'ERROR ' + str(code) in str(exc), str(exc)
            return {'status': 'expected_failure', 'passed': False, 'error': str(exc), 'sql': text}
        raise AssertionError('expected MySQL ERROR ' + str(code))
    for g in result['groups']:
        kind, name = g['target']['kind'], g['target']['name']
        assignment = g['statements'][0]['sql'] + '; SELECT @sql; '
        controls = ';\n'.join(s['sql'] for s in g['statements'][1:]) + ';'
        execute = 'USE probe; ' + assignment + controls
        query = ("SELECT COLUMN_TYPE,IS_NULLABLE,COALESCE(COLUMN_DEFAULT,'<NULL>'),ORDINAL_POSITION "
                 "FROM information_schema.columns WHERE table_schema='probe' AND table_name='sys_user' AND column_name='email';"
                 if kind == 'column' else
                 "SELECT INDEX_NAME,NON_UNIQUE,SEQ_IN_INDEX,COLUMN_NAME,INDEX_TYPE FROM information_schema.statistics "
                 "WHERE table_schema='probe' AND table_name='sys_user' AND index_name='idx_email' ORDER BY SEQ_IN_INDEX;")
        expected = 'varchar(255)\tYES\t<NULL>\t3' if kind == 'column' else 'idx_email\t1\t1\temail\tBTREE'
        incompatible = 'varchar(7)\tNO\tlegacy\t4' if kind == 'column' else 'idx_email\t0\t1\tid\tBTREE'
        for branch in ('absent', 'replay', 'present'):
            setup = fixture
            if kind == 'index':
                setup += ' ALTER TABLE sys_user ADD COLUMN email VARCHAR(255) NULL AFTER phone;'
            if branch == 'present':
                setup += (" ALTER TABLE sys_user ADD COLUMN email VARCHAR(7) NOT NULL DEFAULT 'legacy';" if kind == 'column'
                          else ' ALTER TABLE sys_user ADD UNIQUE INDEX idx_email(id);')
            if branch != 'replay':
                sql(setup)
            before = sql(query)
            data_before = sql(stable_query)
            selected = sql(execute).splitlines()[0]
            after = sql(query)
            assert selected == g['absent_sql' if branch == 'absent' else 'present_sql'], selected
            assert after == (incompatible if branch == 'present' else expected), after
            if branch == 'absent':
                assert before == '', before
            else:
                assert before == after, 'no-op changed catalog'
            assert sql(stable_query) == data_before == '1\t中文电话\tlegacy-sub'
            g['results'][branch] = True
            g['observations'][branch] = {'fixture_sql': setup if branch != 'replay' else 'reuse absent result',
                                         'selected_sql': selected, 'before': before, 'after': after,
                                         'data_before': data_before, 'data_after': sql(stable_query)}
        sql('USE probe; DROP TABLE sys_user;')
        g['observations']['missing_table'] = expected_error(execute, 1146)
        assert sql("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='probe' AND table_name='sys_user';") == '0'
        missing_fixture = ('USE probe; CREATE TABLE sys_user(id BIGINT PRIMARY KEY,keycloak_sub VARCHAR(100));'
                           " INSERT INTO sys_user VALUES(1,'legacy-sub');")
        sql(missing_fixture)
        g['observations']['missing_source_column'] = expected_error(execute, 1054 if kind == 'column' else 1072)
        g['observations']['missing_source_column']['fixture_sql'] = missing_fixture
        g['semantic_verified'] = closed(g['results'])
        save(result)
    full = (ROOT / V51).read_text()
    sql(fixture)
    before = sql(stable_query)
    sql('USE probe;\n' + full)
    columns = "SELECT table_name,column_name,column_type,is_nullable,COALESCE(column_default,'<NULL>'),ordinal_position FROM information_schema.columns WHERE table_schema='probe' AND table_name='sys_user' ORDER BY ordinal_position;"
    indexes = "SELECT table_name,index_name,non_unique,seq_in_index,column_name,index_type FROM information_schema.statistics WHERE table_schema='probe' AND table_name='sys_user' ORDER BY index_name,seq_in_index;"
    assert sql(columns) == v51_expected_columns(), sql(columns)
    assert sql(indexes) == v51_expected_indexes(), sql(indexes)
    assert sql(stable_query) == before == '1\t中文电话\tlegacy-sub'
    sql("USE probe; UPDATE sys_user SET email='person@example.test';")
    comment = "SELECT TABLE_COMMENT FROM information_schema.tables WHERE table_schema='probe' AND table_name='sys_user';"
    snapshot = lambda: {'columns': sql(columns), 'indexes': sql(indexes), 'data': sql('USE probe; SELECT * FROM sys_user ORDER BY id;'), 'comment': sql(comment)}
    first = snapshot()
    assert first['comment'] == '系统用户表（支持本地JWT认证和Keycloak SSO认证）'
    sql('USE probe;\n' + full)
    second = snapshot()
    assert first == second, 'full-file replay changed schema/data/comment'
    result['full_file'] = {'fixture_sql': fixture, 'before_initial': before, 'before_replay': first,
                           'after_replay': second, 'initial_execution': True, 'replay': True, 'counts_as_branch_proof': False}
    result['full_file']['missing_table'] = expected_error('USE probe; DROP TABLE sys_user;\n' + full, 1146)
    result['full_file']['missing_keycloak_sub'] = expected_error(
        'USE probe; DROP TABLE IF EXISTS sys_user; CREATE TABLE sys_user(id BIGINT PRIMARY KEY,phone VARCHAR(64)); INSERT INTO sys_user VALUES(1,\'kept\');\n' + full, 1054)
    result['status'] = 'passed' if all(closed(g['results']) for g in result['groups']) else 'partial_failure'


V55 = 'apex-auth-service/src/main/resources/db/migration/mysql/V55__auth_user_account_binding.sql'
V55_COLUMN = 'bigint\tYES\t<NULL>\t\t统一账户ID(sys_user.id，主应用账户体系)'
V55_INDEX = 'idx_auth_user_account_id\t1\t1\taccount_id\tBTREE\t<NULL>\tA\tYES'


def plan_v55(source_text=None):
    from collect_table_facts import statement_inventory
    text = (ROOT / V55).read_text() if source_text is None else source_text
    items = [i for i in json.loads(BASELINE.read_text())['baseline_audit']['old_sql_items'] if i['source'] == V55]
    digest = hashlib.sha256(text.encode()).hexdigest()
    if any(i['source_sha256'] != digest for i in items):
        raise ValueError('source hash differs from old ID baseline')
    rows = statement_inventory(text, 'mysql')
    groups = []
    for offset, kind, name, variable in ((0, 'column', 'account_id', 'ddl_account_id'),
                                       (4, 'index', 'idx_auth_user_account_id', 'ddl_account_idx')):
        statements = rows[offset:offset + 4]
        bound = [next(i for i in items if i['original']['line'] == s['line']) for s in statements]
        groups.append({'target': {'table': 'auth_user', 'kind': kind, 'name': name},
                       'variable': variable, 'statements': statements,
                       'old_ids': [i['id'] for i in bound], 'statement_ids': [i['statement_ids'] for i in bound],
                       'results': {}, 'observations': {}})
    assert len(items) == 8 and len({i for g in groups for i in g['old_ids']}) == 8
    return attach_prior({'schema_version': 1, 'source': V55, 'source_sha256': digest,
                         'baseline_sha256': hashlib.sha256(BASELINE.read_bytes()).hexdigest(),
                         'items': items, 'groups': groups, 'status': 'planned_not_run',
                         'cleanup': {'attempted': False},
                         'limits': ['Synthetic fixtures only; no full upgrade chain', '',
                                    'Existing names accept incompatible definitions; no equivalence claim',
                                    'Missing-table index creation fails; not all scenarios pass',
                                    'No PostgreSQL, Java, Flyway, concurrency, privileges or rollback verification']})


V59 = 'apex-system/src/main/resources/db/migration/mysql/V59__multi_client_account.sql'
V59_TIME = '2026-01-02 03:04:05'


def plan_v59(source_text=None):
    from collect_table_facts import statement_inventory
    import re
    text = (ROOT / V59).read_text() if source_text is None else source_text
    items = [i for i in json.loads(BASELINE.read_text())['baseline_audit']['old_sql_items']
             if i['source'] == V59 and i['category'] in ('dynamic_sql', 'procedure_or_prepared_control')]
    digest = hashlib.sha256(text.encode()).hexdigest()
    if len(items) != 16 or any(i['source_sha256'] != digest for i in items):
        raise ValueError('source hash differs from old ID baseline')
    rows = statement_inventory(text, 'mysql')
    groups = []
    targets = ((0, 'sys_user', 'column', 'register_channel'),
               (4, 'sys_user', 'index', 'idx_sys_user_register_channel'),
               (10, 'sys_login_log', 'column', 'client_type'),
               (14, 'sys_login_log', 'column', 'platform'))
    for offset, table, kind, name in targets:
        statements = rows[offset:offset + 4]
        bound = [next(i for i in items if i['original']['line'] == s['line']) for s in statements]
        for statement, item in zip(statements, bound):
            identity = f"{V59}:{statement['start_offset']}:{statement['end_offset']}:{statement['statement_sha256']}"
            statement['statement_id'] = 'stmt-' + hashlib.sha256(identity.encode()).hexdigest()[:24]
            if item['statement_ids'] != [statement['statement_id']]:
                raise ValueError('statement binding differs from baseline offset/hash')
        literals = re.findall(r"'((?:''|[^'])*)'", statements[0]['sql'])
        absent = next(s.replace("''", "'") for s in literals if s.startswith(('ALTER TABLE', 'CREATE INDEX')))
        groups.append({'target': {'table': table, 'kind': kind, 'name': name},
                       'variable': re.match(r'SET\s+@(\w+)', statements[0]['sql'])[1],
                       'absent_sql': absent, 'present_sql': 'SELECT 1', 'statements': statements,
                       'old_ids': [i['id'] for i in bound], 'statement_ids': [i['statement_ids'] for i in bound],
                       'results': {}, 'observations': {}})
    assert {i for g in groups for i in g['old_ids']} == {i['id'] for i in items}
    return attach_prior({'schema_version': 1, 'source': V59, 'source_sha256': digest,
                         'baseline_sha256': hashlib.sha256(BASELINE.read_bytes()).hexdigest(),
                         'items': items, 'groups': groups, 'status': 'planned_not_run',
                         'cleanup': {'attempted': False},
                         'limits': ['Synthetic fixtures only; not production multitenant safety proof', '',
                                    'Existing names accept incompatible definitions; no equivalence claim',
                                    'Index guard and full file fail without sys_user (1146); these scenarios are not passed',
                                    'Global (channel,open_id) uniqueness and NOT EXISTS omit tenant scope; no production tenant isolation claim',
                                    'Full-file fixture uses utf8mb4_unicode_ci compatible with new social table; default utf8mb4_0900_ai_ci user fixture failed with real 1267 in retained first evidence',
                                    'No PostgreSQL, full upgrade chain, Flyway, concurrency, privileges or rollback verification']})


def v59_expected_columns():
    definitions = {
        'sys_user': [('id', 'bigint', 'NO', '<NULL>', ''), ('tenant_id', 'varchar(64)', 'YES', '<NULL>', ''),
                     ('open_id', 'varchar(100)', 'YES', '<NULL>', ''), ('union_id', 'varchar(100)', 'YES', '<NULL>', ''),
                     ('deleted', 'int', 'YES', '0', ''), ('create_time', 'datetime', 'YES', '<NULL>', ''),
                     ('register_channel', 'varchar(32)', 'NO', 'UNKNOWN', '')],
        'sys_login_log': [('id', 'bigint', 'NO', '<NULL>', ''), ('client_type', 'varchar(32)', 'YES', '<NULL>', ''),
                          ('platform', 'varchar(32)', 'YES', '<NULL>', '')],
        'sys_user_social': [('id', 'bigint', 'NO', '<NULL>', ''), ('tenant_id', 'varchar(64)', 'YES', '<NULL>', ''),
                            ('user_id', 'bigint', 'NO', '<NULL>', ''), ('channel', 'varchar(32)', 'NO', '<NULL>', ''),
                            ('open_id', 'varchar(100)', 'NO', '<NULL>', ''), ('union_id', 'varchar(100)', 'YES', '<NULL>', ''),
                            ('status', 'int', 'NO', '1', ''), ('bound_at', 'datetime', 'NO', 'CURRENT_TIMESTAMP', 'DEFAULT_GENERATED'),
                            ('create_time', 'datetime', 'NO', 'CURRENT_TIMESTAMP', 'DEFAULT_GENERATED'),
                            ('update_time', 'datetime', 'NO', 'CURRENT_TIMESTAMP', 'DEFAULT_GENERATED on update CURRENT_TIMESTAMP'),
                            ('version', 'int', 'NO', '0', ''), ('deleted', 'int', 'NO', '0', '')]}
    return '\n'.join('\t'.join((table, name, typ, nullable, default, extra, str(n)))
                     for table in sorted(definitions) for n, (name, typ, nullable, default, extra) in enumerate(definitions[table], 1))


def v59_expected_indexes():
    definitions = {'sys_login_log': [('PRIMARY', 0, ('id',))],
                   'sys_user': [('PRIMARY', 0, ('id',)), ('idx_sys_user_register_channel', 1, ('register_channel',))],
                   'sys_user_social': [('PRIMARY', 0, ('id',)), ('idx_union_id', 1, ('union_id',)),
                                       ('idx_user_id', 1, ('user_id',)), ('uk_channel_openid', 0, ('channel', 'open_id'))]}
    return '\n'.join('\t'.join((table, name, str(unique), str(n), column, 'BTREE'))
                     for table in sorted(definitions) for name, unique, cols in sorted(definitions[table], key=lambda row: row[0].lower())
                     for n, column in enumerate(cols, 1))


def v59_existing_social():
    return '\n'.join('\t'.join(map(str, row)) for row in (
        (90, 'original-tenant', 900, 'WECHAT_APP', 'o-existing', 'original-union', 0, '2020-01-01 00:00:00', V59_TIME, V59_TIME, 7, 1),
        (91, 'mini-tenant', 901, 'WECHAT_MINI', 'o-valid-a', 'mini-union', 1, '2020-01-01 00:00:00', V59_TIME, V59_TIME, 0, 0)))


def v59_expected_social():
    rows = [(1, 'tenant-a', 'o-valid-a', 'union-a', '2021-02-03 04:05:06'),
            (2, 'tenant-b', 'o-valid-b', 'NULL', '2022-03-04 05:06:07'),
            (6, 'NULL', 'o-null-time', 'union-six', V59_TIME),
            (7, 'tenant-c', 'PHONEXvalid', 'union-seven', V59_TIME)]
    return '\n'.join('\t'.join(map(str, (i, tenant, i, 'WECHAT_APP', oid, union, 1, bound, V59_TIME, V59_TIME, 0, 0)))
                     for i, tenant, oid, union, bound in rows) + '\n' + v59_existing_social()


def verify_v59(result, sql):
    from collect_table_facts import statement_inventory
    full = (ROOT / V59).read_text()
    for g in result['groups']:
        table, kind, name = (g['target'][k] for k in ('table', 'kind', 'name'))
        body = ';\n'.join(s['sql'] for s in g['statements']) + ';'
        query = ("SELECT COLUMN_TYPE,IS_NULLABLE,COALESCE(COLUMN_DEFAULT,'<NULL>') FROM information_schema.columns "
                 "WHERE table_schema='probe' AND table_name='" + table + "' AND column_name='" + name + "';" if kind == 'column' else
                 "SELECT INDEX_NAME,NON_UNIQUE,SEQ_IN_INDEX,COLUMN_NAME,INDEX_TYPE FROM information_schema.statistics "
                 "WHERE table_schema='probe' AND table_name='" + table + "' AND index_name='" + name + "' ORDER BY SEQ_IN_INDEX;")
        expected = ('varchar(32)\tNO\tUNKNOWN' if name == 'register_channel' else 'varchar(32)\tYES\t<NULL>') if kind == 'column' else name + '\t1\t1\tregister_channel\tBTREE'
        incompatible = 'varchar(7)\tYES\t<NULL>' if kind == 'column' else name + '\t0\t1\tid\tBTREE'
        for branch in ('absent', 'replay', 'present'):
            extra = ', register_channel VARCHAR(32)' if kind == 'index' else ''
            if branch == 'present':
                extra += ', ' + name + ' VARCHAR(7) NULL' if kind == 'column' else ', UNIQUE INDEX ' + name + '(id)'
            fixture = 'USE probe; DROP TABLE IF EXISTS ' + table + '; CREATE TABLE ' + table + '(id BIGINT PRIMARY KEY' + extra + '); INSERT INTO ' + table + '(id) VALUES(1);'
            if branch != 'replay':
                sql(fixture)
            before = sql(query)
            data_query = 'USE probe; SELECT id FROM ' + table + ' ORDER BY id;'
            data_before = sql(data_query)
            output = sql('USE probe; ' + body + '\nSELECT @' + g['variable'] + ';')
            after, data_after = sql(query), sql(data_query)
            selected = output.splitlines()[-1] if output else ''
            assert selected == (g['absent_sql'] if branch == 'absent' else 'SELECT 1'), output
            assert after == (incompatible if branch == 'present' else expected), after
            assert before == ('' if branch == 'absent' else after), (before, after)
            assert data_before == data_after == '1', (data_before, data_after)
            g['results'][branch] = True
            g['observations'][branch] = {'fixture_sql': fixture if branch != 'replay' else 'reuse absent result',
                                        'catalog_before': before, 'catalog_after': after, 'data_before': data_before,
                                        'data_after': data_after, 'selected_sql': selected, 'client_output': output}
            save(result)
        fixture = 'USE probe; DROP TABLE IF EXISTS ' + table + ';'
        sql(fixture)
        try:
            output = sql('USE probe; ' + body + '\nSELECT @' + g['variable'] + ';')
        except RuntimeError as exc:
            assert kind == 'index' and '1146' in str(exc) and 'sys_user' in str(exc), str(exc)
            missing = {'status': 'expected_failure', 'passed': False, 'error': str(exc)}
        else:
            assert kind == 'column' and output.splitlines()[-1] == 'SELECT 1', output
            missing = {'status': 'noop', 'selected_sql': 'SELECT 1', 'client_output': output}
        assert sql("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='probe' AND table_name='" + table + "';") == '0'
        missing.update(fixture_sql=fixture, table_still_absent=True)
        g['observations']['missing_table'] = missing
        g['semantic_verified'] = closed(g['results'])
        save(result)
    prefix = "USE probe; SET time_zone='+00:00'; SET timestamp=1767323045;\n"
    fixture = '''USE probe; DROP TABLE IF EXISTS sys_user_social,sys_user,sys_login_log;
CREATE TABLE sys_user(id BIGINT PRIMARY KEY,tenant_id VARCHAR(64),open_id VARCHAR(100),union_id VARCHAR(100),deleted INT DEFAULT 0,create_time DATETIME) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
CREATE TABLE sys_login_log(id BIGINT PRIMARY KEY);
INSERT INTO sys_login_log VALUES(1),(2);
INSERT INTO sys_user VALUES
(1,'tenant-a','o-valid-a','union-a',0,'2021-02-03 04:05:06'),
(2,'tenant-b','o-valid-b',NULL,0,'2022-03-04 05:06:07'),
(3,'tenant-a','PHONE_123','phone-union',0,NULL),
(4,'tenant-b',NULL,'null-union',0,NULL),
(5,'tenant-c','o-deleted','deleted-union',1,NULL),
(6,NULL,'o-null-time','union-six',0,NULL),
(7,'tenant-c','PHONEXvalid','union-seven',0,'2026-01-02 03:04:05'),
(8,'tenant-b','o-existing','replacement-union',0,NULL);
'''
    create_social = statement_inventory(full, 'mysql')[8]['sql'] + ';'
    fixture += create_social + '''
INSERT INTO sys_user_social(id,tenant_id,user_id,channel,open_id,union_id,status,bound_at,version,deleted) VALUES
(90,'original-tenant',900,'WECHAT_APP','o-existing','original-union',0,'2020-01-01 00:00:00',7,1),
(91,'mini-tenant',901,'WECHAT_MINI','o-valid-a','mini-union',1,'2020-01-01 00:00:00',0,0);
'''
    result['full_file'] = {'fixture_sql': fixture, 'execution_prefix': prefix, 'counts_as_branch_proof': False}
    sql(prefix + fixture)
    column_query = ("SELECT table_name,column_name,column_type,is_nullable,COALESCE(column_default,'<NULL>'),extra,ordinal_position "
                    "FROM information_schema.columns WHERE table_schema='probe' ORDER BY table_name,ordinal_position;")
    index_query = ("SELECT table_name,index_name,NON_UNIQUE,SEQ_IN_INDEX,column_name,INDEX_TYPE "
                   "FROM information_schema.statistics WHERE table_schema='probe' ORDER BY table_name,index_name,seq_in_index;")
    def snapshot():
        return {'columns': sql(column_query), 'indexes': sql(index_query),
                'data': {t: sql('USE probe; SELECT * FROM ' + t + ' ORDER BY id;') for t in ('sys_user', 'sys_login_log', 'sys_user_social')}}
    before = snapshot()
    result['full_file']['before_initial'] = before
    assert before['data']['sys_user_social'] == v59_existing_social(), before
    save(result)
    sql(prefix + full)
    after = snapshot()
    result['full_file']['after_initial'] = after
    save(result)
    assert after['columns'] == v59_expected_columns(), after['columns']
    assert after['indexes'] == v59_expected_indexes(), after['indexes']
    assert after['data']['sys_user_social'] == v59_expected_social(), after['data']['sys_user_social']
    for table, suffix in (('sys_user', '\tUNKNOWN'), ('sys_login_log', '\tNULL\tNULL')):
        expected_data = '\n'.join(line + suffix for line in before['data'][table].splitlines())
        assert after['data'][table] == expected_data, (table, after['data'][table], expected_data)
    result['full_file']['before_replay'] = after
    sql(prefix + full)
    replay = snapshot()
    result['full_file']['after_replay'] = replay
    assert after == replay, 'full replay changed catalog or data'
    result['full_file'].update(initial_execution=True, replay=True, catalog_equal=True, backfill_verified=True)
    missing_fixture = 'USE probe; DROP TABLE sys_user;'
    try:
        sql(prefix + missing_fixture + '\n' + full)
    except RuntimeError as exc:
        assert '1146' in str(exc) and 'sys_user' in str(exc), str(exc)
        result['full_file']['missing_table'] = {'status': 'expected_failure', 'passed': False,
                                                'fixture_sql': missing_fixture, 'error': str(exc)}
    else:
        raise AssertionError('full file without sys_user unexpectedly passed')
    result['scenario_status'] = 'branches_and_backfill_passed_with_missing_table_expected_failures'
    result['status'] = 'passed'


V14 = 'apex-system/src/main/resources/db/migration/mysql/V14__add_tenant_id_to_core_tables.sql'
V15 = 'apex-system/src/main/resources/db/migration/mysql/V15__complete_tenant_isolation_schema.sql'


V16 = 'apex-system/src/main/resources/db/migration/mysql/V16__add_tenant_id_to_job_tables.sql'
