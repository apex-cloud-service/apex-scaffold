# ============================================================
# Apex Scaffold - systemd 服务单元模板（微服务 java -jar 部署）
# ============================================================
# 微服务模式下每个进程对应一个微服务模块（apex-gateway / apex-auth-service /
# apex-system-service / apex-workflow-service / apex-office-service / apex-file-service），
# 由 APEX_SERVICE_MODULE 指定且每个微服务各装一份本模板（不同实例名）。旧单体可执行
# jar（apex-interfaces-*-executable.jar）已随单体退役移除。
#
# 生产推荐使用 Podman Compose（podman-compose.yml，网关 + 5 微服务 + 中间件），
# 本模板仅用于无容器的裸机 java -jar 部署场景。
#
# 部署位置: /etc/systemd/system/apex-<service>.service（如 apex-gateway.service）
# 配套环境变量文件: /etc/apex-scaffold/apex.env（每行 KEY=VALUE）
#
# 使用步骤（以 apex-gateway 为例，其它微服务将 <module> 替换为对应模块名）:
#   1. 构建并拷贝可执行 jar（logs 目录存放 GC 日志 gc.log 与 OOM 堆转储 heapdump.hprof）:
#        ./scripts/build/build.sh -Penterprise
#        mkdir -p /opt/apex-scaffold/logs
#        cp <module>/target/<module>-*.jar /opt/apex-scaffold/app.jar
#   2. 创建环境变量文件（见 docs/05-operations/deployment.md 环境变量参考表）:
#        sudo mkdir -p /etc/apex-scaffold
#        sudo tee /etc/apex-scaffold/apex.env > /dev/null <<'EOF'
#        SPRING_PROFILES_ACTIVE=prod,enterprise
#        # 各微服务使用独立库（网关为响应式服务、不直连数据库，可省略以下数据源项）：
#        #   apex-auth-service -> apex_auth   apex-system-service -> apex_system
#        #   apex-workflow-service -> apex_workflow   apex-office-service -> apex_office
#        #   apex-file-service -> apex_file
#        DB_HOST=127.0.0.1
#        DB_PORT=3306
#        DB_NAME=apex_system
#        DB_USERNAME=apex
#        DB_PASSWORD=********
#        REDIS_HOST=127.0.0.1
#        REDIS_PORT=6379
#        REDIS_PASSWORD=********   # prod 强制要求（spring.data.redis.password）
#        JWT_SECRET=please-generate-a-32-byte-random-secret
#        NACOS_CONFIG_ENABLED=false
#        NACOS_DISCOVERY_ENABLED=false
#        NACOS_REGISTER_ENABLED=false
#        NACOS_NAMESPACE=public
#        ROCKETMQ_NAMESERVER=
#        ROCKETMQ_NAMESRV_ADDR=
#        ROCKETMQ_PRODUCER_GROUP=apex-producer-group
#        ROCKETMQ_ACCESS_KEY=
#        ROCKETMQ_SECRET_KEY=
#        APEX_MQ_CONSUMER_ENABLED=false
#        APEX_MQ_DLQ_ENABLED=false
#        APEX_MQ_DOMAIN_EVENT_ENABLED=false
#        APEX_MQ_DOMAIN_EVENT_TOPIC=apex-domain-event
#        MQ_IDEMPOTENT_TTL_MINUTES=30
#        OUTBOX_BATCH_SIZE=50
#        OUTBOX_MAX_ATTEMPTS=8
#        OUTBOX_LOCK_TIMEOUT_SECONDS=120
#        OUTBOX_PARALLELISM=4
#        OUTBOX_RETENTION_ENABLED=true
#        OUTBOX_RETENTION_DELIVERED_HOURS=168
#        OUTBOX_RETENTION_DEAD_DAYS=30
#        OUTBOX_RETENTION_BATCH_SIZE=5000
#        APEX_LOG_DIR=/var/log/apex-scaffold
#        EOF
#   3. 安装并启用（每个微服务一份，实例名按模块命名）:
#        sudo cp scripts/deploy/apex-scaffold.service /etc/systemd/system/apex-gateway.service
#        sudo chown -R apex:apex /opt/apex-scaffold /var/log/apex-scaffold
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now apex-gateway
#   4. 常用操作:
#        systemctl status apex-gateway
#        journalctl -u apex-gateway -f
#        sudo systemctl restart apex-gateway
# ============================================================

[Unit]
Description=Apex Scaffold Microservice (java -jar)
Documentation=https://github.com/your-org/apex-scaffold
After=network-online.target mysqld.service redis.service
Wants=network-online.target

[Service]
Type=simple
# 建议创建专用系统用户: useradd -r -s /usr/sbin/nologin apex
User=apex
Group=apex
WorkingDirectory=/opt/apex-scaffold

# 环境变量文件（数据库 / Redis / JWT / Nacos / RocketMQ / Outbox / 开关等，见上方说明）
EnvironmentFile=/etc/apex-scaffold/apex.env
# standalone 模式仅维护本地 readiness，不调用 systemd 或编排平台 API
Environment=APEX_GOVERNANCE_DEPLOYMENT_MODE=standalone
Environment=APEX_GOVERNANCE_SHUTDOWN_TIMEOUT=90s
Environment=APEX_GOVERNANCE_READINESS_WITHDRAW_TIMEOUT=5s
Environment=APEX_GOVERNANCE_MQ_DRAIN_TIMEOUT=30s
Environment=APEX_GOVERNANCE_FORCE_SHUTDOWN=true

# JVM 参数（生产级调优默认。注意 Environment= 优先于 EnvironmentFile=：
# 如需覆盖请直接修改本行，或注释本行后在 apex.env 中设置 JAVA_OPTS）:
#   -Xms/-Xmx            堆内存 初始(最小)512m / 最大 1024m
#   -XX:+UseG1GC          G1 垃圾回收器；-XX:MaxGCPauseMillis=200 目标最大停顿
#   -XX:MetaspaceSize/-XX:MaxMetaspaceSize  元空间初始 256m / 上限 512m
#   -XX:+HeapDumpOnOutOfMemoryError          OOM 自动堆转储到 /opt/apex-scaffold/logs
#   -XX:+ExitOnOutOfMemoryError              OOM 后退出进程，systemd Restart=on-failure 自动拉起
#   -Xlog:gc*:file=...                       滚动 GC 日志（5 份 × 20m）
#   -Dfile.encoding=UTF-8 -Djava.security.egd=file:/dev/./urandom
Environment=JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MetaspaceSize=256m -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/apex-scaffold/logs/heapdump.hprof -XX:+ExitOnOutOfMemoryError -Xlog:gc*:file=/opt/apex-scaffold/logs/gc.log:time,uptime,level,tags:filecount=5,filesize=20m -Dfile.encoding=UTF-8 -Djava.security.egd=file:/dev/./urandom

# 启动命令（bash -c 用于展开 $JAVA_OPTS）
ExecStart=/usr/bin/env bash -c 'exec java $JAVA_OPTS -jar /opt/apex-scaffold/app.jar'

# 优雅停机：发送 SIGTERM，105 秒覆盖应用 90 秒总预算并预留摘流传播缓冲
ExecStop=/bin/kill -s TERM $MAINPID
TimeoutStopSec=105
KillMode=control-group

# 崩溃自动重启
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=5

# 日志统一走 journald（应用自身亦输出 logs/ 目录文件，APEX_LOG_DIR 控制）
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
