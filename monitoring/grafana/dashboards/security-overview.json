{
  "dashboard": {
    "title": "Apex安全监控总览",
    "tags": ["security", "authentication", "oauth2"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "认证成功率",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "(sum(rate(auth_success_total[5m])) / (sum(rate(auth_success_total[5m])) + sum(rate(auth_failure_total[5m])))) * 100",
            "legendFormat": "成功率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 90, "color": "yellow"},
                {"value": 95, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "活跃会话数",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "auth_active_sessions",
            "legendFormat": "活跃会话"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1000, "color": "yellow"},
                {"value": 5000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Token颁发速率",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(token_issued_total[5m]))",
            "legendFormat": "Token/秒"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 2
          }
        }
      },
      {
        "id": 4,
        "title": "暴力破解检测",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(security_bruteforce_detected_total[1h]))",
            "legendFormat": "最近1小时"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "orange"},
                {"value": 10, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "认证请求趋势",
        "type": "graph",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(auth_success_total[1m]))",
            "legendFormat": "成功"
          },
          {
            "expr": "sum(rate(auth_failure_total[1m]))",
            "legendFormat": "失败"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "请求/秒"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Token操作趋势",
        "type": "graph",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(token_issued_total[1m]))",
            "legendFormat": "颁发"
          },
          {
            "expr": "sum(rate(token_refreshed_total[1m]))",
            "legendFormat": "刷新"
          },
          {
            "expr": "sum(rate(token_revoked_total[1m]))",
            "legendFormat": "撤销"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "操作/秒"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "认证失败原因分布",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 12, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(auth_failure_by_reason[1h])) by (reason)",
            "legendFormat": "{{reason}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "权限拒绝统计",
        "type": "table",
        "gridPos": {"x": 8, "y": 12, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "topk(10, sum(increase(permission_denied_by_resource[1h])) by (resource, action))",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "resource": "资源",
                "action": "操作",
                "Value": "拒绝次数"
              }
            }
          }
        ]
      },
      {
        "id": 9,
        "title": "认证响应时间 (P50/P95/P99)",
        "type": "graph",
        "gridPos": {"x": 16, "y": 12, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(auth_duration_bucket[5m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(auth_duration_bucket[5m])) by (le))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(auth_duration_bucket[5m])) by (le))",
            "legendFormat": "P99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "延迟"},
          {"format": "short"}
        ]
      },
      {
        "id": 10,
        "title": "失败IP地址 Top 10",
        "type": "table",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "topk(10, auth_failed_logins_ips)",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 11,
        "title": "Token验证响应时间",
        "type": "graph",
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(token_validation_duration_bucket[5m])) by (le))",
            "legendFormat": "P95"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "延迟"},
          {"format": "short"}
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s"
  }
}
