<?xml version="1.0" encoding="UTF-8"?>
<!--
  服务日志配置：控制台 + 滚动文件 + JSON 文件三路输出，按异步 Appender 聚合。

  日志目录优先级：环境变量 LOG_PATH > apex.log.dir（Spring 属性，dev 下指向项目根
  logs/）> APEX_LOG_DIR > 进程工作目录下的 logs/。文件名取 spring.application.name，
  滚动策略为按天 + 100MB 分片、保留 7 天、总量上限 2GB；JSON 输出经 AsyncAppender
  异步写入，避免日志写入阻塞业务线程。
-->
<configuration>
  <springProperty scope="context" name="APEX_LOG_HOME" source="apex.log.dir" defaultValue="${APEX_LOG_DIR:-${user.dir}/logs}"/>
  <property name="LOG_HOME" value="${LOG_PATH:-${APEX_LOG_HOME}}"/>
  <springProperty scope="context" name="LOG_NAME" source="spring.application.name" defaultValue="apex-workflow-service"/>
  <appender name="CONSOLE_OUTPUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-N/A}] %logger{60} - %msg%n</pattern><charset>UTF-8</charset></encoder>
  </appender>
  <appender name="CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>1024</queueSize><discardingThreshold>200</discardingThreshold><neverBlock>true</neverBlock><includeCallerData>false</includeCallerData><maxFlushTime>2000</maxFlushTime>
    <appender-ref ref="CONSOLE_OUTPUT"/>
  </appender>
  <appender name="JSON_FILE_OUTPUT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/${LOG_NAME}-json.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/${LOG_NAME}-json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize><maxHistory>7</maxHistory><totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeContext>false</includeContext><excludeMdcKeyName>tid</excludeMdcKeyName>
      <provider class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.logstash.TraceIdJsonProvider"/>
      <customFields>{"service":"${LOG_NAME}","serviceName":"${LOG_NAME}"}</customFields>
    </encoder>
  </appender>
  <appender name="JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>1024</queueSize><discardingThreshold>200</discardingThreshold><neverBlock>true</neverBlock><includeCallerData>false</includeCallerData><maxFlushTime>2000</maxFlushTime>
    <appender-ref ref="JSON_FILE_OUTPUT"/>
  </appender>
  <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="JSON_FILE"/></root>
</configuration>
