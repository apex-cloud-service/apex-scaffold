<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - Services BOM
  - 微服务改造依赖版本管理 (Bill of Materials)
  - 用途：作为网关、契约、五个业务服务及任务/脱敏服务的 parent，统一锁定：
  -   1) 内部模块版本（apex-common / apex-api-contract / apex-license-starter…）
  -   2) 第三方依赖版本（Spring Cloud / Alibaba / MyBatis-Plus / Redis / MQ / Sentinel / Resilience4j…）
  - 约束：
  -   * 各业务服务、网关、契约模块的 <parent> 必须指向本 BOM；
  -   * 业务代码禁止自行声明第三方版本号，统一经本 BOM 管理（版本单源）；
  -   * 新增第三方依赖须先在本 BOM 声明 <dependencyManagement> 后再使用。
  - @author Apex Team
  - @since 1.3.1 (微服务改造 Phase 1)
  - @version 1.3.1
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- 继承根父 POM（提供插件/质量门禁编排），自身托管微服务依赖版本 -->
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-scaffold</artifactId>
        <version>1.3.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>apex-services-bom</artifactId>
    <packaging>pom</packaging>
    <name>apex-services-bom</name>
    <description>Apex Scaffold - 微服务 BOM (统一锁定各服务模块与第三方依赖版本)</description>

    <dependencyManagement>
        <dependencies>
            <!-- ========== 第三方 BOM 导入 ========== -->
            <!-- Spring Cloud 全家桶版本（含 gateway / loadbalancer / resilience4j 等，由根 POM 提供版本） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba 组件（Nacos / Sentinel）版本单源 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 内部模块版本锁定 ========== -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-api-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-license-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 业务服务 / 契约模块至本 BOM 的互相锁定（Phase 2-6 随模块新增补充） -->
            <!-- 工作流服务（Phase 3） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-workflow-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 工作流领域/应用模块（工作流服务依赖） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 领域层（工作流领域模型与仓储契约） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 文件服务（Phase 4） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-file-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 文件领域/应用模块（文件服务依赖） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 办公领域/应用模块（办公服务依赖，Phase 5） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-office</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 办公服务（Phase 5） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-office-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 系统服务（Phase 6） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-system-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 认证领域/应用模块（认证服务依赖，Phase 6） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 认证服务（Phase 6） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-auth-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 基础设施层（系统服务依赖，Phase 6 收敛） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 接口层（系统 Web 层：ApiRouter 拆分后的子系统路由/处理器，Phase 6 收敛） -->
            <dependency>
                <groupId>com.apex.scaffold</groupId>
                <artifactId>apex-system</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- ========== 持久层 / ORM ========== -->
            <!-- MyBatis-Plus（WebFlux 响应式与声明式事务场景下仍可作为辅助 ORM 使用） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 动态数据源（多库切换：mysql/postgres，微服务独立库场景按需引入） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>

            <!-- ========== 缓存：Redis / Redisson ========== -->
            <!-- 响应式 Redis （网关限流令牌桶依赖） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <!-- Redisson（分布式锁 / 缓存/黑名单场景） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ========== 消息中间件：RocketMQ ========== -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>

            <!-- ========== 限流 / 熔断：Sentinel + Resilience4j ========== -->
            <!-- Sentinel（依托 nacos 数据源实现动态限流/降级规则下发） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-datasource-nacos</artifactId>
                <version>${sentinel-logging-slf4j.version}</version>
            </dependency>
            <!-- Resilience4j（熔断器，WebFlux 响应式场景与 Sentinel 互补） -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-reactor</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- ========== Spring Cloud Alibaba 版本补充 ========== -->
            <!-- spring-cloud-dependencies BOM 不含 alibaba starter 版本, 需在此声明（冗余防护，与上面 import 保持一致性） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
