<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-tools-parent</artifactId>
        <version>1.3.1</version>
    </parent>

    <artifactId>apex-license-tools</artifactId>
    <name>Apex License Tools (Internal)</name>
    <description>
        Apex License 发放工具（卖方内部模块，不随发行源码交付）。

        - 提供 LicenseGenerator CLI：生成密钥对 / 发放 License
        - 仅卖方持有并使用，配合卖方私钥（config/license/private.key，绝不入库、绝不打包）
        - 对外交付的发行包（zip / 源码交付）必须剥离本模块；
          scripts/release/release.sh 不打包本模块产物，源码交付清单见 docs/LICENSING_DELIVERY_CHECKLIST.md
    </description>

    <dependencies>
        <!-- License 校验组件（LicenseInfo/LicenseVersion/RsaUtil） -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-license-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===== 测试依赖 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
