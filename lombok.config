# ============================================================
# Lombok 项目级配置文件
# ============================================================
# 详见：https://projectlombok.org/features/configuration
# 
# 本配置文件统一管理 Apex Scaffold 项目中 Lombok 注解的行为，
# 确保所有模块生成一致的代码风格。
# ============================================================

# Builder 配置
# 注意：toBuilder 功能需要在 @Builder 注解上显式设置 toBuilder = true
# Lombok 不支持全局配置 toBuilder，这里仅作说明

# 为所有 @EqualsAndHashCode 和 @Data 类生成 canEqual() 方法，
# 确保子类与父类的 equals() 语义正确
lombok.equalsAndHashCode.callSuper = call

# 为所有 Lombok 生成的方法添加 @lombok.Generated 注解，
# 方便 JaCoCo 等覆盖率工具排除生成代码
lombok.addLombokGeneratedAnnotation = true

# 构造器访问级别默认配置
# 注意：这些配置可被注解上的 access 参数覆盖
lombok.allArgsConstructor.flagUsage = warning
lombok.noArgsConstructor.flagUsage = warning

# 日志框架配置（统一使用 Slf4j）
lombok.log.fieldName = log
lombok.log.fieldIsStatic = true

# @Accessors 配置（链式调用）
lombok.accessors.chain = false
lombok.accessors.fluent = false

# 禁用某些不推荐使用的 Lombok 功能
# @SneakyThrows 会隐藏检查异常，违反异常处理最佳实践
lombok.sneakyThrows.flagUsage = error

# @Synchronized 生成的同步代码不够灵活，推荐手动使用 synchronized
lombok.synchronized.flagUsage = warning

# @Cleanup 在某些场景下可能导致资源泄露，建议使用 try-with-resources
lombok.cleanup.flagUsage = warning

# @val 和 @var 类型推断可能降低代码可读性
lombok.val.flagUsage = warning
lombok.var.flagUsage = warning

# ============================================================
# Apex Scaffold 项目约定
# ============================================================
# 1. DTO/VO/Request/Response 类：使用 @Data + @Builder + 构造器
# 2. Domain Entity：使用 @Getter + @Builder，通过领域方法修改状态
# 3. Service/Component：使用 @Slf4j + @RequiredArgsConstructor
# 4. 禁止手写 getter/setter/constructor/toString/equals/hashCode
# ============================================================
