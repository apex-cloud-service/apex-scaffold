<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - 知识库业务库 POM
  - 项目专属业务库：知识空间、知识文档摄取（解析/分块/向量化）、混合检索与问答编排的
  -   DDD 四层实现（domain / application / infrastructure）。
  - 约束：本模块 <parent> 指向 apex-business-parent；协议层（Router/Handler）位于
  -   apex-knowledge-service 运行模块，不在此重复。
  - @author Apex Team
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-business-parent</artifactId>
        <version>1.3.1</version>
    </parent>

    <artifactId>apex-knowledge</artifactId>
    <packaging>jar</packaging>
    <name>apex-knowledge</name>
    <description>Apex Scaffold - 知识库业务库（摄取管线/混合检索/问答编排）</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>
        <!-- MyBatis-Plus 拦截器链（多租户/数据权限/乐观锁/分页）由共享持久化能力 JAR 提供 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-infrastructure-persistence</artifactId>
        </dependency>
        <!-- 知识文档对象存取：复用五后端存储自动装配，不在知识域重复实现存储 -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-storage-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 知识分块索引：Meilisearch SDK（写入/索引管理）；hybrid 检索经 REST 直调 -->
        <dependency>
            <groupId>com.meilisearch.sdk</groupId>
            <artifactId>meilisearch-java</artifactId>
        </dependency>
        <!-- 文档文本解析：Tika 一站式抽取 pdf/office/html/txt 正文 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 模型供应商适配器测试：MockWebServer 扮演 OpenAI 兼容端点 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!--
                    结构性代码排除说明（BUNDLE 60%/50% 门禁保留）：
                    - dto/model/po：纯数据载体（record 与 Lombok PO/实体），无分支逻辑；
                    - mapper：MyBatis-Plus BaseMapper 空接口；
                    - config：配置属性绑定与条件装配声明，覆盖意义在装配而非行覆盖。
                    领域服务、应用编排、适配器与仓储全部纳入统计。
                -->
                <configuration>
                    <excludes>
                        <exclude>com/apex/scaffold/knowledge/application/dto/**</exclude>
                        <exclude>com/apex/scaffold/knowledge/domain/model/**</exclude>
                        <exclude>com/apex/scaffold/knowledge/domain/gateway/**</exclude>
                        <exclude>com/apex/scaffold/knowledge/infrastructure/persistence/po/**</exclude>
                        <exclude>com/apex/scaffold/knowledge/infrastructure/persistence/mapper/**</exclude>
                        <exclude>com/apex/scaffold/knowledge/config/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
