# 统一文本文件换行符为 LF，避免跨平台换行符混乱
* text=auto eol=lf

# 源代码统一 LF
*.java text eol=lf
*.kt text eol=lf
*.scala text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.md text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件标记
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
