<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.apex.scaffold</groupId>
        <artifactId>apex-scaffold</artifactId>
        <version>1.1.3</version>
    </parent>

    <artifactId>apex-license-spring-boot-starter</artifactId>
    <name>Apex License Spring Boot Starter</name>
    <description>
        Apex Scaffold 内置 License 授权校验组件（产品整体交付，随源码一同出售）。

        提供 License 校验、FeatureGate 功能门控切面与发放工具：
        - 定位为本脚手架的内置授权模块，与 apex-common 共同编译交付，不可脱离本工程独立分发
        - 全部 Bean 由 AutoConfiguration 注册，不依赖宿主应用的组件扫描路径
        - apex.license.enabled=false 可整体关闭（spring.autoconfigure.exclude 亦可排除）
        - 无有效 License 时容错降级：基础功能放行、商业功能拒绝
        - 商业防护依赖合同约束与私钥保密（卖方保留 config/license/private.key，不随源码交付）；
          对持有完整源码的买家，本组件为最佳努力的授权基线而非绝对技术屏障
    </description>

    <dependencies>
        <!-- Apex 公共模块：依赖其 error/exception/result 与 annotation.FeatureGate -->
        <dependency>
            <groupId>com.apex.scaffold</groupId>
            <artifactId>apex-common</artifactId>
        </dependency>

        <!-- AOP 切面支持（FeatureGateAspect） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Jackson：License JSON 序列化/反序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===== 测试依赖 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
