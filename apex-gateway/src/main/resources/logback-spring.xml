<?xml version="1.0" encoding="UTF-8"?>
<!--
  - Apex Scaffold - API 网关 Logback 配置
  - 与主应用保持同一套日志规范: 控制台 (本地) + 滚动文件 + traceId 透出
  - @author Apex Team
-->
<configuration>

    <springProperty scope="context" name="APEX_LOG_HOME" source="apex.log.dir" defaultValue="${APEX_LOG_DIR:-${user.dir}/logs}"/>
    <property name="LOG_HOME" value="${LOG_PATH:-${APEX_LOG_HOME}}"/>
    <springProperty scope="context" name="LOG_NAME" source="spring.application.name" defaultValue="apex-gateway"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/apex-gateway.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/apex-gateway.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 网关路由/过滤器日志量较大，生产环境收敛为 WARN -->
    <logger name="org.springframework.cloud.gateway" level="INFO"/>
    <logger name="reactor.netty" level="WARN"/>
    <logger name="com.apex.scaffold.gateway" level="INFO"/>

    <appender name="JSON_FILE_OUTPUT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${LOG_NAME}-json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${LOG_NAME}-json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <excludeMdcKeyName>tid</excludeMdcKeyName>
            <provider class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.logstash.TraceIdJsonProvider"/>
            <customFields>{"service":"${LOG_NAME}","serviceName":"${LOG_NAME}"}</customFields>
        </encoder>
    </appender>
    <appender name="JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>200</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <maxFlushTime>2000</maxFlushTime>
        <appender-ref ref="JSON_FILE_OUTPUT"/>
    </appender>
    <root level="INFO">
        <appender-ref ref="JSON_FILE"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
